{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrcaTeamConfig",
  "description": "Configuration schema for Orca Multi-Agent Orchestration Team",
  "projectPath": ".",
  "executionHost": "local",
  "coordinator": {
    "agent": "antigravity",
    "description": "Lead Architect & DAG Coordinator",
    "model": "claude-opus-5-5",
    "effort": "high"
  },
  "roles": {
    "developer": {
      "agent": "antigravity",
      "concurrency": 2,
      "utilities": [
        "git-worktrees",
        "browser-design-mode",
        "orca-skills-registry"
      ],
      "model": "gemini-3.8-flash",
      "effort": "low"
    },
    "qa": {
      "agent": "antigravity",
      "concurrency": 1,
      "utilities": [
        "git-worktrees",
        "browser-design-mode",
        "orca-skills-registry"
      ],
      "model": "gemini-3.8-flash",
      "effort": "low"
    },
    "security": {
      "agent": "antigravity",
      "concurrency": 1,
      "utilities": [
        "git-worktrees",
        "orca-skills-registry"
      ],
      "model": "gemini-4-argon",
      "effort": "high"
    },
    "prReviewer": {
      "agent": "antigravity",
      "utilities": [
        "git-worktrees",
        "diff-viewer",
        "annotate-ai-diff"
      ],
      "model": "gemini-4-argon",
      "effort": "high"
    },
    "issueResolver": {
      "agent": "antigravity",
      "utilities": [
        "git-worktrees",
        "issue-metadata",
        "commit-push"
      ],
      "model": "gemini-4-argon",
      "effort": "high"
    },
    "uiSpecialist": {
      "enabled": true,
      "agent": "antigravity",
      "utilities": [
        "browser-design-mode",
        "per-worktree-browser"
      ],
      "model": "gemini-3.8-flash"
    },
    "devopsSpecialist": {
      "enabled": true,
      "agent": "antigravity",
      "utilities": [
        "ssh-remote-execution",
        "orca-per-workspace-env"
      ],
      "model": "gemini-3.8-flash"
    }
  }
}
