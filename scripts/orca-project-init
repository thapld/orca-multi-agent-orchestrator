  EXTRA_STEP1_RULES="${EXTRA_STEP1_RULES}  # Principal DevOps/SRE (BẮT BUỘC khi có Docker, K8s, pod, Helm, CI/CD, DB migration, .env, infra):
  orca orchestration task-create --spec \"[ROLE: PRINCIPAL DEVOPS/SRE] Nhiệm vụ: [Docker/K8s/DB/Infra]. Chuẩn: Dockerfile multi-stage/non-root, K8s probes/limits, DB migration idempotent có rollback. CẤM VƯỢT RÀO: Chỉ sửa Infra/Docker/K8s/DB/CI; CẤM sửa business logic của Dev (nếu container crash do code Dev, phải gửi container log và báo failed/escalation). BẰNG CHỨNG BẮT BUỘC: (1) Phải git merge --no-edit <nhánh-dev> trước khi build code mới, (2) CẤM chỉ sửa YAML/Dockerfile rồi báo xong — phải chạy build/rollout thật, xác nhận pod Running (1/1 Ready, 0 Restarts, không CrashLoopBackOff), log sạch và git commit.\" --json"$'\n'
  EXTRA_STEP2_CMDS="${EXTRA_STEP2_CMDS}  # DevOps Worker (khi có Task DevOps - Docker/K8s/DB/Infra):
  orca orchestration worker-start --task <DEVOPS_TASK_ID> --worktree new-child --name devops-worker $(fmt_worker_args "$DEVOPS_AGENT" "$DEVOPS_MODEL" "${DEVOPS_EFFORT:-high}") --json"$'\n'
fi

if [[ "$ENABLE_UI" == true ]]; then
  EXTRA_TABLE_ROWS="${EXTRA_TABLE_ROWS}| **UI/UX Specialist** | $(fmt_md_cell "$UI_AGENT" "$UI_MODEL") | On-demand | Design Mode (Click-to-code), responsive & a11y |"$'\n'
  EXTRA_STEP1_RULES="${EXTRA_STEP1_RULES}  # Principal UI/UX (Khi có Frontend, CSS/DOM, Design Mode):
  orca orchestration task-create --spec \"[ROLE: PRINCIPAL UI/UX] Nhiệm vụ: [Giao diện, CSS/DOM, Responsive & a11y]. CẤM VƯỢT RÀO: Chỉ sửa UI/Frontend; CẤM sửa backend/DB. BẰNG CHỨNG BẮT BUỘC: Build/typecheck EXIT_CODE=0, không lỗi Console, kiểm tra snapshot/screenshot Mobile/Desktop và git commit.\" --json"$'\n'
  EXTRA_STEP2_CMDS="${EXTRA_STEP2_CMDS}  # UI Worker (khi có Task Frontend/UI):
  orca orchestration worker-start --task <UI_TASK_ID> --worktree new-child --name ui-worker $(fmt_worker_args "$UI_AGENT" "$UI_MODEL" "${UI_EFFORT:-medium}") --json"$'\n'
fi

if [[ "$ENABLE_BENCH" == true ]]; then
  EXTRA_TABLE_ROWS="${EXTRA_TABLE_ROWS}| **Bench & Perf Specialist** | $(fmt_md_cell "$BENCH_AGENT" "$BENCH_MODEL") | On-demand | Stress/Load test (RPS/EPS), p95/p99 latency, profiling |"$'\n'
  EXTRA_STEP1_RULES="${EXTRA_STEP1_RULES}  # Principal Benchmark & Perf (BẮT BUỘC khi đo tải RPS/EPS, tối ưu hiệu năng, latency p95/p99, batch/queue/DB tuning):
  orca orchestration task-create --spec \"[ROLE: PRINCIPAL BENCHMARK & PERF] Nhiệm vụ: [Đo tải, benchmark & profiling]. Chuẩn: Có bước warm-up, dùng công cụ chuẩn (k6/wrk/JMH/pytest-benchmark/go test -bench/EXPLAIN ANALYZE), đo Before vs After. CẤM VƯỢT RÀO: Chỉ viết/chạy benchmark & phân tích bottleneck; CẤM tự sửa business logic hoặc drop dữ liệu/bỏ validate để ăn gian điểm số! BẰNG CHỨNG BẮT BUỘC: (1) Phải git merge --no-edit <nhánh-dev> để đo trên code mới nhất, (2) CẤM nhận xét cảm tính ('Hệ thống mượt') — bắt buộc xuất bảng số liệu thật: Concurrency, Throughput (req/s hoặc EPS), Latency (p50/p95/p99), Error Rate (0%), CPU/RAM, chỉ rõ file:line gây nghẽn và chốt PERF_VERDICT: PASS hoặc BOTTLENECK_FOUND.\" --json"$'\n'
