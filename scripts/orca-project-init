  EXTRA_STEP1_POST_QA="${EXTRA_STEP1_POST_QA}  # Principal Reverse Engineer - REA (BẮT BUỘC khi dịch ngược binary/JAR/ASAR/APK/firmware/network capture hoặc tái tạo giao thức đóng):
  orca orchestration task-create --spec \"\$(orca-team spec re '[Giải phẫu artifact/binary/protocol với rea]')\""$'\n'
