# ── 7. Host Môi trường Thực thi ──
host_menu=(
  "local (Chạy trực tiếp trên máy macOS)"
  "ssh:orb (Chạy remote qua SSH target 'orb')"
  "SSH target tùy chỉnh..."
)
host_choice_idx=1
if [[ "$AUTO_YES" == true ]]; then
  host_choice_idx=1
elif [[ -x "$ORCA_TEAM_BIN" ]]; then
  host_choice_idx=$(python3 "$ORCA_TEAM_BIN" select \
    --title "PHẦN 7: MÔI TRƯỜNG THỰC THI CHÍNH (Execution Host)" \
    --options "${host_menu[@]}" \
    --default-idx 0 \
    --return-idx)
else
  printf "Chọn [1: local, 2: ssh:orb, 3: custom] (Enter = 1): "
  read -r host_choice_idx
  host_choice_idx="${host_choice_idx:-1}"
fi

if [[ "$host_choice_idx" == "2" ]]; then
  EXEC_HOST="ssh:orb"
  HOST_LABEL="SSH Target (ssh:orb)"
elif [[ "$host_choice_idx" == "3" ]]; then
  printf "   Nhập tên SSH host target trong Orca (ví dụ: ssh:remote-server): "
  read -r ssh_target_input
  EXEC_HOST="${ssh_target_input:-ssh:orb}"
  HOST_LABEL="SSH Target ($EXEC_HOST)"
else
  EXEC_HOST="local"
  HOST_LABEL="Local Machine"
fi

