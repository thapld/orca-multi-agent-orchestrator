# ── Tự động cài đặt & đồng bộ skill reverse-engineer-anything (https://github.com/morluto/rea.git) nếu bật RE ──
if [[ "$ENABLE_RE" == true ]]; then
  rea_skill_gemini="$HOME/.gemini/config/skills/reverse-engineer-anything"
  rea_skill_agents="$HOME/.agents/skills/reverse-engineer-anything"
  rea_skill_claude="$HOME/.claude/skills/reverse-engineer-anything"
  if [[ ! -f "$rea_skill_gemini/SKILL.md" && ! -f "$rea_skill_agents/SKILL.md" ]]; then
    echo "   🔧 [REA] Đang tải và cài đặt skill 'reverse-engineer-anything' từ https://github.com/morluto/rea.git..."
    TMP_REA="/tmp/orca-rea-skill-$$"
    if git clone --depth 1 https://github.com/morluto/rea.git "$TMP_REA" >/dev/null 2>&1; then
      src_skill=""
      for cand in "$TMP_REA/skills/reverse-engineer-anything" "$TMP_REA/skill/reverse-engineer-anything" "$TMP_REA"; do
        if [[ -f "$cand/SKILL.md" ]]; then
          src_skill="$cand"
          break
        fi
      done
      if [[ -n "$src_skill" ]]; then
        mkdir -p "$(dirname "$rea_skill_gemini")"
        cp -R "$src_skill" "$rea_skill_gemini"
        echo "   ✅ [REA] Đã cài đặt skill vào $rea_skill_gemini"
      fi
      rm -rf "$TMP_REA"
      TMP_REA=""
    fi
  fi
  if [[ -f "$rea_skill_gemini/SKILL.md" ]]; then
    for dst_sk in "$rea_skill_agents" "$rea_skill_claude"; do
      if [[ ! -f "$dst_sk/SKILL.md" ]]; then
        mkdir -p "$(dirname "$dst_sk")"
        cp -R "$rea_skill_gemini" "$dst_sk" 2>/dev/null || true
      fi
    done
  fi
  rea_client="antigravity"
  case "${RE_AGENT:l}" in
    antigravity) rea_client="antigravity" ;;
    gemini)      rea_client="gemini_cli" ;;
    claude)      rea_client="claude_code" ;;
    codex)       rea_client="codex" ;;
    cursor)      rea_client="cursor" ;;
    opencode)    rea_client="opencode" ;;
    copilot)     rea_client="copilot_cli" ;;
  esac
  if command -v rea >/dev/null 2>&1; then
    rea setup --client "$rea_client" --yes >/dev/null 2>&1 || true
  elif command -v npx >/dev/null 2>&1; then
    npx -y rea-agents@latest setup --client "$rea_client" --yes >/dev/null 2>&1 || true
  fi
fi

# ── Ghi file config JSON ──
json_str_or_null() {
  local val="$1"
  if [[ -z "$val" ]]; then
    echo "null"
  else
    local esc="${val//\\/\\\\}"
    esc="${esc//\"/\\\"}"
    printf '"%s"' "$esc"
  fi
}

