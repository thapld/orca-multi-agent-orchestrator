  orca orchestration worker-start --task <DEV_TASK_ID> \$(orca-team worktree-arg dev --task <DEV_TASK_ID>) $(fmt_worker_args "$DEV_AGENT" "$DEV_MODEL" "$DEV_EFFORT") --json
  # [ĐỢT 2 — KIỂM ĐỊNH / TRIỂN KHAI] CHỈ chạy các lệnh dưới đây SAU KHI toàn bộ Đợt 1 đã báo worker_done ở Bước 3!
${EXTRA_STEP2_PRE_SEC}  # Security Worker (chạy ở Đợt 2 sau khi Dev đã hoàn tất):
