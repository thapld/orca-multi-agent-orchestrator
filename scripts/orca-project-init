#!/usr/bin/env zsh
# orca-project-init: Cấu hình hệ thống Multi-Agent Orchestration toàn diện trên nền tảng Orca ADE
# Bao gồm: Core Roles, Git Lifecycle Roles (PR Review & Issue Resolver), và Specialized Extensions.
# Dùng: orca-project-init [/path/to/project]

set -e

if [[ "$1" == "--uninstall" || "$1" == "uninstall" || "$1" == "--clean" ]]; then
  TARGET_DIR="${2:-.}"
  TARGET_PATH=$(cd "$TARGET_DIR" 2>/dev/null && pwd || echo "$TARGET_DIR")

  # Bảo vệ: Không bao giờ tự gỡ bỏ chính kho mã nguồn của framework
  if [[ -d "$TARGET_PATH/templates" && -f "$TARGET_PATH/package.json" ]]; then
    if grep -q '"name": *"orca-multi-agent-orchestrator"' "$TARGET_PATH/package.json" 2>/dev/null; then
      echo "🚫 Đây là thư mục gốc của bộ công cụ 'orca-multi-agent-orchestrator'."
      echo "   Không thể tự gỡ bỏ chính kho mã nguồn framework!"
      echo "   Để gỡ bỏ các CLI khỏi máy: hãy chạy './uninstall.sh'."
      exit 1
    fi
  fi

  echo "🐋 [Orca Orchestrator Uninstaller] Đang gỡ bỏ cấu hình khỏi: $TARGET_PATH..."
  
  if [[ -f "$TARGET_PATH/orca-team.json" ]]; then
    rm -f "$TARGET_PATH/orca-team.json"
    echo "  🗑️  Đã xóa: orca-team.json"
  fi
  if [[ -L "$TARGET_PATH/CLAUDE.md" ]]; then
    rm -f "$TARGET_PATH/CLAUDE.md"
    echo "  🗑️  Đã xóa symlink: CLAUDE.md"
  fi
  if [[ -L "$TARGET_PATH/AGENTS.md" ]]; then
    rm -f "$TARGET_PATH/AGENTS.md"
    echo "  🗑️  Đã xóa symlink: AGENTS.md"
  fi
  if [[ -f "$TARGET_PATH/.agents/GEMINI.md" ]]; then
    FIRST_LINE=$(head -n 1 "$TARGET_PATH/.agents/GEMINI.md" 2>/dev/null || true)
    if [[ "$FIRST_LINE" == "# Orca Multi-Agent Orchestration Directive" ]]; then
      rm -f "$TARGET_PATH/.agents/GEMINI.md"
      echo "  🗑️  Đã xóa: .agents/GEMINI.md"
      rmdir "$TARGET_PATH/.agents" 2>/dev/null || true
    fi
  fi
  echo "🎉 Dự án đã được khôi phục về trạng thái ban đầu sạch sẽ!"
  exit 0
fi

PROJECT_DIR="${1:-.}"
PROJECT_PATH=$(cd "$PROJECT_DIR" 2>/dev/null && pwd || echo "$PROJECT_DIR")
AGENTS_DIR="$PROJECT_PATH/.agents"
TARGET_RULE="$AGENTS_DIR/GEMINI.md"
TARGET_CONFIG="$PROJECT_PATH/orca-team.json"

AVAILABLE_AGENTS=(
  "kimi"
  "claude"
  "codex"
  "cursor"
  "antigravity"
  "opencode"
  "aider"
  "goose"
  "copilot"
)

print_agents() {
  local default_idx="$1"
  for i in {1..${#AVAILABLE_AGENTS[@]}}; do
    local marker=""
    [[ "$i" == "$default_idx" ]] && marker=" (khuyến nghị)"
    echo "    $i) ${AVAILABLE_AGENTS[$i]}$marker"
  done
}

choose_agent() {
  local role_title="$1"
  local default_idx="$2"
  echo ""
  echo "👉 [Chọn Agent] cho: $role_title"
  print_agents "$default_idx"
  printf "   Nhập số [1-${#AVAILABLE_AGENTS[@]}] (Enter = $default_idx [${AVAILABLE_AGENTS[$default_idx]}]): "
  read -r choice
  choice="${choice:-$default_idx}"
  if ! [[ "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#AVAILABLE_AGENTS[@]} )); then
    choice=$default_idx
  fi
  SELECTED_AGENT="${AVAILABLE_AGENTS[$choice]}"
  echo "   ➔ Đã chọn: $SELECTED_AGENT"
}

choose_model() {
  local agent="$1"
  local role_title="$2"
  local default_eff="${3:-high}"
  local role_tier="${4:-tier2}"
  
  SELECTED_MODEL=""
  SELECTED_EFFORT=""
  
  local options=()
  local rec_model_idx=1
  case "$agent" in
    claude)
      options=(
        "claude-opus-5-5"
        "claude-3-7-sonnet"
        "claude-3-5-sonnet"
        "claude-3-5-haiku"
      )
      [[ "$role_tier" == "tier1" ]] && rec_model_idx=1
      [[ "$role_tier" == "tier2" ]] && rec_model_idx=2
      [[ "$role_tier" == "tier3" ]] && rec_model_idx=2
      ;;
    codex)
      options=(
        "o3-mini"
        "o1"
        "gpt-4o"
        "gpt-4o-mini"
      )
      [[ "$role_tier" == "tier1" ]] && rec_model_idx=2
      [[ "$role_tier" == "tier2" ]] && rec_model_idx=1
      [[ "$role_tier" == "tier3" ]] && rec_model_idx=3
      ;;
    kimi)
      options=(
        "k1.5"
        "kimi-k3"
      )
      rec_model_idx=1
      ;;
    gemini|antigravity)
      options=(
        "claude-opus-5-5"
        "gemini-4-argon"
        "gemini-3.8-flash"
        "gemini-2.5-pro"
        "gemini-2.5-flash"
      )
      [[ "$role_tier" == "tier1" ]] && rec_model_idx=1
      [[ "$role_tier" == "tier2" ]] && rec_model_idx=2
      [[ "$role_tier" == "tier3" ]] && rec_model_idx=3
      ;;
    cursor)
      options=(
        "claude-3-7-sonnet"
        "claude-3-5-sonnet"
        "gpt-4o"
      )
      rec_model_idx=1
      ;;
    opencode)
      options=(
        "deepseek-r1"
        "deepseek-v3"
        "claude-3-5-sonnet"
      )
      [[ "$role_tier" == "tier3" ]] && rec_model_idx=2 || rec_model_idx=1
      ;;
    *)
      options=()
      ;;
  esac

  echo "👉 [Chọn Model] cho agent '$agent' ($role_title):"
  if (( ${#options[@]} > 0 )); then
    for i in {1..${#options[@]}}; do
      local marker=""
      [[ "$i" == "$rec_model_idx" ]] && marker=" (khuyến nghị cho $role_title)"
      echo "    $i) ${options[$i]}$marker"
    done
    local custom_idx=$(( ${#options[@]} + 1 ))
    local default_idx=$(( ${#options[@]} + 2 ))
    echo "    $custom_idx) Nhập model ID tùy chỉnh"
    echo "    $default_idx) Dùng mặc định của Orca ADE"
    printf "   Nhập số [1-$default_idx] (Enter = $rec_model_idx [${options[$rec_model_idx]}]): "
    read -r m_choice
    m_choice="${m_choice:-$rec_model_idx}"
    
    if [[ "$m_choice" =~ ^[0-9]+$ ]] && (( m_choice >= 1 && m_choice <= ${#options[@]} )); then
      SELECTED_MODEL="${options[$m_choice]}"
    elif [[ "$m_choice" == "$custom_idx" ]]; then
      printf "   Nhập model ID (ví dụ: claude-opus-5-5, gemini-4-argon): "
      read -r custom_model
      SELECTED_MODEL="$custom_model"
    else
      SELECTED_MODEL=""
    fi
  else
    printf "   Nhập model ID (Enter = dùng mặc định của $agent): "
    read -r custom_model
    SELECTED_MODEL="$custom_model"
  fi

  if [[ -n "$SELECTED_MODEL" ]]; then
    echo "   ➔ Đã chọn Model: $SELECTED_MODEL"
    # Hỏi Reasoning Effort cho mọi model suy luận hiện đại
    if [[ "$SELECTED_MODEL" =~ (opus|argon|flash|gemini|o1|o3|r1|sonnet|k1|k3|thinking|reasoning) ]]; then
      printf "   Mức độ suy luận (Reasoning Effort)? [1: low, 2: medium, 3: high, 4: none] (Enter = $default_eff): "
      read -r eff_choice
      eff_choice="${eff_choice:-$default_eff}"
      case "$eff_choice" in
        1|low) SELECTED_EFFORT="low" ;;
        2|med|medium) SELECTED_EFFORT="medium" ;;
        3|high) SELECTED_EFFORT="high" ;;
        4|none|skip) SELECTED_EFFORT="" ;;
        *) SELECTED_EFFORT="$default_eff" ;;
      esac
      [[ -n "$SELECTED_EFFORT" ]] && echo "   ➔ Reasoning Effort: $SELECTED_EFFORT"
    fi
  else
    echo "   ➔ Model: (mặc định Orca ADE)"
  fi
}

fmt_agent_model() {
  local agent="$1"
  local model="$2"
  local effort="$3"
  local out="$agent"
  if [[ -n "$model" ]]; then
    out="$out ($model"
    if [[ -n "$effort" ]]; then
      out="$out, effort: $effort"
    fi
    out="$out)"
  else
    out="$out (model: default)"
  fi
  echo "$out"
}

fmt_md_cell() {
  local agent="$1"
  local model="$2"
  if [[ -n "$model" ]]; then
    echo "\`$agent\` ($model)"
  else
    echo "\`$agent\`"
  fi
}

choose_count() {
  local role_title="$1"
  local default_count="$2"
  printf "   Nhập số lượng agent song song cho $role_title [1-5] (Enter = $default_count): "
  read -r count
  count="${count:-$default_count}"
  if ! [[ "$count" =~ ^[1-5]$ ]]; then
    count=$default_count
  fi
  SELECTED_COUNT="$count"
  echo "   ➔ Số lượng: $SELECTED_COUNT agent(s)"
}

choose_utilities() {
  local default_utils="$1"
  echo "   Tiện ích Orca cấp quyền (1: Worktrees, 2: Browser/Design Mode, 3: SSH, 4: Computer Use, 5: Skills Registry)"
  printf "   Nhập các số cách nhau bằng dấu phẩy (Enter = $default_utils): "
  read -r utils_input
  utils_input="${utils_input:-$default_utils}"
  
  SELECTED_UTILS=()
  for u in ${(s:,:)utils_input}; do
    u=$(echo "$u" | tr -d ' ')
    case "$u" in
      1) SELECTED_UTILS+=("git-worktrees") ;;
      2) SELECTED_UTILS+=("browser-design-mode") ;;
      3) SELECTED_UTILS+=("ssh-remote-execution") ;;
      4) SELECTED_UTILS+=("desktop-computer-use") ;;
      5) SELECTED_UTILS+=("orca-skills-registry") ;;
    esac
  done
  echo "   ➔ Tiện ích: ${(j:, :)SELECTED_UTILS}"
}

utils_to_json() {
  local formatted=()
  for item in "$@"; do
    formatted+=("\"$item\"")
  done
  echo "[${(j:, :)formatted}]"
}

ask_toggle() {
  local feature_name="$1"
  local default_val="$2"
  printf "   Kích hoạt $feature_name? (Y/n, Enter = $default_val): "
  read -r ans
  ans="${ans:-$default_val}"
  if [[ "$ans" == "y" || "$ans" == "Y" ]]; then
    TOGGLE_RESULT=true
  else
    TOGGLE_RESULT=false
  fi
}

echo ""
echo "╔════════════════════════════════════════════════════════════════════════════╗"
echo "║   🐋  ORCA FULL-SPECTRUM MULTI-AGENT ORCHESTRATOR — SETUP WIZARD          ║"
echo "╚════════════════════════════════════════════════════════════════════════════╝"
echo ""
echo "📍 Thư mục dự án: $PROJECT_PATH"

if [[ -f "$TARGET_RULE" ]]; then
  echo ""
  echo "⚠️  Đã tồn tại cấu hình $TARGET_RULE."
  printf "Bạn có muốn cấu hình lại và ghi đè? (y/N): "
  read -r overwrite
  [[ "$overwrite" != "y" && "$overwrite" != "Y" ]] && echo "Đã huỷ." && exit 0
fi

# ── 1. CỐT LÕI: Lead Coordinator ──
echo ""
echo "=================================================================="
echo "PHẦN 1: LEAD COORDINATOR (Nhạc trưởng điều phối)"
echo "Nhiệm vụ: Lập Task DAG, quản lý Run, giao việc và điều phối các worker."
choose_agent "Lead Coordinator" 5
COORD_AGENT="$SELECTED_AGENT"
choose_model "$COORD_AGENT" "Lead Coordinator" "high" "tier1"
COORD_MODEL="$SELECTED_MODEL"
COORD_EFFORT="$SELECTED_EFFORT"

# ── 2. CỐT LÕI: Full-Stack Dev Team ──
echo ""
echo "=================================================================="
echo "PHẦN 2: FULL-STACK DEVELOPERS (Nhóm Lập trình viên)"
echo "Nhiệm vụ: Trực tiếp viết code, unit test trên các child worktree độc lập."
choose_agent "Full-Stack Devs" 5
DEV_AGENT="$SELECTED_AGENT"
choose_model "$DEV_AGENT" "Full-Stack Devs" "high" "tier3"
DEV_MODEL="$SELECTED_MODEL"
DEV_EFFORT="$SELECTED_EFFORT"
choose_count "Developer" 2
DEV_COUNT="$SELECTED_COUNT"
choose_utilities "1,2,5"
DEV_UTILS="${(j:, :)SELECTED_UTILS}"
DEV_UTILS_JSON=$(utils_to_json "${SELECTED_UTILS[@]}")

# ── 3. CỐT LÕI: QA & Test Team ──
echo ""
echo "=================================================================="
echo "PHẦN 3: QA & TEST ENGINEERS (Nhóm Kiểm thử chất lượng)"
echo "Nhiệm vụ: Viết integration tests, kiểm tra edge cases và acceptance criteria."
choose_agent "QA & Testing" 5
QA_AGENT="$SELECTED_AGENT"
choose_model "$QA_AGENT" "QA & Testing" "medium" "tier3"
QA_MODEL="$SELECTED_MODEL"
QA_EFFORT="$SELECTED_EFFORT"
choose_count "QA Tester" 1
QA_COUNT="$SELECTED_COUNT"
choose_utilities "1,2,5"
QA_UTILS="${(j:, :)SELECTED_UTILS}"
QA_UTILS_JSON=$(utils_to_json "${SELECTED_UTILS[@]}")

# ── 4. CỐT LÕI: Bug Hunter & Security ──
echo ""
echo "=================================================================="
echo "PHẦN 4: BUG HUNTER & SECURITY AUDITOR (Nhóm Săn lỗi & Bảo mật)"
echo "Nhiệm vụ: Quét lỗ hổng OWASP, race conditions, memory leaks, rò rỉ secret."
choose_agent "Security & Bug Hunter" 5
SEC_AGENT="$SELECTED_AGENT"
choose_model "$SEC_AGENT" "Security & Bug Hunter" "high" "tier2"
SEC_MODEL="$SELECTED_MODEL"
SEC_EFFORT="$SELECTED_EFFORT"
choose_count "Bug Hunter / Security" 1
SEC_COUNT="$SELECTED_COUNT"
choose_utilities "1,5"
SEC_UTILS="${(j:, :)SELECTED_UTILS}"
SEC_UTILS_JSON=$(utils_to_json "${SELECTED_UTILS[@]}")

# ── 5. GIT LIFECYCLE: PR Reviewer & Issue Resolver ──
echo ""
echo "=================================================================="
echo "PHẦN 5: GIT & GITHUB/GITLAB LIFECYCLE ROLES"
echo "5.1. PR Reviewer (Chuyên gia thẩm định Pull Request & Line-by-line Diff)"
choose_agent "PR Reviewer" 5
PR_AGENT="$SELECTED_AGENT"
choose_model "$PR_AGENT" "PR Reviewer" "high" "tier2"
PR_MODEL="$SELECTED_MODEL"
PR_EFFORT="$SELECTED_EFFORT"

echo ""
echo "5.2. Git Issue Resolver (Chuyên gia xử lý bug được gán / assigned issues)"
choose_agent "Git Issue Resolver" 5
ISSUE_AGENT="$SELECTED_AGENT"
choose_model "$ISSUE_AGENT" "Git Issue Resolver" "high" "tier2"
ISSUE_MODEL="$SELECTED_MODEL"
ISSUE_EFFORT="$SELECTED_EFFORT"

# ── 6. SPECIALIZED EXTENSIONS ──
echo ""
echo "=================================================================="
echo "PHẦN 6: CÁC VAI TRÒ MỞ RỘNG CHUYÊN BIỆT (Tùy chọn bật/tắt)"

# 6.1 UI/UX Specialist
echo ""
echo "6.1. UI/UX Specialist (Khai thác tối đa Design Mode & Embedded Browser)"
ask_toggle "UI/UX Specialist" "y"
ENABLE_UI="$TOGGLE_RESULT"
if [[ "$ENABLE_UI" == true ]]; then
  choose_agent "UI/UX Specialist" 5
  UI_AGENT="$SELECTED_AGENT"
  choose_model "$UI_AGENT" "UI/UX Specialist" "medium" "tier3"
  UI_MODEL="$SELECTED_MODEL"
  UI_EFFORT="$SELECTED_EFFORT"
fi

# 6.2 DevOps Specialist
echo ""
echo "6.2. DevOps / Infra Specialist (DB migration, Docker/Orb, SSH Worktrees)"
ask_toggle "DevOps Specialist" "y"
ENABLE_DEVOPS="$TOGGLE_RESULT"
if [[ "$ENABLE_DEVOPS" == true ]]; then
  choose_agent "DevOps Specialist" 5
  DEVOPS_AGENT="$SELECTED_AGENT"
  choose_model "$DEVOPS_AGENT" "DevOps Specialist" "high" "tier3"
  DEVOPS_MODEL="$SELECTED_MODEL"
  DEVOPS_EFFORT="$SELECTED_EFFORT"
fi

# ── 7. Host Môi trường Thực thi ──
echo ""
echo "=================================================================="
echo "PHẦN 7: MÔI TRƯỜNG THỰC THI CHÍNH (Execution Host)"
echo "  1) local (Chạy trực tiếp trên máy macOS)"
echo "  2) ssh:orb (Chạy remote qua SSH target 'orb')"
printf "Chọn [1-2] (Enter = 1): "
read -r host_choice
host_choice="${host_choice:-1}"
if [[ "$host_choice" == "2" ]]; then
  printf "   Nhập tên SSH host target trong Orca (Enter = ssh:orb): "
  read -r ssh_target_input
  EXEC_HOST="${ssh_target_input:-ssh:orb}"
  HOST_LABEL="SSH Target ($EXEC_HOST)"
else
  EXEC_HOST="local"
  HOST_LABEL="Local Machine"
fi
echo "➔ Môi trường: $HOST_LABEL"

# ── Tổng kết xác nhận ──
echo ""
echo "┌──────────────────────────────────────────────────────────────────────────┐"
echo "│                 TỔNG HỢP CẤU HÌNH ĐỘI NGŨ ORCA TOÀN DIỆN                 │"
echo "├──────────────────────────────────────────────────────────────────────────┤"
echo "│  Coordinator:     $(fmt_agent_model "$COORD_AGENT" "$COORD_MODEL" "$COORD_EFFORT") (1 agent)"
echo "│  Developers:      $(fmt_agent_model "$DEV_AGENT" "$DEV_MODEL" "$DEV_EFFORT") ($DEV_COUNT agents song song) [$DEV_UTILS]"
echo "│  QA Testers:      $(fmt_agent_model "$QA_AGENT" "$QA_MODEL" "$QA_EFFORT") ($QA_COUNT agents song song) [$QA_UTILS]"
echo "│  Security:        $(fmt_agent_model "$SEC_AGENT" "$SEC_MODEL" "$SEC_EFFORT") ($SEC_COUNT agents song song) [$SEC_UTILS]"
echo "│  PR Reviewer:     $(fmt_agent_model "$PR_AGENT" "$PR_MODEL" "$PR_EFFORT")"
echo "│  Issue Resolver:  $(fmt_agent_model "$ISSUE_AGENT" "$ISSUE_MODEL" "$ISSUE_EFFORT")"
if [[ "$ENABLE_UI" == true ]]; then
echo "│  UI/UX Designer:  $(fmt_agent_model "$UI_AGENT" "$UI_MODEL" "$UI_EFFORT")"
fi
if [[ "$ENABLE_DEVOPS" == true ]]; then
echo "│  DevOps / Infra:  $(fmt_agent_model "$DEVOPS_AGENT" "$DEVOPS_MODEL" "$DEVOPS_EFFORT")"
fi
echo "│  Execution Host:  $HOST_LABEL"
echo "└──────────────────────────────────────────────────────────────────────────┘"
echo ""
printf "Xác nhận tạo cấu hình cho project? (Y/n): "
read -r confirm
[[ "$confirm" == "n" || "$confirm" == "N" ]] && echo "Đã huỷ." && exit 0

mkdir -p "$AGENTS_DIR"

# ── Ghi file config JSON ──
cat > "$TARGET_CONFIG" << JSON
{
  "projectPath": "$PROJECT_PATH",
  "executionHost": "$EXEC_HOST",
  "coordinator": {
    "agent": "$COORD_AGENT",
    "model": $([[ -n "$COORD_MODEL" ]] && echo "\"$COORD_MODEL\"" || echo "null"),
    "effort": $([[ -n "$COORD_EFFORT" ]] && echo "\"$COORD_EFFORT\"" || echo "null")
  },
  "roles": {
    "developer": {
      "agent": "$DEV_AGENT",
      "model": $([[ -n "$DEV_MODEL" ]] && echo "\"$DEV_MODEL\"" || echo "null"),
      "effort": $([[ -n "$DEV_EFFORT" ]] && echo "\"$DEV_EFFORT\"" || echo "null"),
      "concurrency": $DEV_COUNT,
      "utilities": $DEV_UTILS_JSON
    },
    "qa": {
      "agent": "$QA_AGENT",
      "model": $([[ -n "$QA_MODEL" ]] && echo "\"$QA_MODEL\"" || echo "null"),
      "effort": $([[ -n "$QA_EFFORT" ]] && echo "\"$QA_EFFORT\"" || echo "null"),
      "concurrency": $QA_COUNT,
      "utilities": $QA_UTILS_JSON
    },
    "security": {
      "agent": "$SEC_AGENT",
      "model": $([[ -n "$SEC_MODEL" ]] && echo "\"$SEC_MODEL\"" || echo "null"),
      "effort": $([[ -n "$SEC_EFFORT" ]] && echo "\"$SEC_EFFORT\"" || echo "null"),
      "concurrency": $SEC_COUNT,
      "utilities": $SEC_UTILS_JSON
    },
    "prReviewer": {
      "agent": "$PR_AGENT",
      "model": $([[ -n "$PR_MODEL" ]] && echo "\"$PR_MODEL\"" || echo "null"),
      "effort": $([[ -n "$PR_EFFORT" ]] && echo "\"$PR_EFFORT\"" || echo "null"),
      "utilities": ["git-worktrees", "diff-viewer", "annotate-ai-diff"]
    },
    "issueResolver": {
      "agent": "$ISSUE_AGENT",
      "model": $([[ -n "$ISSUE_MODEL" ]] && echo "\"$ISSUE_MODEL\"" || echo "null"),
      "effort": $([[ -n "$ISSUE_EFFORT" ]] && echo "\"$ISSUE_EFFORT\"" || echo "null"),
      "utilities": ["git-worktrees", "issue-metadata", "commit-push"]
    },
    "uiSpecialist": {
      "enabled": $ENABLE_UI,
      "agent": "${UI_AGENT:-none}",
      "model": $([[ -n "$UI_MODEL" ]] && echo "\"$UI_MODEL\"" || echo "null"),
      "effort": $([[ -n "$UI_EFFORT" ]] && echo "\"$UI_EFFORT\"" || echo "null"),
      "utilities": ["browser-design-mode", "per-worktree-browser"]
    },
    "devopsSpecialist": {
      "enabled": $ENABLE_DEVOPS,
      "agent": "${DEVOPS_AGENT:-none}",
      "model": $([[ -n "$DEVOPS_MODEL" ]] && echo "\"$DEVOPS_MODEL\"" || echo "null"),
      "effort": $([[ -n "$DEVOPS_EFFORT" ]] && echo "\"$DEVOPS_EFFORT\"" || echo "null"),
      "utilities": ["ssh-remote-execution", "orca-per-workspace-env"]
    }
  }
}
JSON

# Chuẩn bị các dòng bảng tùy chọn (tránh dòng trống làm vỡ bảng Markdown)
EXTRA_TABLE_ROWS=""
[[ "$ENABLE_UI" == true ]] && EXTRA_TABLE_ROWS="${EXTRA_TABLE_ROWS}| **UI/UX Specialist** | $(fmt_md_cell "$UI_AGENT" "$UI_MODEL") | On-demand | Design Mode (Click-to-code), live inspection |"$'\n'
[[ "$ENABLE_DEVOPS" == true ]] && EXTRA_TABLE_ROWS="${EXTRA_TABLE_ROWS}| **DevOps Specialist** | $(fmt_md_cell "$DEVOPS_AGENT" "$DEVOPS_MODEL") | On-demand | DB migrations, Docker/Orb, SSH worktrees |"$'\n'

# ── Ghi file Directive GEMINI.md (Token-Optimized) ──
cat > "$TARGET_RULE" << RULE
# Orca Multi-Agent Orchestration Directive

> **[ROLE SCOPING]** This directive applies strictly to the **Lead Coordinator**. Supervised workers (Dev, QA, Security) running inside child worktrees must ignore orchestration rules and focus entirely on their specific task prompt.

---

## 👥 Configured Agent Topology

| Role | Agent & Model | Concurrency | Capabilities & Orca Utilities |
| :--- | :--- | :--- | :--- |
| **Lead Coordinator** | $(fmt_md_cell "$COORD_AGENT" "$COORD_MODEL") | 1 | Task DAG, Decision Gates, Release |
| **Full-Stack Devs** | $(fmt_md_cell "$DEV_AGENT" "$DEV_MODEL") | $DEV_COUNT parallel | Child worktrees, implementation, unit tests |
| **QA & Testers** | $(fmt_md_cell "$QA_AGENT" "$QA_MODEL") | $QA_COUNT parallel | Integration test suites, acceptance verification |
