#!/usr/bin/env zsh
# orca-project-init: Cấu hình hệ thống Multi-Agent Orchestration toàn diện trên nền tảng Orca ADE
# Bao gồm: Core Roles, Git Lifecycle Roles (PR Review & Issue Resolver), và Specialized Extensions.
# Dùng: orca-project-init [/path/to/project]

set -e

if [[ "$1" == "--uninstall" || "$1" == "uninstall" || "$1" == "--clean" ]]; then
  TARGET_DIR="${2:-.}"
  TARGET_PATH=$(cd "$TARGET_DIR" 2>/dev/null && pwd || echo "$TARGET_DIR")
  echo "🐋 [Orca Orchestrator Uninstaller] Đang gỡ bỏ cấu hình khỏi: $TARGET_PATH..."
  
  if [[ -f "$TARGET_PATH/orca-team.json" ]]; then
    rm -f "$TARGET_PATH/orca-team.json"
    echo "  🗑️  Đã xóa: orca-team.json"
  fi
  if [[ -L "$TARGET_PATH/CLAUDE.md" ]]; then
    rm -f "$TARGET_PATH/CLAUDE.md"
    echo "  🗑️  Đã xóa symlink: CLAUDE.md"
  fi
  if [[ -L "$TARGET_PATH/AGENTS.md" ]]; then
    rm -f "$TARGET_PATH/AGENTS.md"
    echo "  🗑️  Đã xóa symlink: AGENTS.md"
  fi
  if [[ -f "$TARGET_PATH/.agents/GEMINI.md" ]]; then
    if grep -q "Orca Multi-Agent" "$TARGET_PATH/.agents/GEMINI.md" 2>/dev/null; then
      rm -f "$TARGET_PATH/.agents/GEMINI.md"
      echo "  🗑️  Đã xóa: .agents/GEMINI.md"
      rmdir "$TARGET_PATH/.agents" 2>/dev/null || true
    fi
  fi
  echo "🎉 Dự án đã được khôi phục về trạng thái ban đầu sạch sẽ!"
  exit 0
fi

PROJECT_DIR="${1:-.}"
PROJECT_PATH=$(cd "$PROJECT_DIR" 2>/dev/null && pwd || echo "$PROJECT_DIR")
AGENTS_DIR="$PROJECT_PATH/.agents"
TARGET_RULE="$AGENTS_DIR/GEMINI.md"
TARGET_CONFIG="$PROJECT_PATH/orca-team.json"

AVAILABLE_AGENTS=(
  "kimi"
  "claude"
  "codex"
  "cursor"
  "antigravity"
  "opencode"
  "aider"
  "goose"
  "copilot"
)

print_agents() {
  local default_idx="$1"
  for i in {1..${#AVAILABLE_AGENTS[@]}}; do
    local marker=""
    [[ "$i" == "$default_idx" ]] && marker=" (khuyến nghị)"
    echo "    $i) ${AVAILABLE_AGENTS[$i]}$marker"
  done
}

choose_agent() {
  local role_title="$1"
  local default_idx="$2"
  echo ""
  echo "👉 [Chọn Agent] cho: $role_title"
  print_agents "$default_idx"
  printf "   Nhập số [1-${#AVAILABLE_AGENTS[@]}] (Enter = $default_idx [${AVAILABLE_AGENTS[$default_idx]}]): "
  read -r choice
  choice="${choice:-$default_idx}"
  if (( choice < 1 || choice > ${#AVAILABLE_AGENTS[@]} )); then
    choice=$default_idx
  fi
  SELECTED_AGENT="${AVAILABLE_AGENTS[$choice]}"
  echo "   ➔ Đã chọn: $SELECTED_AGENT"
}

choose_count() {
  local role_title="$1"
  local default_count="$2"
  printf "   Nhập số lượng agent song song cho $role_title [1-5] (Enter = $default_count): "
  read -r count
  count="${count:-$default_count}"
  if ! [[ "$count" =~ ^[1-9][0-9]*$ ]]; then
    count=$default_count
  fi
  SELECTED_COUNT="$count"
  echo "   ➔ Số lượng: $SELECTED_COUNT agent(s)"
}

choose_utilities() {
  local default_utils="$1"
  echo "   Tiện ích Orca cấp quyền (1: Worktrees, 2: Browser/Design Mode, 3: SSH, 4: Computer Use, 5: Skills Registry)"
  printf "   Nhập các số cách nhau bằng dấu phẩy (Enter = $default_utils): "
  read -r utils_input
  utils_input="${utils_input:-$default_utils}"
  
  SELECTED_UTILS=()
  for u in ${(s:,:)utils_input}; do
    u=$(echo "$u" | tr -d ' ')
    case "$u" in
      1) SELECTED_UTILS+=("git-worktrees") ;;
      2) SELECTED_UTILS+=("browser-design-mode") ;;
      3) SELECTED_UTILS+=("ssh-remote-execution") ;;
      4) SELECTED_UTILS+=("desktop-computer-use") ;;
      5) SELECTED_UTILS+=("orca-skills-registry") ;;
    esac
  done
  echo "   ➔ Tiện ích: ${(j:, :)SELECTED_UTILS}"
}

utils_to_json() {
  local formatted=()
  for item in "$@"; do
    formatted+=("\"$item\"")
  done
  echo "[${(j:, :)formatted}]"
}

ask_toggle() {
  local feature_name="$1"
  local default_val="$2"
  printf "   Kích hoạt $feature_name? (Y/n, Enter = $default_val): "
  read -r ans
  ans="${ans:-$default_val}"
  if [[ "$ans" == "y" || "$ans" == "Y" ]]; then
    TOGGLE_RESULT=true
  else
    TOGGLE_RESULT=false
  fi
}

echo ""
echo "╔════════════════════════════════════════════════════════════════════════════╗"
echo "║   🐋  ORCA FULL-SPECTRUM MULTI-AGENT ORCHESTRATOR — SETUP WIZARD          ║"
echo "╚════════════════════════════════════════════════════════════════════════════╝"
echo ""
echo "📍 Thư mục dự án: $PROJECT_PATH"

if [[ -f "$TARGET_RULE" ]]; then
  echo ""
  echo "⚠️  Đã tồn tại cấu hình $TARGET_RULE."
  printf "Bạn có muốn cấu hình lại và ghi đè? (y/N): "
  read -r overwrite
  [[ "$overwrite" != "y" && "$overwrite" != "Y" ]] && echo "Đã huỷ." && exit 0
fi

# ── 1. CỐT LÕI: Lead Coordinator ──
echo ""
echo "=================================================================="
echo "PHẦN 1: LEAD COORDINATOR (Nhạc trưởng điều phối)"
echo "Nhiệm vụ: Lập Task DAG, quản lý Run, giao việc và điều phối các worker."
choose_agent "Lead Coordinator" 2
COORD_AGENT="$SELECTED_AGENT"

# ── 2. CỐT LÕI: Full-Stack Dev Team ──
echo ""
echo "=================================================================="
echo "PHẦN 2: FULL-STACK DEVELOPERS (Nhóm Lập trình viên)"
echo "Nhiệm vụ: Trực tiếp viết code, unit test trên các child worktree độc lập."
choose_agent "Full-Stack Devs" 1
DEV_AGENT="$SELECTED_AGENT"
choose_count "Developer" 2
DEV_COUNT="$SELECTED_COUNT"
choose_utilities "1,2,5"
DEV_UTILS="${(j:, :)SELECTED_UTILS}"
DEV_UTILS_JSON=$(utils_to_json "${SELECTED_UTILS[@]}")

# ── 3. CỐT LÕI: QA & Test Team ──
echo ""
echo "=================================================================="
echo "PHẦN 3: QA & TEST ENGINEERS (Nhóm Kiểm thử chất lượng)"
echo "Nhiệm vụ: Viết integration tests, kiểm tra edge cases và acceptance criteria."
choose_agent "QA & Testing" 1
QA_AGENT="$SELECTED_AGENT"
choose_count "QA Tester" 1
QA_COUNT="$SELECTED_COUNT"
choose_utilities "1,2,5"
QA_UTILS="${(j:, :)SELECTED_UTILS}"
QA_UTILS_JSON=$(utils_to_json "${SELECTED_UTILS[@]}")

# ── 4. CỐT LÕI: Bug Hunter & Security ──
echo ""
echo "=================================================================="
echo "PHẦN 4: BUG HUNTER & SECURITY AUDITOR (Nhóm Săn lỗi & Bảo mật)"
echo "Nhiệm vụ: Quét lỗ hổng OWASP, race conditions, memory leaks, rò rỉ secret."
choose_agent "Security & Bug Hunter" 3
SEC_AGENT="$SELECTED_AGENT"
choose_count "Bug Hunter / Security" 1
SEC_COUNT="$SELECTED_COUNT"
choose_utilities "1,5"
SEC_UTILS="${(j:, :)SELECTED_UTILS}"
SEC_UTILS_JSON=$(utils_to_json "${SELECTED_UTILS[@]}")

# ── 5. GIT LIFECYCLE: PR Reviewer & Issue Resolver ──
echo ""
echo "=================================================================="
echo "PHẦN 5: GIT & GITHUB/GITLAB LIFECYCLE ROLES"
echo "5.1. PR Reviewer (Chuyên gia thẩm định Pull Request & Line-by-line Diff)"
choose_agent "PR Reviewer" 2
PR_AGENT="$SELECTED_AGENT"

echo ""
echo "5.2. Git Issue Resolver (Chuyên gia xử lý bug được gán / assigned issues)"
choose_agent "Git Issue Resolver" 1
ISSUE_AGENT="$SELECTED_AGENT"

# ── 6. SPECIALIZED EXTENSIONS ──
echo ""
echo "=================================================================="
echo "PHẦN 6: CÁC VAI TRÒ MỞ RỘNG CHUYÊN BIỆT (Tùy chọn bật/tắt)"

# 6.1 UI/UX Specialist
echo ""
echo "6.1. UI/UX Specialist (Khai thác tối đa Design Mode & Embedded Browser)"
ask_toggle "UI/UX Specialist" "y"
ENABLE_UI="$TOGGLE_RESULT"
if [[ "$ENABLE_UI" == true ]]; then
  choose_agent "UI/UX Specialist" 2
  UI_AGENT="$SELECTED_AGENT"
fi

# 6.2 DevOps Specialist
echo ""
echo "6.2. DevOps / Infra Specialist (DB migration, Docker/Orb, SSH Worktrees)"
ask_toggle "DevOps Specialist" "y"
ENABLE_DEVOPS="$TOGGLE_RESULT"
if [[ "$ENABLE_DEVOPS" == true ]]; then
  choose_agent "DevOps Specialist" 3
  DEVOPS_AGENT="$SELECTED_AGENT"
fi

# ── 7. Host Môi trường Thực thi ──
echo ""
echo "=================================================================="
echo "PHẦN 7: MÔI TRƯỜNG THỰC THI CHÍNH (Execution Host)"
echo "  1) local (Chạy trực tiếp trên máy macOS)"
echo "  2) ssh:orb (Chạy remote qua SSH target 'orb')"
printf "Chọn [1-2] (Enter = 1): "
read -r host_choice
host_choice="${host_choice:-1}"
if [[ "$host_choice" == "2" ]]; then
  EXEC_HOST="ssh:ssh-1791972097322-ckux63"
  HOST_LABEL="SSH Target (orb)"
else
  EXEC_HOST="local"
  HOST_LABEL="Local Machine"
fi
echo "➔ Môi trường: $HOST_LABEL"

# ── Tổng kết xác nhận ──
echo ""
echo "┌──────────────────────────────────────────────────────────────────────────┐"
echo "│                 TỔNG HỢP CẤU HÌNH ĐỘI NGŨ ORCA TOÀN DIỆN                 │"
echo "├──────────────────────────────────────────────────────────────────────────┤"
echo "│  Coordinator:     $COORD_AGENT (1 agent)"
echo "│  Developers:      $DEV_AGENT ($DEV_COUNT agents song song) [$DEV_UTILS]"
echo "│  QA Testers:      $QA_AGENT ($QA_COUNT agents song song) [$QA_UTILS]"
echo "│  Security:        $SEC_AGENT ($SEC_COUNT agents song song) [$SEC_UTILS]"
echo "│  PR Reviewer:     $PR_AGENT (Checkout PR, line-by-line diff, CI checks)"
echo "│  Issue Resolver:  $ISSUE_AGENT (Checkout issue, auto-fix, commit & push)"
if [[ "$ENABLE_UI" == true ]]; then
echo "│  UI/UX Designer:  $UI_AGENT (Design Mode, DOM/CSS inspection)"
fi
if [[ "$ENABLE_DEVOPS" == true ]]; then
echo "│  DevOps / Infra:  $DEVOPS_AGENT (Migrations, Docker/Orb, SSH Worktrees)"
fi
echo "│  Execution Host:  $HOST_LABEL"
echo "└──────────────────────────────────────────────────────────────────────────┘"
echo ""
printf "Xác nhận tạo cấu hình cho project? (Y/n): "
read -r confirm
[[ "$confirm" == "n" || "$confirm" == "N" ]] && echo "Đã huỷ." && exit 0

mkdir -p "$AGENTS_DIR"

# ── Ghi file config JSON ──
cat > "$TARGET_CONFIG" << JSON
{
  "projectPath": "$PROJECT_PATH",
  "executionHost": "$EXEC_HOST",
  "coordinator": {
    "agent": "$COORD_AGENT"
  },
  "roles": {
    "developer": {
      "agent": "$DEV_AGENT",
      "concurrency": $DEV_COUNT,
      "utilities": $DEV_UTILS_JSON
    },
    "qa": {
      "agent": "$QA_AGENT",
      "concurrency": $QA_COUNT,
      "utilities": $QA_UTILS_JSON
    },
    "security": {
      "agent": "$SEC_AGENT",
      "concurrency": $SEC_COUNT,
      "utilities": $SEC_UTILS_JSON
    },
    "prReviewer": {
      "agent": "$PR_AGENT",
      "utilities": ["git-worktrees", "diff-viewer", "annotate-ai-diff"]
    },
    "issueResolver": {
      "agent": "$ISSUE_AGENT",
      "utilities": ["git-worktrees", "issue-metadata", "commit-push"]
    },
    "uiSpecialist": {
      "enabled": $ENABLE_UI,
      "agent": "${UI_AGENT:-none}",
      "utilities": ["browser-design-mode", "per-worktree-browser"]
    },
    "devopsSpecialist": {
      "enabled": $ENABLE_DEVOPS,
      "agent": "${DEVOPS_AGENT:-none}",
      "utilities": ["ssh-remote-execution", "orca-per-workspace-env"]
    }
  }
}
JSON

# ── Ghi file Directive GEMINI.md (Token-Optimized) ──
cat > "$TARGET_RULE" << RULE
# Orca Multi-Agent Orchestration Directive

> **[ROLE SCOPING]** This directive applies strictly to the **Lead Coordinator**. Supervised workers (Dev, QA, Security) running inside child worktrees must ignore orchestration rules and focus entirely on their specific task prompt.

---

## 👥 Configured Agent Topology

| Role | Agent & Model | Concurrency | Capabilities & Orca Utilities |
| :--- | :--- | :--- | :--- |
| **Lead Coordinator** | \`$COORD_AGENT\` | 1 | Task DAG, Decision Gates, Release |
| **Full-Stack Devs** | \`$DEV_AGENT\` | $DEV_COUNT parallel | Child worktrees, implementation, unit tests |
| **QA & Testers** | \`$QA_AGENT\` | $QA_COUNT parallel | Integration test suites, acceptance verification |
| **Security & Bug Hunter** | \`$SEC_AGENT\` | $SEC_COUNT parallel | OWASP audit, security scan, diff review |
| **PR Reviewer** | \`$PR_AGENT\` | On-demand | PR checkout (\`--pr\`), diff audit (\`open-changed\`) |
| **Issue Resolver** | \`$ISSUE_AGENT\` | On-demand | Issue checkout (\`--issue\`), auto-fix, commit & push |
$([[ "$ENABLE_UI" == true ]] && echo "| **UI/UX Specialist** | \`$UI_AGENT\` | On-demand | Design Mode (Click-to-code), live inspection |")
$([[ "$ENABLE_DEVOPS" == true ]] && echo "| **DevOps Specialist** | \`$DEVOPS_AGENT\` | On-demand | DB migrations, Docker/Orb, SSH worktrees |")

- **Execution Host:** \`$EXEC_HOST\` ($HOST_LABEL) | **Orca CLI:** \`/usr/local/bin/orca\`

---

## ⚡ Core Operational Runbook (Anti-Token-Waste Rules)

### 1. Phase 0 Planning Gate
Analyze requirements and produce a concise \`plan.md\` (see \`templates/plan-template.md\`). Wait for user approval before dispatching workers.

### 2. STRICT ANTI-POLLING RULE (CRITICAL)
- **NEVER poll in loops** with \`orca orchestration check\` or \`worker-show\`.
- After dispatching workers, **STOP CALLING TOOLS**. Wait reactively for worker completion notifications or explicit user input. Repeated polling burns thousands of tokens per minute.

### 3. Worker Launch & Token Frugality
Use \`orca-dispatch\` to launch workers (auto-injects 5m timeout, auto-resolves configured dev agent, and suppresses 200+ lines of raw JSON stdout):
\`\`\`bash
orca-dispatch "feature-name" [agent] "Spec description (reference file paths, do NOT dump full file contents)"
\`\`\`

### 4. Concurrent Dual-Track (Hotfix P0)
If a GitHub issue is assigned during feature development, fork an isolated worktree in 1 line:
\`\`\`bash
orca-hotfix <issue-id> [agent]
\`\`\`

### 5. Issue Reassignment & Handoff
If an issue is reassigned: stop worker (\`worker-stop\`), commit WIP branch \`wip/issue-<id>-handover\`, post comment on issue, and release worktree.

### 6. Watchdog & Rate-Limit Failover
- **Worker waiting on prompt (\`[y/n]\`):** Auto-unblock via: \`orca-team watchdog --unblock\`.
- **Session context overflow:** Spawn fresh worker on same worktree: \`worker-start --task <taskId> --retry-of <id> --worktree current\`.
- **Account Rate Limit (429):** Do not respawn same provider! Switch provider via \`orca-team set dev --agent <fallback_agent>\` (e.g. Claude ➔ Kimi, Kimi ➔ Codex).
- **All providers exhausted:** Halt all workers cleanly and report to user (Human Gate).

### 7. Quality Gate & Release
- Verify workers sent \`send --type worker_done --outcome succeeded\`.
- Release settled workers: \`orca orchestration worker-release --dispatch <id> --json\`.
- For extended workflows and diagrams, refer to \`docs/workflows.md\` and \`docs/roles.md\`.
RULE

# ── Quản lý symlink thông minh: Tránh nạp trùng lặp context ──
case "$COORD_AGENT" in
  "claude")
    ln -sf .agents/GEMINI.md "$PROJECT_PATH/CLAUDE.md"
    rm -f "$PROJECT_PATH/AGENTS.md"
    LINK_MSG="CLAUDE.md -> .agents/GEMINI.md"
    ;;
  "codex"|"cursor"|"opencode")
    ln -sf .agents/GEMINI.md "$PROJECT_PATH/AGENTS.md"
    rm -f "$PROJECT_PATH/CLAUDE.md"
    LINK_MSG="AGENTS.md -> .agents/GEMINI.md"
    ;;
  *)
    # Với Antigravity / Gemini: Natively đọc .agents/GEMINI.md, xóa bỏ symlink root để tránh ăn 2 lần token
    rm -f "$PROJECT_PATH/CLAUDE.md" "$PROJECT_PATH/AGENTS.md"
    LINK_MSG="Native (.agents/GEMINI.md, không trùng lặp)"
    ;;
# ── Đảm bảo .gitignore bỏ qua runtime của Orca (Chống tràn token) ──
GITIGNORE_FILE="$PROJECT_PATH/.gitignore"
if [[ -f "$GITIGNORE_FILE" ]]; then
  if ! grep -q "^\.orca/" "$GITIGNORE_FILE" 2>/dev/null; then
    printf "\n# Orca ADE runtime & worktrees (chống tràn token khi git status/diff)\n.orca/\n.orca-cache/\n*.orca.log\n" >> "$GITIGNORE_FILE"
    echo "   🛡️  Đã thêm .orca/ vào .gitignore (chống tràn context)."
  fi
else
  printf "# Orca ADE runtime & worktrees (chống tràn token khi git status/diff)\n.orca/\n.orca-cache/\n*.orca.log\n" > "$GITIGNORE_FILE"
  echo "   🛡️  Đã tạo .gitignore và thêm .orca/ (chống tràn context)."
fi

echo ""
echo "🎉 [HOÀN TẤT] Đã tạo xong hệ thống Full-Spectrum Orchestrator (Token-Optimized)!"
echo "   1. Directive Rule:   $TARGET_RULE (~60 dòng tinh gọn, chống lãng phí token)"
echo "   2. Team Config:      $TARGET_CONFIG"
echo "   3. Leader Discovery: $LINK_MSG"
echo ""
echo "👉 Mở Antigravity, Claude Code (claude), Codex, hoặc Orca tại '$PROJECT_PATH' để bắt đầu làm việc."
