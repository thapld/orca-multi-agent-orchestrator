  ROUTING_LINE="${ROUTING_LINE} | Giao diện CSS/DOM ➔ **\`ui-worker\`**"
  EXTRA_TABLE_ROWS="${EXTRA_TABLE_ROWS}| **UI/UX Specialist** | $(fmt_md_cell "$UI_AGENT" "$UI_MODEL") | Auto-scale${GOAL_BADGE} | Design Mode (Click-to-code), responsive & a11y |"$'\n'
fi

if [[ "$ENABLE_CRITIC" == true ]]; then
  ROUTING_LINE="${ROUTING_LINE} | Quân sư Kiến trúc, phản biện System Engineering, duyệt Kế hoạch & truy tìm root-cause ➔ **\`critic-worker\`**"
  EXTRA_TABLE_ROWS="${EXTRA_TABLE_ROWS}| **Research & Critic** | $(fmt_md_cell "$CRITIC_AGENT" "$CRITIC_MODEL") | Auto-scale${GOAL_BADGE} | Quân sư System Engineering, Plan Critique, root-cause consensus |"$'\n'
  EXTRA_STEP1_PRE_SEC="${EXTRA_STEP1_PRE_SEC}  # [PHA 1.A — QUÂN SƯ CRITIC] Giao critic-worker thẩm định & hiệu chỉnh Kế hoạch theo System Engineering (BẮT BUỘC trước khi khóa Plan giao cho toàn team):
  orca orchestration task-create --spec \"\$(orca-team spec critic 'Triệu chứng/Bối cảnh & bằng chứng thô: [...] | Bản nháp Kế hoạch [P1..Pn] của Leader: [...]')\""$'\n'
  EXTRA_STEP2_PRE_SEC="${EXTRA_STEP2_PRE_SEC}  # [PHA 1.A — QUÂN SƯ CRITIC] Khởi chạy critic-worker để thảo luận 2 chiều & thống nhất Master Plan trước:
  orca orchestration worker-start --task <CRITIC_TASK_ID> \$(orca-team worktree-arg critic --task <CRITIC_TASK_ID>) $(fmt_worker_args "$CRITIC_AGENT" "$CRITIC_MODEL" "$CRITIC_EFFORT") --json"$'\n'
fi

if [[ "$ENABLE_BENCH" == true ]]; then
  EXTRA_STEP1_POST_QA="${EXTRA_STEP1_POST_QA}  # Principal Benchmark & Perf (BẮT BUỘC khi đo tải RPS/EPS, tối ưu hiệu năng, latency p95/p99, batch/queue/DB tuning):
  orca orchestration task-create --spec \"\$(orca-team spec bench '[Đo tải, benchmark & profiling]')\""$'\n'
  EXTRA_STEP2_POST_QA="${EXTRA_STEP2_POST_QA}  # Benchmark Worker (khi có Task Benchmark / Stress Test / Tối ưu hiệu năng):
  orca orchestration worker-start --task <BENCH_TASK_ID> \$(orca-team worktree-arg bench --task <BENCH_TASK_ID>) $(fmt_worker_args "$BENCH_AGENT" "$BENCH_MODEL" "$BENCH_EFFORT") --json"$'\n'
