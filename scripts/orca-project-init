#!/usr/bin/env zsh
# orca-project-init: Cấu hình hệ thống Multi-Agent Orchestration toàn diện trên nền tảng Orca ADE
# Bao gồm: Core Roles, Git Lifecycle Roles (PR Review & Issue Resolver), và Specialized Extensions.
# Dùng: orca-project-init [/path/to/project]

set -e

SCRIPT_DIR="${0:A:h}"
ORCA_TEAM_BIN="$SCRIPT_DIR/orca-team"
if [[ ! -x "$ORCA_TEAM_BIN" ]] && command -v orca-team >/dev/null 2>&1; then
  ORCA_TEAM_BIN="$(command -v orca-team)"
fi
if [[ ! -x "$ORCA_TEAM_BIN" ]] && command -v curl >/dev/null 2>&1; then
  TMP_ORCA_TEAM="/tmp/orca-team-$$"
  if curl -fsSL "https://raw.githubusercontent.com/thapld/orca-multi-agent-orchestrator/main/scripts/orca-team" -o "$TMP_ORCA_TEAM" 2>/dev/null; then
    chmod +x "$TMP_ORCA_TEAM"
    ORCA_TEAM_BIN="$TMP_ORCA_TEAM"
    trap 'rm -f "$TMP_ORCA_TEAM"' EXIT
  fi
fi

ACTION_UNINSTALL=false
AUTO_YES=false
SHOW_HELP=false
PROJECT_DIR=""

for arg in "$@"; do
  case "$arg" in
    -h|--help|help)
      SHOW_HELP=true
      ;;
    -y|--yes|--force|-f)
      AUTO_YES=true
      ;;
    -u|--uninstall|uninstall|--clean)
      ACTION_UNINSTALL=true
      ;;
    -*)
      echo "⚠️  Cảnh báo: Tùy chọn không nhận diện: $arg" >&2
      ;;
    *)
      if [[ -z "$PROJECT_DIR" ]]; then
        PROJECT_DIR="$arg"
      fi
      ;;
  esac
done

PROJECT_DIR="${PROJECT_DIR:-.}"

if [[ "$SHOW_HELP" == true ]]; then
  echo "🐋 [Orca Project Init] Khởi tạo hệ thống Multi-Agent Orchestration cho dự án"
  echo "Sử dụng:"
  echo "  orca-project-init [options] [/path/to/project]"
  echo ""
  echo "Tùy chọn:"
  echo "  -y, --yes         Khởi tạo tự động với cấu hình khuyến nghị (không hỏi tương tác)"
  echo "  -u, --uninstall   Gỡ bỏ cấu hình Orchestrator khỏi dự án"
  echo "  -h, --help        Hiển thị hướng dẫn sử dụng"
  exit 0
fi

if [[ "$ACTION_UNINSTALL" == true ]]; then
  TARGET_DIR="$PROJECT_DIR"
  TARGET_PATH=$(cd "$TARGET_DIR" 2>/dev/null && pwd || echo "$TARGET_DIR")

  if [[ -x "$ORCA_TEAM_BIN" ]]; then
    exec python3 "$ORCA_TEAM_BIN" uninstall "$TARGET_PATH" -y
  fi

  # Bảo vệ: Không bao giờ tự gỡ bỏ chính kho mã nguồn của framework
  if [[ -d "$TARGET_PATH/templates" && -f "$TARGET_PATH/package.json" ]]; then
    if grep -q '"name": *"orca-multi-agent-orchestrator"' "$TARGET_PATH/package.json" 2>/dev/null; then
      echo "🚫 Đây là thư mục gốc của bộ công cụ 'orca-multi-agent-orchestrator'."
      echo "   Không thể tự gỡ bỏ chính kho mã nguồn framework!"
      echo "   Để gỡ bỏ các CLI khỏi máy: hãy chạy './uninstall.sh'."
      exit 1
    fi
  fi

  echo "🐋 [Orca Orchestrator Uninstaller] Đang gỡ bỏ cấu hình khỏi: $TARGET_PATH..."
  rm -f "$TARGET_PATH/orca-team.json"
  for link_name in GEMINI.md CLAUDE.md AGENTS.md; do
    if [[ -L "$TARGET_PATH/$link_name" && "$(readlink "$TARGET_PATH/$link_name" 2>/dev/null)" == *".agents/GEMINI.md" ]]; then
      rm -f "$TARGET_PATH/$link_name"
      echo "  🗑️  Đã xóa symlink: $link_name"
    fi
  done
  rm -f "$TARGET_PATH/.agents/GEMINI.md"
  rmdir "$TARGET_PATH/.agents" 2>/dev/null || true
  echo "🎉 Dự án đã được khôi phục về trạng thái ban đầu sạch sẽ!"
  exit 0
fi

PROJECT_PATH=$(cd "$PROJECT_DIR" 2>/dev/null && pwd || echo "$PROJECT_DIR")
AGENTS_DIR="$PROJECT_PATH/.agents"
TARGET_RULE="$AGENTS_DIR/GEMINI.md"
TARGET_CONFIG="$PROJECT_PATH/orca-team.json"

AVAILABLE_AGENTS=(
  "kimi"
  "claude"
  "codex"
  "cursor"
  "antigravity"
  "opencode"
  "aider"
  "goose"
  "copilot"
  "gemini"
  "muse"
  "codebuddy"
  "omp"
)

choose_agent() {
  local role_title="$1"
  local default_idx="${2:-5}"
  if [[ "$AUTO_YES" == true ]]; then
    SELECTED_AGENT="${AVAILABLE_AGENTS[$default_idx]}"
    echo "   ➔ Đã chọn tự động ($role_title): $SELECTED_AGENT"
    return
  fi
  local menu_items=()
  for i in {1..${#AVAILABLE_AGENTS[@]}}; do
    local ag="${AVAILABLE_AGENTS[$i]}"
    local marker=""
    [[ "$i" == "$default_idx" ]] && marker=" ⭐ (khuyến nghị)"
    menu_items+=("$ag$marker")
  done

  if [[ -x "$ORCA_TEAM_BIN" ]]; then
    local chosen_idx
    chosen_idx=$(python3 "$ORCA_TEAM_BIN" select \
      --title "👉 [Chọn Agent] cho: $role_title" \
      --options "${menu_items[@]}" \
      --default-idx "$((default_idx - 1))" \
      --return-idx)
    if [[ "$chosen_idx" =~ ^[0-9]+$ ]] && (( chosen_idx >= 1 && chosen_idx <= ${#AVAILABLE_AGENTS[@]} )); then
      SELECTED_AGENT="${AVAILABLE_AGENTS[$chosen_idx]}"
    else
      SELECTED_AGENT="${AVAILABLE_AGENTS[$default_idx]}"
    fi
  else
    echo "👉 [Chọn Agent] cho: $role_title"
    for i in {1..${#AVAILABLE_AGENTS[@]}}; do
      echo "    $i) ${AVAILABLE_AGENTS[$i]}"
    done
    printf "   Nhập số [1-${#AVAILABLE_AGENTS[@]}] (Enter = $default_idx [${AVAILABLE_AGENTS[$default_idx]}]): "
    read -r choice
    choice="${choice:-$default_idx}"
    SELECTED_AGENT="${AVAILABLE_AGENTS[$choice]}"
  fi
}

choose_model() {
  local agent="$1"
  local role_title="$2"
  local default_eff="${3:-high}"
  local role_tier="${4:-tier2}"
  
  SELECTED_MODEL=""
  SELECTED_EFFORT=""
  
  local model_ids=()
  local model_labels=()
  local model_baked_efforts=()
  local model_efforts_csv=()
  local rec_model_idx=1
  local source_label="provider-cli"
  local chosen_baked_effort=""
  local chosen_efforts_csv=""

  if [[ -x "$ORCA_TEAM_BIN" ]]; then
    local tsv_out
    tsv_out=$(python3 "$ORCA_TEAM_BIN" models "$agent" --tsv --tier "$role_tier" --effort "$default_eff" 2>/dev/null || true)
    if [[ -n "$tsv_out" ]]; then
      while IFS=$'\t' read -r rec_type col1 col2 col3 col4; do
        if [[ "$rec_type" == "META" ]]; then
          source_label="${col1:-provider-cli}"
          [[ "$col2" =~ ^[0-9]+$ ]] && rec_model_idx="$col2"
        elif [[ "$rec_type" == "MODEL" && -n "$col1" ]]; then
          model_ids+=("$col1")
          model_labels+=("${col2:-$col1}")
          model_baked_efforts+=("${col3:-}")
          model_efforts_csv+=("${col4:-}")
        fi
      done <<< "$tsv_out"
    fi
  fi

  if (( ${#model_ids[@]} > 0 )); then
    local chosen_idx="$rec_model_idx"
    if [[ "$AUTO_YES" != true ]]; then
      local menu_items=()
      for i in {1..${#model_ids[@]}}; do
        local marker=""
        [[ "$i" == "$rec_model_idx" ]] && marker=" ⭐ (khuyến nghị cho $role_title)"
        local m_id="${model_ids[$i]}"
        local m_lbl="${model_labels[$i]}"
        if [[ "$m_lbl" != "$m_id" && -n "$m_lbl" ]]; then
          menu_items+=("$m_id — $m_lbl$marker")
        else
          menu_items+=("$m_id$marker")
        fi
      done
      local custom_idx=$(( ${#model_ids[@]} + 1 ))
      local default_idx=$(( ${#model_ids[@]} + 2 ))
      menu_items+=("Nhập model ID tùy chỉnh...")
      menu_items+=("Dùng mặc định của Orca ADE")

      if [[ -x "$ORCA_TEAM_BIN" ]]; then
        chosen_idx=$(python3 "$ORCA_TEAM_BIN" select \
          --title "👉 [Chọn Model] cho agent '$agent' ($role_title) — Nguồn: $source_label" \
          --options "${menu_items[@]}" \
          --default-idx "$((rec_model_idx - 1))" \
          --return-idx)
      else
        for i in {1..${#menu_items[@]}}; do
          echo "   $i) ${menu_items[$i]}"
        done
        printf "   Nhập số (Enter = $rec_model_idx): "
        read -r chosen_idx
        chosen_idx="${chosen_idx:-$rec_model_idx}"
      fi
    fi

    if [[ "$chosen_idx" =~ ^[0-9]+$ ]] && (( chosen_idx >= 1 && chosen_idx <= ${#model_ids[@]} )); then
      SELECTED_MODEL="${model_ids[$chosen_idx]}"
      chosen_baked_effort="${model_baked_efforts[$chosen_idx]}"
      chosen_efforts_csv="${model_efforts_csv[$chosen_idx]}"
    elif [[ -n "$custom_idx" && "$chosen_idx" == "$custom_idx" ]]; then
      printf "   Nhập model ID tùy chỉnh: "
      read -r custom_model
      SELECTED_MODEL="$custom_model"
    else
      SELECTED_MODEL=""
    fi
  elif [[ "$AUTO_YES" != true ]]; then
    printf "   ⚠️ Không tìm thấy danh sách model động từ CLI của '$agent'. Nhập model ID (Enter = mặc định): "
    read -r custom_model
    SELECTED_MODEL="$custom_model"
  fi

  if [[ -n "$SELECTED_MODEL" ]]; then
    # Kiểm tra nếu model ID đã tích hợp sẵn hậu tố effort (-low, -medium, -high, -xhigh, -max)
    if [[ -z "$chosen_baked_effort" && "$SELECTED_MODEL" =~ -(low|medium|high|xhigh|max)$ ]]; then
      chosen_baked_effort="${match[1]:l}"
    fi

    # Kiểm tra xem agent/model có hỗ trợ --effort khi chạy Orca worker-start không
    local effort_supported=true
    if ! [[ "${agent:l}" =~ ^(antigravity|claude|codex|cursor|muse|codebuddy)$ ]]; then
      effort_supported=false
    elif [[ "${agent:l}" == "claude" && "${SELECTED_MODEL:l}" == *haiku* ]]; then
      effort_supported=false
    elif [[ "${agent:l}" == "cursor" && "$SELECTED_MODEL" != "gpt-5.3-codex" && "$SELECTED_MODEL" != "claude-opus-4-8" ]]; then
      effort_supported=false
    fi

    if [[ "$effort_supported" == false ]]; then
      SELECTED_EFFORT=""
    elif [[ -n "$chosen_baked_effort" ]]; then
      SELECTED_EFFORT="$chosen_baked_effort"
    elif [[ "$AUTO_YES" == true ]]; then
      SELECTED_EFFORT="$default_eff"
    else
      if [[ -n "$chosen_efforts_csv" || "$SELECTED_MODEL" =~ (opus|argon|flash|gemini|o1|o3|gpt-5|r1|sonnet|fable|k1|k3|glm|thinking|reasoning) ]]; then
        local eff_menu=("high (khuyến nghị suy luận cao)" "medium" "low" "none (tắt reasoning)")
        local def_eff_idx=0
        [[ "$default_eff" == "medium" ]] && def_eff_idx=1
        [[ "$default_eff" == "low" ]] && def_eff_idx=2
        [[ "$default_eff" == "none" ]] && def_eff_idx=3

        local eff_choice_idx
        if [[ -x "$ORCA_TEAM_BIN" ]]; then
          eff_choice_idx=$(python3 "$ORCA_TEAM_BIN" select \
            --title "👉 Mức độ suy luận (Reasoning Effort) cho model '$SELECTED_MODEL':" \
            --options "${eff_menu[@]}" \
            --default-idx "$def_eff_idx" \
            --return-idx)
        else
          printf "   Mức độ suy luận? [1: high, 2: medium, 3: low, 4: none] (Enter = $default_eff): "
          read -r eff_choice_idx
          eff_choice_idx="${eff_choice_idx:-$((def_eff_idx + 1))}"
        fi

        case "$eff_choice_idx" in
          1) SELECTED_EFFORT="high" ;;
          2) SELECTED_EFFORT="medium" ;;
          3) SELECTED_EFFORT="low" ;;
          4) SELECTED_EFFORT="" ;;
          *) SELECTED_EFFORT="$default_eff" ;;
        esac
      fi
    fi
  fi
}

fmt_agent_model() {
  local agent="$1"
  local model="$2"
  local effort="$3"
  local out="$agent"
  if [[ -n "$model" ]]; then
    out="$out ($model"
    if [[ -n "$effort" ]]; then
      out="$out, effort: $effort"
    fi
    out="$out)"
  else
    out="$out (model: default)"
  fi
  echo "$out"
}

fmt_md_cell() {
  local agent="$1"
  local model="$2"
  if [[ -n "$model" ]]; then
    echo "\`$agent\` ($model)"
  else
    echo "\`$agent\`"
  fi
}

fmt_worker_args() {
  local agent="${1:l}"
  local model="$2"
  local effort="${3:l}"
  local args="--agent ${1}"

  [[ "$model" == "null" || "$model" == "None" || "$model" == "(default)" ]] && model=""
  [[ "$effort" == "null" || "$effort" == "none" || "$effort" == "-" ]] && effort=""

  # Orca worker-start chỉ hỗ trợ --model trên: antigravity, claude, codex, cursor, muse, codebuddy, omp
  if [[ -z "$model" ]] || ! [[ "$agent" =~ ^(antigravity|claude|codex|cursor|muse|codebuddy|omp)$ ]]; then
    echo "$args"
    return
  fi

  args="${args} --model \"${model}\""

  if [[ -z "$effort" || "$agent" == "omp" ]]; then
    echo "$args"
    return
  fi

  case "$agent" in
    antigravity|codebuddy)
      [[ "$effort" =~ ^(xhigh|max|ultra)$ ]] && effort="high"
      [[ "$effort" == "minimal" ]] && effort="low"
      [[ "$effort" =~ ^(low|medium|high)$ ]] && args="${args} --effort ${effort}"
      ;;
    claude)
      if [[ "${model:l}" != "haiku" && "$effort" =~ ^(low|medium|high|xhigh|max)$ ]]; then
        args="${args} --effort ${effort}"
      fi
      ;;
    cursor)
      if [[ "$model" =~ ^(gpt-5\.3-codex|claude-opus-4-8)$ && "$effort" =~ ^(low|medium|high)$ ]]; then
        args="${args} --effort ${effort}"
      fi
      ;;
    codex|muse)
      if [[ "$effort" =~ ^(minimal|low|medium|high|xhigh|max|ultra)$ ]]; then
        args="${args} --effort ${effort}"
      fi
      ;;
  esac
  echo "$args"
}

choose_count() {
  local role_title="$1"
  local default_count="${2:-1}"
  if [[ "$AUTO_YES" == true ]]; then
    SELECTED_COUNT="$default_count"
    echo "   ➔ Số lượng ($role_title): $SELECTED_COUNT agent(s) (--yes)"
    return
  fi
  local count_options=(
    "1 agent"
    "2 agents (khuyến nghị song song)"
    "3 agents"
    "4 agents"
    "5 agents"
  )
  local def_i=$(( default_count - 1 ))
  [[ $def_i -lt 0 || $def_i -gt 4 ]] && def_i=0

  if [[ -x "$ORCA_TEAM_BIN" ]]; then
    local chosen_i
    chosen_i=$(python3 "$ORCA_TEAM_BIN" select \
      --title "👉 Chọn số lượng agent song song cho $role_title:" \
      --options "${count_options[@]}" \
      --default-idx "$def_i" \
      --return-idx)
    SELECTED_COUNT="${chosen_i:-$default_count}"
  else
    printf "   Nhập số lượng agent song song cho $role_title [1-5] (Enter = $default_count): "
    read -r count
    SELECTED_COUNT="${count:-$default_count}"
  fi
}

choose_utilities() {
  local default_utils="$1"
  if [[ "$AUTO_YES" == true ]]; then
    if [[ "$default_utils" == "1,5" ]]; then
      SELECTED_UTILS=("git-worktrees" "orca-skills-registry")
    else
      SELECTED_UTILS=("git-worktrees" "browser-design-mode" "orca-skills-registry")
    fi
    echo "   ➔ Tiện ích: ${(j:, :)SELECTED_UTILS} (--yes)"
    return
  fi
  local def_idx=0
  [[ "$default_utils" == "1,5" ]] && def_idx=1

  local util_bundles=(
    "Gói Tiêu chuẩn: Git Worktrees + Browser Design Mode + Skills Registry ⭐"
    "Gói Bảo mật & Backend: Git Worktrees + Skills Registry"
    "Gói Full-Stack + SSH Remote: Worktrees + Browser + SSH + Skills Registry"
    "Gói Toàn diện: Tất cả 5 tiện ích (kèm Desktop Computer Use)"
  )

  if [[ -x "$ORCA_TEAM_BIN" ]]; then
    local bundle_idx
    bundle_idx=$(python3 "$ORCA_TEAM_BIN" select \
      --title "👉 Chọn gói tiện ích Orca cấp quyền cho nhóm này:" \
      --options "${util_bundles[@]}" \
      --default-idx "$def_idx" \
      --return-idx)
    case "$bundle_idx" in
      2) SELECTED_UTILS=("git-worktrees" "orca-skills-registry") ;;
      3) SELECTED_UTILS=("git-worktrees" "browser-design-mode" "ssh-remote-execution" "orca-skills-registry") ;;
      4) SELECTED_UTILS=("git-worktrees" "browser-design-mode" "ssh-remote-execution" "desktop-computer-use" "orca-skills-registry") ;;
      *) SELECTED_UTILS=("git-worktrees" "browser-design-mode" "orca-skills-registry") ;;
    esac
  else
    echo "   Tiện ích Orca cấp quyền (1: Worktrees, 2: Browser/Design Mode, 3: SSH, 4: Computer Use, 5: Skills Registry)"
    printf "   Nhập các số cách nhau bằng dấu phẩy (Enter = $default_utils): "
    read -r utils_input
    utils_input="${utils_input:-$default_utils}"
    SELECTED_UTILS=()
    for u in ${(s:,:)utils_input}; do
      u=$(echo "$u" | tr -d ' ')
      case "$u" in
        1) SELECTED_UTILS+=("git-worktrees") ;;
        2) SELECTED_UTILS+=("browser-design-mode") ;;
        3) SELECTED_UTILS+=("ssh-remote-execution") ;;
        4) SELECTED_UTILS+=("desktop-computer-use") ;;
        5) SELECTED_UTILS+=("orca-skills-registry") ;;
      esac
    done
  fi
  echo "   ➔ Tiện ích: ${(j:, :)SELECTED_UTILS}"
}

utils_to_json() {
  local formatted=()
  for item in "$@"; do
    formatted+=("\"$item\"")
  done
  echo "[${(j:, :)formatted}]"
}

ask_toggle() {
  local feature_name="$1"
  local default_val="${2:-y}"
  if [[ "$AUTO_YES" == true ]]; then
    if [[ "$default_val" == "n" || "$default_val" == "N" ]]; then
      TOGGLE_RESULT=false
    else
      TOGGLE_RESULT=true
    fi
    echo "   ➔ Vai trò mở rộng ($feature_name): $TOGGLE_RESULT (--yes)"
    return
  fi
  local toggle_options=(
    "Có (Kích hoạt $feature_name)"
    "Không (Tắt $feature_name)"
  )
  local def_i=0
  [[ "$default_val" == "n" || "$default_val" == "N" ]] && def_i=1

  if [[ -x "$ORCA_TEAM_BIN" ]]; then
    local ans_idx
    ans_idx=$(python3 "$ORCA_TEAM_BIN" select \
      --title "👉 Bạn có muốn kích hoạt vai trò mở rộng $feature_name?" \
      --options "${toggle_options[@]}" \
      --default-idx "$def_i" \
      --return-idx)
    if [[ "$ans_idx" == "1" ]]; then
      TOGGLE_RESULT=true
    else
      TOGGLE_RESULT=false
    fi
  else
    printf "   Kích hoạt $feature_name? (Y/n, Enter = $default_val): "
    read -r ans
    ans="${ans:-$default_val}"
    if [[ "$ans" == "y" || "$ans" == "Y" ]]; then
      TOGGLE_RESULT=true
    else
      TOGGLE_RESULT=false
    fi
  fi
}

echo ""
echo "╔════════════════════════════════════════════════════════════════════════════╗"
echo "║   🐋  ORCA FULL-SPECTRUM MULTI-AGENT ORCHESTRATOR — SETUP WIZARD          ║"
echo "╚════════════════════════════════════════════════════════════════════════════╝"
echo ""
echo "📍 Thư mục dự án: $PROJECT_PATH"

if [[ -f "$TARGET_RULE" && "$AUTO_YES" != true ]]; then
  if [[ -x "$ORCA_TEAM_BIN" ]]; then
    ow_choice=$(python3 "$ORCA_TEAM_BIN" select \
      --title "⚠️ Đã tồn tại cấu hình $TARGET_RULE. Bạn muốn làm gì?" \
      --options "Cấu hình lại và ghi đè" "Hủy bỏ và giữ nguyên cấu hình cũ" \
      --default-idx 0 \
      --return-idx)
    [[ "$ow_choice" != "1" ]] && echo "Đã huỷ." && exit 0
  else
    printf "Bạn có muốn cấu hình lại và ghi đè? (y/N): "
    read -r overwrite
    [[ "$overwrite" != "y" && "$overwrite" != "Y" ]] && echo "Đã huỷ." && exit 0
  fi
fi

# ── 1. CỐT LÕI: Lead Coordinator ──
echo ""
echo "=================================================================="
echo "PHẦN 1: LEAD COORDINATOR (Nhạc trưởng điều phối)"
echo "Nhiệm vụ: Lập Task DAG, quản lý Run, giao việc và điều phối các worker."
choose_agent "Lead Coordinator" 5
COORD_AGENT="$SELECTED_AGENT"
choose_model "$COORD_AGENT" "Lead Coordinator" "high" "tier1"
COORD_MODEL="$SELECTED_MODEL"
COORD_EFFORT="$SELECTED_EFFORT"

# ── 2. CỐT LÕI: Full-Stack Dev Team ──
echo ""
echo "=================================================================="
echo "PHẦN 2: FULL-STACK DEVELOPERS (Nhóm Lập trình viên)"
echo "Nhiệm vụ: Trực tiếp viết code, unit test trên các child worktree độc lập."
choose_agent "Full-Stack Devs" 5
DEV_AGENT="$SELECTED_AGENT"
choose_model "$DEV_AGENT" "Full-Stack Devs" "high" "tier3"
DEV_MODEL="$SELECTED_MODEL"
DEV_EFFORT="$SELECTED_EFFORT"
choose_count "Developer" 2
DEV_COUNT="$SELECTED_COUNT"
choose_utilities "1,2,5"
DEV_UTILS="${(j:, :)SELECTED_UTILS}"
DEV_UTILS_JSON=$(utils_to_json "${SELECTED_UTILS[@]}")

# ── 3. CỐT LÕI: QA & Test Team ──
echo ""
echo "=================================================================="
echo "PHẦN 3: QA & TEST ENGINEERS (Nhóm Kiểm thử chất lượng)"
echo "Nhiệm vụ: Viết integration tests, kiểm tra edge cases và acceptance criteria."
choose_agent "QA & Testing" 5
