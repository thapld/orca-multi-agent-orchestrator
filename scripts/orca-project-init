# Chuẩn bị các dòng bảng tùy chọn và lệnh điều phối theo đúng vai trò đã bật
EXTRA_TABLE_ROWS=""
EXTRA_STEP1_RULES=""
EXTRA_STEP2_CMDS=""
ROUTING_LINE='Code ứng dụng ➔ **`dev-worker`**'

if [[ "$ENABLE_DEVOPS" == true ]]; then
  ROUTING_LINE="${ROUTING_LINE} | Docker, K8s, Helm, DB migration, \`.env\`, infra ➔ **\`devops-worker\`**"
  EXTRA_TABLE_ROWS="${EXTRA_TABLE_ROWS}| **DevOps Specialist** | $(fmt_md_cell "$DEVOPS_AGENT" "$DEVOPS_MODEL") | On-demand | Docker/K8s rollout, DB migrations, SSH worktrees |"$'\n'
  EXTRA_STEP1_RULES="${EXTRA_STEP1_RULES}  # Principal DevOps/SRE (BẮT BUỘC khi có Docker, K8s, pod, Helm, CI/CD, DB migration, .env, infra):
  orca orchestration task-create --spec \"\$(orca-team spec devops '[Docker/K8s/DB/Infra cần triển khai]')\""$'\n'
  EXTRA_STEP2_CMDS="${EXTRA_STEP2_CMDS}  # DevOps Worker (khi có Task DevOps - Docker/K8s/DB/Infra):
  orca orchestration worker-start --task <DEVOPS_TASK_ID> \$(git worktree list | sed -n 's/^\\([^ ]*\\/devops-worker\\) .*/--worktree path:\\1/p; s/^\\([^ ]*\\).*\\[devops-worker\\].*/--worktree path:\\1/p' | head -n 1 | grep . || echo \"--worktree new-child --name devops-worker\") $(fmt_worker_args "$DEVOPS_AGENT" "$DEVOPS_MODEL" "$DEVOPS_EFFORT") --json"$'\n'
fi

ROUTING_LINE="${ROUTING_LINE} | Kiểm toán bảo mật & rò rỉ ➔ **\`sec-worker\`** | Kiểm thử nghiệm thu ➔ **\`qa-worker\`**"

if [[ "$ENABLE_UI" == true ]]; then
  ROUTING_LINE="${ROUTING_LINE} | Giao diện CSS/DOM ➔ **\`ui-worker\`**"
  EXTRA_TABLE_ROWS="${EXTRA_TABLE_ROWS}| **UI/UX Specialist** | $(fmt_md_cell "$UI_AGENT" "$UI_MODEL") | On-demand | Design Mode (Click-to-code), responsive & a11y |"$'\n'
fi

if [[ "$ENABLE_BENCH" == true ]]; then
  ROUTING_LINE="${ROUTING_LINE} | Đo tải RPS/EPS & tối ưu hiệu năng ➔ **\`bench-worker\`**"
  EXTRA_TABLE_ROWS="${EXTRA_TABLE_ROWS}| **Bench & Perf Specialist** | $(fmt_md_cell "$BENCH_AGENT" "$BENCH_MODEL") | On-demand | Stress/Load test (RPS/EPS), p95/p99 latency, profiling |"$'\n'
fi

if [[ "$ENABLE_RE" == true ]]; then
  ROUTING_LINE="${ROUTING_LINE} | Dịch ngược Binary/ASAR/Protocol (\`rea\`) ➔ **\`re-worker\`**"
  EXTRA_TABLE_ROWS="${EXTRA_TABLE_ROWS}| **Reverse Eng (REA)** | $(fmt_md_cell "$RE_AGENT" "$RE_MODEL") | On-demand | Binary/Package/ASAR/Protocol decompile (\`rea\` skill) |"$'\n'
fi

if [[ "$ENABLE_CRITIC" == true ]]; then
  ROUTING_LINE="${ROUTING_LINE} | Khảo sát sâu, phản biện giả thuyết/kế hoạch của Leader & truy tìm root-cause ➔ **\`critic-worker\`**"
  EXTRA_TABLE_ROWS="${EXTRA_TABLE_ROWS}| **Research & Critic** | $(fmt_md_cell "$CRITIC_AGENT" "$CRITIC_MODEL") | On-demand | Deep research, Devil's Advocate critique, root-cause consensus |"$'\n'
  EXTRA_STEP1_RULES="${EXTRA_STEP1_RULES}  # Principal Research & Adversarial Critic (BẮT BUỘC khi gặp 1 trong 4 trigger Anti-Autocracy ở Bước 3):
  orca orchestration task-create --spec \"\$(orca-team spec critic 'Triệu chứng & bằng chứng thô: [...] | Giả thuyết/Kế hoạch của Leader: [...]')\""$'\n'
  EXTRA_STEP2_CMDS="${EXTRA_STEP2_CMDS}  # Research & Critic Worker (khi cần khảo sát sâu, phản biện kế hoạch Leader & thống nhất root-cause):
  orca orchestration worker-start --task <CRITIC_TASK_ID> \$(git worktree list | sed -n 's/^\\([^ ]*\\/critic-worker\\) .*/--worktree path:\\1/p; s/^\\([^ ]*\\).*\\[critic-worker\\].*/--worktree path:\\1/p' | head -n 1 | grep . || echo \"--worktree new-child --name critic-worker\") $(fmt_worker_args "$CRITIC_AGENT" "$CRITIC_MODEL" "$CRITIC_EFFORT") --json"$'\n'
fi

if [[ "$ENABLE_BENCH" == true ]]; then
  EXTRA_STEP1_RULES="${EXTRA_STEP1_RULES}  # Principal Benchmark & Perf (BẮT BUỘC khi đo tải RPS/EPS, tối ưu hiệu năng, latency p95/p99, batch/queue/DB tuning):
  orca orchestration task-create --spec \"\$(orca-team spec bench '[Đo tải, benchmark & profiling]')\""$'\n'
  EXTRA_STEP2_CMDS="${EXTRA_STEP2_CMDS}  # Benchmark Worker (khi có Task Benchmark / Stress Test / Tối ưu hiệu năng):
  orca orchestration worker-start --task <BENCH_TASK_ID> \$(git worktree list | sed -n 's/^\\([^ ]*\\/bench-worker\\) .*/--worktree path:\\1/p; s/^\\([^ ]*\\).*\\[bench-worker\\].*/--worktree path:\\1/p' | head -n 1 | grep . || echo \"--worktree new-child --name bench-worker\") $(fmt_worker_args "$BENCH_AGENT" "$BENCH_MODEL" "$BENCH_EFFORT") --json"$'\n'
fi

if [[ "$ENABLE_RE" == true ]]; then
  EXTRA_STEP1_RULES="${EXTRA_STEP1_RULES}  # Principal Reverse Engineer - REA (BẮT BUỘC khi dịch ngược binary/JAR/ASAR/APK/firmware/network capture hoặc tái tạo giao thức đóng):
  orca orchestration task-create --spec \"\$(orca-team spec re '[Giải phẫu artifact/binary/protocol với rea]')\""$'\n'
  EXTRA_STEP2_CMDS="${EXTRA_STEP2_CMDS}  # Reverse Engineering Worker (khi có Task Dịch ngược Binary/Package/ASAR/Protocol với REA):
  orca orchestration worker-start --task <RE_TASK_ID> \$(git worktree list | sed -n 's/^\\([^ ]*\\/re-worker\\) .*/--worktree path:\\1/p; s/^\\([^ ]*\\).*\\[re-worker\\].*/--worktree path:\\1/p' | head -n 1 | grep . || echo \"--worktree new-child --name re-worker\") $(fmt_worker_args "$RE_AGENT" "$RE_MODEL" "$RE_EFFORT") --json"$'\n'
fi

if [[ "$ENABLE_UI" == true ]]; then
  EXTRA_STEP1_RULES="${EXTRA_STEP1_RULES}  # Principal UI/UX (Khi có Frontend, CSS/DOM, Design Mode):
  orca orchestration task-create --spec \"\$(orca-team spec ui '[Giao diện, CSS/DOM, Responsive & a11y]')\""$'\n'
  EXTRA_STEP2_CMDS="${EXTRA_STEP2_CMDS}  # UI Worker (khi có Task Frontend/UI):
  orca orchestration worker-start --task <UI_TASK_ID> \$(git worktree list | sed -n 's/^\\([^ ]*\\/ui-worker\\) .*/--worktree path:\\1/p; s/^\\([^ ]*\\).*\\[ui-worker\\].*/--worktree path:\\1/p' | head -n 1 | grep . || echo \"--worktree new-child --name ui-worker\") $(fmt_worker_args "$UI_AGENT" "$UI_MODEL" "$UI_EFFORT") --json"$'\n'
fi

# ── Các đoạn chỉ dẫn phụ thuộc Research & Critic (đồng bộ 1:1 với `orca-team sync`) ──
if [[ "$ENABLE_CRITIC" == true ]]; then
  C_RULE_LINE="> - **LUẬT CHỐNG ĐỘC ĐOÁN & QUY KẾT VỘI VÀNG (ANTI-AUTOCRACY):** Leader **CẤM** quy kết lỗi cho bất kỳ role nào hoặc khóa thiết kế/root-cause khi chưa có bằng chứng \`file:line\` + log. Gặp 1 trong 4 trigger ở Bước 3 ➔ **BẮT BUỘC** qua vòng phản biện với **\`critic-worker\`** tới \`CRITIC_VERDICT: CONSENSUS_REACHED\` mới khóa Spec; bất đồng sau 3 vòng ➔ Human Gate, Leader **CẤM** tự phán quyết."
  C_STEP2_RULE="- 🔴 **QUY TẮC GOM NHÓM TERMINAL TABS (CẤM ĐẺ THÊM WORKTREE TRÙNG LẶP \`-2\`, \`-3\` & TRÁNH XUNG ĐỘT ĐA REPO \`selector_ambiguous\`):** Mỗi vai trò (\`dev-worker\`, \`devops-worker\`, \`qa-worker\`, \`sec-worker\`, \`bench-worker\`, \`re-worker\`, \`ui-worker\`, \`critic-worker\`) chỉ dùng **1 Worktree định danh duy nhất**. Nếu worktree của role đó đã tồn tại trong repo (\`git worktree list\`), **BẮT BUỘC truyền \`--worktree path:<abs_path>\` (không truyền \`--name\`)** để Orca định vị chính xác tuyệt đối worktree của repo hiện tại và **mở + gom nhóm các Terminal Tab mới ngay bên trong worktree đó** (giống hệt cách \`main\` worktree gom nhóm các tab của Leader); chỉ tạo \`--worktree new-child --name <role>-worker\` ở lần chạy đầu tiên khi worktree chưa tồn tại:"
  C_STEP3_BULLET="  - **Phản biện 2 chiều với \`critic-worker\` (Anti-Autocracy):** BẮT BUỘC giao \`critic-worker\` TRƯỚC khi khóa Spec/kết luận root-cause nếu gặp 1 trong 4 trigger: (a) bug đã fix ≥1 lần vẫn tái phát, (b) escalation quy lỗi sang role khác hoặc bug liên tầng App↔DB↔Infra↔Network, (c) thay đổi schema/API contract/auth/payment hoặc chạm ≥2 tầng, (d) các worker báo cáo mâu thuẫn. Spec giao Critic phải tách riêng *Triệu chứng + bằng chứng thô* và *Giả thuyết Leader*. Nhận \`question\` \`CRITIC_CHALLENGE\` ➔ trả lời bằng \`orca orchestration reply --id <MSG_ID> --body \"...\" --json\` kèm phản chứng \`file:line\`/log HOẶC chấp nhận & sửa kế hoạch (CẤM bác bỏ suông hoặc lờ câu hỏi). \`Critic Consensus\` ➔ khóa Spec giao việc; \`Critic Deadlock\` ➔ Leader CẤM tự quyết, BẮT BUỘC \`orca orchestration gate-create --task <CRITIC_TASK_ID> --question \"Leader vs Critic bất đồng: <2 phương án + bằng chứng>\" --options '[\"leader\",\"critic\",\"wait\"]' --json\` cho sếp chọn."
  C_HANDOFF_LINE="  - **Nhận \`handoff\` (từ Critic/RE/Dev/DevOps/UI):** Coordinator kiểm duyệt bằng chứng (\`CONSENSUS_REACHED\`, Commit Hash, Clean-Room Spec, Pod/Port/Log sạch) rồi quyết định bàn giao cho role kế tiếp."
  C_ESCALATION_LINE="  - **Nhận \`escalation\` (từ DevOps/QA/Sec/Bench):** Coordinator phân xử dựa trên bằng chứng (gặp trigger Anti-Autocracy ➔ qua \`critic-worker\` trước) và điều phối bản vá: nếu worker cần sửa **đang chạy (\`live\`)** thì gửi \`orca orchestration send --to dispatch:<LIVE_DISPATCH_ID> --type dispatch --subject \"Coordinator Directive\" --body \"...\" --json\`; nếu worker **đã kết thúc (\`settled\` / đã \`worker_done\`)** thì tạo Task fix mới (\`task-create\`) + \`worker-start\` vào đúng worktree định danh của role đó (\`--worktree path:<abs_path>\`), rồi điều phối \`devops-worker\` & \`qa-worker\` kiểm toán lại."
  C_ZT1_LINE="  1. **Báo sạch giả (Fake Clean):** Báo \`succeeded\` nhưng thiếu \`EXIT_CODE=0\`, thiếu \`git commit\` (Commit Hash), \`Tests Run = 0\`, thiếu bảng số liệu Benchmark (RPS/EPS, p95/p99), thiếu Evidence từ \`rea\` (\`re-worker\`), thiếu bằng chứng \`file:line\` khi phản biện (\`critic-worker\`), hoặc QA/DevOps/Sec/Bench chạy trên nhánh cũ chưa merge commit mới của Dev."
  C_ZT3_LINE="  3. **Còn lỗi tồn đọng hoặc Chưa đạt Đồng thuận:** Lỗi compile, test fail, lỗi runtime logs, \`Critic Deadlock\` chưa được sếp phân xử qua Gate, \`SECURITY_VERDICT: BLOCK\`, \`QA_VERDICT: FAIL\`, \`PERF_VERDICT: BOTTLENECK_FOUND\`, \`RE_VERDICT: BLOCKED_BY_UNKNOWN\`, hoặc pod \`CrashLoopBackOff\`/\`ErrImagePull\`."
  C_ZT4_LINE="  4. **Vượt rào (Boundary Crossing):** Critic/QA/Bench/RE tự sửa code app, Dev xóa/skip test cũ, DevOps sửa business logic, hoặc Worker tự ý đổi kiến trúc không qua Coordinator."
  C_STEP4_COND="- Chỉ khi đã thống nhất kiến trúc/root-cause (\`CRITIC_VERDICT: CONSENSUS_REACHED\` khi có trigger Anti-Autocracy) và đủ bằng chứng thép của Dev (\`Commit Hash\` + \`Build OK\`), DevOps (\`Pod/Infra Ready\`), Security (\`PASS\`), QA (\`PASS 100%\`), Benchmark (\`PERF_VERDICT: PASS\`) và Reverse Eng (\`RE_VERDICT: EVIDENCE_COMPLETE\` nếu có), mới tạo Gate báo chuông xin phép người dùng (cấm tự ý merge):"
  C_GATE_LINE="  orca orchestration gate-create --task <FINAL_TASK_ID> --question \"Đã kiểm chứng đủ bằng chứng Đồng thuận (Critic), Build, DevOps, Security (PASS), QA (PASS 100%) và Benchmark/RE. Merge code vào nhánh chính chứ sếp?\" --options '[\"yes\",\"wait\"]' --json"
else
