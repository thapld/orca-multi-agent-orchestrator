      "model": $(json_str_or_null "$CRITIC_MODEL"),
      "effort": $(json_str_or_null "$CRITIC_EFFORT"),
      "goalMode": $GOAL_MODE,
      "utilities": ["git-worktrees", "diff-viewer", "orca-skills-registry"]
    }
  }
}
JSON

# Chuẩn bị các dòng bảng tùy chọn và lệnh điều phối theo đúng vai trò đã bật
GOAL_BADGE=""
[[ "$GOAL_MODE" == true ]] && GOAL_BADGE=" (🎯 \`/goal\`)"
EXTRA_TABLE_ROWS=""
EXTRA_STEP1_PRE_SEC=""
EXTRA_STEP1_POST_QA=""
EXTRA_STEP2_PRE_SEC=""
EXTRA_STEP2_POST_QA=""
ROUTING_LINE='Code ứng dụng ➔ **`dev-worker`**'

if [[ "$ENABLE_DEVOPS" == true ]]; then
  ROUTING_LINE="${ROUTING_LINE} | Docker, K8s, Helm, DB migration, \`.env\`, infra ➔ **\`devops-worker\`**"
  EXTRA_TABLE_ROWS="${EXTRA_TABLE_ROWS}| **DevOps Specialist** | $(fmt_md_cell "$DEVOPS_AGENT" "$DEVOPS_MODEL") | Auto-scale${GOAL_BADGE} | Docker/K8s rollout, DB migrations, SSH worktrees |"$'\n'
  EXTRA_STEP1_PRE_SEC="${EXTRA_STEP1_PRE_SEC}  # Principal DevOps/SRE (BẮT BUỘC khi có Docker, K8s, pod, Helm, CI/CD, DB migration, .env, infra):
  orca orchestration task-create --spec \"\$(orca-team spec devops '[Docker/K8s/DB/Infra cần triển khai]')\""$'\n'
  EXTRA_STEP2_PRE_SEC="${EXTRA_STEP2_PRE_SEC}  # DevOps Worker (khi có Task DevOps - Docker/K8s/DB/Infra):
  orca orchestration worker-start --task <DEVOPS_TASK_ID> \$(orca-team worktree-arg devops --task <DEVOPS_TASK_ID>) $(fmt_worker_args "$DEVOPS_AGENT" "$DEVOPS_MODEL" "$DEVOPS_EFFORT") --json"$'\n'
fi

ROUTING_LINE="${ROUTING_LINE} | Kiểm toán bảo mật & rò rỉ ➔ **\`sec-worker\`** | Kiểm thử nghiệm thu ➔ **\`qa-worker\`**"

if [[ "$ENABLE_BENCH" == true ]]; then
  ROUTING_LINE="${ROUTING_LINE} | Đo tải RPS/EPS & tối ưu hiệu năng ➔ **\`bench-worker\`**"
  EXTRA_TABLE_ROWS="${EXTRA_TABLE_ROWS}| **Bench & Perf Specialist** | $(fmt_md_cell "$BENCH_AGENT" "$BENCH_MODEL") | Auto-scale${GOAL_BADGE} | Stress/Load test (RPS/EPS), p95/p99 latency, profiling |"$'\n'
fi

if [[ "$ENABLE_RE" == true ]]; then
  ROUTING_LINE="${ROUTING_LINE} | Dịch ngược Binary/ASAR/Protocol (\`rea\`) ➔ **\`re-worker\`**"
