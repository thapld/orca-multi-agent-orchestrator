    --title "👉 Xác nhận tạo cấu hình cho project?" \
    --options "Xác nhận tạo cấu hình cho project" "Hủy bỏ" \
    --default-idx 0 \
    --return-idx)
  [[ "$confirm_choice" != "1" ]] && echo "Đã huỷ." && exit 0
else
  printf "Xác nhận tạo cấu hình cho project? (Y/n): "
  read -r confirm
  [[ "$confirm" == "n" || "$confirm" == "N" ]] && echo "Đã huỷ." && exit 0
