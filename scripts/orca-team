#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
orca-team: CLI tool to inspect and dynamically reconfigure agents, models,
and elastic worktree slots for roles in an Orca Multi-Agent Orchestrator project.

Usage:
  orca-team [status|list]
  orca-team models [agent] [--json|--tsv] [--role <role>] [--tier <tier1|tier2|tier3>] [--effort <low|medium|high>]
  orca-team select --title "..." [--options opt1 opt2 ...] [--default-idx 0] [--return-idx]
  orca-team set <role> [--agent <id>] [--model <id>] [--effort <low|medium|high>] [--goal|--no-goal] [--enable|--disable]
  orca-team get <role> [--field agent|model|effort|concurrency|goal]
  orca-team spec <role> "<task-description>"
  orca-team plan [pin|show] [--run <RUN_ID>] [--content "<PLAN>" | --file <PATH>] [--json]
  orca-team kb [index|01|02|03|04|05]
  orca-team worktree-arg <role> [--slot-only] [--no-reserve] [--release] [--json]
  orca-team release-workers [--run <RUN_ID>] [--worktree <SLOT>] [--quiet] [--json]
  orca-team merge-upstream [--role <role>] [--run <RUN_ID>] [--to-main] [--json]
  orca-team link [all|clean|status]
  orca-team watchdog [--unblock]
  orca-team monitor [--fix] [--verbose]
  orca-team uninstall [-y|--force]
  orca-team agents
"""

from __future__ import annotations

import sys
import os
import subprocess
import json
import re
import shutil
import select
import tty
import termios
from datetime import datetime, timezone
