def _build_orca_state_text(
    caller_dir: Path,
    run_id: str = "",
    since_cursor: int | None = None,
    full: bool = False,
) -> tuple[str, int]:
    """FIX-12: Xây dựng chuỗi [ORCA STATE] hoặc [ORCA DELTA] từ SQLite orchestration.db (read-only, timeout 2s) + evidence ledger."""
    import sqlite3

    db_path = _find_orca_orchestration_db()
    if not db_path or not db_path.is_file():
        return "", 0

    try:
        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=2.0)
        conn.row_factory = sqlite3.Row
    except Exception:
        return "", 0

    try:
        target_run = (run_id or "").strip()
        run_row = None
        if target_run:
            run_row = conn.execute("SELECT * FROM runs WHERE id=?", (target_run,)).fetchone()
        if not run_row:
            run_row = conn.execute(
                "SELECT * FROM runs ORDER BY CASE WHEN status IN ('active','running','waiting') THEN 0 ELSE 1 END, updated_at DESC LIMIT 1"
            ).fetchone()
        if not run_row:
            conn.close()
            return "", 0

        eff_run = str(run_row["id"])
        objective = str(run_row["objective"] or "").strip()
        tasks = conn.execute("SELECT * FROM tasks WHERE run_id=? ORDER BY created_at", (eff_run,)).fetchall()
        disp = conn.execute(
            """SELECT dc.id AS did, dc.status AS dc_status, dc.task_id, dc.created_at, dc.completed_at,
                      wd.state AS wd_state, wd.stage, wd.worktree_id, wd.agent_terminal_handle
               FROM dispatch_contexts dc LEFT JOIN worker_dispatches wd ON wd.dispatch_id = dc.id
               WHERE dc.run_id=? ORDER BY dc.created_at""",
            (eff_run,),
        ).fetchall()
        msgs = conn.execute(
            """SELECT rowid AS cursor, * FROM messages WHERE run_id=?
               AND LOWER(COALESCE(type,'')) != 'heartbeat' ORDER BY rowid""",
            (eff_run,),
        ).fetchall()
        gates = conn.execute("SELECT * FROM decision_gates WHERE run_id=? AND status='pending'", (eff_run,)).fetchall()
        conn.close()
    except Exception:
        try:
            conn.close()
        except Exception:
            pass
        return "", 0

    # Resolve project root containing .orca/runs/<eff_run>
    proj_root = caller_dir.resolve()
    if not (proj_root / ".orca" / "runs" / eff_run).is_dir():
        for cand_p in [proj_root, proj_root / "project"] + list(proj_root.parents):
            if (cand_p / ".orca" / "runs" / eff_run).is_dir():
                proj_root = cand_p
                break
        else:
            # Try inferring from worktree_id in dispatches
            for d in disp:
                wt_raw = str(d["worktree_id"] or "")
                if wt_raw.startswith("path:"):
                    wt_p = Path(wt_raw[5:]).parent
                    if (wt_p / ".orca" / "runs" / eff_run).is_dir():
                        proj_root = wt_p
                        break

    run_dir = proj_root / ".orca" / "runs" / eff_run

    # Build items [P1..Pn]
    items: dict[str, dict] = {}
    for t in tasks:
        spec_s = str(t["spec"] or "")
        st_s = str(t["status"] or "").lower()
        sym = {"completed": "✓", "working": "◐", "in_progress": "◐", "dispatched": "◐", "ready": "·", "pending": "·", "failed": "✗", "blocked": "✗"}.get(st_s, "?")
        for pk in re.findall(r"\[P(\d+)\]", spec_s):
            items[f"P{pk}"] = {"sym": sym, "owner": t["id"], "title": t["task_title"]}
    for m in msgs:
        m_type = str(m["type"] or "").lower()
        m_body = str(m["body"] or "")
        m_subj = str(m["subject"] or "")
        if m_type == "escalation" or "QA_REJECT" in m_subj or "QA_REJECT" in m_body:
            for pk in re.findall(r"\[P(\d+)\]", m_body):
                if f"P{pk}" in items:
                    items[f"P{pk}"]["sym"] = "✗"

    plan_line = " ".join(f"[{k}]{v['sym']}" for k, v in sorted(items.items(), key=lambda kv: int(kv[0][1:]) if kv[0][1:].isdigit() else 999))

    # Build WAVE line
    marks_sym = {"succeeded": "✓", "completed": "✓", "working": "◐", "ready": "·", "failed": "✗"}
    groups: dict[str, list[str]] = {}
    for d in disp:
        slot = os.path.basename(str(d["worktree_id"] or "")) or str(d["agent_terminal_handle"] or "")
        role = slot.split("-worker")[0] if "-worker" in slot else slot
        st_val = str(d["wd_state"] or d["dc_status"] or "").lower()
        groups.setdefault(role, []).append(marks_sym.get(st_val, "?"))
    wave_parts = []
    for role in ["critic", "re", "dev", "ui", "sec", "qa", "devops", "bench"]:
        if role not in groups:
            continue
        marks = groups[role]
        if role == "dev" and len(marks) > 1:
            wave_parts.append("dev*" + "".join(marks))
            continue
        if "◐" in marks:
            m_sym = "◐"
        elif "✗" in marks:
            m_sym = "✗"
        elif all(x == "·" for x in marks):
            m_sym = "·"
        else:
            m_sym = "✓"
        wave_parts.append(role + m_sym)
    wave_line = " ".join(wave_parts)

    # Build EVID line from .orca/runs/<eff_run>/evidence.jsonl and ~/.orca/evidence/<eff_run>/*.jsonl
    ev_rows: list[dict] = []
    run_ev_file = run_dir / "evidence.jsonl"
    if run_ev_file.is_file():
        for ln in run_ev_file.read_text(encoding="utf-8", errors="ignore").splitlines():
            if ln.strip():
                try:
                    ev_rows.append(json.loads(ln))
                except Exception:
                    pass
    ev_home_dir = Path(os.environ.get("ORCA_EVIDENCE_DIR", "").strip() or str(Path.home() / ".orca" / "evidence")) / eff_run
    if ev_home_dir.is_dir():
        for jf in sorted(ev_home_dir.glob("*.jsonl")):
            for ln in jf.read_text(encoding="utf-8", errors="ignore").splitlines():
                if ln.strip():
                    try:
                        ev_rows.append(json.loads(ln))
                    except Exception:
                        pass

    ev_str = "build=? test=?"
    ev_path_lbl = "no-evidence"
    if ev_rows:
        last_by_kind: dict[str, dict] = {}
        for r in ev_rows:
            if isinstance(r, dict):
                k = str(r.get("kind") or ("test" if "test" in str(r.get("cmd") or "").lower() else "build"))
                last_by_kind[k] = r
        b_row = last_by_kind.get("build")
        t_row = last_by_kind.get("test")
        e_parts = []
        if b_row:
            b_exit = int(b_row.get("exit", b_row.get("exit_code", 0)))
            b_ts = str(b_row.get("ts") or "")[11:16]
            e_parts.append(f"build={'OK' if b_exit == 0 else 'FAIL'}({b_exit})@{b_ts}Z")
        if t_row:
            t_exit = int(t_row.get("exit", t_row.get("exit_code", 0)))
            t_fail = int(t_row.get("failed", 0 if t_exit == 0 else 1))
            t_ts = str(t_row.get("ts") or "")[11:16]
            e_parts.append(f"test={'OK' if t_exit == 0 else 'FAIL'}({t_fail} failed)@{t_ts}Z")
        if e_parts:
            ev_str = " · ".join(e_parts)
        try:
            ev_path_lbl = str(run_ev_file.relative_to(proj_root)) if run_ev_file.is_file() else str(ev_home_dir)
        except Exception:
            ev_path_lbl = str(run_ev_file)

    slots_out = []
    for d in disp:
        slot = os.path.basename(str(d["worktree_id"] or "")) or str(d["agent_terminal_handle"] or "")
        st_v = str(d["wd_state"] or d["dc_status"] or "").lower()
        mark = marks_sym.get(st_v, "?")
        slots_out.append(f"{slot}{mark}")
    slots_line = " ".join(slots_out)

    cursor = max([int(m["cursor"]) for m in msgs] or [0])

    if since_cursor is not None:
        delta = [m for m in msgs if int(m["cursor"]) > int(since_cursor)]
        lines_d = [f"[ORCA DELTA] cursor {since_cursor}→{cursor} · {eff_run} · {len(delta)} sự kiện mới"]
        for m in delta:
            body_clean = str(m["body"] or "").replace("\n", " ")
            subj_clean = str(m["subject"] or "")[:46]
            lines_d.append(f"+ {str(m['type'] or ''):<10} {str(m['from_handle'] or ''):<14} {subj_clean:<46} {body_clean[:90]}")
        lines_d.append(f"ANCHOR plan={plan_line} evid={ev_str}")
        return "\n".join(lines_d), cursor

    esc = [m for m in msgs if str(m["type"] or "").lower() == "escalation"]
    has_qa_working = any("qa" in str(d["agent_terminal_handle"] or "") and str(d["wd_state"] or "").lower() == "working" for d in disp)
    phase_lbl = "3/4 (QA re-test)" if (esc and has_qa_working) else ("3/4 (Verify)" if has_qa_working else "2/4 (Execute)")

    out_lines = [
        f"[ORCA STATE] {eff_run} · phase={phase_lbl} · objective={objective}",
        f"PLAN  {plan_line}",
        f"WAVE  {wave_line}",
    ]
    if esc:
        last_esc = esc[-1]
        e_body = str(last_esc["body"] or "")
        e_subj = str(last_esc["subject"] or "")
        e_txt = e_body if e_body.startswith(e_subj) else f"{e_subj}: {e_body}"
        out_lines.append(f"BLOCK {e_txt[:170]}")
    out_lines.append(f"EVID  {ev_str} · {ev_path_lbl}")
    if gates:
        g0 = gates[0]
        out_lines.append(f"GATE  {len(gates)} pending: {g0['question']} options={g0['options']}")
    out_lines.append(f"SLOT  {slots_line}")
    if esc or gates:
        out_lines.append("NEXT  dev fix blockers → QA re-run; CẤM QA PASS khi còn BLOCK/GATE pending")
    else:
        out_lines.append("NEXT  QA verify [P1..Pn] + ledger exit=0 → mở Human Gate ở Bước 4")
    out_lines.append(f"CURSOR {cursor}")

    if full:
        out_lines.append("\n-- CHECKPOINT (đủ để phục hồi sau compaction) --")
        plan_file = run_dir / "master-plan.md"
        if plan_file.is_file():
            plan_txt = plan_file.read_text(encoding="utf-8", errors="ignore")
            sec_hdr = ""
            for ln in plan_txt.splitlines():
                if ln.startswith("## "):
                    sec_hdr = ln
                if sec_hdr.startswith("## Hợp đồng") or sec_hdr.upper().startswith("## CONTRACT"):
                    out_lines.append(ln)
        for t in tasks:
            pks = re.findall(r"\[P(\d+)\]", str(t["spec"] or ""))
            if pks:
                out_lines.append(f"[{','.join('P' + p for p in pks)}] owner={t['id']} status={t['status']} title={t['task_title']}")
        out_lines.append("RULE  PASS cần: exit=0 + commit + merge-base --is-ancestor mọi nhánh dev/ui + [P1..Pn] đủ + log sạch")

    return "\n".join(out_lines), cursor


def _update_context_budget_and_checkpoint(
    caller_dir: Path,
    run_id: str,
    added_bytes: int = 0,
    events_delta: int = 0,
    context_limit_tokens: int = 200000,
) -> dict:
    """FIX-14: Theo dõi context budget tại ~/.orca/evidence/<run>/budget.json; tự động ghi state.md khi >=70% hoặc mỗi 20 sự kiện."""
    eff_run = (run_id or "default").strip() or "default"
    ev_base = Path(os.environ.get("ORCA_EVIDENCE_DIR", "").strip() or str(Path.home() / ".orca" / "evidence"))
    run_ev_dir = ev_base / eff_run
    run_ev_dir.mkdir(parents=True, exist_ok=True)
    budget_file = run_ev_dir / "budget.json"

    data = {
        "runId": eff_run,
        "cumulativeBytes": 0,
        "estimatedTokens": 0,
        "contextLimitTokens": context_limit_tokens,
        "contextPct": 0.0,
        "totalEvents": 0,
        "eventsSinceCheckpoint": 0,
        "checkpointsWritten": 0,
        "lastCheckpointPath": "",
    }
    if budget_file.is_file():
        try:
            loaded = json.loads(budget_file.read_text(encoding="utf-8", errors="ignore"))
            if isinstance(loaded, dict):
                data.update(loaded)
        except Exception:
            pass

    data["cumulativeBytes"] = int(data.get("cumulativeBytes") or 0) + max(0, int(added_bytes))
    data["estimatedTokens"] = round(data["cumulativeBytes"] / 3.2)
    data["contextPct"] = round((data["estimatedTokens"] / max(1, context_limit_tokens)) * 100.0, 2)
    data["totalEvents"] = int(data.get("totalEvents") or 0) + max(0, int(events_delta))
    data["eventsSinceCheckpoint"] = int(data.get("eventsSinceCheckpoint") or 0) + max(0, int(events_delta))

    if data["contextPct"] >= 70.0 or data["eventsSinceCheckpoint"] >= 20:
        state_txt, _ = _build_orca_state_text(caller_dir, run_id=eff_run if eff_run != "default" else "", full=True)
        if state_txt:
            proj_root = caller_dir.resolve()
            ckpt_dir = proj_root / ".orca" / "runs" / eff_run
            ckpt_dir.mkdir(parents=True, exist_ok=True)
            ckpt_file = ckpt_dir / "state.md"
            ckpt_file.write_text(state_txt + "\n", encoding="utf-8")
            data["eventsSinceCheckpoint"] = 0
            data["checkpointsWritten"] = int(data.get("checkpointsWritten") or 0) + 1
            data["lastCheckpointPath"] = str(ckpt_file)

    try:
        budget_file.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
    except Exception:
        pass
    return data


def cmd_state(args: list, caller_dir: Path | None = None):
    """FIX-12: CLI `orca-team state [--run <RUN_ID>] [--since <CURSOR>] [--full] [--json]`."""
    work_dir = Path(caller_dir).resolve() if caller_dir else Path.cwd().resolve()
    run_id = ""
    since_cursor: int | None = None
    full = False
    as_json = False

    idx = 0
    while idx < len(args):
        tok = str(args[idx])
        if tok in ("-h", "--help", "help"):
            print("Sử dụng: orca-team state [--run <RUN_ID>] [--since <CURSOR>] [--full] [--json]")
            return
        elif tok in ("--run", "--run-id") and idx + 1 < len(args):
            run_id = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--run=") or tok.startswith("--run-id="):
            run_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok == "--since" and idx + 1 < len(args):
            try:
                since_cursor = int(args[idx + 1])
            except ValueError:
                pass
            idx += 2
        elif tok.startswith("--since="):
            try:
                since_cursor = int(tok.split("=", 1)[1].strip())
            except ValueError:
                pass
            idx += 1
        elif tok == "--full":
            full = True
            idx += 1
        elif tok == "--json":
            as_json = True
            idx += 1
        elif tok.startswith("run_") and not run_id:
            run_id = tok.strip()
            idx += 1
        else:
            idx += 1

    txt, cur = _build_orca_state_text(work_dir, run_id=run_id, since_cursor=since_cursor, full=full)
    if not txt:
        if as_json:
            print(json.dumps({"ok": False, "error": "no_active_run_or_db"}, ensure_ascii=False))
        else:
            print("[ORCA STATE] Chưa có Run hoặc DB orchestration.db.")
        return
    if as_json:
        print(json.dumps({"ok": True, "cursor": cur, "state": txt}, ensure_ascii=False, indent=2))
    else:
        print(txt)


def cmd_card(args: list):
    """FIX-11: CLI `orca-team card [role] [--role <role>] [--phase|--step <plan|implement|verify|merge|1|2|3|4>]`."""
    role_raw = ""
    step_raw = ""
    idx = 0
    while idx < len(args):
        tok = str(args[idx])
        if tok in ("-h", "--help", "help"):
            print("Sử dụng: orca-team card <role> [--step|--phase <1|2|3|4|plan|implement|verify|merge>]")
            return
        elif tok in ("--role", "-r") and idx + 1 < len(args):
            role_raw = str(args[idx + 1]).strip().lower()
            idx += 2
        elif tok.startswith("--role="):
            role_raw = tok.split("=", 1)[1].strip().lower()
            idx += 1
        elif tok in ("--step", "--phase", "-s", "-p") and idx + 1 < len(args):
            step_raw = str(args[idx + 1]).strip().lower()
            idx += 2
        elif tok.startswith("--step=") or tok.startswith("--phase="):
            step_raw = tok.split("=", 1)[1].strip().lower()
            idx += 1
        elif not tok.startswith("-") and not role_raw:
            role_raw = tok.strip().lower()
            idx += 1
        elif not tok.startswith("-") and not step_raw:
            step_raw = tok.strip().lower()
            idx += 1
        else:
            idx += 1

    role_norm_map = {
        "coord": "leader", "coordinator": "leader", "leader": "leader", "lead": "leader",
        "dev": "dev", "developer": "dev", "dev-worker": "dev",
        "qa": "qa", "tester": "qa", "qa-worker": "qa",
        "sec": "sec", "security": "sec", "sec-worker": "sec",
        "ui": "ui", "uiSpecialist": "ui", "uispecialist": "ui", "ui-worker": "ui",
        "devops": "devops", "devopsSpecialist": "devops", "devopsspecialist": "devops", "devops-worker": "devops",
        "critic": "critic", "criticSpecialist": "critic", "criticspecialist": "critic", "critic-worker": "critic",
        "re": "re", "reSpecialist": "re", "respecialist": "re", "re-worker": "re",
        "bench": "bench", "benchSpecialist": "bench", "benchspecialist": "bench", "bench-worker": "bench",
        "pr": "pr", "prReviewer": "pr", "prreviewer": "pr", "pr-worker": "pr", "doc": "pr", "docs": "pr", "doc-worker": "pr",
        "issue": "issue", "issueResolver": "issue", "issueresolver": "issue", "issue-worker": "issue", "fix": "issue", "fix-worker": "issue",
    }
    r_key = role_norm_map.get(role_raw, role_raw or "leader")
    phase_alias = {"plan": "1", "implement": "2", "verify": "3", "merge": "4"}
    default_step_for_role = {
        "leader": "3",
        "qa": "verify",
        "sec": "verify",
        "devops": "verify",
        "bench": "verify",
        "pr": "verify",
        "critic": "plan",
        "dev": "implement",
        "ui": "implement",
        "re": "implement",
        "issue": "implement",
    }
    s_key = step_raw or default_step_for_role.get(r_key, "implement")
    card = (
        ROLE_PHASE_CARDS.get((r_key, s_key))
        or ROLE_PHASE_CARDS.get((r_key, phase_alias.get(s_key, s_key)))
        or ROLE_PHASE_CARDS.get((r_key, default_step_for_role.get(r_key, "implement")))
    )
    if not card:
        sys.exit(f"Không có card cho role='{role_raw}' step='{step_raw}'")
    print(card)


def cmd_verify(args: list, caller_dir: Path | None = None):
    """FIX-02: CLI `orca-team verify [--run <RUN>] [--dispatch-id <DID>] [--task-id <TID>] [--plan-items P1,P2] [--kind test|build] [--require-tdd] -- <cmd...>`."""
    import hashlib

    work_dir = Path(caller_dir).resolve() if caller_dir else Path.cwd().resolve()
    run_id = ""
    dispatch_id = ""
    task_id = ""
    plan_items: list[str] = []
    kind = ""
    require_tdd = os.environ.get("ORCA_REQUIRE_TDD", "").strip() == "1"
    cmd_tokens: list[str] = []

    after_dd = False
    idx = 0
    while idx < len(args):
        tok = str(args[idx])
        if after_dd:
            cmd_tokens.append(tok)
            idx += 1
            continue
        if tok == "--":
            after_dd = True
            idx += 1
            continue
        if tok in ("-h", "--help", "help"):
            print(
                "Sử dụng: orca-team verify [--run <RUN_ID>] [--dispatch-id <DID>] [--task-id <TID>] "
                "[--plan-items P1,P2] [--kind test|build|lint|typecheck] [--require-tdd] -- <command...>"
            )
            return
        elif tok in ("--run", "--run-id") and idx + 1 < len(args):
            run_id = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--run=") or tok.startswith("--run-id="):
            run_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--dispatch", "--dispatch-id") and idx + 1 < len(args):
            dispatch_id = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--dispatch=") or tok.startswith("--dispatch-id="):
            dispatch_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--task", "--task-id") and idx + 1 < len(args):
            task_id = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--task=") or tok.startswith("--task-id="):
            task_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--plan-items", "--items") and idx + 1 < len(args):
            plan_items = [x.strip() for x in str(args[idx + 1]).split(",") if x.strip()]
            idx += 2
        elif tok.startswith("--plan-items=") or tok.startswith("--items="):
            plan_items = [x.strip() for x in tok.split("=", 1)[1].split(",") if x.strip()]
            idx += 1
        elif tok == "--kind" and idx + 1 < len(args):
            kind = str(args[idx + 1]).strip().lower()
            idx += 2
        elif tok.startswith("--kind="):
            kind = tok.split("=", 1)[1].strip().lower()
            idx += 1
        elif tok == "--require-tdd":
            require_tdd = True
            idx += 1
        else:
            cmd_tokens.append(tok)
            idx += 1

    if not cmd_tokens:
        print("❌ Thiếu lệnh cần chạy cho 'orca-team verify -- <cmd...>'.", file=sys.stderr)
        sys.exit(2)

    scripts_dir = Path(__file__).resolve().parent
    if str(scripts_dir) not in sys.path:
        sys.path.insert(0, str(scripts_dir))
    import orca_critic_gate as cg

    cmd_str = " ".join(cmd_tokens)
    if not kind:
        low_c = cmd_str.lower()
        if any(k in low_c for k in ("lint", "eslint", "ruff", "flake8")):
            kind = "lint"
        elif any(k in low_c for k in ("typecheck", "tsc", "mypy", "pyright")):
            kind = "typecheck"
        elif any(k in low_c for k in ("build", "compile", "py_compile", "compileall")):
            kind = "build"
        else:
            kind = "test"

    # C-FIX-13, C-FIX-19 & C-FIX-28: Strict Runner Allowlist + full-argv worktree confinement
    allowed_ok, allow_err = cg.validate_runner_allowlist(cmd_tokens, kind, worktree_dir=work_dir)
    if not allowed_ok:
        print(f"❌ {allow_err}", file=sys.stderr)
        sys.exit(2)

    info = resolve_run_upstream_branches(work_dir, run_id=run_id, dispatch_id=dispatch_id, task_id=task_id)
    eff_run = info.get("runId") or run_id or "default"
    eff_did = dispatch_id or "default"
    main_root = Path(info.get("mainRoot") or work_dir)

    t0 = time.time()
    try:
        proc = subprocess.run(
            cmd_tokens,
            cwd=str(work_dir),
            shell=False,
            capture_output=True,
            text=True,
            env=dict(os.environ, PYTHONDONTWRITEBYTECODE="1"),
        )
    except FileNotFoundError:
        print(f"❌ Không tìm thấy tệp thực thi '{cmd_tokens[0]}'.", file=sys.stderr)
        sys.exit(127)
    dur_ms = int((time.time() - t0) * 1000)
    combined_out = (proc.stdout or "") + (proc.stderr or "")
    if proc.stdout:
        sys.stdout.write(proc.stdout)
    if proc.stderr:
        sys.stderr.write(proc.stderr)

    head_sha = ""
    dirty = False
    try:
        hp = subprocess.run(["git", "-C", str(work_dir), "rev-parse", "--verify", "HEAD"], capture_output=True, text=True, timeout=2)
        if hp.returncode == 0:
            head_sha = (hp.stdout or "").strip()
        sp = subprocess.run(["git", "-C", str(work_dir), "status", "--porcelain"], capture_output=True, text=True, timeout=2)
        if sp.returncode == 0:
            dirty_lines = [
                ln for ln in (sp.stdout or "").splitlines()
                if len(ln) >= 4 and not ln[3:].strip().strip('"').startswith(".orca")
            ]
            dirty = bool(dirty_lines)
    except Exception:
        pass

    failed_cnt = 0
    for pat_f in (
        r"(\d+)\s+failed\b",
        r"(\d+)\s+failing\b",
        r"failures\s*=\s*(\d+)",
        r"ℹ\s+fail\s+(\d+)",
    ):
        m_fail = re.search(pat_f, combined_out, re.IGNORECASE)
        if m_fail:
            try:
                failed_cnt = max(failed_cnt, int(m_fail.group(1)))
            except ValueError:
                pass
    if proc.returncode != 0 and failed_cnt == 0:
        failed_cnt = 1

    passed_cnt = 0
    for pat_p in (
        r"(\d+)\s+passed\b",
        r"(\d+)\s+passing\b",
        r"Ran\s+(\d+)\s+tests?\b",
        r"ℹ\s+pass\s+(\d+)",
        r"tests\s*=\s*['\"]?(\d+)",
        r"(\d+)\s+unit\s+test\s+classes\s+executed",
    ):
        m_pass = re.search(pat_p, combined_out, re.IGNORECASE)
        if m_pass:
            try:
                passed_cnt = max(passed_cnt, int(m_pass.group(1)))
            except ValueError:
                pass
    if passed_cnt == 0:
        go_ok = re.findall(r"(?:^|\n)ok\s+\S+", combined_out)
        tap_ok = re.findall(r"(?:^|\n)ok\s+\d+\b", combined_out)
        passed_matches = re.findall(r"\bPASSED\b", combined_out)
        if go_ok or tap_ok or passed_matches:
            passed_cnt = max(len(go_ok), len(tap_ok), len(passed_matches))

    # Item 4: Never fabricate tests_total=1 when no real test output was parsed
    total_cnt = passed_cnt + failed_cnt
    eff_exit = int(proc.returncode)
    if kind == "test" and eff_exit == 0 and total_cnt <= 0:
        print(
            "❌ [ORCA VERIFY GUARD] Lệnh kết thúc với exit 0 nhưng không phát hiện bất kỳ test case nào thực thi (tests_total=0)!",
            file=sys.stderr,
        )
        eff_exit = 2

    # C-FIX-14: Compute test_tree_hash over all test files and test configs
    test_tree_hash, test_files = cg.compute_test_tree_hash(work_dir)

    ev_base = Path(os.environ.get("ORCA_EVIDENCE_DIR", "").strip() or str(Path.home() / ".orca" / "evidence"))
    ev_dir = ev_base / eff_run
    ev_dir.mkdir(parents=True, exist_ok=True)
    secret_bytes, _ = cg.get_or_create_hmac_secret(ev_base, create_if_missing=True)

    row = {
        "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "run_id": eff_run,
        "dispatch_id": eff_did,
        "dispatch": eff_did,
        "task_id": task_id,
        "plan_items": plan_items,
        "kind": kind,
        "cmd": list(cmd_tokens),
        "cmd_str": cmd_str,
        "cmd_hash": cg.canonical_cmd_hash(cmd_tokens),
        "cwd": str(work_dir),
        "head_sha": head_sha,
        "dirty": dirty,
        "exit_code": eff_exit,
        "exit": eff_exit,
        "tests_total": total_cnt,
        "tests_failed": failed_cnt,
        "failed": failed_cnt,
        "test_tree_hash": test_tree_hash,
        "test_files": test_files,
        "duration_ms": dur_ms,
        "stdout_tail_hash": hashlib.sha256(combined_out[-4096:].encode("utf-8", errors="ignore")).hexdigest()[:16],
        "artifacts": [],
        "require_tdd": require_tdd,
        "source": "recorder",
    }
    if secret_bytes:
        row["row_hmac"] = cg.compute_row_hmac(row, secret_bytes)
    row_line = json.dumps(row, ensure_ascii=False) + "\n"

    ev_file = ev_dir / f"{eff_did}.jsonl"
    fd = os.open(str(ev_file), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(fd, "a", encoding="utf-8") as f:
        f.write(row_line)
    try:
        os.chmod(ev_file, 0o600)
    except Exception:
        pass

    sys.exit(eff_exit)


def cmd_gate(args: list, caller_dir: Path | None = None):
    """FIX-09 / C-FIX-07: CLI `orca-team gate [run|create] [--from-consensus <RUN>] [--run <RUN_ID>] [--dispatch-id <DID>] [--profile contracts|default] [--json]`."""
    work_dir = Path(caller_dir).resolve() if caller_dir else Path.cwd().resolve()
    sub_action = "run"
    run_id = ""
    from_consensus_run = ""
    question_str = ""
    options_str = ""
    dispatch_id = ""
    task_id = ""
    profile = "default"
    as_json = False

    idx = 0
    while idx < len(args):
        tok = str(args[idx])
        if tok in ("-h", "--help", "help"):
            print(
                "Sử dụng:\n"
                "  orca-team gate [run] [--run <RUN_ID>] [--dispatch-id <DID>] [--profile contracts|default] [--json]\n"
                "  orca-team gate create [--from-consensus <RUN_ID>] [--run <RUN_ID>] [--question \"...\"] [--options '[\"A\",\"B\"]'] [--json]"
            )
            return
        elif tok in ("run", "create") and idx == 0:
            sub_action = tok
            idx += 1
        elif tok == "--from-consensus" and idx + 1 < len(args):
            sub_action = "create"
            from_consensus_run = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--from-consensus="):
            sub_action = "create"
            from_consensus_run = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--question", "-q") and idx + 1 < len(args):
            question_str = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--question="):
            question_str = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok == "--options" and idx + 1 < len(args):
            options_str = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--options="):
            options_str = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--run", "--run-id") and idx + 1 < len(args):
            run_id = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--run=") or tok.startswith("--run-id="):
            run_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--dispatch", "--dispatch-id") and idx + 1 < len(args):
            dispatch_id = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--dispatch=") or tok.startswith("--dispatch-id="):
            dispatch_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--task", "--task-id") and idx + 1 < len(args):
            task_id = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--task=") or tok.startswith("--task-id="):
            task_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok == "--profile" and idx + 1 < len(args):
            profile = str(args[idx + 1]).strip().lower()
            idx += 2
        elif tok.startswith("--profile="):
            profile = tok.split("=", 1)[1].strip().lower()
            idx += 1
        elif tok == "--json":
            as_json = True
            idx += 1
        else:
            idx += 1

    if sub_action == "create":
        eff_run = from_consensus_run or run_id or "default"
        info = resolve_run_upstream_branches(work_dir, run_id=eff_run)
        main_root = Path(info.get("mainRoot") or work_dir)
        run_dir = main_root / ".orca" / "runs" / eff_run
        critic_dir = run_dir / "critic"

        p_hash = ""
        msg_ids: dict = {}
        unresolved_objs: list[dict] = []

        cons_p = run_dir / "consensus.json"
        if cons_p.is_file():
            try:
                c_obj = json.loads(cons_p.read_text(encoding="utf-8", errors="ignore"))
                if isinstance(c_obj, dict):
                    p_hash = str(c_obj.get("planHash") or "")
                    msg_ids = c_obj.get("messageIds") if isinstance(c_obj.get("messageIds"), dict) else {}
            except Exception:
                pass

        if critic_dir.is_dir():
            for rf in sorted(critic_dir.glob("review-*.json"), reverse=True):
                try:
                    r_obj = json.loads(rf.read_text(encoding="utf-8", errors="ignore"))
                    if not isinstance(r_obj, dict):
                        continue
                    if not p_hash:
                        p_hash = str(r_obj.get("planHash") or "")
                    res_map = {
                        str(r.get("objectionId")): str(r.get("status") or "").lower()
                        for r in (r_obj.get("resolutions") or [])
                        if isinstance(r, dict)
                    }
                    for obj in r_obj.get("objections") or []:
                        if isinstance(obj, dict):
                            oid = str(obj.get("id") or "")
                            if res_map.get(oid, "unresolved") == "unresolved":
                                unresolved_objs.append(obj)
                    break
                except Exception:
                    continue

        if not question_str:
            if unresolved_objs:
                o0 = unresolved_objs[0]
                question_str = f"Critic bất đồng [{o0.get('item') or 'P1'}] ({o0.get('id') or 'O1'}): {o0.get('claim') or 'unresolved blocker'}. Chọn hướng?"
            else:
                question_str = f"Critic bất đồng trên Run {eff_run} (planHash={p_hash}). Chọn hướng?"

        opts = ["A", "B", "human_review"]
        if options_str:
            try:
                parsed_o = json.loads(options_str)
                if isinstance(parsed_o, list) and parsed_o:
                    opts = [str(x) for x in parsed_o]
            except Exception:
                opts = [x.strip() for x in options_str.split(",") if x.strip()] or opts

        gate_id = f"gate_critic_{int(time.time())}"
        gate_payload = {
            "gateId": gate_id,
            "runId": eff_run,
            "planHash": p_hash,
            "messageIds": msg_ids,
            "unresolvedObjections": unresolved_objs,
            "question": question_str,
            "options": opts,
            "status": "pending",
            "createdAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        }
        gates_dir = run_dir / "gates"
        gates_dir.mkdir(parents=True, exist_ok=True)
        (gates_dir / f"{gate_id}.json").write_text(json.dumps(gate_payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")

        db_p = _find_orca_orchestration_db()
        if db_p and db_p.is_file() and os.environ.get("ORCA_ORCHESTRATION_DB", "").strip():
            try:
                import sqlite3

                conn = sqlite3.connect(str(db_p), timeout=2.0)
                cols = [r[1] for r in conn.execute("PRAGMA table_info(decision_gates)").fetchall()]
                if "payload" in cols:
                    conn.execute(
                        "INSERT OR REPLACE INTO decision_gates (id, run_id, task_id, status, question, options, resolution, created_at, resolved_at, payload) "
                        "VALUES (?,?,?,?,?,?,?,?,?,?)",
                        (
                            gate_id,
                            eff_run,
                            task_id or "task_critic",
                            "pending",
                            question_str,
                            json.dumps(opts, ensure_ascii=False),
                            None,
                            gate_payload["createdAt"],
                            None,
                            json.dumps(gate_payload, ensure_ascii=False),
                        ),
                    )
                else:
                    conn.execute(
                        "INSERT OR REPLACE INTO decision_gates (id, run_id, task_id, status, question, options, resolution, created_at, resolved_at) "
                        "VALUES (?,?,?,?,?,?,?,?,?)",
                        (
                            gate_id,
                            eff_run,
                            task_id or "task_critic",
                            "pending",
                            question_str,
                            json.dumps(opts, ensure_ascii=False),
                            None,
                            gate_payload["createdAt"],
                            None,
                        ),
                    )
                conn.commit()
                conn.close()
            except Exception:
                pass

        if as_json:
            print(json.dumps(gate_payload, ensure_ascii=False, indent=2))
        else:
            print(f"🚨 [HUMAN GATE CREATED] {gate_id} (Run {eff_run}, planHash={p_hash})")
            print(f"   Câu hỏi: {question_str}")
            print(f"   Lựa chọn: {json.dumps(opts, ensure_ascii=False)}")
        return

    # C-FIX-17: Discover canonical gate commands as token lists from contracts.json, orca-team.json, or repo manifest
    scripts_dir = Path(__file__).resolve().parent
    if str(scripts_dir) not in sys.path:
        sys.path.insert(0, str(scripts_dir))
    import orca_critic_gate as cg

    info = resolve_run_upstream_branches(work_dir, run_id=run_id, dispatch_id=dispatch_id, task_id=task_id)
    eff_run = info.get("runId") or run_id or "default"
    main_root = Path(info.get("mainRoot") or work_dir)
    cfg = load_config(work_dir) or load_config(main_root) or {}

    contracts_obj = None
    contracts_p = main_root / ".orca" / "runs" / eff_run / "contracts.json"
    if contracts_p.is_file():
        try:
            contracts_obj = json.loads(contracts_p.read_text(encoding="utf-8", errors="ignore"))
        except Exception:
            contracts_obj = None

    gate_cmds: list[tuple[str, list[str]]] = cg.resolve_canonical_gate_commands(
        work_dir, main_root, contracts_obj, cfg
    )

    if not gate_cmds:
        print(
            "❌ [ORCA GATE GUARD] Không tìm thấy lệnh kiểm thử chuẩn (canonical gate command) từ manifest dự án "
            "(tests/, package.json, pyproject.toml, pytest.ini, go.mod, Cargo.toml) hoặc 'gateCommands' trong orca-team.json!\n"
            "Hướng dẫn: Khai báo 'gateCommands' trong orca-team.json với giá trị 'cmd' dạng mảng token, ví dụ:\n"
            '  "gateCommands": [{"kind": "test", "cmd": ["python3", "-m", "unittest", "discover", "-s", "tests"]}]',
            file=sys.stderr,
        )
        sys.exit(2)

    results = []
    overall_rc = 0
    for g_kind, g_tokens in gate_cmds:
        g_cmd_str = " ".join(g_tokens)
        v_args = [sys.executable, str(Path(__file__).resolve()), "--path", str(work_dir), "verify"]
        if run_id:
            v_args += ["--run", run_id]
        if dispatch_id:
            v_args += ["--dispatch-id", dispatch_id]
        if task_id:
            v_args += ["--task-id", task_id]
        v_args += ["--kind", g_kind, "--", *g_tokens]
        p = subprocess.run(v_args, cwd=str(work_dir), capture_output=True, text=True)
        results.append({"kind": g_kind, "cmd": g_cmd_str, "exitCode": p.returncode, "output": ((p.stdout or "") + (p.stderr or ""))[-400:]})
        if p.returncode != 0:
            overall_rc = p.returncode
            break

    if as_json:
        print(json.dumps({"ok": overall_rc == 0, "profile": profile, "steps": results}, ensure_ascii=False, indent=2))
    else:
        for r in results:
            sym = "✅" if r["exitCode"] == 0 else "❌"
            print(f"{sym} [GATE {r['kind']}] {r['cmd']} -> exit={r['exitCode']}")
    sys.exit(overall_rc)


def cmd_brief(args: list, caller_dir: Path | None = None):
    """FIX-14: CLI `orca-team brief [--run <RUN_ID>] [--fresh] [--retry-of <DISPATCH_ID>] [--json]` (<= 500 tokens)."""
    import sqlite3

    work_dir = Path(caller_dir).resolve() if caller_dir else Path.cwd().resolve()
    run_id = ""
    retry_of = ""
    as_json = False

    idx = 0
    while idx < len(args):
        tok = str(args[idx])
        if tok in ("-h", "--help", "help"):
            print("Sử dụng: orca-team brief [--run <RUN_ID>] [--fresh] [--retry-of <DISPATCH_ID>] [--json]")
            return
        elif tok in ("--run", "--run-id") and idx + 1 < len(args):
            run_id = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--run=") or tok.startswith("--run-id="):
            run_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--retry-of", "--dispatch", "--dispatch-id") and idx + 1 < len(args):
            retry_of = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--retry-of=") or tok.startswith("--dispatch="):
            retry_of = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok == "--fresh":
            idx += 1
        elif tok == "--json":
            as_json = True
            idx += 1
        else:
            idx += 1

    state_txt, _ = _build_orca_state_text(work_dir, run_id=run_id, full=False)
    diff_stat = ""
    try:
        dp = subprocess.run(["git", "-C", str(work_dir), "diff", "--stat", "HEAD~1..HEAD"], capture_output=True, text=True, timeout=2)
        if dp.returncode == 0 and (dp.stdout or "").strip():
            diff_stat = (dp.stdout or "").strip()[:360]
    except Exception:
        pass

    last_reject = ""
    db_path = _find_orca_orchestration_db()
    if db_path and db_path.is_file():
        try:
            conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=1.5)
            conn.row_factory = sqlite3.Row
            rows = conn.execute(
                "SELECT subject, body FROM messages WHERE type IN ('escalation','handoff') ORDER BY rowid DESC LIMIT 15"
            ).fetchall()
            conn.close()
            for r in rows:
                comb = f"{r['subject'] or ''}: {r['body'] or ''}"
                if "QA_REJECT" in comb or "SEC_BLOCK" in comb or (retry_of and retry_of in comb):
                    last_reject = comb.replace("\n", " ")[:320]
                    break
        except Exception:
            pass

    brief_lines = [
        f"[FRESH RETRY BRIEF · retry_of={retry_of or 'latest'}]",
        state_txt or "(no run state)",
    ]
    if last_reject:
        brief_lines.append(f"LAST_FAIL {last_reject}")
    if diff_stat:
        brief_lines.append(f"DIFF_STAT {diff_stat}")
    brief_text = "\n".join(brief_lines)[:1550]

    if as_json:
        print(json.dumps({"ok": True, "retryOf": retry_of, "brief": brief_text, "approxTokens": round(len(brief_text) / 3.2)}, ensure_ascii=False, indent=2))
    else:
        print(brief_text)


def _truncate_preserving_structured_json(
    txt: str,
    max_chars: int = 240,
    keys: tuple[str, ...] = ("schema", "plan_item", "file_path", "error_code", "repro_cmd", "planHash", "CRITIC_VERDICT"),
) -> str:
    """C-FIX-04 / FIX-08: Never truncate inside a structured review JSON or bug report JSON block; only trim surrounding prose."""
    if len(txt) <= max_chars:
        return txt

    # 1. Check fenced ```json ... ``` blocks first (handles nested objects like orca.critic.review/v1)
    for m_fence in re.finditer(r"(```(?:json)?\s*\{[\s\S]*?\}\s*```)", txt, re.IGNORECASE):
        f_block = m_fence.group(1)
        if any(f'"{k}"' in f_block or k in f_block for k in keys):
            prefix = txt[: m_fence.start()].strip()
            budget_prose = max(0, max_chars - len(f_block) - 4)
            if budget_prose > 10 and prefix:
                return f"{prefix[:budget_prose].rstrip()}...\n{f_block}"
            if prefix:
                return f"{prefix[:120].rstrip()}...\n{f_block}"
            return f_block

    # 2. Check flat or nested JSON object containing any target key
    key_alt = "|".join(re.escape(k) for k in keys)
    m_j = re.search(rf"(\{{[^{{}}]*\"(?:{key_alt})\"[\s\S]*\}})", txt)
    if m_j:
        j_block = m_j.group(1)
        prefix = txt[: m_j.start()].strip()
        budget_prose = max(0, max_chars - len(j_block) - 4)
        if budget_prose > 10 and prefix:
            return f"{prefix[:budget_prose].rstrip()}... {j_block}"
        return j_block
    return txt[: max(0, max_chars - 3)].rstrip() + "..."


_truncate_preserving_bug_json = _truncate_preserving_structured_json


def cmd_critic_brief(args: list, caller_dir: Path | None = None):
    """C-FIX-09: CLI `orca-team critic brief --run <RUN_ID> [--json]` — Blind pack không chứa giải pháp/rationale của Leader."""
    work_dir = Path(caller_dir).resolve() if caller_dir else Path.cwd().resolve()
    run_id = ""
    as_json = False
    idx = 0
    while idx < len(args):
        tok = str(args[idx])
        if tok in ("-h", "--help", "help"):
            print("Sử dụng: orca-team critic brief [--run <RUN_ID>] [--json]")
            return
        elif tok in ("--run", "--run-id") and idx + 1 < len(args):
            run_id = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--run=") or tok.startswith("--run-id="):
            run_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok == "--json":
            as_json = True
            idx += 1
        elif tok.startswith("run_") and not run_id:
            run_id = tok.strip()
            idx += 1
        else:
            idx += 1

    info = resolve_run_upstream_branches(work_dir, run_id=run_id)
    eff_run = info.get("runId") or run_id or "default"
    main_root = Path(info.get("mainRoot") or work_dir)
    objective = (info.get("runObjective") or "").strip()

    # Load only [P1..Pn] id + short title & contracts (strip solution rationale)
    run_dir = main_root / ".orca" / "runs" / eff_run
    plan_txt = ""
    for cand in (run_dir / "plan-draft.md", run_dir / "master-plan.md"):
        if cand.is_file():
            plan_txt = cand.read_text(encoding="utf-8", errors="ignore")
            break

    scripts_dir = Path(__file__).resolve().parent
    if str(scripts_dir) not in sys.path:
        sys.path.insert(0, str(scripts_dir))
    import orca_critic_gate as cg

    items_raw = cg.extract_items(plan_txt) if plan_txt else []
    blind_items = []
    for it in items_raw:
        desc_short = re.sub(r"\(\s*files\s*:[^)]+\)", "", str(it.get("description") or ""), flags=re.IGNORECASE).strip()
        desc_short = desc_short.split("—")[0].split(":")[0].strip()[:80]
        blind_items.append({"id": it["id"], "summary": desc_short})
    contracts = cg.contract_lines(plan_txt) if plan_txt else []

    # Machine-generated inventory: 2-level module tree, SQL tables, routes, deps, hotspots
    ignore_dirs = {".git", ".orca", ".orca-cache", "node_modules", "__pycache__", ".venv", "venv", "dist", "build", "worktrees"}
    module_tree: list[str] = []
    hotspots: list[str] = []
    sql_tables: list[str] = []
    routes: list[str] = []

    try:
        for p1 in sorted(main_root.iterdir()):
            if p1.name in ignore_dirs or p1.name.startswith("."):
                continue
            if p1.is_dir():
                sub_names = [p2.name for p2 in sorted(p1.iterdir()) if p2.name not in ignore_dirs and not p2.name.startswith(".")][:8]
                module_tree.append(f"{p1.name}/ ({', '.join(sub_names)})" if sub_names else f"{p1.name}/")
            elif p1.is_file():
                module_tree.append(p1.name)
    except Exception:
        pass

    for root_w, dirs_w, files_w in os.walk(main_root):
        dirs_w[:] = [d for d in dirs_w if d not in ignore_dirs and not d.startswith(".")]
        for fn in sorted(files_w):
            fp = Path(root_w) / fn
            try:
                rel_p = str(fp.relative_to(main_root))
            except Exception:
                continue
            if fn.endswith((".sql", ".ts", ".tsx", ".py", ".go", ".js", ".yml", ".yaml")):
                try:
                    lines_f = fp.read_text(encoding="utf-8", errors="ignore").splitlines()
                except Exception:
                    continue
                if lines_f and len(hotspots) < 10:
                    hotspots.append(f"{rel_p}:{min(len(lines_f), 10)}")
                for lno, ln in enumerate(lines_f, 1):
                    m_tbl = re.search(r"CREATE\s+TABLE(?:\s+IF\s+NOT\s+EXISTS)?\s+([A-Za-z0-9_]+)", ln, re.IGNORECASE)
                    if m_tbl and m_tbl.group(1) not in sql_tables:
                        sql_tables.append(m_tbl.group(1))
                    m_rt = re.search(r"\b(GET|POST|PUT|DELETE|PATCH)\s+(/api/[A-Za-z0-9_/\-:]+)", ln)
                    if m_rt:
                        r_str = f"{m_rt.group(1)} {m_rt.group(2)} ({rel_p}:{lno})"
                        if r_str not in routes:
                            routes.append(r_str)

    deps: list[str] = []
    pkg_json = main_root / "package.json"
    if pkg_json.is_file():
        try:
            pj = json.loads(pkg_json.read_text(encoding="utf-8", errors="ignore"))
            deps = sorted(list((pj.get("dependencies") or {}).keys()))[:15]
        except Exception:
            pass

    payload = {
        "runId": eff_run,
        "objective": objective,
        "items": blind_items,
        "contracts": contracts,
        "inventory": {
            "modules": module_tree[:15],
            "tables": sql_tables[:15],
            "routes": routes[:15],
            "dependencies": deps,
        },
        "hotspots": hotspots[:10],
    }
    if as_json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return

    out = [
        f"[CRITIC BLIND PACK · run={eff_run}]",
        f"OBJECTIVE: {objective or '(chưa có)'}",
        "ITEMS: " + (" · ".join(f"[{x['id']}] {x['summary']}" for x in blind_items) if blind_items else "(chưa có)"),
        "CONTRACTS: " + (" | ".join(contracts) if contracts else "(chưa có)"),
        "MODULES: " + (", ".join(payload["inventory"]["modules"]) or "(root)"),
        "TABLES: " + (", ".join(sql_tables[:10]) or "(none)"),
        "ROUTES: " + (", ".join(routes[:10]) or "(none)"),
        "HOTSPOTS: " + (", ".join(hotspots[:10]) or "(none)"),
        f"NEXT: Tự khảo sát repo và ghi .orca/runs/{eff_run}/critic/hypothesis.md + hypothesis.json TRƯỚC khi gọi ask!",
    ]
    print("\n".join(out))


def cmd_critic_write(args: list, caller_dir: Path | None = None):
    """C-FIX-25: CLI `orca-team critic write --run <RUN_ID> --file <filename> [--content <text>]` — Sanctioned write path into `.orca/runs/<run>/critic/`."""
    work_dir = Path(caller_dir).resolve() if caller_dir else Path.cwd().resolve()
    run_id = ""
    file_name = ""
    content_arg: str | None = None
    idx = 0
    while idx < len(args):
        tok = str(args[idx])
        if tok in ("-h", "--help", "help"):
            print("Sử dụng: orca-team critic write --run <RUN_ID> --file <tên-file-trong-critic/> [--content <text>]")
            return
        elif tok in ("--run", "--run-id") and idx + 1 < len(args):
            run_id = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--run=") or tok.startswith("--run-id="):
            run_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--file", "-f") and idx + 1 < len(args):
            file_name = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--file="):
            file_name = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--content", "-c") and idx + 1 < len(args):
            content_arg = str(args[idx + 1])
            idx += 2
        elif tok.startswith("--content="):
            content_arg = tok.split("=", 1)[1]
            idx += 1
        else:
            idx += 1

    if not file_name or "/" in file_name.replace("\\", "/") or ".." in file_name:
        print("❌ [ORCA CRITIC WRITE] Chỉ cho phép ghi tên file đơn trực tiếp bên trong '.orca/runs/<run>/critic/' (cấm '..' hoặc đường dẫn con).", file=sys.stderr)
        sys.exit(2)

    info = resolve_run_upstream_branches(work_dir, run_id=run_id)
    eff_run = info.get("runId") or run_id or "default"
    main_root = Path(info.get("mainRoot") or work_dir)
    critic_dir = (main_root / ".orca" / "runs" / eff_run / "critic").resolve()
    critic_dir.mkdir(parents=True, exist_ok=True)
    target_path = (critic_dir / file_name).resolve()
    if target_path.parent != critic_dir:
        print("❌ [ORCA CRITIC WRITE] Đường dẫn đích vượt ra ngoài thư mục critic!", file=sys.stderr)
        sys.exit(2)

    data = content_arg if content_arg is not None else sys.stdin.read()
    target_path.write_text(data, encoding="utf-8")
    _sync_orca_runs_into_child_worktrees(main_root)
    print(f"✅ [CRITIC WRITE] Đã ghi {len(data)} bytes vào {target_path}")


def cmd_wait_events(args: list, caller_dir: Path | None = None):
    """
    Chờ sự kiện từ Worker thông minh cho Lead Coordinator (`orca-team wait-events`):
    1. Lọc bỏ 100% dòng rác `_keepalive` / Electron warning trên stderr của `orca orchestration check --wait`,
       ngăn Antigravity cắt cụt `<SYSTEM_MESSAGE>` làm mất `deliveryId` (triệt tiêu hoàn toàn việc gọi `view_file` đọc `task-XX.log`).
    2. Tự động lọc bỏ các bản tin `"type": "heartbeat"` (`"subject": "alive"`) khỏi mảng `messages` (và tự động `--ack` nếu cả batch chỉ toàn heartbeat).
    3. Chống hết hạn Prompt Cache (`cache=0` ở mốc 5 phút = 300,000ms): Khi một chặng chờ timeout rỗng (`messages: []`) nhưng các Worker trong Run vẫn đang `working`,
       tự động tiếp tục vòng chờ ngầm dưới CLI (tối đa 45 phút) thay vì đánh thức LLM Leader dậy vô ích làm tốn 180k–260k Fresh Input Tokens mỗi 5 phút!
    4. Tự động thoát ngay lập tức khi có bản tin thật (`worker_done,escalation,question,handoff`) HOẶC khi toàn bộ Worker trong Run đã kết thúc (`allWorkersSettled: true`).
    """
    import sqlite3
    import subprocess
    import time

    work_dir = Path(caller_dir).resolve() if caller_dir else Path.cwd().resolve()
    ack_id = ""
    run_id = ""
    terminal_handle = ""
    types_val = "worker_done,escalation,question,handoff"
    req_timeout_ms: int | None = None
    max_wait_ms: int | None = None
    extra_flags: list[str] = []

    idx = 0
    while idx < len(args):
        tok = str(args[idx])
        if tok in ("-h", "--help", "help"):
            print(
                "Sử dụng: orca-team wait-events [--ack <DELIVERY_ID>] [--run <RUN_ID>] [--terminal <HANDLE>] [--types <CSV>] [--timeout-ms <MS>]\n"
                "  • Tự động lọc sạch stderr `_keepalive` và tin nhắn `heartbeat`.\n"
                "  • Giữ vòng chờ ngầm khi Worker vẫn đang `working`, chỉ đánh thức LLM Leader khi có sự kiện thật hoặc khi toàn bộ Worker đã settled."
            )
            return
        elif tok == "--ack" and idx + 1 < len(args):
            ack_id = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--ack="):
            ack_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok == "--run" and idx + 1 < len(args):
            run_id = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--run="):
            run_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok == "--terminal" and idx + 1 < len(args):
            terminal_handle = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--terminal="):
            terminal_handle = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok == "--types" and idx + 1 < len(args):
            types_val = str(args[idx + 1]).strip() or types_val
            idx += 2
        elif tok.startswith("--types="):
            types_val = tok.split("=", 1)[1].strip() or types_val
            idx += 1
        elif tok == "--timeout-ms" and idx + 1 < len(args):
            try:
                req_timeout_ms = int(args[idx + 1])
            except ValueError:
                pass
            idx += 2
        elif tok.startswith("--timeout-ms="):
            try:
                req_timeout_ms = int(tok.split("=", 1)[1])
            except ValueError:
                pass
            idx += 1
        elif tok == "--max-wait-ms" and idx + 1 < len(args):
            try:
                max_wait_ms = int(args[idx + 1])
            except ValueError:
                pass
            idx += 2
        elif tok.startswith("--max-wait-ms="):
            try:
                max_wait_ms = int(tok.split("=", 1)[1])
            except ValueError:
                pass
            idx += 1
        elif tok in ("--wait", "--json"):
            idx += 1
        elif tok == "--no-wave-coalesce":
            idx += 1
        elif tok in ("--peek", "--unread", "--all"):
            extra_flags.append(tok)
            idx += 1
        elif tok.startswith("delivery_") and not ack_id:
            ack_id = tok.strip()
            idx += 1
        elif tok.startswith("run_") and not run_id:
            run_id = tok.strip()
            idx += 1
        else:
            idx += 1

    no_wave_coalesce = "--no-wave-coalesce" in (args or [])
    if max_wait_ms is not None:
        total_budget_ms = max(1000, max_wait_ms)
    elif req_timeout_ms is not None and req_timeout_ms < 180000:
        # Cho phép timeout ngắn (< 3 phút) khi chạy test/spike nhanh
        total_budget_ms = max(1000, req_timeout_ms)
    else:
        # Mặc định chờ tối đa 45 phút (2,700,000 ms) khi Worker đang working để không đánh thức LLM dậy giữa chừng với cache=0
        total_budget_ms = max(req_timeout_ms or 0, 2700000)

    slice_default_ms = min(120000, total_budget_ms)
    start_ts = time.time()
    deadline_ts = start_ts + (total_budget_ms / 1000.0)
    pending_ack = ack_id if (ack_id and not ack_id.startswith("<")) else ""
    first_acknowledged = None
    last_data = None
    db_path = _find_orca_orchestration_db()

    def _inspect_run_dispatches_in_db(target_run_id: str) -> tuple[int, int, list[dict], set[str]]:
        """Trả về (total_dispatches, working_dispatches, settled_summary_list, working_handles) từ SQLite orchestration.db."""
        if not target_run_id or not db_path or not db_path.is_file():
            return -1, -1, [], set()
        try:
            conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=1.5)
            conn.row_factory = sqlite3.Row
            cur = conn.cursor()
            cur.execute(
                """
                SELECT dc.id AS context_id, dc.task_id, dc.status AS dc_status,
                       wd.state AS wd_state, wd.stage AS wd_stage, wd.agent_terminal_handle, wd.updated_at
                FROM dispatch_contexts dc
                LEFT JOIN worker_dispatches wd ON wd.dispatch_id = dc.id
                WHERE dc.run_id = ?
                ORDER BY dc.created_at ASC
                """,
                (target_run_id,),
            )
            rows = cur.fetchall()
            conn.close()
            total_c = len(rows)
            working_c = 0
            settled_list = []
            working_handles: set[str] = set()
            for r in rows:
                dc_st = str(r["dc_status"] or "").strip().lower()
                wd_st = str(r["wd_state"] or "").strip().lower()
                wd_sg = str(r["wd_stage"] or "").strip().lower()
                w_handle = str(r["agent_terminal_handle"] or "").strip()
                is_terminal = (
                    dc_st in ("completed", "failed", "circuit_broken", "canceled", "cancelled", "stopped", "released")
                    or wd_st in ("succeeded", "completed", "failed", "stopped", "timed_out", "canceled", "cancelled")
                    or wd_sg in ("settled", "process_stopped")
                )
                if not is_terminal and (
                    dc_st in ("pending", "dispatched", "working")
                    or wd_st in ("ready", "working", "starting", "booting")
                    or wd_sg in ("worktree_create", "terminal_create", "booting", "ready", "input_accepted", "working")
                ):
                    working_c += 1
                    if w_handle:
                        working_handles.add(w_handle)
                    continue
                settled_list.append(
                    {
                        "dispatchId": r["context_id"],
                        "taskId": r["task_id"],
                        "status": r["wd_state"] or r["dc_status"],
                        "stage": r["wd_stage"],
                    }
                )
            return total_c, working_c, settled_list, working_handles
        except Exception:
            return -1, -1, [], set()

    def _has_unread_actionable_in_db(target_run_id: str) -> bool:
        """Kiểm tra trong SQLite xem Run có tin nhắn thật (khác heartbeat) nào đang unread (read = 0) hay không."""
        if not target_run_id or not db_path or not db_path.is_file():
            return False
        try:
            conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=1.5)
            cur = conn.cursor()
            cur.execute(
                """
                SELECT COUNT(*) FROM messages
                WHERE run_id = ? AND read = 0 AND LOWER(COALESCE(type, '')) != 'heartbeat'
                """,
                (target_run_id,),
            )
            cnt = int((cur.fetchone() or [0])[0] or 0)
            conn.close()
            return cnt > 0
        except Exception:
            return False

    env = os.environ.copy()
    env["ORCA_INTERNAL_WAIT"] = "1"
    waiter_collision_retries = 0
    accumulated_msgs: list[dict] = []
    accumulated_msg_ids: set[str] = set()
    auto_retained_list: list[str] = []
    auto_retained_set: set[str] = set()
    latest_unacked_deliv = ""
    handoff_only_grace_used = False
    next_slice_override_ms: int | None = None

    # FIX-13: Mandatory --ack enforcement on batch 2+ when prior batch returned an unacked deliveryId
    ev_base_dir = Path(os.environ.get("ORCA_EVIDENCE_DIR", "").strip() or str(Path.home() / ".orca" / "evidence"))
    ack_state_file = ev_base_dir / (run_id or "default") / "last_delivery.json"
    prior_cursor = 0
    if ack_state_file.is_file():
        try:
            ack_meta = json.loads(ack_state_file.read_text(encoding="utf-8", errors="ignore"))
            if isinstance(ack_meta, dict):
                prior_deliv = str(ack_meta.get("unackedDeliveryId") or "").strip()
                prior_cursor = int(ack_meta.get("cursor") or 0)
                if prior_deliv and not pending_ack and not extra_flags:
                    if "--allow-unacked" in (args or []):
                        print(
                            f"⚠️ [ORCA ACK WARNING] Batch trước có deliveryId='{prior_deliv}' chưa ack (đang dùng --allow-unacked).",
                            file=sys.stderr,
                        )
                    else:
                        print(
                            json.dumps(
                                {
                                    "ok": False,
                                    "error": {
                                        "code": "ack_required",
                                        "message": (
                                            f"[ORCA ACK-REQUIRED GUARD] Batch trước đã trả về deliveryId='{prior_deliv}' nhưng bạn gọi "
                                            f"'orca-team wait-events' thiếu cờ '--ack {prior_deliv}'! "
                                            f"Hãy chạy lại: orca-team wait-events --ack {prior_deliv}" + (f" --run {run_id}" if run_id else "")
                                        ),
                                    },
                                },
                                ensure_ascii=False,
                            ),
                            file=sys.stderr,
                        )
                        sys.exit(2)
        except SystemExit:
            raise
        except Exception:
            pass

    def _truncate_preserving_bug_json(txt: str, max_chars: int = 240) -> str:
        """C-FIX-04 / FIX-08: Never truncate inside a structured review or bug report JSON block."""
        return _truncate_preserving_structured_json(txt, max_chars=max_chars)

    def _append_accumulated(new_msgs: list[dict]) -> None:
        for nm in new_msgs:
            if not isinstance(nm, dict):
                continue
            mid = str(nm.get("id") or "").strip()
            if mid:
                if mid in accumulated_msg_ids:
                    continue
                accumulated_msg_ids.add(mid)
            # Nếu là `worker_done` mà trong batch đã có bản tin `handoff` từ cùng sender/dispatch,
            # khử trùng lặp `body` để tổng dung lượng Wave Coalescing luôn < 4KB (không bị cắt cụt `<SYSTEM_MESSAGE>`)
            if str(nm.get("type") or "").strip().lower() == "worker_done":
                nm_sender = str(nm.get("from_handle") or nm.get("from") or "").strip()
                nm_did = str(nm.get("dispatchId") or nm.get("dispatch_id") or "").strip()
                nm_body = str(nm.get("body") or "").strip()
                for prev_m in accumulated_msgs:
                    if str(prev_m.get("type") or "").strip().lower() != "handoff":
                        continue
                    prev_sender = str(prev_m.get("from_handle") or prev_m.get("from") or "").strip()
                    prev_did = str(prev_m.get("dispatchId") or prev_m.get("dispatch_id") or "").strip()
                    if (nm_did and nm_did == prev_did) or (nm_sender and nm_sender == prev_sender):
                        prev_body = str(prev_m.get("body") or "").strip()
                        if nm_body and (nm_body == prev_body or nm_body in prev_body):
                            nm = dict(nm)
                            nm["body"] = "[deduplicated: identical to handoff body]"
                        elif len(nm_body) > 240 and len(prev_body) > 200:
                            nm = dict(nm)
                            nm["body"] = _truncate_preserving_bug_json(nm_body, 240)
                        break
            accumulated_msgs.append(nm)

    def _auto_retain_settled_dispatches(msgs_list: list[dict], settled_items: list[dict]) -> None:
        """Tự động gọi `worker-retain` cho các dispatch đã hoàn tất (`succeeded` + `settled`) để Leader không tốn thêm lượt LLM riêng."""
        if terminal_handle or extra_flags:
            return
        candidate_dids: list[str] = []
        for m in msgs_list:
            if not isinstance(m, dict):
                continue
            m_type = str(m.get("type") or "").strip().lower()
            m_out = str(m.get("outcome") or "").strip().lower()
            did = str(m.get("dispatchId") or m.get("dispatch_id") or "").strip()
            if m_type == "worker_done" and m_out in ("", "succeeded") and did.startswith("ctx_"):
                candidate_dids.append(did)
        for s_item in settled_items:
            if not isinstance(s_item, dict):
                continue
            st_val = str(s_item.get("status") or "").strip().lower()
            sg_val = str(s_item.get("stage") or "").strip().lower()
            did = str(s_item.get("dispatchId") or "").strip()
            if st_val in ("succeeded", "completed") and sg_val == "settled" and did.startswith("ctx_"):
                candidate_dids.append(did)
        for did in candidate_dids:
            if did in auto_retained_set:
                continue
            auto_retained_set.add(did)
            try:
                r_proc = subprocess.run(
                    ["orca", "orchestration", "worker-retain", "--dispatch", did, "--json"],
                    cwd=str(work_dir),
                    capture_output=True,
                    text=True,
                    timeout=6.0,
                    env=env,
                )
                if r_proc.returncode == 0:
                    auto_retained_list.append(did)
            except Exception:
                pass

    def _needs_immediate_leader_wakeup(msgs_list: list[dict]) -> bool:
        """Trả về True nếu có bất kỳ tin nhắn nào cần Leader xử lý ngay lập tức (question, escalation, lỗi, hoặc tín hiệu REJECT/BLOCK)."""
        reject_pat = re.compile(
            r"\b(?:CRITIC_VERDICT:\s*REJECT|QA_REJECT|INCOMPLETE_PLAN|TEST_FAIL|SEC_BLOCK|SECURITY_VERDICT:\s*BLOCK|PERF_VERDICT:\s*BOTTLENECK_FOUND|BLOCKED_BY_UNKNOWN)\b",
            re.IGNORECASE,
        )
        for m in msgs_list:
            if not isinstance(m, dict):
                continue
            m_type = str(m.get("type") or "").strip().lower()
            if m_type not in ("handoff", "worker_done"):
                return True
            if m_type == "worker_done":
                m_out = str(m.get("outcome") or "").strip().lower()
                if m_out not in ("", "succeeded"):
                    return True
            combined_txt = f"{m.get('subject') or ''}\n{m.get('body') or ''}"
            if reject_pat.search(combined_txt):
                return True
        return False

    def _finalize_wait_events_output(out_dict: dict, eff_rid: str = "") -> None:
        """FIX-13 & FIX-14: Prepend stateDelta, record last_delivery.json for --ack enforcement, and update budget.json."""
        try:
            r_obj = out_dict.get("result") if isinstance(out_dict, dict) else None
            if isinstance(r_obj, dict):
                target_rid = eff_rid or run_id or str(r_obj.get("runId") or "").strip() or "default"
                deliv_val = str(r_obj.get("deliveryId") or "").strip()
                delta_txt, new_cur = _build_orca_state_text(work_dir, run_id=target_rid if target_rid != "default" else "", since_cursor=prior_cursor)
                if delta_txt:
                    r_obj["stateDelta"] = delta_txt
                run_ev_dir = ev_base_dir / target_rid
                run_ev_dir.mkdir(parents=True, exist_ok=True)
                (run_ev_dir / "last_delivery.json").write_text(
                    json.dumps({"unackedDeliveryId": deliv_val, "cursor": new_cur, "ts": time.time()}, indent=2),
                    encoding="utf-8",
                )
                _update_context_budget_and_checkpoint(
                    work_dir,
                    target_rid,
                    added_bytes=len(json.dumps(out_dict, ensure_ascii=False)),
                    events_delta=len(r_obj.get("messages") or []),
                )
        except Exception:
            pass
        print(json.dumps(out_dict, ensure_ascii=False, indent=2))

    while True:
        rem_ms = int(max(1000.0, (deadline_ts - time.time()) * 1000.0))
        cur_slice_ms = min(slice_default_ms, rem_ms)
        if next_slice_override_ms is not None:
            cur_slice_ms = min(cur_slice_ms, next_slice_override_ms)
            next_slice_override_ms = None
        cmd = ["orca", "orchestration", "check"]
        if pending_ack:
            cmd += ["--ack", pending_ack]
        if run_id and not terminal_handle:
            cmd += ["--run", run_id]
        if terminal_handle:
            cmd += ["--terminal", terminal_handle]
        if extra_flags:
            cmd += extra_flags
        else:
            cmd += ["--wait", "--types", types_val, "--timeout-ms", str(cur_slice_ms)]
        cmd.append("--json")

        try:
            proc = subprocess.run(
                cmd,
                cwd=str(work_dir),
                capture_output=True,
                text=True,
                timeout=(cur_slice_ms / 1000.0) + 15.0,
                env=env,
            )
        except subprocess.TimeoutExpired:
            if time.time() >= deadline_ts:
                break
            continue

        raw_out = (proc.stdout or "").strip()
        parsed = None
        if raw_out:
            try:
                parsed = json.loads(raw_out)
            except Exception:
                # Fallback: tìm JSON object cuối cùng trong stdout
                brace_idx = raw_out.find("{")
                if brace_idx >= 0:
                    try:
                        parsed = json.loads(raw_out[brace_idx:])
                    except Exception:
                        parsed = None

        if not isinstance(parsed, dict):
            if proc.returncode != 0:
                err_txt = (proc.stderr or raw_out or "").strip()
                if "waiter_exists" in err_txt and waiter_collision_retries < 3:
                    waiter_collision_retries += 1
                    time.sleep(2.0)
                    continue
                if raw_out:
                    print(raw_out)
                elif err_txt:
                    print(json.dumps({"ok": False, "error": err_txt}, ensure_ascii=False))
                sys.exit(proc.returncode or 1)
            break

        if not parsed.get("ok"):
            err_obj = parsed.get("error") or {}
            err_code = str(err_obj.get("code") if isinstance(err_obj, dict) else err_obj)
            if "waiter_exists" in err_code and waiter_collision_retries < 3:
                waiter_collision_retries += 1
                time.sleep(2.0)
                continue
            print(json.dumps(parsed, ensure_ascii=False, indent=2))
            sys.exit(proc.returncode or 1)

        last_data = parsed
        res_obj = parsed.get("result")
        if not isinstance(res_obj, dict):
            print(json.dumps(parsed, ensure_ascii=False, indent=2))
            return

        if pending_ack:
            if not first_acknowledged:
                first_acknowledged = res_obj.get("acknowledged") or pending_ack
            pending_ack = ""

        if first_acknowledged and not res_obj.get("acknowledged"):
            res_obj["acknowledged"] = first_acknowledged

        def _compact_wait_events_messages(msgs: list[dict]) -> list[dict]:
            """Loại bỏ sự trùng lặp 100% giữa `m['body']` và `m['payload']` (JSON chứa lại toàn bộ `question`/`body`),
            đồng thời lược bỏ các trường rỗng/thừa để tổng đầu ra Wave Coalescing luôn < 4KB (tránh cắt cụt `<SYSTEM_MESSAGE>`)."""
            out_msgs: list[dict] = []
            for m in msgs:
                if not isinstance(m, dict):
                    continue
                mc = dict(m)
                body_str = str(mc.get("body") or "").strip()
                raw_pl = mc.get("payload")
                pl_obj = None
                if isinstance(raw_pl, dict):
                    pl_obj = dict(raw_pl)
                elif isinstance(raw_pl, str) and raw_pl.strip().startswith("{"):
                    try:
                        parsed_pl = json.loads(raw_pl)
                        if isinstance(parsed_pl, dict):
                            pl_obj = dict(parsed_pl)
                    except Exception:
                        pl_obj = None
                if isinstance(pl_obj, dict):
                    for k_id in ("taskId", "task_id", "dispatchId", "dispatch_id", "outcome", "filesModified", "files_modified", "reportPath", "report_path", "phase"):
                        if k_id in pl_obj and pl_obj[k_id] and k_id not in mc:
                            mc[k_id] = pl_obj[k_id]
                        pl_obj.pop(k_id, None)
                    for dup_k in ("question", "body", "summary", "details", "text", "message", "subject", "type"):
                        val_s = str(pl_obj.get(dup_k) or "").strip()
                        if not val_s or val_s == body_str or (len(val_s) > 80 and val_s in body_str) or dup_k in mc:
                            pl_obj.pop(dup_k, None)
                    if pl_obj:
                        mc["payload"] = json.dumps(pl_obj, ensure_ascii=False, separators=(",", ":"))
                    else:
                        mc.pop("payload", None)
                for noisy_k in ("read_at", "acked_at", "readAt", "ackedAt", "run_id", "runId", "to_handle", "toHandle"):
                    mc.pop(noisy_k, None)
                if mc.get("thread_id") is None:
                    mc.pop("thread_id", None)
                if mc.get("priority") in (None, "normal"):
                    mc.pop("priority", None)
                out_msgs.append(mc)
            return out_msgs

        raw_msgs = res_obj.get("messages") or []
        actionable_msgs = [
            m for m in raw_msgs
            if isinstance(m, dict) and str(m.get("type") or "").strip().lower() != "heartbeat"
        ]

        if actionable_msgs:
            # Micro-coalescing (1.2s): Khi Worker kết thúc, nó gửi `--type handoff` (DEV_READY/QA_FINAL)
            # rồi ~0.5s sau gửi tiếp `--type worker_done`. Nếu batch hiện tại có `handoff` nhưng chưa có
            # `worker_done` từ cùng sender, chờ 1.2s và kiểm tra SQLite `messages` (`read = 0`); nếu đã có
            # tin nhắn kế tiếp trong hàng đợi thì gộp luôn vào cùng 1 lượt đánh thức Leader (tiết kiệm 250k tokens/lượt)!
            eff_run_coalesce = run_id or str(res_obj.get("runId") or "").strip()
            cur_deliv = str(res_obj.get("deliveryId") or "").strip()
            has_handoff_only = any(str(m.get("type") or "").lower() == "handoff" for m in actionable_msgs) and not any(
                str(m.get("type") or "").lower() == "worker_done" for m in actionable_msgs
            )
            if has_handoff_only and cur_deliv and eff_run_coalesce and not extra_flags:
                time.sleep(1.2)
                if _has_unread_actionable_in_db(eff_run_coalesce):
                    coal_cmd = ["orca", "orchestration", "check", "--ack", cur_deliv]
                    if run_id and not terminal_handle:
                        coal_cmd += ["--run", run_id]
                    if terminal_handle:
                        coal_cmd += ["--terminal", terminal_handle]
                    coal_cmd += ["--types", types_val, "--json"]
                    try:
                        c_proc = subprocess.run(coal_cmd, cwd=str(work_dir), capture_output=True, text=True, timeout=8.0, env=env)
                        c_parsed = json.loads((c_proc.stdout or "").strip()) if (c_proc.stdout or "").strip() else None
                        if isinstance(c_parsed, dict) and c_parsed.get("ok") and isinstance(c_parsed.get("result"), dict):
                            c_res = c_parsed["result"]
                            c_msgs = [
                                m for m in (c_res.get("messages") or [])
                                if isinstance(m, dict) and str(m.get("type") or "").strip().lower() != "heartbeat"
                            ]
                            if c_msgs:
                                seen_mids = {str(m.get("id") or "") for m in actionable_msgs if m.get("id")}
                                for cm in c_msgs:
                                    mid = str(cm.get("id") or "")
                                    if not mid or mid not in seen_mids:
                                        actionable_msgs.append(cm)
                                        if mid:
                                            seen_mids.add(mid)
                                if c_res.get("deliveryId"):
                                    res_obj["deliveryId"] = c_res["deliveryId"]
                                    cur_deliv = str(c_res["deliveryId"]).strip()
                    except Exception:
                        pass
            actionable_msgs = _compact_wait_events_messages(actionable_msgs)
            _append_accumulated(actionable_msgs)
            if cur_deliv:
                latest_unacked_deliv = cur_deliv

            total_d, working_d, settled_summary, working_handles = _inspect_run_dispatches_in_db(eff_run_coalesce)
            _auto_retain_settled_dispatches(accumulated_msgs, settled_summary)

            # Wave-Barrier Coalescing: Khi nhiều Worker chạy song song trong cùng 1 Wave (VD dev-worker, dev-worker-2, ui-worker),
            # nếu 1 Worker hoàn tất sạch (`handoff` + `worker_done: succeeded`, không có question/escalation/REJECT/lỗi) trong khi
            # các Worker khác của Wave vẫn đang `working` (`working_d > 0`), tự động retain Worker đã xong và tiếp tục chờ
            # các Worker còn lại của Wave để chỉ đánh thức Leader ĐÚNG 1 LẦN khi cả Wave hoàn tất (tiết kiệm 300k–900k tokens/Wave)!
            if (
                not terminal_handle
                and not extra_flags
                and not no_wave_coalesce
                and working_d > 0
                and (time.time() + 5.0 < deadline_ts)
                and not _needs_immediate_leader_wakeup(accumulated_msgs)
            ):
                handoff_senders = {
                    str(m.get("from_handle") or "").strip()
                    for m in accumulated_msgs
                    if str(m.get("type") or "").strip().lower() == "handoff" and m.get("from_handle")
                }
                done_senders = {
                    str(m.get("from_handle") or "").strip()
                    for m in accumulated_msgs
                    if str(m.get("type") or "").strip().lower() == "worker_done" and m.get("from_handle")
                }
                other_working = working_handles - (handoff_senders - done_senders)
                if other_working:
                    if latest_unacked_deliv:
                        pending_ack = latest_unacked_deliv
                        latest_unacked_deliv = ""
                    continue
                elif not handoff_only_grace_used:
                    # Trường hợp duy nhất 1 Worker vừa gửi `handoff` và đang chuẩn bị gửi `worker_done` (chậm hơn 1.2s):
                    # chờ thêm tối đa 1 nhịp ngắn 12s để bắt luôn `worker_done` trước khi trả về cho Leader.
                    handoff_only_grace_used = True
                    next_slice_override_ms = 12000
                    if latest_unacked_deliv:
                        pending_ack = latest_unacked_deliv
                        latest_unacked_deliv = ""
                    continue

            res_obj["messages"] = accumulated_msgs
            res_obj["count"] = len(accumulated_msgs)
            res_obj["deliveryId"] = latest_unacked_deliv or None
            if auto_retained_list:
                res_obj["autoRetainedDispatches"] = auto_retained_list
            if total_d > 0 and working_d == 0:
                res_obj["allWorkersSettled"] = True
                res_obj["settledDispatches"] = settled_summary[-8:]
            _finalize_wait_events_output(parsed, eff_run_coalesce)
            return

        # Nếu batch trả về chỉ toàn tin nhắn heartbeat ("subject": "alive"), tự động ack nó ở vòng kế tiếp và tiếp tục chờ
        if raw_msgs and not actionable_msgs:
            hb_deliv = str(res_obj.get("deliveryId") or "").strip()
            if hb_deliv:
                pending_ack = hb_deliv
            res_obj["messages"] = []
            res_obj["count"] = 0
            res_obj["deliveryId"] = None

        if extra_flags or time.time() >= deadline_ts:
            if accumulated_msgs:
                res_obj["messages"] = accumulated_msgs
                res_obj["count"] = len(accumulated_msgs)
                res_obj["deliveryId"] = latest_unacked_deliv or None
            if auto_retained_list:
                res_obj["autoRetainedDispatches"] = auto_retained_list
            _finalize_wait_events_output(parsed, run_id)
            return

        eff_run_id = run_id or str(res_obj.get("runId") or "").strip()
        total_d, working_d, settled_summary, _ = _inspect_run_dispatches_in_db(eff_run_id)
        if total_d > 0 and working_d == 0:
            # Tất cả worker trong Run đều đã settled (không còn worker nào đang 'working').
            # Chỉ gọi check không --wait nếu thực sự có tin nhắn unread trong SQLite để không vô tình xóa deliveryId của batch trước!
            if _has_unread_actionable_in_db(eff_run_id):
                quick_cmd = ["orca", "orchestration", "check"]
                if pending_ack:
                    quick_cmd += ["--ack", pending_ack]
                if eff_run_id and not terminal_handle:
                    quick_cmd += ["--run", eff_run_id]
                if terminal_handle:
                    quick_cmd += ["--terminal", terminal_handle]
                quick_cmd.append("--json")
                try:
                    q_proc = subprocess.run(quick_cmd, cwd=str(work_dir), capture_output=True, text=True, timeout=8.0, env=env)
                    q_parsed = json.loads((q_proc.stdout or "").strip()) if (q_proc.stdout or "").strip() else None
                    if isinstance(q_parsed, dict) and q_parsed.get("ok") and isinstance(q_parsed.get("result"), dict):
                        q_res = q_parsed["result"]
                        q_msgs = [
                            m for m in (q_res.get("messages") or [])
                            if isinstance(m, dict) and str(m.get("type") or "").strip().lower() != "heartbeat"
                        ]
                        if q_msgs:
                            q_msgs = _compact_wait_events_messages(q_msgs)
                            _append_accumulated(q_msgs)
                            if q_res.get("deliveryId"):
                                latest_unacked_deliv = str(q_res.get("deliveryId")).strip()
                            _auto_retain_settled_dispatches(accumulated_msgs, settled_summary)
                            q_res["messages"] = accumulated_msgs
                            q_res["count"] = len(accumulated_msgs)
                            q_res["deliveryId"] = latest_unacked_deliv or None
                            if auto_retained_list:
                                q_res["autoRetainedDispatches"] = auto_retained_list
                            q_res["allWorkersSettled"] = True
                            q_res["settledDispatches"] = settled_summary[-8:]
                            if first_acknowledged and not q_res.get("acknowledged"):
                                q_res["acknowledged"] = first_acknowledged
                            _finalize_wait_events_output(q_parsed, eff_run_id)
                            return
                except Exception:
                    pass
            _auto_retain_settled_dispatches(accumulated_msgs, settled_summary)
            if accumulated_msgs:
                res_obj["messages"] = accumulated_msgs
                res_obj["count"] = len(accumulated_msgs)
                res_obj["deliveryId"] = latest_unacked_deliv or None
                res_obj["timedOut"] = False
            if auto_retained_list:
                res_obj["autoRetainedDispatches"] = auto_retained_list
            res_obj["allWorkersSettled"] = True
            res_obj["settledDispatches"] = settled_summary[-8:]
            _finalize_wait_events_output(parsed, eff_run_id)
            return

    if last_data is not None and isinstance(last_data.get("result"), dict):
        if accumulated_msgs:
            last_data["result"]["messages"] = accumulated_msgs
            last_data["result"]["count"] = len(accumulated_msgs)
            last_data["result"]["deliveryId"] = latest_unacked_deliv or None
        if auto_retained_list:
            last_data["result"]["autoRetainedDispatches"] = auto_retained_list
        _finalize_wait_events_output(last_data, run_id)
    else:
        _finalize_wait_events_output(
            {"ok": True, "result": {"messages": accumulated_msgs, "count": len(accumulated_msgs), "deliveryId": latest_unacked_deliv or None, "timedOut": True}},
            run_id,
        )



def _infer_task_role_prefix(title: str, spec: str) -> str:
    """Suy luận tiền tố role ('dev', 'ui', 'fix', 'devops', 'qa', 'sec', 'bench', 're', 'critic', 'pr') từ spec hoặc title."""
    s_up = (spec or "").upper()
    if "[ROLE: PRINCIPAL FULL-STACK" in s_up or "[ROLE: PRINCIPAL DEV" in s_up or "[ROLE: DEVELOPER" in s_up:
        return "dev"
    if "[ROLE: PRINCIPAL UI/UX" in s_up or "[ROLE: UI" in s_up:
        return "ui"
    if "[ROLE: PRINCIPAL ISSUE RESOLVER" in s_up:
        return "fix"
    if "[ROLE: PRINCIPAL DEVOPS/SRE" in s_up:
        return "devops"
    if "[ROLE: PRINCIPAL QA/SDET" in s_up:
        return "qa"
    if "[ROLE: PRINCIPAL SECURITY AUDITOR" in s_up:
        return "sec"
    if "[ROLE: PRINCIPAL BENCHMARK & PERF" in s_up:
        return "bench"
    if "[ROLE: PRINCIPAL REVERSE ENGINEER" in s_up:
        return "re"
    if "[ROLE: PRINCIPAL RESEARCH" in s_up or "ADVERSARIAL CRITIC" in s_up:
        return "critic"
    if "[ROLE: PRINCIPAL PR REVIEWER" in s_up:
        return "pr"
    t_low = (title or "").strip().lower()
    m = re.match(r"^(dev|ui|fix|devops|qa|sec|security|bench|re|critic)(?:[-_\s\d:]|$)", t_low)
    if m:
        tok = m.group(1)
        return "sec" if tok == "security" else tok
    return ""


def _extract_user_task_from_spec(spec_str: str) -> str:
    """Trích xuất phần mô tả nhiệm vụ/Checklist Plan gốc của Leader từ chuỗi spec đã tiêm [ROLE: ...]."""
    raw = (spec_str or "").strip()
    if not raw:
        return ""
    m_critic = re.search(
        r"\]\s*Nhiệm vụ:\s*([\s\S]+?)\s*\(Spec tách riêng Triệu chứng[^\n)]*\)\.\s*Chuẩn",
        raw,
    )
    if m_critic:
        return m_critic.group(1).strip()
    m = re.search(
        r"\]\s*Nhiệm vụ:\s*([\s\S]+)\.\s*Chuẩn(?:\s+Quân Sư[^\n:]*)?\s*:",
        raw,
    )
    if m:
        return m.group(1).strip()
    return raw


def _ensure_orca_dir_git_excluded(main_root: Path):
    """Đảm bảo .orca/, .orca-cache/, *.orca.log và cấu hình Orchestrator luôn có mặt trong cả .gitignore lẫn .git/info/exclude."""
    import subprocess

    root_p = Path(main_root)
    try:
        (root_p / ".orca" / "runs").mkdir(parents=True, exist_ok=True)
    except Exception:
        pass
    orca_entries = [
        ".agents/",
        "GEMINI.md",
        "AGENTS.md",
        "CLAUDE.md",
        "orca-team.json",
        ".orca/",
        ".orca-cache/",
        "*.orca.log",
    ]
    is_orca_proj = (root_p / "orca-team.json").is_file() or (root_p / ".agents" / "GEMINI.md").is_file()
    is_orchestrator_source_repo = (root_p / "scripts" / "orca-team").is_file() and (root_p / "templates" / "GEMINI.md").is_file()
    entries_to_check = (
        orca_entries
        if (is_orca_proj and not is_orchestrator_source_repo)
        else [".orca/", ".orca-cache/", "*.orca.log"]
    )

    # 1. Cập nhật .gitignore ở root dự án
    gi_file = root_p / ".gitignore"
    if is_orca_proj or gi_file.is_file():
        try:
            cur_gi = gi_file.read_text(encoding="utf-8", errors="ignore") if gi_file.is_file() else ""
            gi_lines = {ln.strip().rstrip("/") for ln in cur_gi.splitlines() if ln.strip() and not ln.strip().startswith("#")}
            missing_gi = [e for e in entries_to_check if e.rstrip("/") not in gi_lines]
            if missing_gi:
                with open(gi_file, "a", encoding="utf-8") as f:
                    if cur_gi and not cur_gi.endswith("\n"):
                        f.write("\n")
                    if "# Orca Multi-Agent Orchestrator" not in cur_gi:
                        f.write("\n# Orca Multi-Agent Orchestrator (Directives & Runtime)\n")
                    for m_e in missing_gi:
                        f.write(f"{m_e}\n")
        except Exception:
            pass

    # 2. Cập nhật .git/info/exclude (dùng chung cho mọi Child Worktrees ngay cả khi .gitignore chưa được commit)
    try:
        excl = root_p / ".git" / "info" / "exclude"
        if not excl.parent.is_dir():
            gc_res = subprocess.run(
                ["git", "-C", str(root_p), "rev-parse", "--path-format=absolute", "--git-common-dir"],
                capture_output=True, text=True, timeout=2,
            )
            if gc_res.returncode == 0 and gc_res.stdout.strip():
                excl = Path(gc_res.stdout.strip()) / "info" / "exclude"
        if excl.parent.is_dir():
            cur_ex = excl.read_text(encoding="utf-8", errors="ignore") if excl.exists() else ""
            raw_ex_lines = {ln.strip() for ln in cur_ex.splitlines() if ln.strip() and not ln.strip().startswith("#")}
            ex_lines = {ln.rstrip("/") for ln in raw_ex_lines}
            missing_ex = [e for e in entries_to_check if e.rstrip("/") not in ex_lines]
            if (root_p / "package.json").is_file() and "node_modules" not in raw_ex_lines:
                missing_ex.append("node_modules")
            if missing_ex:
                with open(excl, "a", encoding="utf-8") as f:
                    if cur_ex and not cur_ex.endswith("\n"):
                        f.write("\n")
                    for m_e in missing_ex:
                        f.write(f"{m_e}\n")
    except Exception:
        pass


def run_orca_json(orca_args: list, cwd: Path = None, timeout: int = 6) -> tuple[int, dict, str]:
    """Gọi `orca <orca_args>` và parse JSON output (tự động bóc tách lớp vỏ `result` nếu có)."""
    import subprocess

    cmd = ["orca", *[str(a) for a in (orca_args or [])]]
    try:
        proc = subprocess.run(
            cmd,
            cwd=str(cwd) if cwd else None,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except (subprocess.TimeoutExpired, OSError) as e:
        return 124, {}, str(e)
    raw_out = (proc.stdout or "").strip()
    raw_err = (proc.stderr or "").strip()
    if not raw_out:
        return proc.returncode, {}, raw_err
    try:
        parsed = json.loads(raw_out)
        if isinstance(parsed, dict):
            inner = parsed.get("result")
            if isinstance(inner, dict):
                return proc.returncode, inner, raw_err
            return proc.returncode, parsed, raw_err
    except Exception:
        pass
    return proc.returncode, {}, raw_err or raw_out


def _has_active_reject_marker(text: str) -> bool:
    """Kiểm tra xem văn bản có chứa cờ từ chối P2P đang hoạt động (QA_REJECT / SEC_BLOCK / INCOMPLETE_PLAN)
    mà KHÔNG phải là câu thông báo đã khắc phục (vd: 'Fixed QA_REJECT', '0 QA_REJECT', 'Resolved SEC_BLOCK')."""
    if not text:
        return False
    if re.search(r"(?:QA_VERDICT|SECURITY_VERDICT)\s*:\s*(?:FAIL|BLOCK)\b", text, re.IGNORECASE):
        return True
    cleaned = re.sub(
        r"\b(?:fixed|resolved|address(?:ed)?|fix(?:ing)?|no|0|zero|without|clear(?:ed)?|pass(?:ed)?\s+after)\s+"
        r"(?:all\s+|the\s+|previous\s+)?(?:qa_reject|sec_block|incomplete_plan)\w*",
        "",
        text,
        flags=re.IGNORECASE,
    )
    return bool(re.search(r"\b(QA_REJECT|SEC_BLOCK|INCOMPLETE_PLAN)\b", cleaned, re.IGNORECASE))


def _classify_p2p_message(m_type: str, m_subj: str, m_body: str) -> str:
    """Phân loại bản tin P2P thành 'ready', 'reject', hoặc 'other'."""
    m_type_l = (m_type or "").strip().lower()
    subj_s = m_subj or ""
    body_s = m_body or ""
    combined = f"{subj_s}\n{body_s}"
    if _has_active_reject_marker(subj_s):
        return "reject"
    if re.search(r"(?:QA_VERDICT|SECURITY_VERDICT)\s*:\s*(?:FAIL|BLOCK)\b", combined, re.IGNORECASE):
        return "reject"
    if m_type_l == "handoff" and re.search(
        r"\b(DEV_READY|DEV HANDOFF|UI_READY|UI READY|INFRA_READY|INFRA READY|QA_FINAL|CONSENSUS_REACHED)\b|"
        r"(?:QA_VERDICT|SECURITY_VERDICT|PERF_VERDICT|CRITIC_VERDICT)\s*:\s*(?:PASS|CONSENSUS_REACHED)\b",
        combined,
        re.IGNORECASE,
    ):
        return "ready"
    if _has_active_reject_marker(body_s):
        return "reject"
    if m_type_l == "handoff":
        return "ready"
    return "other"


def _extract_msg_dispatch_and_task(
    m_obj,
    handle_to_disp: dict[str, str] | None = None,
    handle_to_task: dict[str, str] | None = None,
) -> tuple[str, str]:
    """Trích xuất (dispatch_id, task_id) của người gửi bản tin từ top-level fields, JSON `payload`, hoặc `from_handle`."""
    try:
        m_dict = m_obj if isinstance(m_obj, dict) else dict(m_obj)
    except Exception:
        return "", ""
    s_did = str(
        m_dict.get("fromDispatchId")
        or m_dict.get("from_dispatch_id")
        or m_dict.get("sender_dispatch_id")
        or m_dict.get("senderDispatchId")
        or m_dict.get("dispatch_id")
        or m_dict.get("dispatchId")
        or ""
    ).strip()
    s_tid = str(m_dict.get("task_id") or m_dict.get("taskId") or "").strip()

    raw_payload = m_dict.get("payload")
    payload_obj = None
    if isinstance(raw_payload, dict):
        payload_obj = raw_payload
    elif isinstance(raw_payload, str) and raw_payload.strip().startswith("{"):
        try:
            payload_obj = json.loads(raw_payload)
        except Exception:
            payload_obj = None
    if isinstance(payload_obj, dict):
        if not s_did:
            s_did = str(
                payload_obj.get("dispatchId")
                or payload_obj.get("dispatch_id")
                or payload_obj.get("fromDispatchId")
                or payload_obj.get("from_dispatch_id")
                or ""
            ).strip()
        if not s_tid:
            s_tid = str(payload_obj.get("taskId") or payload_obj.get("task_id") or "").strip()

    from_h = str(m_dict.get("from_handle") or m_dict.get("fromHandle") or m_dict.get("from") or "").strip()
    if from_h:
        norm_h = from_h[len("terminal:"):] if from_h.startswith("terminal:") else from_h
        cand_handles = (from_h, norm_h, f"terminal:{norm_h}")
        if not s_did and handle_to_disp:
            for ch in cand_handles:
                if ch in handle_to_disp and handle_to_disp[ch]:
                    s_did = handle_to_disp[ch]
                    break
        if not s_tid and handle_to_task:
            for ch in cand_handles:
                if ch in handle_to_task and handle_to_task[ch]:
                    s_tid = handle_to_task[ch]
                    break
    return s_did, s_tid


def resolve_run_upstream_branches(
    caller_dir: Path,
    run_id: str = "",
    dispatch_id: str = "",
    task_id: str = "",
    terminal_handle: str = "",
    caller_role: str = "",
    to_main: bool = False,
    allow_live: bool = False,
) -> dict:
    """
    Xác định danh sách các nhánh git worktree thuộc ĐÚNG Run của Leader hiện tại,
    đồng thời kiểm tra xem còn bất kỳ upstream worker nào (dev-worker*, ui-worker*, fix-worker*, devops-worker*)
    trong cùng Run đang chạy dở hoặc chưa được khởi chạy hay không.
    - Ngăn chặn QA/Sec/DevOps/Bench hoặc Leader (Step 4) merge nhầm nhánh của Leader khác khi chạy đa Leader.
    - Ngăn chặn QA/Sec/DevOps/Bench chạy hoặc merge sớm khi dev-worker-2 trong cùng Run vẫn đang làm việc.
    - Hỗ trợ chế độ P2P (khi dev-worker đang LIVE nhưng đã commit sạch và bắn bản tin `--type handoff` DEV_READY,
      hoặc khi truyền `--allow-live` / `--p2p`).
    """
    import sqlite3
    import subprocess

    caller_dir = Path(caller_dir).resolve()
    caller_wt_real = os.path.realpath(str(caller_dir))
    main_root = caller_dir
    git_wt_map: dict[str, str] = {}
    try:
        wt_res = subprocess.run(
            ["git", "-C", str(caller_dir), "worktree", "list", "--porcelain"],
            capture_output=True,
            text=True,
            timeout=4,
        )
        if wt_res.returncode == 0 and wt_res.stdout:
            cur_wt = ""
            cur_br = ""
            first_seen = False
            for ln in wt_res.stdout.splitlines() + [""]:
                if ln.startswith("worktree "):
                    cur_wt = ln[9:].strip()
                    if not first_seen and cur_wt:
                        first_seen = True
                        try:
                            main_root = Path(cur_wt).resolve()
                        except Exception:
                            main_root = Path(cur_wt)
                elif ln.startswith("branch "):
                    cur_br = ln[7:].strip()
                elif not ln.strip() and cur_wt:
                    wt_r = os.path.realpath(cur_wt)
                    br_short = cur_br[len("refs/heads/"):] if cur_br.startswith("refs/heads/") else ""
                    if not br_short and wt_r != os.path.realpath(str(main_root)):
                        br_short = _extract_canonical_slot_name(Path(cur_wt).name) or Path(cur_wt).name
                    git_wt_map[wt_r] = br_short
                    cur_wt = ""
                    cur_br = ""
    except Exception:
        pass

    main_root_real = os.path.realpath(str(main_root))
    main_branch = git_wt_map.get(main_root_real, "main")
    if not main_branch or main_branch == "HEAD":
        main_branch = "main"

    caller_branch = git_wt_map.get(caller_wt_real, "")
    is_in_worker_wt = caller_wt_real != main_root_real and caller_wt_real in git_wt_map

    for wt_r in git_wt_map:
        if wt_r != main_root_real and os.path.isdir(wt_r):
            _strip_leader_directives_in_child_worktree(Path(wt_r), main_root)

    norm_role = (caller_role or "").strip().lower()
    if norm_role in ROLE_ALIASES:
        canon_r = ROLE_ALIASES[norm_role]
        norm_role = BASE_WORKTREE_MAP.get(canon_r, "dev-worker").split("-worker")[0]
    elif norm_role.endswith("-worker"):
        norm_role = norm_role.split("-worker")[0]

    if not norm_role and not to_main and caller_branch:
        m_br = re.match(r"^([a-z]+)-worker(?:-\d+)?$", caller_branch)
        if m_br:
            norm_role = m_br.group(1)

    def _compute_role_prefixes(r_name: str, is_to_main: bool):
        if is_to_main or r_name in ("main", "leader", "coordinator"):
            all_p = ("re", "dev", "ui", "fix", "devops", "qa", "sec", "bench")
            return all_p, all_p + ("critic",), all_p + ("critic",)
        if r_name in ("critic", "re", "pr", "issue", "doc"):
            return (), (), ()
        if r_name in ("dev", "ui", "fix"):
            return ("re",), ("critic", "re"), ("critic", "re")
        if r_name == "devops":
            p = ("re", "dev", "ui", "fix")
            return p, ("critic",) + p, ("critic",) + p
        if r_name == "sec":
            return ("re", "dev", "ui", "fix", "devops"), ("critic", "re", "dev", "ui", "fix"), ("critic", "re", "dev", "ui", "fix")
        # Mặc định cho qa, bench (hoặc bất kỳ downstream verifier nào)
        return ("re", "dev", "ui", "fix", "devops"), ("critic", "re", "dev", "ui", "fix", "devops"), ("critic", "re", "dev", "ui", "fix")

    if to_main or norm_role in ("main", "leader", "coordinator"):
        to_main = True
        norm_role = "main"
    upstream_prefixes, active_blocking_prefixes, unstarted_blocking_prefixes = _compute_role_prefixes(norm_role, to_main)

    resolved_run_id = (run_id or "").strip()
    resolved_dispatch_id = (dispatch_id or "").strip()
    resolved_task_id = (task_id or "").strip()
    resolved_term = (terminal_handle or "").strip()

    run_objective = ""
    tasks_in_run: dict[str, dict] = {}
    dispatches_in_run: list[dict] = []
    p2p_handoff_dispatch_ids: set[str] = set()
    p2p_ready_handoff_ts: dict[str, float] = {}
    db_path = _find_orca_orchestration_db()
    used_sqlite = False

    _SETTLED_STATES = (
        "succeeded",
        "failed",
        "canceled",
        "cancelled",
        "blocked",
        "completed",
        "stopped",
        "timed_out",
        "abandoned",
        "circuit_broken",
    )
    _NON_SUCCESS_STATES = (
        "failed",
        "canceled",
        "cancelled",
        "blocked",
        "stopped",
        "timed_out",
        "abandoned",
        "circuit_broken",
    )

    def _to_epoch_secs(val) -> float:
        if val is None or isinstance(val, bool):
            return 0.0
        if isinstance(val, (int, float)):
            v = float(val)
            return v / 1000.0 if v > 1e11 else v
        s = str(val).strip()
        if not s:
            return 0.0
        try:
            v = float(s)
            return v / 1000.0 if v > 1e11 else v
        except Exception:
            pass
        try:
            if s.endswith("Z"):
                s = s[:-1] + "+00:00"
            dt = datetime.fromisoformat(s)
            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=timezone.utc)
            return dt.timestamp()
        except Exception:
            return 0.0

    def _extract_slot_and_branch(wt_id_str: str) -> tuple[str, str, str]:
        raw = (wt_id_str or "").strip()
        if not raw:
            return "", "", ""
        wt_p = raw.split("::", 1)[-1] if "::" in raw else raw
        if wt_p.startswith("path:"):
            wt_p = wt_p[5:]
        wt_real = os.path.realpath(wt_p) if os.path.isabs(wt_p) else ""
        br = git_wt_map.get(wt_real, "") if wt_real else ""
        base_n = os.path.basename((wt_real or wt_p).rstrip("/"))
        slot = _extract_canonical_slot_name(br) or _extract_canonical_slot_name(base_n) or br or base_n
        if not br and slot and re.match(r"^[a-z]+-worker(?:-\d+)?$", slot):
            br = slot
        return wt_real, slot, br

    if db_path is not None:
        try:
            conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=1.5)
            conn.row_factory = sqlite3.Row
            used_sqlite = True

            if not resolved_run_id and resolved_dispatch_id:
                row = conn.execute(
                    "SELECT run_id, task_id FROM dispatch_contexts WHERE id = ? LIMIT 1",
                    (resolved_dispatch_id,),
                ).fetchone()
                if row:
                    resolved_run_id = str(row["run_id"] or "")
                    if not resolved_task_id:
                        resolved_task_id = str(row["task_id"] or "")

            if not resolved_run_id and resolved_task_id:
                row = conn.execute(
                    "SELECT run_id FROM tasks WHERE id = ? LIMIT 1",
                    (resolved_task_id,),
                ).fetchone()
                if row:
                    resolved_run_id = str(row["run_id"] or "")

            if not resolved_run_id and resolved_term:
                row = conn.execute(
                    """
                    SELECT dc.run_id, dc.id AS dispatch_id, dc.task_id
                    FROM worker_dispatches wd
                    JOIN dispatch_contexts dc ON dc.id = wd.dispatch_id
                    WHERE wd.agent_terminal_handle = ?
                    ORDER BY dc.created_at DESC LIMIT 1
                    """,
                    (resolved_term,),
                ).fetchone()
                if row:
                    resolved_run_id = str(row["run_id"] or "")
                    if not resolved_dispatch_id:
                        resolved_dispatch_id = str(row["dispatch_id"] or "")
                    if not resolved_task_id:
                        resolved_task_id = str(row["task_id"] or "")

            if not resolved_run_id and is_in_worker_wt:
                rows = conn.execute(
                    """
                    SELECT dc.run_id, dc.id AS dispatch_id, dc.task_id, dc.status, wd.state, wd.worktree_id
                    FROM dispatch_contexts dc
                    JOIN worker_dispatches wd ON wd.dispatch_id = dc.id
                    ORDER BY dc.created_at DESC LIMIT 80
                    """
                ).fetchall()
                fallback_row = None
                for r in rows:
                    wt_real, _, _ = _extract_slot_and_branch(str(r["worktree_id"] or ""))
                    if wt_real == caller_wt_real:
                        st = str(r["state"] or "").lower()
                        dc_st = str(r["status"] or "").lower()
                        if st in ("starting", "ready", "busy", "waiting") or dc_st == "dispatched":
                            resolved_run_id = str(r["run_id"] or "")
                            if not resolved_dispatch_id:
                                resolved_dispatch_id = str(r["dispatch_id"] or "")
                            if not resolved_task_id:
                                resolved_task_id = str(r["task_id"] or "")
                            break
                        if fallback_row is None:
                            fallback_row = r
                if not resolved_run_id and fallback_row is not None:
                    resolved_run_id = str(fallback_row["run_id"] or "")
                    if not resolved_dispatch_id:
                        resolved_dispatch_id = str(fallback_row["dispatch_id"] or "")
                    if not resolved_task_id:
                        resolved_task_id = str(fallback_row["task_id"] or "")

            if not resolved_run_id:
                # Tìm run gần nhất thuộc về main_root này (bao gồm cả Run vừa được tạo chưa có worker_dispatches)
                rows = conn.execute(
                    """
                    SELECT dc.run_id, wd.worktree_id, dc.created_at
                    FROM dispatch_contexts dc
                    JOIN worker_dispatches wd ON wd.dispatch_id = dc.id
                    ORDER BY dc.created_at DESC LIMIT 120
                    """
                ).fetchall()
                candidate_runs: list[str] = []
                cand_latest_ts: dict[str, int] = {}
                for r in rows:
                    rid = str(r["run_id"] or "")
                    wt_real, _, _ = _extract_slot_and_branch(str(r["worktree_id"] or ""))
                    if rid and wt_real and wt_real in git_wt_map:
                        if rid not in candidate_runs:
                            candidate_runs.append(rid)
                            try:
                                cand_latest_ts[rid] = int(r["created_at"] or 0)
                            except Exception:
                                cand_latest_ts[rid] = 0
                best_cand_rid = candidate_runs[0] if candidate_runs else ""
                best_cand_ts = cand_latest_ts.get(best_cand_rid, 0)

                # Kiểm tra xem có Run mới vừa được tạo (chưa có worker_dispatches nào) mới hơn best_cand_rid không
                newest_unstarted_rid = ""
                try:
                    r_rows = conn.execute(
                        """
                        SELECT r.id, r.created_at,
                               (SELECT COUNT(*) FROM dispatch_contexts dc WHERE dc.run_id = r.id) AS dc_cnt
                        FROM runs r
                        ORDER BY r.created_at DESC LIMIT 5
                        """
                    ).fetchall()
                    for rr in r_rows:
                        rr_id = str(rr["id"] or "")
                        rr_ts = int(rr["created_at"] or 0)
                        rr_dc_cnt = int(rr["dc_cnt"] or 0)
                        if rr_id and (Path(main_root_real) / ".orca" / "runs" / rr_id).is_dir():
                            if rr_ts >= best_cand_ts:
                                newest_unstarted_rid = rr_id
                                break
                        if rr_id and rr_dc_cnt == 0 and rr_ts > best_cand_ts:
                            newest_unstarted_rid = rr_id
                            break
                except Exception:
                    pass

                if newest_unstarted_rid:
                    resolved_run_id = newest_unstarted_rid
                elif best_cand_rid:
                    resolved_run_id = best_cand_rid
                else:
                    try:
                        r_row = conn.execute(
                            "SELECT id FROM runs ORDER BY created_at DESC LIMIT 1"
                        ).fetchone()
                        if r_row:
                            resolved_run_id = str(r_row["id"] or "")
                    except Exception:
                        pass

            if resolved_run_id:
                try:
                    r_obj_row = conn.execute(
                        "SELECT objective FROM runs WHERE id = ? LIMIT 1",
                        (resolved_run_id,),
                    ).fetchone()
                    if r_obj_row:
                        run_objective = str(r_obj_row["objective"] or "")
                except Exception:
                    pass

                try:
                    _heal_completed_tasks_after_gate([resolved_run_id])
                except Exception:
                    pass

                t_rows = conn.execute(
                    "SELECT id, task_title, spec, status, deps, created_at FROM tasks WHERE run_id = ? ORDER BY created_at ASC",
                    (resolved_run_id,),
                ).fetchall()
                for tr in t_rows:
                    tid = str(tr["id"] or "")
                    t_title = str(tr["task_title"] or "")
                    t_spec = str(tr["spec"] or "")
                    t_role = _infer_task_role_prefix(t_title, t_spec)
                    if tid == resolved_task_id and t_role and not caller_role and not to_main:
                        norm_role = t_role
                        upstream_prefixes, active_blocking_prefixes, unstarted_blocking_prefixes = _compute_role_prefixes(norm_role, to_main)
                    tasks_in_run[tid] = {
                        "id": tid,
                        "title": t_title,
                        "rolePrefix": t_role,
                        "status": str(tr["status"] or "").lower(),
                        "spec": t_spec,
                        "userTask": _extract_user_task_from_spec(t_spec),
                        "createdAt": tr["created_at"],
                    }

                d_rows = conn.execute(
                    """
                    SELECT dc.id AS dispatch_id, dc.task_id, dc.status AS dc_status, dc.created_at, dc.completed_at,
                           wd.state AS wd_state, wd.worktree_id, wd.agent_terminal_handle
                    FROM dispatch_contexts dc
                    LEFT JOIN worker_dispatches wd ON wd.dispatch_id = dc.id
                    WHERE dc.run_id = ?
                    ORDER BY dc.created_at ASC
                    """,
                    (resolved_run_id,),
                ).fetchall()
                for dr in d_rows:
                    did = str(dr["dispatch_id"] or "")
                    tid = str(dr["task_id"] or "")
                    dc_st = str(dr["dc_status"] or "").lower()
                    wd_st = str(dr["wd_state"] or "").lower()
                    wt_real, slot, br = _extract_slot_and_branch(str(dr["worktree_id"] or ""))
                    slot_prefix = ""
                    m_sp = re.match(r"^([a-z]+)-worker(?:-\d+)?$", slot or br)
                    if m_sp:
                        slot_prefix = m_sp.group(1)
                    if not slot_prefix and tid in tasks_in_run:
                        slot_prefix = tasks_in_run[tid].get("rolePrefix") or ""

                    is_settled = wd_st in _SETTLED_STATES or dc_st in _SETTLED_STATES
                    is_succeeded = wd_st == "succeeded" or (dc_st == "completed" and wd_st not in _NON_SUCCESS_STATES)
                    dispatches_in_run.append({
                        "dispatchId": did,
                        "taskId": tid,
                        "dcStatus": dc_st,
                        "state": wd_st or dc_st,
                        "isSettled": is_settled,
                        "isSucceeded": is_succeeded,
                        "worktreePath": wt_real,
                        "slotName": slot,
                        "branch": br,
                        "rolePrefix": slot_prefix,
                        "terminalHandle": str(dr["agent_terminal_handle"] or ""),
                        "createdAt": dr["created_at"],
                        "completedAt": dr["completed_at"],
                    })

                try:
                    m_rows = conn.execute(
                        """
                        SELECT from_handle, to_handle, type, subject, body, payload, created_at
                        FROM messages
                        WHERE run_id = ? AND type IN ('handoff', 'escalation')
                        ORDER BY created_at ASC, rowid ASC
                        """,
                        (resolved_run_id,),
                    ).fetchall()
                    raw_msg_dicts = [dict(mr) for mr in m_rows]
                except Exception:
                    raw_msg_dicts = []
            conn.close()
        except Exception:
            used_sqlite = False
            raw_msg_dicts = []
    else:
        raw_msg_dicts = []

    if not used_sqlite:
        # Fallback qua Orca CLI nếu không đọc được SQLite
        if not resolved_run_id:
            rc_rl, out_rl, _ = run_orca_json(["orchestration", "run-list", "--json"], cwd=main_root, timeout=6)
            if rc_rl == 0 and isinstance(out_rl, dict):
                runs = out_rl.get("runs") if isinstance(out_rl.get("runs"), list) else []
                if runs and isinstance(runs[0], dict):
                    resolved_run_id = str(runs[0].get("id") or "")
                    run_objective = str(runs[0].get("objective") or "")
        if resolved_run_id:
            rc_tl, out_tl, _ = run_orca_json(
                ["orchestration", "task-list", "--run", resolved_run_id, "--json"],
                cwd=main_root,
                timeout=6,
            )
            if rc_tl == 0 and isinstance(out_tl, dict):
                t_list = out_tl.get("tasks") if isinstance(out_tl.get("tasks"), list) else []
                t_list_sorted = sorted(t_list, key=lambda x: _to_epoch_secs(x.get("createdAt")) if isinstance(x, dict) else 0.0)
                for tr in t_list_sorted:
                    if not isinstance(tr, dict):
                        continue
                    tid = str(tr.get("id") or "")
                    t_title = str(tr.get("title") or tr.get("taskTitle") or "")
                    t_spec = str(tr.get("spec") or "")
                    t_role = _infer_task_role_prefix(t_title, t_spec)
                    if tid == resolved_task_id and t_role and not caller_role and not to_main:
                        norm_role = t_role
                        upstream_prefixes, active_blocking_prefixes, unstarted_blocking_prefixes = _compute_role_prefixes(norm_role, to_main)
                    tasks_in_run[tid] = {
                        "id": tid,
                        "title": t_title,
                        "rolePrefix": t_role,
                        "status": str(tr.get("status") or "").lower(),
                        "spec": t_spec,
                        "userTask": _extract_user_task_from_spec(t_spec),
                        "createdAt": tr.get("createdAt"),
                    }

            rc_wl, out_wl, _ = run_orca_json(
                ["orchestration", "worker-list", "--run", resolved_run_id, "--json"],
                cwd=main_root,
                timeout=6,
            )
            if rc_wl == 0 and isinstance(out_wl, dict):
                w_list = out_wl.get("workers") if isinstance(out_wl.get("workers"), list) else []
                # Orca CLI worker-list trả về thứ tự mới nhất trước (DESC); cần đảo/sort tăng dần theo thời gian để giữ đúng latest_dispatch
                w_list_sorted = sorted(
                    enumerate(w_list),
                    key=lambda pair: (
                        _to_epoch_secs(pair[1].get("createdAt") or pair[1].get("startedAt")) if isinstance(pair[1], dict) else 0.0,
                        -pair[0],
                    ),
                )
                for _, w in w_list_sorted:
                    if not isinstance(w, dict):
                        continue
                    did = str(w.get("dispatchId") or w.get("id") or "")
                    tid = str(w.get("taskId") or "")
                    st = str(w.get("workerState") or w.get("state") or w.get("status") or "").lower()
                    res_obj = w.get("resource") if isinstance(w.get("resource"), dict) else {}
                    wt_id_val = str(res_obj.get("worktreeId") or w.get("worktreeId") or w.get("worktreePath") or "")
                    wt_real, slot, br = _extract_slot_and_branch(wt_id_val)
                    slot_prefix = ""
                    m_sp = re.match(r"^([a-z]+)-worker(?:-\d+)?$", slot or br)
                    if m_sp:
                        slot_prefix = m_sp.group(1)
                    if not slot_prefix and tid in tasks_in_run:
                        slot_prefix = tasks_in_run[tid].get("rolePrefix") or ""
                    is_settled = bool(w.get("isSettled")) or st in _SETTLED_STATES
                    is_succeeded = st in ("succeeded", "completed")
                    dispatches_in_run.append({
                        "dispatchId": did,
                        "taskId": tid,
                        "dcStatus": st,
                        "state": st,
                        "isSettled": is_settled,
                        "isSucceeded": is_succeeded,
                        "worktreePath": wt_real,
                        "slotName": slot,
                        "branch": br,
                        "rolePrefix": slot_prefix,
                        "terminalHandle": str(w.get("agentTerminalHandle") or ""),
                        "createdAt": w.get("createdAt") or w.get("startedAt"),
                        "completedAt": w.get("completedAt") or w.get("settledAt"),
                    })

            rc_ml, out_ml, _ = run_orca_json(
                ["orchestration", "inbox", "--limit", "500", "--json"],
                cwd=main_root,
                timeout=6,
            )
            if rc_ml == 0 and isinstance(out_ml, dict):
                m_list = out_ml.get("messages") if isinstance(out_ml.get("messages"), list) else []
                m_list = [
                    m for m in m_list
                    if isinstance(m, dict) and (m.get("run_id") == resolved_run_id or m.get("runId") == resolved_run_id)
                ]
                m_list_sorted = sorted(
                    enumerate(m_list),
                    key=lambda pair: (
                        _to_epoch_secs(pair[1].get("createdAt") or pair[1].get("created_at")) if isinstance(pair[1], dict) else 0.0,
                        pair[0],
                    ),
                )
                raw_msg_dicts = [mr for _, mr in m_list_sorted if isinstance(mr, dict)]

    if raw_msg_dicts and dispatches_in_run:
        disp_role_map = {
            str(d.get("dispatchId") or ""): str(d.get("rolePrefix") or "dev")
            for d in dispatches_in_run
            if d.get("dispatchId")
        }
        disp_created_ts: dict[str, float] = {}
        for d in dispatches_in_run:
            did_v = str(d.get("dispatchId") or "").strip()
            if did_v:
                disp_created_ts[did_v] = _to_epoch_secs(d.get("createdAt"))

        def _build_active_maps_at_ts(msg_ts: float):
            s_map: dict[str, str] = {}
            h_map: dict[str, str] = {}
            for d in dispatches_in_run:
                did_v = str(d.get("dispatchId") or "").strip()
                if not did_v:
                    continue
                c_ts = disp_created_ts.get(did_v, 0.0)
                if msg_ts > 0 and c_ts > 0 and c_ts > (msg_ts + 2.0):
                    continue
                slot_v = str(d.get("slotName") or d.get("branch") or "").strip()
                th_v = str(d.get("terminalHandle") or "").strip()
                h_map[did_v] = did_v
                h_map[f"dispatch:{did_v}"] = did_v
                if slot_v:
                    s_map[slot_v] = did_v
                if th_v:
                    norm_th = th_v[len("terminal:"):] if th_v.startswith("terminal:") else th_v
                    h_map[th_v] = did_v
                    h_map[norm_th] = did_v
                    h_map[f"terminal:{norm_th}"] = did_v
            return s_map, h_map

        latest_global_reject_ts = 0.0
        latest_slot_reject_ts: dict[str, float] = {}
        latest_ready_ts_by_disp: dict[str, float] = {}

        for mr in raw_msg_dicts:
            m_type = str(mr.get("type") or "").strip().lower()
            if m_type not in ("handoff", "escalation"):
                continue
            m_ts = _to_epoch_secs(mr.get("createdAt") or mr.get("created_at"))
            slot_to_disp, handle_to_disp = _build_active_maps_at_ts(m_ts)
            fd_id, _ = _extract_msg_dispatch_and_task(mr, handle_to_disp=handle_to_disp)
            if fd_id and m_ts > 0 and disp_created_ts.get(fd_id, 0.0) > (m_ts + 2.0):
                fd_id = ""
            m_subj = str(mr.get("subject") or "")
            m_body = str(mr.get("body") or "")
            msg_cls = _classify_p2p_message(m_type, m_subj, m_body)
            if msg_cls == "reject":
                targeted_dids: set[str] = set()
                to_val = str(mr.get("to_handle") or mr.get("to") or "").strip()
                if to_val and to_val in handle_to_disp:
                    targeted_dids.add(handle_to_disp[to_val])
                combined_txt = f"{m_subj} {m_body}"
                for cand_did in disp_role_map:
                    if cand_did and cand_did != fd_id and cand_did in combined_txt:
                        if m_ts <= 0 or disp_created_ts.get(cand_did, 0.0) <= (m_ts + 2.0):
                            targeted_dids.add(cand_did)
                for cand_slot, cand_did in slot_to_disp.items():
                    if cand_slot and cand_did != fd_id:
                        if re.search(rf"\b{re.escape(cand_slot)}(?!-\d)\b", combined_txt):
                            targeted_dids.add(cand_did)
                if not targeted_dids:
                    active_builders_at_ts = [
                        did_c
                        for did_c, r_p in disp_role_map.items()
                        if r_p in ("dev", "ui", "fix")
                        and did_c != fd_id
                        and (m_ts <= 0 or disp_created_ts.get(did_c, 0.0) <= (m_ts + 2.0))
                    ]
                    if len(active_builders_at_ts) == 1:
                        targeted_dids.add(active_builders_at_ts[0])
                if targeted_dids:
                    for td in targeted_dids:
                        if m_ts > latest_slot_reject_ts.get(td, 0.0):
                            latest_slot_reject_ts[td] = m_ts
                else:
                    if m_ts > latest_global_reject_ts:
                        latest_global_reject_ts = m_ts
            elif msg_cls == "ready" and fd_id:
                if m_ts >= latest_ready_ts_by_disp.get(fd_id, 0.0):
                    latest_ready_ts_by_disp[fd_id] = m_ts

        max_ready_ts_by_grp: dict[str, float] = {}
        for fd_id, r_ts in latest_ready_ts_by_disp.items():
            r_pref = disp_role_map.get(fd_id, "dev")
            r_grp = "builder" if r_pref in ("dev", "ui", "fix") else r_pref
            if r_ts > max_ready_ts_by_grp.get(r_grp, 0.0):
                max_ready_ts_by_grp[r_grp] = r_ts
        for d in dispatches_in_run:
            if d.get("isSucceeded"):
                did_v = str(d.get("dispatchId") or "").strip()
                r_pref = disp_role_map.get(did_v, str(d.get("rolePrefix") or "dev"))
                r_grp = "builder" if r_pref in ("dev", "ui", "fix") else r_pref
                comp_ts = max(
                    _to_epoch_secs(d.get("completedAt")),
                    _to_epoch_secs(d.get("createdAt")),
                )
                if comp_ts > max_ready_ts_by_grp.get(r_grp, 0.0):
                    max_ready_ts_by_grp[r_grp] = comp_ts
        for fd_id, r_ts in latest_ready_ts_by_disp.items():
            r_pref = disp_role_map.get(fd_id, "dev")
            r_grp = "builder" if r_pref in ("dev", "ui", "fix") else r_pref
            slot_rej_ts = latest_slot_reject_ts.get(fd_id, 0.0)
            if r_ts > 0 and r_ts > slot_rej_ts and max_ready_ts_by_grp.get(r_grp, 0.0) > latest_global_reject_ts:
                p2p_handoff_dispatch_ids.add(fd_id)
                p2p_ready_handoff_ts[fd_id] = r_ts

    def _is_live_dispatch_p2p_ready(d_item: dict) -> bool:
        """Kiểm tra xem một upstream dispatch đang LIVE có đủ điều kiện P2P-Ready để downstream merge hay không:
        1. Đã gửi bản tin `--type handoff` (vd: DEV_READY / INFRA_READY / CRITIC_VERDICT) sau bất kỳ bản tin QA_REJECT/SEC_BLOCK nào nhắm tới nó HOẶC caller truyền `--allow-live`/`--p2p`.
        2. Nếu có commit mới (`ahead_cnt > 0`), commit HEAD không mới hơn thời điểm gửi DEV_READY (tránh merge WIP commit ở vòng tiếp theo); nếu chưa gửi P2P handoff mà dùng `--allow-live` thì bắt buộc `ahead_cnt > 0`. Worktree phải sạch.
        """
        did_s = str(d_item.get("dispatchId") or "")
        br_s = str(d_item.get("branch") or "")
        wt_s = str(d_item.get("worktreePath") or "")
        if not br_s or br_s == main_branch:
            return False
        if to_main and not allow_live:
            return False
        if not allow_live and did_s not in p2p_handoff_dispatch_ids:
            return False
        try:
            rev_proc = subprocess.run(
                ["git", "-C", str(main_root), "rev-list", "--count", f"{main_branch}..{br_s}"],
                capture_output=True,
                text=True,
                timeout=3,
            )
            ahead_cnt = int((rev_proc.stdout or "0").strip() or "0") if rev_proc.returncode == 0 else 0
            d_item["aheadCount"] = ahead_cnt
            if ahead_cnt <= 0 and did_s not in p2p_handoff_dispatch_ids:
                return False
            if ahead_cnt > 0 and not allow_live and did_s in p2p_ready_handoff_ts and p2p_ready_handoff_ts[did_s] > 0:
                ct_proc = subprocess.run(
                    ["git", "-C", str(main_root), "log", "-1", "--format=%ct", br_s],
                    capture_output=True,
                    text=True,
                    timeout=3,
                )
                if ct_proc.returncode == 0:
                    head_ct = _to_epoch_secs((ct_proc.stdout or "0").strip())
                    if head_ct > p2p_ready_handoff_ts[did_s] + 10.0:
                        return False
            if wt_s and os.path.isdir(wt_s):
                st_proc = subprocess.run(
                    ["git", "-C", wt_s, "status", "--porcelain"],
                    capture_output=True,
                    text=True,
                    timeout=3,
                )
                if st_proc.returncode == 0 and (st_proc.stdout or "").strip():
                    return False
            return True
        except Exception:
            return False

    # Phân tích trạng thái upstream trong Run này
    blocking_active_upstream: list[dict] = []
    blocking_unstarted_upstream: list[dict] = []
    blocking_failed_upstream: list[dict] = []
    upstream_branches: list[str] = []
    upstream_dispatches: list[dict] = []

    dispatched_task_ids: set[str] = set()
    succeeded_task_ids: set[str] = set()
    succeeded_role_prefixes: set[str] = set()
    latest_dispatch_by_task: dict[str, dict] = {}
    latest_dispatch_by_slot: dict[str, dict] = {}

    for d in dispatches_in_run:
        tid = d.get("taskId") or ""
        slot_k = d.get("slotName") or d.get("branch") or d.get("dispatchId") or ""
        if not d.get("isSettled"):
            d["isP2PReady"] = _is_live_dispatch_p2p_ready(d)
        else:
            d["isP2PReady"] = False
            br_c = str(d.get("branch") or "")
            if br_c and br_c != main_branch:
                try:
                    rv_p = subprocess.run(
                        ["git", "-C", str(main_root), "rev-list", "--count", f"{main_branch}..{br_c}"],
                        capture_output=True, text=True, timeout=2,
                    )
                    d["aheadCount"] = int((rv_p.stdout or "0").strip() or "0") if rv_p.returncode == 0 else 1
                except Exception:
                    d["aheadCount"] = 1
        if slot_k:
            latest_dispatch_by_slot[slot_k] = d
        if tid:
            dispatched_task_ids.add(tid)
            latest_dispatch_by_task[tid] = d
        if d.get("isSucceeded") or d.get("isP2PReady"):
            if tid:
                succeeded_task_ids.add(tid)
            if d.get("rolePrefix"):
                succeeded_role_prefixes.add(d["rolePrefix"])

    for d in latest_dispatch_by_slot.values():
        did = d.get("dispatchId") or ""
        tid = d.get("taskId") or ""
        r_pref = d.get("rolePrefix") or ""
        br = d.get("branch") or ""

        # Bỏ qua chính dispatch/task hoặc nhánh hiện tại của caller
        if (resolved_dispatch_id and did == resolved_dispatch_id) or (resolved_task_id and tid == resolved_task_id):
            continue
        if is_in_worker_wt and caller_branch and br == caller_branch:
            continue

        if r_pref in active_blocking_prefixes:
            if not d.get("isSettled") and not d.get("isP2PReady"):
                blocking_active_upstream.append({
                    "dispatchId": did,
                    "taskId": tid,
                    "slot": d.get("slotName") or br,
                    "branch": br,
                    "role": r_pref,
                    "state": d.get("state"),
                })

        if r_pref in upstream_prefixes and (d.get("isSucceeded") or d.get("isP2PReady")) and br and br != main_branch:
            if int(d.get("aheadCount", 1)) > 0 and br not in upstream_branches:
                upstream_branches.append(br)
            upstream_dispatches.append({
                "dispatchId": did,
                "taskId": tid,
                "slot": d.get("slotName") or br,
                "branch": br,
                "role": r_pref,
                "isP2PReady": bool(d.get("isP2PReady")),
            })

    # Kiểm tra các task upstream trong cùng Run chưa từng được dispatch hoặc bị failed mà chưa có task/dispatch thay thế
    for tid, t_info in tasks_in_run.items():
        if resolved_task_id and tid == resolved_task_id:
            continue
        t_role = t_info.get("rolePrefix") or ""
        t_status = t_info.get("status") or ""
        if tid not in dispatched_task_ids and t_role in unstarted_blocking_prefixes and t_status in ("ready", "pending", "in_progress", "dispatched", "blocked", "todo"):
            blocking_unstarted_upstream.append({
                "taskId": tid,
                "title": t_info.get("title"),
                "role": t_role,
                "status": t_status,
            })
        elif tid in latest_dispatch_by_task and t_role in active_blocking_prefixes:
            ld = latest_dispatch_by_task[tid]
            if ld.get("isSettled") and not ld.get("isSucceeded") and tid not in succeeded_task_ids:
                # Nếu task đã bị canceled hoặc đã có một task cùng role chạy succeeded sau đó thì không chặn cứng
                if ld.get("state") not in ("canceled", "cancelled") and t_status not in ("cancelled", "canceled", "completed"):
                    blocking_failed_upstream.append({
                        "taskId": tid,
                        "dispatchId": ld.get("dispatchId"),
                        "slot": ld.get("slotName") or ld.get("branch"),
                        "role": t_role,
                        "state": ld.get("state"),
                    })

    requires_run_id = to_main or norm_role in ("devops", "sec", "qa", "bench")
    ready_to_merge = (
        (bool(resolved_run_id) or not requires_run_id)
        and len(blocking_active_upstream) == 0
        and len(blocking_unstarted_upstream) == 0
        and len(blocking_failed_upstream) == 0
    )

    pinned_plan_path = ""
    pinned_plan_content = ""
    if resolved_run_id:
        cand_plan = Path(main_root_real) / ".orca" / "runs" / resolved_run_id / "master-plan.md"
        if cand_plan.is_file():
            try:
                pinned_plan_path = str(cand_plan)
                pinned_plan_content = cand_plan.read_text(encoding="utf-8", errors="ignore").strip()
            except Exception:
                pass

    upstream_task_specs: list[dict] = []
    for tid, t_info in tasks_in_run.items():
        r_p = t_info.get("rolePrefix") or ""
        ld_slot = (latest_dispatch_by_task.get(tid) or {}).get("slotName") or (latest_dispatch_by_task.get(tid) or {}).get("branch") or ""
        raw_ut = (t_info.get("userTask") or "").strip()
        # Khi đã có Pinned Master Plan (hoặc userTask quá dài > 600 ký tự), thu gọn userTask trong JSON summary
        # để tránh nhân đôi 20,000+ chars khi gọi `plan show --json` / `merge-upstream --json`.
        if pinned_plan_content and len(raw_ut) > 360:
            raw_ut = raw_ut[:357].rstrip() + "..."
        elif len(raw_ut) > 900:
            raw_ut = raw_ut[:897].rstrip() + "..."
        upstream_task_specs.append({
            "taskId": tid,
            "role": r_p,
            "slot": ld_slot,
            "title": t_info.get("title") or "",
            "status": t_info.get("status") or "",
            "userTask": raw_ut,
        })

    peer_directory: list[dict] = []
    for slot_k, d_item in latest_dispatch_by_slot.items():
        peer_directory.append({
            "slot": slot_k,
            "role": d_item.get("rolePrefix") or "",
            "dispatchId": d_item.get("dispatchId") or "",
            "taskId": d_item.get("taskId") or "",
            "state": d_item.get("state") or "",
            "isSettled": bool(d_item.get("isSettled")),
            "isP2PReady": bool(d_item.get("isP2PReady")),
            "branch": d_item.get("branch") or "",
            "terminalHandle": d_item.get("terminalHandle") or "",
        })

    return {
        "runId": resolved_run_id,
        "runObjective": run_objective,
        "callerRole": norm_role,
        "toMain": to_main,
        "mainRoot": main_root_real,
        "mainBranch": main_branch,
        "callerWorktree": caller_wt_real,
        "callerBranch": caller_branch,
        "isInWorkerWorktree": is_in_worker_wt,
        "readyToMerge": ready_to_merge,
        "upstreamBranches": upstream_branches,
        "upstreamDispatches": upstream_dispatches,
        "blockingActiveUpstream": blocking_active_upstream,
        "blockingUnstartedUpstream": blocking_unstarted_upstream,
        "blockingFailedUpstream": blocking_failed_upstream,
        "pinnedPlanPath": pinned_plan_path,
        "pinnedPlanContent": pinned_plan_content,
        "upstreamTaskSpecs": upstream_task_specs,
        "peerDirectory": peer_directory,
    }


def _print_run_plan_and_peers_summary(info: dict, show_all_tasks: bool = False):
    """In tóm tắt Pinned Master Plan, Danh sách Hạng mục Task Specs [P1..Pn] và Peer Directory cho Worker.
    Chống rò rỉ token (Anti-Token-Leak):
    - Nếu cùng một Worker/Branch trong cùng Run gọi `merge-upstream` lần thứ 2+ (vd: vòng P2P 2/3), không in lặp lại
      toàn bộ 5,000+ ký tự `master-plan.md` và Checklist mà chỉ in dòng tham chiếu gọn + Danh bạ Peer-to-Peer mới nhất.
    - Với các Builder ở Wave 1 (`dev`, `ui`, `fix`, `re`) khi gọi `merge-upstream` (`show_all_tasks=False`), nếu `master-plan.md`
      quá dài (`> 2,200` ký tự) trong khi Worker đã có sẵn đặc tả nhiệm vụ chi tiết trong `step 0`, thu gọn phần hiển thị `master-plan.md`
      ở mức tổng quan (`<= 1,500` ký tự) kèm đường dẫn file `.orca/runs/<RUN_ID>/master-plan.md`."""
    run_id = info.get("runId") or "(unknown)"
    obj = (info.get("runObjective") or "").strip()
    pinned_content = (info.get("pinnedPlanContent") or "").strip()
    pinned_path = info.get("pinnedPlanPath") or ""
    task_specs = info.get("upstreamTaskSpecs") or []
    peers = info.get("peerDirectory") or []
    caller_role = (info.get("callerRole") or "").strip().lower()
    caller_branch = (info.get("callerBranch") or "").strip()
    main_root = info.get("mainRoot") or ""

    already_printed_for_caller = False
    cache_file = Path(main_root) / ".orca-cache" / "plan-printed.json" if (main_root and main_root != "/") else None
    cache_key = f"{run_id}:{caller_branch or caller_role or 'main'}"
    if not show_all_tasks and cache_file is not None and run_id != "(unknown)":
        try:
            if cache_file.is_file():
                c_data = json.loads(cache_file.read_text(encoding="utf-8", errors="ignore"))
                if isinstance(c_data, dict):
                    prev_ts = float(c_data.get(cache_key) or 0.0)
                    if (time.time() - prev_ts) < 7200.0:
                        already_printed_for_caller = True
        except Exception:
            pass

    if obj and not already_printed_for_caller:
        print(f"🎯 Mục tiêu Run ({run_id}): {obj}")

    if already_printed_for_caller:
        if pinned_path:
            print(f"📌 Pinned Master Plan ({pinned_path}) & Checklist [P1..Pn] đã hiển thị ở lượt trước (gõ `orca-team plan show` nếu cần xem lại).")
    else:
        if pinned_content:
            display_plan = pinned_content
            if not show_all_tasks and caller_role in ("dev", "ui", "fix", "re") and len(pinned_content) > 2200:
                display_plan = (
                    pinned_content[:1500].rstrip()
                    + f"\n... [Đã rút gọn {len(pinned_content) - 1500} ký tự chi tiết của các role khác để tiết kiệm token — xem đầy đủ tại: {pinned_path}]"
                )
            print(f"\n📌 BẢN KẾ HOẠCH ĐÃ GHIM (PINNED MASTER PLAN — {pinned_path}):")
            print("─" * 88)
            print(display_plan)
            print("─" * 88)

        relevant_specs = [
            ts for ts in task_specs
            if show_all_tasks or (ts.get("role") in ("dev", "ui", "fix", "devops", "critic", "re"))
        ]
        if relevant_specs:
            print(f"\n📋 CHECKLIST NHIỆM VỤ CÁC ROLE TRONG RUN {run_id} (CĂN CỨ ĐỂ QA/SEC/DEVOPS ĐỐI CHIẾU 100%):")
            for ts in relevant_specs:
                slot_lbl = f" [{ts.get('slot')}]" if ts.get("slot") else ""
                u_task = (ts.get("userTask") or ts.get("title") or "").strip().replace("\n", " ")
                max_u = 180 if pinned_content else 300
                if len(u_task) > max_u:
                    u_task = u_task[: max_u - 3].rstrip() + "..."
                print(f"   • [{ts.get('taskId')}] ({ts.get('role') or 'task'}{slot_lbl}, status={ts.get('status')}): {u_task}")

        if not show_all_tasks and cache_file is not None and run_id != "(unknown)" and (pinned_content or relevant_specs):
            try:
                cache_file.parent.mkdir(parents=True, exist_ok=True)
                c_data = {}
                if cache_file.is_file():
                    raw_c = json.loads(cache_file.read_text(encoding="utf-8", errors="ignore"))
                    if isinstance(raw_c, dict):
                        now_c = time.time()
                        c_data = {k: v for k, v in raw_c.items() if isinstance(v, (int, float)) and (now_c - float(v)) < 14400.0}
                c_data[cache_key] = time.time()
                cache_file.write_text(json.dumps(c_data, indent=2), encoding="utf-8")
            except Exception:
                pass

    if peers:
        print(f"\n📡 DANH BẠ PEER-TO-PEER TRONG RUN {run_id} (Dùng `--to dispatch:<ID>` hoặc `--to '@all'` kèm `--type handoff` khi giao tiếp nội bộ team):")
        for p in peers:
            if not p.get("isSettled"):
                p2p_lbl = " [P2P HANDOFF READY]" if p.get("isP2PReady") else ""
                live_tag = f"🟢 LIVE{p2p_lbl} (nhắn P2P bằng --type handoff)"
            else:
                live_tag = f"⚪ SETTLED ({p.get('state')})"
            print(
                f"   • {p.get('slot'):<16} ➔ dispatch:{p.get('dispatchId')} | branch={p.get('branch')} | {live_tag}"
            )


def cmd_plan(args: list, caller_dir: Path = None):
    """
    CLI:
      orca-team plan draft [--run <RUN_ID>] [--title <TITLE>] [--file <PATH> | --content <TEXT>] [--json]
      orca-team plan consensus [--run <RUN_ID>] [--plan-hash <H>] [--json]
      orca-team plan pin [--run <RUN_ID>] [--title <TITLE>] [--file <PATH> | --content <TEXT>] [--from-scratch] [--json]
      orca-team plan [show] [--run <RUN_ID>] [--task-id <TASK_ID>] [--dispatch-id <DISPATCH_ID>] [--json]
    """
    scripts_dir = Path(__file__).resolve().parent
    if str(scripts_dir) not in sys.path:
        sys.path.insert(0, str(scripts_dir))
    import orca_critic_gate as cg

    target_dir = (caller_dir or Path.cwd()).resolve()
    raw_list = list(args or [])
    sub = ""

    run_id = ""
    task_id = ""
    dispatch_id = ""
    terminal_handle = ""
    plan_title = ""
    file_path = ""
    plan_hash_arg = ""
    from_scratch = False
    content_parts: list[str] = []
    as_json = False
    after_double_dash = False

    idx = 0
    while idx < len(raw_list):
        tok = str(raw_list[idx])
        if after_double_dash:
            content_parts.append(tok)
            idx += 1
            continue
        if tok == "--":
            after_double_dash = True
            idx += 1
            continue
        if tok in ("-h", "--help", "help"):
            print(
                "Sử dụng:\n"
                "  orca-team plan draft [--run <RUN_ID>] [--title <TITLE>] [--file <PATH> | --content \"<PLAN_MD>\"] [--json]\n"
                "  orca-team plan consensus [--run <RUN_ID>] [--plan-hash <H>] [--json]\n"
                "  orca-team plan pin [--run <RUN_ID>] [--title <TITLE>] [--file <PATH> | --content \"<PLAN_MD>\"] [--from-scratch] [--json]\n"
                "  orca-team plan show [--run <RUN_ID>] [--task-id <TASK_ID>] [--dispatch-id <DISPATCH_ID>] [--json]"
            )
            return
        if not sub and not tok.startswith("-") and tok.lower() in (
            "draft", "consensus", "pin", "set", "save", "write", "show", "get", "view", "read", "status"
        ):
            t_low = tok.lower()
            if t_low == "draft":
                sub = "draft"
            elif t_low == "consensus":
                sub = "consensus"
            elif t_low in ("pin", "set", "save", "write"):
                sub = "pin"
            else:
                sub = "show"
            idx += 1
            continue
        if tok in ("--run", "--run-id") and idx + 1 < len(raw_list):
            run_id = str(raw_list[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--run=") or tok.startswith("--run-id="):
            run_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--plan-hash", "--hash") and idx + 1 < len(raw_list):
            plan_hash_arg = str(raw_list[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--plan-hash=") or tok.startswith("--hash="):
            plan_hash_arg = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok == "--from-scratch":
            from_scratch = True
            idx += 1
        elif tok in ("--task", "--task-id") and idx + 1 < len(raw_list):
            task_id = str(raw_list[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--task=") or tok.startswith("--task-id="):
            task_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--dispatch", "--dispatch-id") and idx + 1 < len(raw_list):
            dispatch_id = str(raw_list[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--dispatch=") or tok.startswith("--dispatch-id="):
            dispatch_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--terminal", "--from") and idx + 1 < len(raw_list):
            terminal_handle = str(raw_list[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--terminal=") or tok.startswith("--from="):
            terminal_handle = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--title", "-t") and idx + 1 < len(raw_list):
            plan_title = str(raw_list[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--title="):
            plan_title = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--file", "-f") and idx + 1 < len(raw_list):
            file_path = str(raw_list[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--file="):
            file_path = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--content", "-c", "--body") and idx + 1 < len(raw_list):
            content_parts.append(str(raw_list[idx + 1]))
            idx += 2
        elif tok.startswith("--content=") or tok.startswith("--body="):
            content_parts.append(tok.split("=", 1)[1])
            idx += 1
        elif tok == "--json":
            as_json = True
            idx += 1
        elif tok.startswith("run_") and not run_id:
            run_id = tok.strip()
            idx += 1
        else:
            content_parts.append(tok)
            idx += 1

    if not sub:
        sub = "pin" if (file_path or content_parts or plan_title) else "show"

    info = resolve_run_upstream_branches(
        target_dir,
        run_id=run_id,
        dispatch_id=dispatch_id,
        task_id=task_id,
        terminal_handle=terminal_handle,
    )
    resolved_run = info.get("runId") or run_id or "default"
    main_root = Path(info.get("mainRoot") or target_dir)
    run_dir = main_root / ".orca" / "runs" / resolved_run

    def _append_critic_audit(entry: dict) -> None:
        critic_d = run_dir / "critic"
        critic_d.mkdir(parents=True, exist_ok=True)
        audit_f = critic_d / "audit.jsonl"
        row_e = dict(entry)
        row_e.setdefault("ts", time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
        row_e.setdefault("runId", resolved_run)
        with open(audit_f, "a", encoding="utf-8") as af:
            af.write(json.dumps(row_e, ensure_ascii=False) + "\n")

    if sub in ("draft", "pin"):
        raw_plan = ""
        if file_path:
            fp = Path(file_path).expanduser()
            if not fp.is_file():
                print(f"❌ Không tìm thấy file kế hoạch: '{file_path}'.", file=sys.stderr)
                sys.exit(1)
            raw_plan = fp.read_text(encoding="utf-8", errors="ignore").strip()
        elif content_parts:
            raw_plan = " ".join(content_parts).replace("\\n", "\n").strip()
        elif not sys.stdin.isatty():
            raw_plan = sys.stdin.read().strip()

        if not raw_plan and sub == "pin" and (run_dir / "plan-draft.md").is_file():
            raw_plan = (run_dir / "plan-draft.md").read_text(encoding="utf-8", errors="ignore").strip()

        if not raw_plan:
            lines_auto = []
            if info.get("runObjective"):
                lines_auto.append(f"## Mục tiêu Run ({resolved_run})\n{info.get('runObjective')}\n")
            if info.get("upstreamTaskSpecs"):
                lines_auto.append("## Checklist Hạng Mục Bàn Giao Theo Task")
                for idx_t, ts in enumerate(info.get("upstreamTaskSpecs") or [], 1):
                    lines_auto.append(f"- **[P{idx_t}] ({ts.get('role') or 'task'} - `{ts.get('taskId')}`)**: {ts.get('userTask') or ts.get('title')}")
            raw_plan = "\n".join(lines_auto).strip()

        if not raw_plan:
            print("❌ Thiếu nội dung Master Plan (dùng --content \"...\", --file <path>, hoặc truyền qua stdin).", file=sys.stderr)
            sys.exit(1)

        _ensure_orca_dir_git_excluded(main_root)
        run_dir.mkdir(parents=True, exist_ok=True)
        header_title = plan_title or info.get("runObjective") or f"Master Plan — {resolved_run}"
        if not raw_plan.startswith("#"):
            formatted_plan = f"# 📌 Pinned Master Plan: {header_title}\n- **Run ID:** `{resolved_run}`\n\n{raw_plan}\n"
        else:
            formatted_plan = raw_plan.rstrip("\n") + "\n"

        items_extracted = cg.extract_items(formatted_plan)
        if not items_extracted:
            print("❌ [ORCA PLAN-ITEM GUARD] Kế hoạch thiếu danh sách hạng mục [P1..Pn]!", file=sys.stderr)
            sys.exit(1)
        for it in items_extracted:
            if not it.get("files"):
                print(
                    f"❌ [ORCA PLAN-ITEM GUARD] [{it['id']}] thiếu (files: ...) — bắt buộc khai báo file sở hữu để kiểm tra Disjoint File Ownership!",
                    file=sys.stderr,
                )
                sys.exit(1)

        contracts_list = cg.contract_lines(formatted_plan)
        computed_hash = cg.plan_hash(formatted_plan)
        computed_risk = cg.compute_risk(items_extracted, contracts_list)
        resolved_gates = cg.resolve_canonical_gate_commands(main_root, main_root, None, load_config(main_root) or {})
        canon_test_toks = cg.normalize_cmd_tokens(
            next((toks for k, toks in resolved_gates if k == "test"), ["python3", "-m", "unittest", "discover", "-s", "tests"])
        )
        canon_test_hash = cg.canonical_cmd_hash(canon_test_toks)
        items_v2 = [
            {
                "id": it["id"],
                "description": it["description"],
                "files": it["files"],
                "axes": ["ownership", "dbApiCompat"],
                "verify_cmd": canon_test_toks,
                "cmd_hash": canon_test_hash,
                "verify": {
                    "cmd": " ".join(canon_test_toks),
                    "test_pattern": rf"(?i)\btest[_\-]?{it['id'].lower()}\b",
                },
            }
            for it in items_extracted
        ]
        contracts_payload = {
            "runId": resolved_run,
            "title": header_title,
            "planHash": computed_hash,
            "riskLevel": computed_risk,
            "contracts": contracts_list,
            "verify_cmd": canon_test_toks,
            "test_allowlist": [],
            "items": items_v2,
        }

        if sub == "draft":
            draft_file = run_dir / "plan-draft.md"
            draft_contracts_file = run_dir / "plan-draft.contracts.json"
            draft_file.write_text(formatted_plan, encoding="utf-8")
            draft_contracts_file.write_text(json.dumps(contracts_payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
            _sync_orca_runs_into_child_worktrees(main_root)
            if as_json:
                print(
                    json.dumps(
                        {
                            "runId": resolved_run,
                            "draftPlanPath": str(draft_file),
                            "planHash": computed_hash,
                            "riskLevel": computed_risk,
                            "items": len(items_v2),
                        },
                        ensure_ascii=False,
                        indent=2,
                    )
                )
            else:
                print(f"PLAN_DRAFT_READY plan_hash={computed_hash} risk={computed_risk['level']} items={len(items_v2)}")
            return

        # sub == "pin"
        for existing_cp in (run_dir / "plan-draft.contracts.json", run_dir / "contracts.json"):
            if existing_cp.is_file():
                try:
                    ec_obj = json.loads(existing_cp.read_text(encoding="utf-8", errors="ignore"))
                except Exception:
                    ec_obj = {}
                if isinstance(ec_obj, dict):
                    ec_hash = str(ec_obj.get("planHash") or "").strip()
                    if ec_hash and ec_hash != computed_hash and not from_scratch:
                        print(
                            f"❌ [ORCA PLAN BINDING GUARD] Plan đã đổi sau khi duyệt: duyệt {ec_hash}, hiện {computed_hash}. Chạy lại critic (hoặc dùng --from-scratch để xoá consensus cũ).",
                            file=sys.stderr,
                        )
                        sys.exit(1)
                    if isinstance(ec_obj.get("riskLevel"), dict) and not from_scratch:
                        ec_lvl = str(ec_obj["riskLevel"].get("level") or "").strip().lower()
                        if ec_lvl and ec_lvl != computed_risk["level"]:
                            print(
                                f"❌ [ORCA RISK BINDING GUARD] riskLevel trong '{existing_cp.name}' ('{ec_lvl}') đã bị sửa lệch với risk tính từ plan ('{computed_risk['level']}')!",
                                file=sys.stderr,
                            )
                            sys.exit(2)
        draft_contracts_file = run_dir / "plan-draft.contracts.json"
        if draft_contracts_file.is_file():
            try:
                dc_obj = json.loads(draft_contracts_file.read_text(encoding="utf-8", errors="ignore"))
                draft_h = str((dc_obj or {}).get("planHash") or "").strip()
            except Exception:
                draft_h = ""
            if draft_h and draft_h != computed_hash:
                if not from_scratch:
                    print(
                        f"❌ [ORCA PLAN BINDING GUARD] Plan đã đổi sau khi duyệt: duyệt {draft_h}, hiện {computed_hash}. Chạy lại critic (hoặc dùng --from-scratch để xoá consensus cũ).",
                        file=sys.stderr,
                    )
                    sys.exit(1)
                cons_p = run_dir / "consensus.json"
                if cons_p.is_file():
                    cons_p.unlink()
                draft_contracts_file.write_text(json.dumps(contracts_payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
                (run_dir / "plan-draft.md").write_text(formatted_plan, encoding="utf-8")

        plan_file = run_dir / "master-plan.md"
        plan_file.write_text(formatted_plan, encoding="utf-8")
        latest_file = main_root / ".orca" / "runs" / "latest-master-plan.md"
        try:
            latest_file.write_text(formatted_plan, encoding="utf-8")
        except Exception:
            pass

        hist_dir = run_dir / "plan-history"
        hist_dir.mkdir(parents=True, exist_ok=True)
        h_hex = computed_hash.split(":", 1)[-1]
        (hist_dir / f"{h_hex}.md").write_text(formatted_plan, encoding="utf-8")

        # C-FIX-13 & C-FIX-27: Write 0600 HMAC-signed policy anchor outside the worktree + .orca/acceptance-manifest.json at plan pin
        try:
            ev_base_pin = Path(os.environ.get("ORCA_EVIDENCE_DIR", "").strip() or str(Path.home() / ".orca" / "evidence"))
            pin_patterns = {
                str(it["id"]): str(it["verify"]["test_pattern"])
                for it in items_v2
                if isinstance(it, dict) and it.get("id") and isinstance(it.get("verify"), dict)
            }
            pin_gates = resolved_gates or [("test", canon_test_toks)]
            _, manifest_sha = cg.write_pinned_policy_anchor(
                ev_base_pin,
                resolved_run,
                computed_hash,
                pin_gates,
                pin_patterns,
                contracts_payload.get("test_allowlist") or [],
                worktree_dir=main_root,
                run_dir=run_dir,
            )
            if manifest_sha and manifest_sha.startswith("sha256:"):
                contracts_payload["manifestSha256"] = manifest_sha
                contracts_payload["acceptanceCommands"] = [
                    {"kind": k, "cmd": cg.normalize_cmd_tokens(toks), "cmd_hash": cg.canonical_cmd_hash(toks)}
                    for k, toks in pin_gates
                ]
                contracts_payload["baselineTestFiles"] = cg.compute_baseline_test_files(main_root)
        except Exception:
            pass
        (run_dir / "contracts.json").write_text(
            json.dumps(contracts_payload, ensure_ascii=False, indent=2) + "\n",
            encoding="utf-8",
        )
        if "--contracts" in raw_list:
            docs_c_dir = main_root / "docs" / "orca-contracts"
            docs_c_dir.mkdir(parents=True, exist_ok=True)
            (docs_c_dir / f"{resolved_run}.md").write_text(formatted_plan, encoding="utf-8")

        _sync_orca_runs_into_child_worktrees(main_root)

        if as_json:
            print(
                json.dumps(
                    {
                        "runId": resolved_run,
                        "pinnedPlanPath": str(plan_file),
                        "planHash": computed_hash,
                        "riskLevel": computed_risk,
                        "content": formatted_plan.strip(),
                    },
                    ensure_ascii=False,
                    indent=2,
                )
            )
        else:
            print(
                f"📌 [Run {resolved_run}] Đã ghim Pinned Master Plan tại: {plan_file} "
                f"(plan_hash={computed_hash}, risk={computed_risk['level']}, reasons={','.join(computed_risk['reasons'])})"
            )
        return

    if sub == "consensus":
        # C-FIX-03 & C-FIX-20..C-FIX-24: Projection of Critic Consensus from SQLite messages + question_threads
        import sqlite3

        contracts_obj: dict = {}
        loaded_contracts_files: list[tuple[str, dict]] = []
        for cp in (run_dir / "contracts.json", run_dir / "plan-draft.contracts.json"):
            if cp.is_file():
                try:
                    c_loaded = json.loads(cp.read_text(encoding="utf-8", errors="ignore"))
                    if isinstance(c_loaded, dict):
                        loaded_contracts_files.append((cp.name, c_loaded))
                        if not contracts_obj:
                            contracts_obj = c_loaded
                except Exception:
                    continue

        if not (run_dir / "plan-draft.contracts.json").is_file() or not (run_dir / "plan-draft.md").is_file():
            _append_critic_audit({"ok": False, "error": "missing_plan_draft_artifacts"})
            print(
                json.dumps(
                    {
                        "ok": False,
                        "error": "missing_plan_draft_artifacts",
                        "message": "[ORCA PLAN BINDING GUARD] Thiếu plan-draft.contracts.json / plan-draft.md do 'orca-team plan draft' khởi tạo!",
                    },
                    ensure_ascii=False,
                )
            )
            sys.exit(2)

        plan_txt = ""
        for pp in (run_dir / "master-plan.md", run_dir / "plan-draft.md"):
            if pp.is_file():
                plan_txt = pp.read_text(encoding="utf-8", errors="ignore")
                break

        if not plan_txt:
            _append_critic_audit({"ok": False, "error": "missing_plan_file"})
            print(json.dumps({"ok": False, "error": "missing_plan_file"}, ensure_ascii=False))
            sys.exit(2)

        actual_h = cg.plan_hash(plan_txt)
        expected_h = plan_hash_arg or str(contracts_obj.get("planHash") or "").strip() or actual_h
        if actual_h != expected_h:
            _append_critic_audit({"ok": False, "error": "plan_hash_mismatch", "expected": expected_h, "actual": actual_h})
            print(
                json.dumps(
                    {
                        "ok": False,
                        "error": "plan_hash_mismatch",
                        "message": f"[ORCA PLAN BINDING GUARD] Plan đã đổi sau khi duyệt: duyệt {expected_h}, hiện {actual_h}. Chạy lại critic.",
                    },
                    ensure_ascii=False,
                )
            )
            sys.exit(2)

        # C-FIX-20: Always compute risk directly from plan_txt and block if any contracts file downgraded/modified riskLevel
        items_ext = cg.extract_items(plan_txt)
        contracts_ext = cg.contract_lines(plan_txt)
        computed_risk = cg.compute_risk(items_ext, contracts_ext)
        actual_risk_level = str(computed_risk.get("level") or "high").lower()
        for c_name, c_dict in loaded_contracts_files:
            rl_obj = c_dict.get("riskLevel")
            if isinstance(rl_obj, dict):
                file_lvl = str(rl_obj.get("level") or "").strip().lower()
                if file_lvl and file_lvl != actual_risk_level:
                    msg_err = (
                        f"[ORCA RISK BINDING GUARD] riskLevel trong '{c_name}' ('{file_lvl}') "
                        f"lệch với risk thực tế tính từ plan ('{actual_risk_level}')!"
                    )
                    _append_critic_audit({"ok": False, "error": "risk_level_mismatch", "file": c_name, "fileLevel": file_lvl, "computedLevel": actual_risk_level})
                    print(json.dumps({"ok": False, "error": "risk_level_mismatch", "message": msg_err}, ensure_ascii=False))
                    sys.exit(2)

        db_path = _find_orca_orchestration_db()
        if not db_path or not db_path.is_file():
            _append_critic_audit({"ok": False, "error": "missing_db", "planHash": expected_h})
            print(json.dumps({"ok": False, "error": "missing_db"}, ensure_ascii=False))
            sys.exit(3)

        try:
            conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=2.0)
            conn.row_factory = sqlite3.Row
            dc_rows = conn.execute(
                "SELECT dc.id AS did, dc.assignee_handle, wd.agent_terminal_handle, wd.worktree_id, t.task_title, t.spec "
                "FROM dispatch_contexts dc "
                "INNER JOIN worker_dispatches wd ON wd.dispatch_id = dc.id "
                "LEFT JOIN tasks t ON t.id = dc.task_id "
                "WHERE dc.run_id = ? ORDER BY dc.created_at DESC",
                (resolved_run,),
            ).fetchall()
            # C-FIX-21: Never hardcode 'critic-worker' or infer from worktree_id substring;
            # bind strictly to task role in DB (_infer_task_role_prefix == 'critic') + worker_dispatches.agent_terminal_handle
            critic_dids: list[str] = []
            critic_handles: set[str] = set()
            for r in dc_rows:
                t_role = _infer_task_role_prefix(str(r["task_title"] or ""), str(r["spec"] or ""))
                t_h = str(r["agent_terminal_handle"] or "").strip()
                if t_role == "critic" and t_h:
                    critic_dids.append(str(r["did"]))
                    critic_handles.add(t_h)
                    critic_handles.add(f"dispatch:{r['did']}")

            msgs = conn.execute(
                "SELECT rowid AS r_idx, * FROM messages WHERE run_id = ? ORDER BY created_at ASC, rowid ASC",
                (resolved_run,),
            ).fetchall()
            qt_rows = conn.execute(
                "SELECT * FROM question_threads WHERE run_id = ? ORDER BY created_at ASC",
                (resolved_run,),
            ).fetchall()
            conn.close()
        except Exception as exc:
            _append_critic_audit({"ok": False, "error": f"db_error:{exc}", "planHash": expected_h})
            print(json.dumps({"ok": False, "error": f"db_error:{exc}"}, ensure_ascii=False))
            sys.exit(3)

        if not critic_dids or not critic_handles:
            _append_critic_audit({"ok": False, "error": "no_critic_dispatch", "planHash": expected_h})
            print(json.dumps({"ok": False, "error": "no_critic_dispatch"}, ensure_ascii=False))
            sys.exit(3)

        # C-FIX-21 & C-FIX-24: Bind challenges and replies to verified question_threads of the critic dispatch
        qt_by_challenge: dict[str, dict] = {}
        for q in qt_rows:
            q_did = str(q["dispatch_id"] or "").strip()
            q_asker = str(q["asker_handle"] or "").strip()
            q_status = str(q["status"] or "").strip().lower()
            q_mid = str(q["message_id"] or "").strip()
            q_ans = str(q["answer_message_id"] or "").strip()
            q_cat = str(q["created_at"] or "").strip()
            q_aat = str(q["answered_at"] or "").strip()
            if (
                q_did in critic_dids
                and q_asker in critic_handles
                and q_status in ("answered", "resolved", "closed")
                and q_mid
                and q_ans
                and (not (q_cat and q_aat) or q_aat > q_cat)
            ):
                qt_by_challenge[q_mid] = dict(q)

        challenges = [
            m for m in msgs
            if str(m["id"] or "") in qt_by_challenge
            and str(m["from_handle"] or "") in critic_handles
            and str(m["to_handle"] or "") not in critic_handles
            and str(m["type"] or "").lower() == "question"
            and "CRITIC_CHALLENGE" in str(m["body"] or "")
        ]
        expected_answer_to_challenge = {
            str(qt_by_challenge[str(c["id"])]["answer_message_id"]): str(c["id"])
            for c in challenges
        }
        replies = [
            m for m in msgs
            if str(m["id"] or "") in expected_answer_to_challenge
            and str(m["from_handle"] or "").lower() in ("leader", "coordinator", "orca", f"run:{resolved_run}".lower())
            and str(m["to_handle"] or "") in critic_handles
            and str(m["thread_id"] or "") == expected_answer_to_challenge[str(m["id"] or "")]
            and len(str(m["body"] or "").strip()) >= 60
        ]
        finals = [
            m for m in msgs
            if str(m["from_handle"] or "") in critic_handles
            and str(m["type"] or "").lower() in ("handoff", "worker_done")
            and "CRITIC_VERDICT" in str(m["body"] or "")
        ]

        if not challenges or not replies or not finals:
            _append_critic_audit(
                {
                    "ok": False,
                    "error": "incomplete_or_unverified_message_chain",
                    "planHash": expected_h,
                    "challenges": len(challenges),
                    "replies": len(replies),
                    "finals": len(finals),
                }
            )
            print(
                json.dumps(
                    {
                        "ok": False,
                        "error": "incomplete_or_unverified_message_chain",
                        "challenges": len(challenges),
                        "replies": len(replies),
                        "finals": len(finals),
                    },
                    ensure_ascii=False,
                )
            )
            sys.exit(3)

        final_m = next(
            (m for m in reversed(finals) if isinstance(cg.extract_review_json_from_body(str(m["body"] or "")), dict)),
            finals[-1],
        )
        final_ts = str(final_m["created_at"] or "")
        final_body = str(final_m["body"] or "")

        for ch in challenges:
            ch_id = str(ch["id"] or "")
            ch_ts = str(ch["created_at"] or "")
            if ch_ts > final_ts:
                _append_critic_audit({"ok": False, "error": "challenge_after_final", "planHash": expected_h})
                print(json.dumps({"ok": False, "error": "challenge_after_final"}, ensure_ascii=False))
                sys.exit(3)
            has_rep = any(
                str(rp["thread_id"] or "") == ch_id and ch_ts <= str(rp["created_at"] or "") <= final_ts
                for rp in replies
            )
            if not has_rep:
                _append_critic_audit({"ok": False, "error": f"unanswered_challenge:{ch_id}", "planHash": expected_h})
                print(json.dumps({"ok": False, "error": f"unanswered_challenge:{ch_id}"}, ensure_ascii=False))
                sys.exit(3)

        if expected_h not in final_body:
            _append_critic_audit({"ok": False, "error": "missing_plan_hash_in_final", "planHash": expected_h})
            print(json.dumps({"ok": False, "error": "missing_plan_hash_in_final"}, ensure_ascii=False))
            sys.exit(3)

        valid_reply_ids = {str(r["id"]) for r in replies}
        if not any(rid in final_body for rid in valid_reply_ids):
            _append_critic_audit({"ok": False, "error": "missing_answer_message_id_in_final", "planHash": expected_h})
            print(json.dumps({"ok": False, "error": "missing_answer_message_id_in_final", "expectedOneOf": sorted(valid_reply_ids)}, ensure_ascii=False))
            sys.exit(3)

        # C-FIX-22: Parse review JSON EXCLUSIVELY from final_body fenced block (NEVER fallback to file on disk!)
        review_obj = cg.extract_review_json_from_body(final_body)
        if not isinstance(review_obj, dict):
            _append_critic_audit({"ok": False, "error": "missing_or_invalid_review_json_in_body", "planHash": expected_h})
            print(
                json.dumps(
                    {
                        "ok": False,
                        "error": "missing_or_invalid_review_json_in_body",
                        "message": "[ORCA CONSENSUS PROVENANCE GUARD] Bản tin handoff cuối của Critic không chứa khối ```json ... ``` review hợp lệ (cấm fallback đọc từ file rời)!",
                    },
                    ensure_ascii=False,
                )
            )
            sys.exit(3)

        hyp_obj = None
        hyp_file = run_dir / "critic" / "hypothesis.json"
        if hyp_file.is_file():
            try:
                hyp_obj = json.loads(hyp_file.read_text(encoding="utf-8", errors="ignore"))
            except Exception:
                hyp_obj = None

        hyp_md_file = run_dir / "critic" / "hypothesis.md"
        hyp_md_txt = hyp_md_file.read_text(encoding="utf-8", errors="ignore") if hyp_md_file.is_file() else ""
        first_challenge_at = min(str(c["created_at"] or "") for c in challenges)

        viols = cg.validate_review(review_obj, plan_txt, computed_risk, valid_reply_ids=valid_reply_ids)
        viols.extend(
            cg.validate_independence(
                review_obj,
                plan_txt,
                hyp_obj,
                computed_risk,
                hypothesis_md_text=hyp_md_txt,
                first_challenge_at=first_challenge_at,
            )
        )
        if viols:
            _append_critic_audit({"ok": False, "error": "review_validation_failed", "planHash": expected_h, "violations": viols})
            print(json.dumps({"ok": False, "error": "review_validation_failed", "violations": viols}, ensure_ascii=False, indent=2))
            sys.exit(3)

        h_hex = expected_h.split(":", 1)[-1]
        rev_file = run_dir / "critic" / f"review-{h_hex}.json"
        (run_dir / "critic").mkdir(parents=True, exist_ok=True)
        rev_file.write_text(json.dumps(review_obj, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")

        verdict_val = str(review_obj.get("verdict") or "CONSENSUS_REACHED")
        msg_ids_obj = {
            "challenges": [str(c["id"]) for c in challenges],
            "replies": [str(r["id"]) for r in replies],
            "final": str(final_m["id"]),
        }
        consensus_payload = {
            "schema": cg.CONSENSUS_SCHEMA,
            "runId": resolved_run,
            "planHash": expected_h,
            "risk": computed_risk,
            "verdict": verdict_val,
            "criticDispatchId": critic_dids[0],
            "messageIds": msg_ids_obj,
            "reviewFile": f".orca/runs/{resolved_run}/critic/review-{h_hex}.json",
            "createdAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        }
        (run_dir / "consensus.json").write_text(json.dumps(consensus_payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        _append_critic_audit(
            {
                "ok": True,
                "planHash": expected_h,
                "verdict": verdict_val,
                "deadlock": verdict_val == "DEADLOCK",
                "messageIds": msg_ids_obj,
            }
        )
        _sync_orca_runs_into_child_worktrees(main_root)

        if as_json:
            print(json.dumps(consensus_payload, ensure_ascii=False, indent=2))
        else:
            print(f"✅ [CRITIC CONSENSUS PROJECTED] Run={resolved_run} planHash={expected_h} verdict={verdict_val}")
        return

    # sub == "show"
    try:
        _ensure_orca_dir_git_excluded(main_root)
        _sync_orca_runs_into_child_worktrees(main_root)
        if info.get("isInWorkerWorktree") and info.get("callerWorktree"):
            _strip_leader_directives_in_child_worktree(Path(info["callerWorktree"]), main_root)
    except Exception:
        pass
    if as_json:
        print(json.dumps(info, ensure_ascii=False, indent=2))
        return
    _print_run_plan_and_peers_summary(info, show_all_tasks=True)
    if not info.get("pinnedPlanContent") and not info.get("upstreamTaskSpecs"):
        print(f"ℹ️ Run '{resolved_run}' hiện chưa có Pinned Master Plan hoặc Task nào.")


def cmd_kb(args: list, caller_dir: Path = None):
    """
    CLI: orca-team kb [index|01|02|03|04|05|<từ-khóa>]
    Tra cứu nhanh Cẩm nang System Engineering cho Quân sư `critic-worker`.
    """
    kb_dirs = [
        (caller_dir or Path.cwd()).resolve() / "knowledge" / "system-engineer",
        Path(__file__).resolve().parent.parent / "knowledge" / "system-engineer",
        Path.home() / ".orca" / "knowledge" / "system-engineer",
    ]
    kb_dir = next((d for d in kb_dirs if d.is_dir()), None)
    if kb_dir is None:
        print("❌ Không tìm thấy thư mục knowledge/system-engineer.", file=sys.stderr)
        sys.exit(1)

    query = " ".join(args or []).strip().lower()
    if not query or query in ("index", "list", "ls", "all", "-h", "--help", "help"):
        idx_file = kb_dir / "INDEX.md"
        if idx_file.is_file():
            print(idx_file.read_text(encoding="utf-8", errors="ignore").strip())
            return

    topic_map = {
        "01": "01-distributed-systems-consensus.md",
        "1": "01-distributed-systems-consensus.md",
        "distributed": "01-distributed-systems-consensus.md",
        "consensus": "01-distributed-systems-consensus.md",
        "idempotency": "01-distributed-systems-consensus.md",
        "outbox": "01-distributed-systems-consensus.md",
        "02": "02-data-storage-indexing-consistency.md",
        "2": "02-data-storage-indexing-consistency.md",
        "data": "02-data-storage-indexing-consistency.md",
        "db": "02-data-storage-indexing-consistency.md",
        "index": "02-data-storage-indexing-consistency.md",
        "indexing": "02-data-storage-indexing-consistency.md",
        "migration": "02-data-storage-indexing-consistency.md",
        "03": "03-reliability-sre-observability.md",
        "3": "03-reliability-sre-observability.md",
        "sre": "03-reliability-sre-observability.md",
        "reliability": "03-reliability-sre-observability.md",
        "timeout": "03-reliability-sre-observability.md",
        "logs": "03-reliability-sre-observability.md",
        "04": "04-security-zero-trust-architecture.md",
        "4": "04-security-zero-trust-architecture.md",
        "sec": "04-security-zero-trust-architecture.md",
        "security": "04-security-zero-trust-architecture.md",
        "zerotrust": "04-security-zero-trust-architecture.md",
        "05": "05-performance-capacity-scalability.md",
        "5": "05-performance-capacity-scalability.md",
        "perf": "05-performance-capacity-scalability.md",
        "performance": "05-performance-capacity-scalability.md",
        "scale": "05-performance-capacity-scalability.md",
        "06": "06-frontend-ui-parity-and-realtime-isolation.md",
        "6": "06-frontend-ui-parity-and-realtime-isolation.md",
        "ui": "06-frontend-ui-parity-and-realtime-isolation.md",
        "frontend": "06-frontend-ui-parity-and-realtime-isolation.md",
        "figma": "06-frontend-ui-parity-and-realtime-isolation.md",
        "design": "06-frontend-ui-parity-and-realtime-isolation.md",
        "i18n": "06-frontend-ui-parity-and-realtime-isolation.md",
        "realtime": "06-frontend-ui-parity-and-realtime-isolation.md",
    }
    tokens = [t.strip().lower() for raw_a in (args or []) for t in raw_a.split(",") if t.strip()]
    matched_files: list[Path] = []
    seen_names: set[str] = set()
    for tok in tokens:
        t_name = topic_map.get(tok)
        if not t_name:
            for f in sorted(kb_dir.glob("*.md")):
                if f.name != "INDEX.md" and tok in f.name.lower():
                    t_name = f.name
                    break
        if t_name and t_name not in seen_names and (kb_dir / t_name).is_file():
            seen_names.add(t_name)
            matched_files.append(kb_dir / t_name)

    if matched_files:
        # Giới hạn tối đa 2 cẩm nang mỗi lần gọi để tổng output luôn < 9KB (không bị cắt cụt 10KB)
        out_chunks = [mf.read_text(encoding="utf-8", errors="ignore").strip() for mf in matched_files[:2]]
        print("\n\n---\n\n".join(out_chunks))
        return

    target_file = kb_dir / "INDEX.md"
    if target_file.is_file():
        print(target_file.read_text(encoding="utf-8", errors="ignore").strip())
    else:
        print(f"❌ Không tìm thấy chủ đề '{query}' trong {kb_dir}.", file=sys.stderr)
        sys.exit(1)


def _git_merge_branch_safe(git_cwd: Path, branch_name: str, abort_on_conflict: bool = True) -> tuple[int, str, list[str], list[str]]:
    """Chạy `git merge --no-edit <branch_name>` an toàn:
    1) Nếu lỗi do 'untracked working tree files would be overwritten by merge', tự động dọn các file untracked gây va chạm và thử lại 1 lần.
    2) Nếu xảy ra xung đột (CONFLICT), thu thập danh sách file xung đột và tự động chạy `git merge --abort` (khi abort_on_conflict=True)
       để không bao giờ để lại MERGE_HEAD bẩn trên nhánh main hoặc worktree của QA/Sec/Bench."""
    cleaned_untracked: list[str] = []
    conflict_files: list[str] = []
    git_cwd_real = os.path.realpath(str(git_cwd))

    proc = subprocess.run(
        ["git", "merge", "--no-edit", branch_name],
        cwd=str(git_cwd),
        capture_output=True,
        text=True,
    )
    if proc.returncode == 0:
        return 0, "", [], []

    combined_out = f"{proc.stderr or ''}\n{proc.stdout or ''}"
    if "untracked working tree files would be overwritten by merge" in combined_out.lower():
        cand_rels: list[str] = []
        in_untracked_block = False
        for raw_ln in combined_out.splitlines():
            ln_low = raw_ln.strip().lower()
            if "untracked working tree files would be overwritten by merge" in ln_low:
                in_untracked_block = True
                continue
            if in_untracked_block:
                if (
                    ln_low.startswith("please move or remove")
                    or ln_low.startswith("aborting")
                    or ln_low.startswith("merge with strategy")
                    or ln_low.startswith("error:")
                    or ln_low.startswith("fatal:")
                ):
                    break
                rel_p = raw_ln.strip()
                if rel_p:
                    cand_rels.append(rel_p)
        if not cand_rels:
            try:
                p_untr = subprocess.run(
                    ["git", "ls-files", "--others", "--exclude-standard"],
                    cwd=str(git_cwd),
                    capture_output=True,
                    text=True,
                )
                p_diff = subprocess.run(
                    ["git", "diff", "--name-only", f"HEAD..{branch_name}"],
                    cwd=str(git_cwd),
                    capture_output=True,
                    text=True,
                )
                untr_set = {x.strip() for x in (p_untr.stdout or "").splitlines() if x.strip()}
                diff_set = {x.strip() for x in (p_diff.stdout or "").splitlines() if x.strip()}
                cand_rels = sorted(untr_set & diff_set)
            except Exception:
                cand_rels = []

        for rel_p in cand_rels:
            full_p = os.path.realpath(os.path.join(git_cwd_real, rel_p))
            if full_p.startswith(git_cwd_real + os.sep) and os.path.lexists(full_p):
                try:
                    if os.path.isdir(full_p) and not os.path.islink(full_p):
                        shutil.rmtree(full_p, ignore_errors=True)
                    else:
                        os.unlink(full_p)
                    cleaned_untracked.append(rel_p)
                except OSError:
                    pass

        if cleaned_untracked:
            proc = subprocess.run(
                ["git", "merge", "--no-edit", branch_name],
                cwd=str(git_cwd),
                capture_output=True,
                text=True,
            )
            if proc.returncode == 0:
                return 0, "", [], cleaned_untracked
            combined_out = f"{proc.stderr or ''}\n{proc.stdout or ''}"

    try:
        p_cf = subprocess.run(
            ["git", "diff", "--name-only", "--diff-filter=U"],
            cwd=str(git_cwd),
            capture_output=True,
            text=True,
        )
        conflict_files = [x.strip() for x in (p_cf.stdout or "").splitlines() if x.strip()]
    except Exception:
        conflict_files = []

    if abort_on_conflict:
        try:
            subprocess.run(
                ["git", "merge", "--abort"],
                cwd=str(git_cwd),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except Exception:
            pass

    err_msg = (proc.stderr or proc.stdout or "").strip()
    return proc.returncode or 1, err_msg, conflict_files, cleaned_untracked


def cmd_merge_upstream(args: list, caller_dir: Path = None):
    """
    CLI: orca-team merge-upstream [--run <RUN_ID>] [--dispatch <CTX_ID>] [--task <TASK_ID>]
         [--terminal <TERM_ID>] [--role <ROLE>] [--to-main] [--allow-live|--p2p]
         [--from-branch <BRANCH>] [--keep-conflict]
         [--wait|--no-wait] [--wait-timeout <SECS>] [--check-only|--list-only] [--json]
    Đồng bộ (git merge --no-edit) nhánh gốc (main/develop) và CHỈ các nhánh upstream thuộc ĐÚNG Run hiện tại
    sau khi đã xác minh 100% upstream worker trong cùng Run đã hoàn tất (succeeded) hoặc đã gửi P2P handoff (DEV_READY).
    """
    target_dir = (caller_dir or Path.cwd()).resolve()
    run_id = ""
    dispatch_id = ""
    task_id = ""
    terminal_handle = ""
    role_str = ""
    to_main = False
    allow_live = False
    check_only = False
    list_only = False
    as_json = False
    explicit_wait = False
    no_wait = False
    wait_timeout = 1800.0
    explicit_branches: list[str] = []
    keep_conflict = False

    idx = 0
    while idx < len(args):
        tok = str(args[idx])
        if tok in ("-h", "--help", "help"):
            print(
                "Sử dụng: orca-team merge-upstream [--role <dev|ui|devops|sec|qa|bench>] [--run <RUN_ID>]\n"
                "         [--task-id <TASK_ID>] [--dispatch-id <DISPATCH_ID>] [--terminal <HANDLE>]\n"
                "         [--from-branch <BRANCH>] [--keep-conflict]\n"
                "         [--to-main] [--allow-live|--p2p] [--wait|--no-wait] [--wait-timeout <SECS>]\n"
                "         [--check-only] [--list-only] [--json]"
            )
            return
        if tok in ("--run", "--run-id") and idx + 1 < len(args):
            run_id = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--run=") or tok.startswith("--run-id="):
            run_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--dispatch", "--dispatch-id") and idx + 1 < len(args):
            dispatch_id = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--dispatch=") or tok.startswith("--dispatch-id="):
            dispatch_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--task", "--task-id") and idx + 1 < len(args):
            task_id = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--task=") or tok.startswith("--task-id="):
            task_id = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--terminal", "--from") and idx + 1 < len(args):
            terminal_handle = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--terminal=") or tok.startswith("--from="):
            terminal_handle = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--role", "-r") and idx + 1 < len(args):
            role_str = str(args[idx + 1]).strip()
            idx += 2
        elif tok.startswith("--role="):
            role_str = tok.split("=", 1)[1].strip()
            idx += 1
        elif tok in ("--from-branch", "--peer", "--peer-branch") and idx + 1 < len(args):
            for b_item in str(args[idx + 1]).split(","):
                b_clean = b_item.strip()
                if b_clean and b_clean not in explicit_branches:
                    explicit_branches.append(b_clean)
            idx += 2
        elif tok.startswith("--from-branch=") or tok.startswith("--peer=") or tok.startswith("--peer-branch="):
            for b_item in tok.split("=", 1)[1].split(","):
                b_clean = b_item.strip()
                if b_clean and b_clean not in explicit_branches:
                    explicit_branches.append(b_clean)
            idx += 1
        elif tok == "--keep-conflict":
            keep_conflict = True
            idx += 1
        elif tok == "--to-main":
            to_main = True
            idx += 1
        elif tok in ("--allow-live", "--p2p"):
            allow_live = True
            idx += 1
        elif tok == "--wait":
            explicit_wait = True
            no_wait = False
            idx += 1
        elif tok == "--no-wait":
            no_wait = True
            explicit_wait = False
            idx += 1
        elif tok == "--wait-timeout" and idx + 1 < len(args):
            try:
                wait_timeout = max(0.5, float(args[idx + 1]))
            except Exception:
                pass
            idx += 2
        elif tok.startswith("--wait-timeout="):
            try:
                wait_timeout = max(0.5, float(tok.split("=", 1)[1]))
            except Exception:
                pass
            idx += 1
        elif tok == "--check-only":
            check_only = True
            idx += 1
        elif tok == "--list-only":
            list_only = True
            idx += 1
        elif tok == "--json":
            as_json = True
            idx += 1
        else:
            idx += 1

    info = resolve_run_upstream_branches(
        target_dir,
        run_id=run_id,
        dispatch_id=dispatch_id,
        task_id=task_id,
        terminal_handle=terminal_handle,
        caller_role=role_str,
        to_main=to_main,
        allow_live=allow_live,
    )
    if explicit_branches:
        up_brs = list(info.get("upstreamBranches") or [])
        for eb in explicit_branches:
            if eb and eb != info.get("callerBranch") and eb not in up_brs:
                up_brs.append(eb)
        info["upstreamBranches"] = up_brs
        info["readyToMerge"] = True

    try:
        main_root_p = Path(info.get("mainRoot") or target_dir)
        _ensure_orca_dir_git_excluded(main_root_p)
        _sync_orca_runs_into_child_worktrees(main_root_p)
        if info.get("isInWorkerWorktree") and info.get("callerWorktree"):
            _strip_leader_directives_in_child_worktree(Path(info["callerWorktree"]), main_root_p)
    except Exception:
        pass

    if list_only:
        if as_json:
            print(json.dumps(info, ensure_ascii=False, indent=2))
        else:
            print(" ".join(info.get("upstreamBranches") or []))
        return

    if check_only:
        if as_json:
            print(json.dumps(info, ensure_ascii=False, indent=2))
        else:
            if info.get("readyToMerge"):
                brs = ", ".join(info.get("upstreamBranches") or []) or "(không có nhánh phụ)"
                print(f"✅ Run {info.get('runId')}: 100% upstream đã hoàn tất. Các nhánh cần merge: {brs}")
            else:
                print(f"⛔ Run {info.get('runId') or '(không xác định)'}: CHƯA SẴN SÀNG MERGE!")
                for b in info.get("blockingActiveUpstream") or []:
                    print(f"   • Worker đang làm việc: {b.get('slot')} ({b.get('dispatchId')}, state={b.get('state')})")
                for u in info.get("blockingUnstartedUpstream") or []:
                    print(f"   • Task chưa chạy: {u.get('taskId')} ({u.get('role')} - {u.get('title')})")
                for f_item in info.get("blockingFailedUpstream") or []:
                    print(f"   • Task bị lỗi chưa khắc phục: {f_item.get('slot')} ({f_item.get('taskId')}, state={f_item.get('state')})")
        if not info.get("readyToMerge"):
            sys.exit(1)
        return

    # Chế độ Auto-Wait P2P (--wait) cho Worker downstream (devops/qa/sec/bench) để loại bỏ hoàn toàn vòng lặp busy-wait tốn token
    should_auto_wait = explicit_wait and (
        not no_wait
        and not to_main
        and bool(info.get("runId"))
        and len(info.get("blockingFailedUpstream") or []) == 0
        and bool((info.get("blockingActiveUpstream") or []) or (info.get("blockingUnstartedUpstream") or []))
    )

    printed_plan_once = False
    if not info.get("readyToMerge") and should_auto_wait:
        if not as_json:
            _print_run_plan_and_peers_summary(info, show_all_tasks=False)
            printed_plan_once = True
            active_names = [f"{b.get('slot')} ({b.get('dispatchId')})" for b in (info.get("blockingActiveUpstream") or [])]
            unstarted_names = [f"{u.get('role')}:{u.get('taskId')}" for u in (info.get("blockingUnstartedUpstream") or [])]
            waiting_on = ", ".join(active_names + unstarted_names) or "upstream"
            print(
                f"\n⏳ [ORCA AUTO-WAIT P2P MERGE] Run {info.get('runId')}: Đang tự động chờ các nhánh upstream hoàn tất hoặc gửi tín hiệu P2P READY ({waiting_on})...\n"
                f"   💡 Lệnh này sẽ tự động poll SQLite (0 LLM token) và merge ngay khi upstream sẵn sàng. Bạn KHÔNG cần chạy vòng lặp kiểm tra thủ công.",
                flush=True,
            )
        t_wait_start = time.time()
        last_wait_sig = ""
        poll_interval = min(2.0, max(0.2, wait_timeout / 4.0))
        while (time.time() - t_wait_start) < wait_timeout:
            time.sleep(poll_interval)
            info = resolve_run_upstream_branches(
                target_dir,
                run_id=run_id or str(info.get("runId") or ""),
                dispatch_id=dispatch_id,
                task_id=task_id,
                terminal_handle=terminal_handle,
                caller_role=role_str,
                to_main=to_main,
                allow_live=allow_live,
            )
            if info.get("readyToMerge"):
                elapsed_w = time.time() - t_wait_start
                if not as_json:
                    print(f"✅ [ORCA AUTO-WAIT P2P MERGE] Upstream đã sẵn sàng sau {elapsed_w:.1f}s! Bắt đầu đồng bộ nhánh...", flush=True)
                break
            if info.get("blockingFailedUpstream"):
                break
            cur_sig = ",".join(
                sorted(
                    [f"{b.get('slot')}:{b.get('dispatchId')}" for b in (info.get("blockingActiveUpstream") or [])]
                    + [f"{u.get('role')}:{u.get('taskId')}" for u in (info.get("blockingUnstartedUpstream") or [])]
                )
            )
            if cur_sig != last_wait_sig and not as_json:
                last_wait_sig = cur_sig
                print(f"   ⏳ Vẫn đang chờ upstream: {cur_sig}", flush=True)

    if not info.get("readyToMerge"):
        if as_json:
            print(json.dumps(info, ensure_ascii=False, indent=2))
        else:
            if not printed_plan_once:
                _print_run_plan_and_peers_summary(info, show_all_tasks=False)
            print(
                f"\n⛔ [ORCA RUN-SCOPED MERGE GUARD] Chưa thể merge cho Run {info.get('runId') or '(không xác định)'} "
                f"vì các nhánh upstream phía trước trong cùng Run vẫn đang chạy hoặc chưa gửi P2P handoff:",
                file=sys.stderr,
            )
            for b in info.get("blockingActiveUpstream") or []:
                print(
                    f"   • Worker '{b.get('slot')}' ({b.get('dispatchId')}) vẫn đang làm việc (state={b.get('state')}). "
                    f"Nếu merge lúc này sẽ bị thiếu code của '{b.get('slot')}'!",
                    file=sys.stderr,
                )
            for u in info.get("blockingUnstartedUpstream") or []:
                print(
                    f"   • Task upstream '{u.get('taskId')}' ({u.get('role')}: {u.get('title')}) vẫn đang ở trạng thái '{u.get('status')}' (chưa chạy).",
                    file=sys.stderr,
                )
            for f_item in info.get("blockingFailedUpstream") or []:
                print(
                    f"   • Worker upstream '{f_item.get('slot')}' ({f_item.get('taskId')}) kết thúc với trạng thái '{f_item.get('state')}'.",
                    file=sys.stderr,
                )
            wait_cmd_parts = ["orca-team merge-upstream --wait"]
            if role_str:
                wait_cmd_parts.append(f"--role {role_str}")
            if task_id:
                wait_cmd_parts.append(f"--task-id {task_id}")
            if dispatch_id:
                wait_cmd_parts.append(f"--dispatch-id {dispatch_id}")
            if run_id and not task_id and not dispatch_id:
                wait_cmd_parts.append(f"--run {run_id}")
            wait_cmd_hint = " ".join(wait_cmd_parts)
            print(
                f"⏳ [TRẠNG THÁI CHỜ P2P BÌNH THƯỜNG]: Hãy chạy `{wait_cmd_hint}` để tự động chờ ngầm (0 LLM token) và merge ngay khi upstream gửi tín hiệu P2P READY hoặc báo worker-done! "
                "Tuyệt đối KHÔNG chạy vòng lặp sleep/poll thủ công và KHÔNG cần chạy `orca-team --help`.",
                file=sys.stderr,
            )
        sys.exit(1)

    git_cwd = Path(info["mainRoot"]) if to_main else Path(info["callerWorktree"])
    merged_branches: list[str] = []
    cleaned_untracked_all: list[str] = []
    main_br = info.get("mainBranch") or "main"
    abort_on_conflict = not keep_conflict

    if not to_main and info.get("isInWorkerWorktree"):
        _strip_leader_directives_in_child_worktree(git_cwd, Path(info["mainRoot"]))

    # Bước 1: Nếu đang đứng trong worktree của worker (không phải --to-main), merge nhánh gốc (main/develop) trước
    if not to_main and info.get("callerBranch") != main_br:
        rc_v = subprocess.run(
            ["git", "rev-parse", "--verify", "--quiet", main_br],
            cwd=str(git_cwd),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        ).returncode
        if rc_v == 0:
            rc_m, err_msg, cf_list, cl_untr = _git_merge_branch_safe(
                git_cwd, main_br, abort_on_conflict=abort_on_conflict
            )
            if cl_untr:
                cleaned_untracked_all.extend(cl_untr)
            if rc_m != 0:
                info["mergeError"] = f"Conflict/error merging {main_br}: {err_msg}"
                info["conflictBranch"] = main_br
                info["conflictFiles"] = cf_list
                info["conflictAborted"] = abort_on_conflict
                if cleaned_untracked_all:
                    info["cleanedUntrackedFiles"] = cleaned_untracked_all
                if as_json:
                    print(json.dumps(info, ensure_ascii=False, indent=2))
                else:
                    print(f"❌ Lỗi khi merge nhánh '{main_br}' vào '{info.get('callerBranch')}':\n{err_msg}", file=sys.stderr)
                    if cf_list:
                        print(f"   • Các file xung đột: {', '.join(cf_list)}", file=sys.stderr)
                    if abort_on_conflict:
                        print(
                            f"   💡 Đã tự động chạy 'git merge --abort' để giữ sạch worktree. "
                            f"Nếu bạn là Dev/Fix worker muốn tự giải quyết conflict với '{main_br}', hãy chạy kèm cờ '--keep-conflict'.",
                            file=sys.stderr,
                        )
                sys.exit(rc_m or 1)
            merged_branches.append(main_br)

    # Bước 2: Lọc bỏ các nhánh đã là ancestor của một nhánh downstream khác trong danh sách (Ancestor Branch Pruning)
    # Ví dụ: nếu qa-worker hoặc devops-worker đã merge dev-worker + dev-worker-2 và giải quyết xong conflict,
    # thì dev-worker và dev-worker-2 đã là ancestor của qa-worker -> không merge lặp lại từng nhánh thô gây nổ conflict lần 2!
    cand_branches: list[str] = []
    for br in info.get("upstreamBranches") or []:
        if not br or br == info.get("callerBranch") or br in cand_branches:
            continue
        rc_v = subprocess.run(
            ["git", "rev-parse", "--verify", "--quiet", br],
            cwd=str(git_cwd),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        ).returncode
        if rc_v == 0:
            cand_branches.append(br)

    ancestor_covered_by: dict[str, str] = {}
    for br_a in cand_branches:
        for br_b in cand_branches:
            if br_a == br_b:
                continue
            # Tránh chu trình nếu 2 nhánh trỏ cùng 1 commit SHA (chỉ giữ nhánh đứng sau trong thứ tự downstream)
            rc_anc = subprocess.run(
                ["git", "merge-base", "--is-ancestor", br_a, br_b],
                cwd=str(git_cwd),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            ).returncode
            if rc_anc == 0:
                rc_rev = subprocess.run(
                    ["git", "merge-base", "--is-ancestor", br_b, br_a],
                    cwd=str(git_cwd),
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                ).returncode
                if rc_rev == 0 and cand_branches.index(br_a) > cand_branches.index(br_b):
                    continue
                ancestor_covered_by[br_a] = br_b
                break

    for br in cand_branches:
        if br in ancestor_covered_by:
            if br not in merged_branches:
                merged_branches.append(br)
            continue
        rc_b, err_msg, cf_list, cl_untr = _git_merge_branch_safe(
            git_cwd, br, abort_on_conflict=abort_on_conflict
        )
        if cl_untr:
            cleaned_untracked_all.extend(cl_untr)
        if rc_b != 0:
            info["mergedBranches"] = merged_branches
            info["mergeError"] = f"Conflict/error merging {br}: {err_msg}"
            info["conflictBranch"] = br
            info["conflictFiles"] = cf_list
            info["conflictAborted"] = abort_on_conflict
            if cleaned_untracked_all:
                info["cleanedUntrackedFiles"] = cleaned_untracked_all
            if as_json:
                print(json.dumps(info, ensure_ascii=False, indent=2))
            else:
                print(f"❌ Lỗi/xung đột khi merge nhánh '{br}' (thuộc Run {info.get('runId')}):\n{err_msg}", file=sys.stderr)
                if cf_list:
                    print(f"   • Các file xung đột ({len(cf_list)}): {', '.join(cf_list)}", file=sys.stderr)
                if abort_on_conflict:
                    prev_merged = [b for b in merged_branches if b != main_br]
                    peer_hint = prev_merged[-1] if prev_merged else main_br
                    if to_main:
                        print(
                            f"   🛡️ [AUTO-ABORT CLEANUP] Đã tự động chạy 'git merge --abort' để giữ sạch nhánh '{main_br}' (Leader cấm tự sửa code giải quyết conflict).\n"
                            f"   👉 Cách xử lý chuẩn: Giao/mở lại Dev hoặc Fix worker trên nhánh '{br}' chạy:\n"
                            f"      `orca-team merge-upstream --role dev --from-branch {peer_hint} --keep-conflict`\n"
                            f"      để giải quyết conflict, chạy test xanh và git commit trước khi Leader merge lại vào '{main_br}'!",
                            file=sys.stderr,
                        )
                    else:
                        print(
                            f"   🛡️ [AUTO-ABORT CLEANUP] Đã tự động chạy 'git merge --abort' để giữ sạch worktree '{info.get('callerBranch')}'.\n"
                            f"   👉 Nếu bạn là QA/Sec/Bench (không tự sửa business logic của Dev): Hãy gửi P2P handoff/escalation "
                            f"('QA_REJECT: Merge conflict trên nhánh {br} tại {', '.join(cf_list[:4]) or 'files'}') yêu cầu worker '{br}' chạy:\n"
                            f"      `orca-team merge-upstream --role dev --from-branch {peer_hint} --keep-conflict`\n"
                            f"      để giải quyết conflict, test xanh, commit và gửi lại DEV_READY!\n"
                            f"   👉 Nếu bạn là Dev/Fix worker đang muốn tự giải quyết conflict với '{br}': hãy chạy lại lệnh kèm cờ `--keep-conflict`.",
                            file=sys.stderr,
                        )
            sys.exit(rc_b or 1)
        merged_branches.append(br)

    if cleaned_untracked_all:
        info["cleanedUntrackedFiles"] = cleaned_untracked_all

    if not to_main and info.get("isInWorkerWorktree"):
        _strip_leader_directives_in_child_worktree(git_cwd, Path(info["mainRoot"]))

    if to_main and info.get("runId"):
        try:
            _heal_completed_tasks_after_gate([str(info.get("runId"))])
        except Exception:
            pass

    info["mergedBranches"] = merged_branches
    if ancestor_covered_by:
        info["ancestorCoveredBranches"] = ancestor_covered_by
    if as_json:
        print(json.dumps(info, ensure_ascii=False, indent=2))
    else:
        br_summary = ", ".join(merged_branches) if merged_branches else "(không có nhánh mới cần merge)"
        target_lbl = main_br if to_main else (info.get("callerBranch") or str(git_cwd))
        print(
            f"✅ [Run {info.get('runId')}] Đã đồng bộ an toàn các nhánh thuộc Run hiện tại vào '{target_lbl}': {br_summary}"
        )
        if not to_main:
            print(f"💡 Nhánh gốc của repo là '{main_br}' — dùng `git diff {main_br}...HEAD` khi đối chiếu thay đổi của Run.")
            if not printed_plan_once:
                _print_run_plan_and_peers_summary(info, show_all_tasks=False)


def cmd_spec(args: list, explicit_root: Path = None):
    raw_list = list(args or [])
    leading_dd = False
    if raw_list and raw_list[0] == "--":
        raw_list = raw_list[1:]
        leading_dd = True
    if not raw_list or (not leading_dd and raw_list[0] in ("-h", "--help", "help")):
        print("Sử dụng: orca-team spec <role> \"<mô-tả-nhiệm-vụ>\" [--goal|--no-goal]")
        print("Các role hỗ trợ: dev, devops, critic, sec, qa, bench, re, ui, pr, issue")
        return
    if not leading_dd and raw_list[0] == "--list":
        for alias_k, canon_v in sorted(ROLE_ALIASES.items()):
            if canon_v in ROLE_SPEC_TEMPLATES:
                print(f"{alias_k:<18} -> {canon_v}")
        return
    clean_args = []
    explicit_role = None
    explicit_task = None
    goal_override = None
    spec_root = explicit_root
    idx = 0
    after_dd = leading_dd
    while idx < len(raw_list):
        tok = raw_list[idx]
        if not after_dd:
            if tok == "--":
                after_dd = True
                idx += 1
                continue
            if tok in ("-h", "--help"):
                print("Sử dụng: orca-team spec <role> \"<mô-tả-nhiệm-vụ>\" [--goal|--no-goal]")
                print("Các role hỗ trợ: dev, devops, critic, sec, qa, bench, re, ui, pr, issue")
                return
            if tok == "--goal":
                goal_override = True
                idx += 1
                continue
            if tok == "--no-goal":
                goal_override = False
                idx += 1
                continue
            if tok in ("--path", "-C"):
                if idx + 1 >= len(raw_list) or not raw_list[idx + 1].strip() or raw_list[idx + 1].startswith("-"):
                    print(f"❌ Thiếu giá trị đường dẫn sau '{tok}'.", file=sys.stderr)
                    sys.exit(1)
                cand = Path(raw_list[idx + 1]).expanduser()
                if not cand.is_dir():
                    print(f"❌ Đường dẫn không tồn tại: '{raw_list[idx + 1]}'.", file=sys.stderr)
                    sys.exit(1)
                spec_root = cand.resolve()
                idx += 2
                continue
            if tok.startswith("--path="):
                p_val = tok.split("=", 1)[1].strip()
                if not p_val or not Path(p_val).expanduser().is_dir():
                    print(f"❌ Đường dẫn không tồn tại: '{p_val}'.", file=sys.stderr)
                    sys.exit(1)
                spec_root = Path(p_val).expanduser().resolve()
                idx += 1
                continue
            if tok in ("--role", "-r") and explicit_role is None:
                if idx + 1 >= len(raw_list) or not raw_list[idx + 1].strip() or raw_list[idx + 1].startswith("-"):
                    print(f"❌ Thiếu giá trị cho '{tok}'.", file=sys.stderr)
                    sys.exit(1)
                explicit_role = raw_list[idx + 1]
                idx += 2
                continue
            if tok.startswith("--role=") and explicit_role is None:
                r_val = tok.split("=", 1)[1].strip()
                if not r_val:
                    print("❌ Thiếu giá trị cho '--role='.", file=sys.stderr)
                    sys.exit(1)
                explicit_role = r_val
                idx += 1
                continue
            if tok in ("--task", "-t") and explicit_task is None:
                if idx + 1 >= len(raw_list):
                    print(f"❌ Thiếu giá trị cho '{tok}'.", file=sys.stderr)
                    sys.exit(1)
                explicit_task = raw_list[idx + 1]
                idx += 2
                continue
            if tok.startswith("--task=") and explicit_task is None:
                explicit_task = tok.split("=", 1)[1]
                idx += 1
                continue
        clean_args.append(tok)
        idx += 1

    if explicit_role is not None:
        role_arg = explicit_role
        task_parts = [explicit_task] if explicit_task is not None else clean_args
    elif not clean_args:
        role_arg = ""
        task_parts = [explicit_task] if explicit_task is not None else []
    else:
        first_tok = clean_args[0].strip().lower()
        if not leading_dd and _is_role_or_slot_token(first_tok):
            role_arg = clean_args[0]
            task_parts = [explicit_task] if explicit_task is not None else clean_args[1:]
        elif not leading_dd and len(clean_args) == 2 and re.match(r"^[a-z0-9_-]{1,20}$", clean_args[0]):
            role_arg = clean_args[0]
            task_parts = [explicit_task] if explicit_task is not None else clean_args[1:]
        else:
            role_arg = "" if clean_args[0].strip().startswith("[ROLE:") else "dev"
            task_parts = [explicit_task] if explicit_task is not None else clean_args
    if task_parts and (after_dd or explicit_task is not None or task_parts != ["-"]):
        task_text = " ".join(task_parts)
    elif not sys.stdin.isatty():
        task_text = sys.stdin.read()
    else:
        task_text = ""
    cfg_root = spec_root if spec_root is not None else find_project_root()
    cfg = load_config(cfg_root) if cfg_root else None
    sys.stdout.write(build_role_spec(role_arg, task_text, config=cfg, goal_override=goal_override) + "\n")


def _is_orca_discovery_link(p: Path) -> bool:
    """True chỉ khi p là symlink do Orca tạo (trỏ tới .agents/GEMINI.md) — không đụng symlink riêng của user."""
    try:
        if not p.is_symlink():
            return False
        tgt = os.readlink(p)
        return tgt == ".agents/GEMINI.md" or Path(tgt).as_posix().endswith("/.agents/GEMINI.md")
    except OSError:
        return False


def _ensure_critic_defaults(config: dict) -> dict:
    """Bổ sung criticSpecialist và goalMode mặc định (trong bộ nhớ) cho config cũ — dùng chung cho status/get/sync."""
    if not isinstance(config, dict):
        return config
    if "goalMode" not in config:
        config["goalMode"] = False
    if isinstance(config.get("coordinator"), dict) and "goalMode" not in config["coordinator"]:
        config["coordinator"]["goalMode"] = config.get("goalMode", False)
    if not isinstance(config.get("roles"), dict):
        config["roles"] = {}
    roles = config["roles"]
    if "criticSpecialist" not in roles:
        coord = config.get("coordinator") if isinstance(config.get("coordinator"), dict) else {}
        sec_cfg = roles.get("security") if isinstance(roles.get("security"), dict) else {}
        roles["criticSpecialist"] = {
            "enabled": True,
            "agent": sec_cfg.get("agent") or coord.get("agent") or "antigravity",
            "model": sec_cfg.get("model") or coord.get("model") or "gemini-4-argon-high",
            "effort": sec_cfg.get("effort") or "high",
            "goalMode": config.get("goalMode", False),
            "utilities": ["git-worktrees", "diff-viewer", "orca-skills-registry"],
        }
    for r_cfg in roles.values():
        if isinstance(r_cfg, dict) and "goalMode" not in r_cfg:
            r_cfg["goalMode"] = config.get("goalMode", False)
    return config

REA_REPO_URL = "https://github.com/morluto/rea.git"
REA_CLIENT_MAP = {
    "antigravity": "antigravity",
    "gemini": "gemini_cli",
    "claude": "claude_code",
    "codex": "codex",
    "cursor": "cursor",
    "opencode": "opencode",
    "copilot": "copilot_cli",
}

def ensure_rea_skill(agent: str = "antigravity"):
    """
    Đảm bảo skill 'reverse-engineer-anything' (từ https://github.com/morluto/rea.git)
    và công cụ 'rea' được cài đặt/đồng bộ cho các agent CLI (Antigravity, Claude, Codex, Kimi...).
    """
    import subprocess
    import tempfile

    skill_targets = [
        Path.home() / ".gemini" / "config" / "skills" / "reverse-engineer-anything",
        Path.home() / ".agents" / "skills" / "reverse-engineer-anything",
        Path.home() / ".claude" / "skills" / "reverse-engineer-anything",
    ]

    # 1. Kiểm tra xem đã có bản cài đặt chuẩn ở một trong các thư mục chưa
    existing_src = None
    for st in skill_targets:
        if (st / "SKILL.md").exists():
            existing_src = st
            break

    # 2. Nếu chưa có ở bất kỳ đâu, thử chạy rea setup, npx rea-agents, hoặc git clone từ https://github.com/morluto/rea.git
    env = _build_discovery_env()
    rea_bin = _find_cli_binary(["rea"], env)
    npx_bin = _find_cli_binary(["npx"], env)
    rea_client = REA_CLIENT_MAP.get((agent or "antigravity").lower(), "antigravity")

    if not existing_src:
        print(f"   🔧 [REA] Đang cài đặt skill 'reverse-engineer-anything' từ {REA_REPO_URL}...")
        if rea_bin:
            try:
                subprocess.run([rea_bin, "setup", "--client", rea_client, "--yes"], capture_output=True, text=True, env=env, timeout=30)
            except Exception:
                pass
        elif npx_bin:
            try:
                subprocess.run([npx_bin, "-y", "rea-agents@latest", "setup", "--client", rea_client, "--yes"], capture_output=True, text=True, env=env, timeout=45)
            except Exception:
                pass
        for st in skill_targets:
            if (st / "SKILL.md").exists():
                existing_src = st
                break

    if not existing_src:
        tmp_dir = Path(tempfile.mkdtemp(prefix="orca-rea-"))
        try:
            res = subprocess.run(
                ["git", "clone", "--depth", "1", REA_REPO_URL, str(tmp_dir)],
                capture_output=True, text=True, timeout=45
            )
            if res.returncode == 0:
                candidates = [
                    tmp_dir / "skills" / "reverse-engineer-anything",
                    tmp_dir / "skill" / "reverse-engineer-anything",
                    tmp_dir / "reverse-engineer-anything",
                    tmp_dir,
                ]
                for cand in candidates:
                    if (cand / "SKILL.md").exists():
                        target_primary = skill_targets[0]
                        target_primary.parent.mkdir(parents=True, exist_ok=True)
                        if target_primary.exists():
                            shutil.rmtree(target_primary, ignore_errors=True)
                        shutil.copytree(cand, target_primary, dirs_exist_ok=True)
                        existing_src = target_primary
                        print(f"   ✅ [REA] Đã tải và cài đặt skill 'reverse-engineer-anything' vào {target_primary}")
                        break
        except Exception as e:
            print(f"   ⚠️  [REA] Không thể clone tự động từ {REA_REPO_URL}: {e}", file=sys.stderr)
        finally:
            shutil.rmtree(tmp_dir, ignore_errors=True)

    # 3. Đồng bộ sang các thư mục skill chung (~/.gemini/config/skills, ~/.agents/skills, ~/.claude/skills, ~/.qoder/skills)
    #    cho cả reverse-engineer-anything, reverse-clone-website, game-reverse-reconstruct, impeccable và design-taste-frontend để mọi worker đều đọc được
    if existing_src and (existing_src / "SKILL.md").exists():
        for st in skill_targets:
            if st == existing_src or (st / "SKILL.md").exists():
                continue
            try:
                st.parent.mkdir(parents=True, exist_ok=True)
                shutil.copytree(existing_src, st, dirs_exist_ok=True)
            except Exception:
                pass

    shared_role_skills = (
        "reverse-engineer-anything",
        "reverse-clone-website",
        "game-reverse-reconstruct",
        "impeccable",
        "design-taste-frontend",
    )
    skill_roots = (
        Path.home() / ".gemini" / "config" / "skills",
        Path.home() / ".agents" / "skills",
        Path.home() / ".claude" / "skills",
        Path.home() / ".qoder" / "skills",
    )
    for sk_name in shared_role_skills:
        src_dir = next((sr / sk_name for sr in skill_roots if (sr / sk_name / "SKILL.md").is_file()), None)
        if not src_dir:
            continue
        for dst_root in skill_roots:
            dst_dir = dst_root / sk_name
            if dst_dir == src_dir or (dst_dir / "SKILL.md").is_file():
                continue
            try:
                dst_root.mkdir(parents=True, exist_ok=True)
                shutil.copytree(src_dir, dst_dir, symlinks=False, dirs_exist_ok=True)
            except Exception:
                pass

    # 4. Nếu có binary 'rea', đảm bảo đăng ký MCP/client cho agent được chọn
    if rea_bin:
        try:
            subprocess.run([rea_bin, "setup", "--client", rea_client, "--yes"], capture_output=True, text=True, env=env, timeout=20)
        except Exception:
            pass


def find_project_root():
    curr = Path.cwd().resolve()
    # 1. Tra cứu Git common-dir nếu đang nằm trong child worktree
    try:
        import subprocess
        res = subprocess.run(["git", "rev-parse", "--git-common-dir"], capture_output=True, text=True, cwd=str(curr))
        if res.returncode == 0 and res.stdout.strip():
            raw_git = Path(res.stdout.strip())
            common_git = raw_git if raw_git.is_absolute() else (curr / raw_git).resolve()
            main_root = common_git.parent
            if (main_root / "orca-team.json").exists() or (main_root / ".agents" / "GEMINI.md").exists():
                return main_root
    except Exception:
        pass

    # 2. Quét ngược lên các thư mục cha thông thường
    for parent in [curr] + list(curr.parents):
        if (parent / "orca-team.json").exists() or (parent / ".agents" / "GEMINI.md").exists():
            return parent
    return curr

def load_config(root: Path):
    cfg_file = root / "orca-team.json"
    if not cfg_file.exists():
        return None
    try:
        with open(cfg_file, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception as e:
        print(f"❌ Lỗi đọc orca-team.json: {e}", file=sys.stderr)
        return None

def save_config(root: Path, config: dict):
    cfg_file = root / "orca-team.json"
    with open(cfg_file, "w", encoding="utf-8") as f:
        json.dump(config, f, indent=2, ensure_ascii=False)
        f.write("\n")

def _supports_effort_py(agent: str, model: str) -> bool:
    ag = (agent or "").strip().lower()
    mod = str(model or "").strip()
    if not mod or mod in ("None", "null", "(default)"):
        return False
    if ag in ("antigravity", "codebuddy", "codex", "muse"):
        return True
    if ag == "claude":
        return "haiku" not in mod.lower()
    if ag == "cursor":
        return mod in ("gpt-5.3-codex", "claude-opus-4-8")
    return False

def _fmt_worker_args_py(agent: str, model, effort: str) -> str:
    ag = (agent or "").strip().lower()
    args = f"--agent {agent}"
    mod = str(model).strip() if (model and str(model).strip() not in ("None", "null", "(default)")) else ""
    eff = str(effort).strip().lower() if (effort and str(effort).strip() not in ("None", "null", "-")) else ""

    # Orca worker-start chỉ hỗ trợ --model trên: antigravity, claude, codex, cursor, muse, codebuddy, omp
    # (kimi, gemini, opencode khi tạo new-child, aider, goose, copilot tự lấy model từ config riêng)
    model_supported_agents = {"antigravity", "claude", "codex", "cursor", "muse", "codebuddy", "omp"}
    if not mod or ag not in model_supported_agents:
        return args

    args += f' --model "{mod}"'

    # --effort bắt buộc phải đi kèm --model và chỉ hỗ trợ trên một số agent/model nhất định trong Orca
    if not eff or ag == "omp":
        return args
    if ag == "antigravity" or ag == "codebuddy":
        if eff in ("xhigh", "max", "ultra"):
            eff = "high"
        elif eff == "minimal":
            eff = "low"
        if eff not in ("low", "medium", "high"):
            return args
    elif ag == "claude":
        if "haiku" in mod.lower():
            return args
        if eff not in ("low", "medium", "high", "xhigh", "max"):
            return args
    elif ag == "cursor":
        if mod not in ("gpt-5.3-codex", "claude-opus-4-8") or eff not in ("low", "medium", "high"):
            return args
    elif ag in ("codex", "muse"):
        if eff not in ("minimal", "low", "medium", "high", "xhigh", "max", "ultra"):
            return args
    else:
        return args

    args += f" --effort {eff}"
    return args

def _is_role_enabled(data: dict, is_optional: bool = True) -> bool:
    if not isinstance(data, dict):
        return False
    ag = data.get("agent")
    ag_norm = str(ag).strip().lower() if ag is not None else ""
    if "enabled" in data:
        return bool(data["enabled"]) and ag_norm != "none"
    has_valid_agent = bool(ag_norm and ag_norm not in ("none", "null"))
    return has_valid_agent if is_optional else (ag_norm != "none")

def _sync_discovery_links(root: Path, config: dict, create_missing: bool = False):
    """Đảm bảo GEMINI.md, AGENTS.md và CLAUDE.md ở root luôn trỏ tới .agents/GEMINI.md (không ghi đè file riêng của user) để đổi CLI nào làm Leader cũng nhận đủ directive."""
    gemini_md = root / ".agents" / "GEMINI.md"
    if not gemini_md.exists():
        return
    root_gemini_md = root / "GEMINI.md"
    claude_md = root / "CLAUDE.md"
    agents_md = root / "AGENTS.md"
    has_any_orca_link = (
        create_missing
        or _is_orca_discovery_link(root_gemini_md)
        or _is_orca_discovery_link(claude_md)
        or _is_orca_discovery_link(agents_md)
    )
    if not has_any_orca_link:
        return

    for link_path in (root_gemini_md, agents_md, claude_md):
        if not os.path.lexists(link_path):
            try:
                os.symlink(".agents/GEMINI.md", link_path)
            except OSError:
                pass


def sync_gemini_directive(root: Path, config: dict):
    gemini_file = root / ".agents" / "GEMINI.md"
    content = gemini_file.read_text(encoding="utf-8") if gemini_file.exists() else ""
    upgraded_from_template = not gemini_file.exists()

    # Khởi tạo mới hoặc nâng cấp tự động nếu .agents/GEMINI.md đang ở phiên bản cũ (v1/v2 thiếu cấu trúc 4 BƯỚC)
    if (
        "### BƯỚC 1:" not in content
        or "### BƯỚC 2:" not in content
        or "### BƯỚC 3:" not in content
        or "### BƯỚC 4:" not in content
        or "> - **BẮT BUỘC PHÂN VAI ĐÚNG CHUYÊN MÔN:**" not in content
    ):
        tpl_candidates = [
            Path(__file__).resolve().parent.parent / "templates" / "GEMINI.md",
            Path.home() / ".gemini" / "antigravity" / "scratch" / "orca-multi-agent-orchestrator" / "templates" / "GEMINI.md",
        ]
        for tpl_p in tpl_candidates:
            if tpl_p.is_file():
                try:
                    content = tpl_p.read_text(encoding="utf-8")
                    upgraded_from_template = True
                    break
                except Exception:
                    pass
        if not content:
            return
    gemini_file.parent.mkdir(parents=True, exist_ok=True)

    # Build updated table rows
    rows = []
    rows.append("| Role | Agent & Model | Concurrency | Capabilities & Orca Utilities |")
    rows.append("| :--- | :--- | :--- | :--- |")

    def _goal_badge(role_cfg: dict) -> str:
        return " (🎯 /goal)" if _is_goal_mode_enabled(role_cfg, config) else ""

    # Coordinator
    coord = config.get("coordinator") or {}
    c_agent = coord.get("agent") or "claude"
    c_model = coord.get("model")
    c_display = f"`{c_agent}`" + (f" ({c_model})" if c_model else "")
    rows.append(f"| **Lead Coordinator** | {c_display} | 1{_goal_badge(coord)} | Task DAG, Zero-Trust Audit, Decision Gates, Release |")

    def _table_conc_label(role_cfg: dict, is_on_demand: bool = False) -> str:
        badge = _goal_badge(role_cfg)
        if is_on_demand:
            return f"On-demand{badge}"
        return f"Auto-scale{badge}"

    # Developer
    roles = config.get("roles") or {}
    dev = roles.get("developer") or {}
    d_agent = dev.get("agent") or "kimi"
    d_model = dev.get("model")
    d_display = f"`{d_agent}`" + (f" ({d_model})" if d_model else "")
    rows.append(f"| **Full-Stack Devs** | {d_display} | {_table_conc_label(dev)} | `dev-worker*`, app code & unit tests |")

    # QA
    qa = roles.get("qa") or {}
    q_agent = qa.get("agent") or "kimi"
    q_model = qa.get("model")
    q_display = f"`{q_agent}`" + (f" ({q_model})" if q_model else "")
    rows.append(f"| **QA & Testers** | {q_display} | {_table_conc_label(qa)} | `qa-worker`, E2E/integration & Evidence Ledger |")

    # Security
    sec = roles.get("security") or {}
    s_agent = sec.get("agent") or "codex"
    s_model = sec.get("model")
    s_display = f"`{s_agent}`" + (f" ({s_model})" if s_model else "")
    rows.append(f"| **Security & Bug Hunter** | {s_display} | {_table_conc_label(sec)} | `sec-worker`, OWASP, concurrency & secret audit |")

    # PR Reviewer
    pr = roles.get("prReviewer") or {}
    p_agent = pr.get("agent") or "claude"
    p_model = pr.get("model")
    p_display = f"`{p_agent}`" + (f" ({p_model})" if p_model else "")
    rows.append(f"| **PR Reviewer** | {p_display} | {_table_conc_label(pr, True)} | PR checkout (`--pr`), diff audit |")

    # Issue Resolver
    issue = roles.get("issueResolver") or {}
    i_agent = issue.get("agent") or "kimi"
    i_model = issue.get("model")
    i_display = f"`{i_agent}`" + (f" ({i_model})" if i_model else "")
    rows.append(f"| **Issue Resolver** | {i_display} | {_table_conc_label(issue, True)} | Issue checkout (`--issue`), TDD repro & fix |")

    # DevOps Specialist
    devops = roles.get("devopsSpecialist") or {}
    devops_enabled = _is_role_enabled(devops, is_optional=True)
    if devops_enabled:
        do_agent = devops.get("agent") or "codex"
        do_model = devops.get("model")
        do_display = f"`{do_agent}`" + (f" ({do_model})" if do_model else "")
        rows.append(f"| **DevOps Specialist** | {do_display} | {_table_conc_label(devops)} | `devops-worker`, Docker/K8s/DB & runtime logs |")

    # Bench & Perf Specialist
    bench = roles.get("benchSpecialist") or {}
    bench_enabled = _is_role_enabled(bench, is_optional=True)
    if bench_enabled:
        b_agent = bench.get("agent") or "antigravity"
        b_model = bench.get("model")
        b_display = f"`{b_agent}`" + (f" ({b_model})" if b_model else "")
        rows.append(f"| **Bench & Perf Specialist** | {b_display} | {_table_conc_label(bench)} | `bench-worker`, RPS/EPS & p95/p99 latency |")

    # Reverse Engineering Specialist (REA)
    re_spec = roles.get("reSpecialist") or {}
    re_enabled = _is_role_enabled(re_spec, is_optional=True)
    if re_enabled:
        r_agent = re_spec.get("agent") or "antigravity"
        r_model = re_spec.get("model")
        r_display = f"`{r_agent}`" + (f" ({r_model})" if r_model else "")
        rows.append(f"| **Reverse Eng (REA)** | {r_display} | {_table_conc_label(re_spec)} | `re-worker`, binary/web/game 1:1 (`rea`) |")

    # UI Specialist
    ui = roles.get("uiSpecialist") or {}
    ui_enabled = _is_role_enabled(ui, is_optional=True)
    if ui_enabled:
        u_agent = ui.get("agent") or "claude"
        u_model = ui.get("model")
        u_display = f"`{u_agent}`" + (f" ({u_model})" if u_model else "")
        rows.append(f"| **UI/UX Specialist** | {u_display} | {_table_conc_label(ui)} | `ui-worker`, UI/UX, theme tokens & i18n |")

    # Research & Adversarial Critic Specialist (Auto-seed from security/coordinator if missing in legacy config)
    if "criticSpecialist" not in roles:
        roles["criticSpecialist"] = {
            "enabled": True,
            "agent": sec.get("agent") or coord.get("agent") or "antigravity",
            "model": sec.get("model") or coord.get("model") or "gemini-4-argon-high",
            "effort": sec.get("effort") or "high",
            "goalMode": config.get("goalMode", False),
            "utilities": ["git-worktrees", "diff-viewer", "orca-skills-registry"],
        }
        try:
            save_config(root, config)
        except Exception:
            pass
    critic_spec = roles.get("criticSpecialist") or {}
    critic_enabled = _is_role_enabled(critic_spec, is_optional=True)
    if critic_enabled:
        cr_agent = critic_spec.get("agent") or "antigravity"
        cr_model = critic_spec.get("model")
        cr_display = f"`{cr_agent}`" + (f" ({cr_model})" if cr_model else "")
        rows.append(f"| **Research & Critic** | {cr_display} | {_table_conc_label(critic_spec)} | `critic-worker`, architecture & root-cause |")

    table_text = "\n".join(rows)

    routing_line = (
        "> - **BẮT BUỘC PHÂN VAI ĐÚNG CHUYÊN MÔN:** "
        "App ➔ `dev-worker*` | Infra/DB ➔ `devops-worker` | Sec ➔ `sec-worker` | QA/E2E ➔ `qa-worker` | "
        "Perf ➔ `bench-worker` | Reverse (`rea`) ➔ `re-worker` | UI ➔ `ui-worker` | Critic ➔ `critic-worker`."
    )
    anti_autocracy_line = (
        "> - **QUÂN SƯ CRITIC & CHỐNG ĐỘC ĐOÁN:** Chạm ≥2 tầng/schema/API/auth ➔ `ask`/`reply` với `critic-worker` tới `CONSENSUS_REACHED` rồi `orca-team plan pin`; bất đồng >3 vòng ➔ mở Gate."
    )
    if not critic_enabled:
        anti_autocracy_line = "> - **LUẬT CHỐNG ĐỘC ĐOÁN:** CẤM quy kết lỗi khi chưa có bằng chứng `file:line` + log."
    coord_goal = _is_goal_mode_enabled(coord, config)
    any_worker_goal = any(
        _is_goal_mode_enabled(r_cfg, config)
        for r_cfg, en in [
            (dev, True), (qa, True), (sec, True), (pr, True), (issue, True),
            (devops, devops_enabled), (bench, bench_enabled), (re_spec, re_enabled),
            (ui, ui_enabled), (critic_spec, critic_enabled),
        ]
        if en
    )
    if coord_goal or any_worker_goal:
        goal_rule_line = "> - **CHẾ ĐỘ `/goal`:** Hoàn tất 100% yêu cầu và gửi `send --type worker_done` trước khi xuất `<!-- GOAL_COMPLETE -->`."
    else:
        goal_rule_line = (
            "> - **EVIDENCE LEDGER & PROGRESSIVE DISCLOSURE:** "
            "Ghi bằng chứng qua `orca-team verify --run <RUN> --dispatch-id <DID> --task-id <TID> -- <cmd>`, "
            "xem luật bằng `orca-team card <role> --step <1..4>`, xem state bằng `orca-team state --run <RUN> [--full|--since <CURSOR>]`."
        )
    header_rules_block = routing_line + "\n" + anti_autocracy_line + ("\n" + goal_rule_line if goal_rule_line else "")
    content = re.sub(
        r"^> - \*\*BẮT BUỘC PHÂN VAI ĐÚNG CHUYÊN MÔN[^\n]*\n(?:> - \*\*(?:LUẬT CHỐNG ĐỘC ĐOÁN|QUÂN SƯ)[^\n]*\n?)?(?:> - \*\*(?:CHẾ ĐỘ|TRÁCH NHIỆM|PHÂN ĐỊNH|KIỂM SOÁT|EVIDENCE LEDGER)[^\n]*)?",
        header_rules_block,
        content,
        flags=re.M
    )
    content = re.sub(
        r"^> 🔴 \*\*LUẬT CẤM VƯỢT RÀO TẠI ROOT WORKSPACE[^\n]*\n> - Tuyệt đối \*\*KHÔNG\*\* dùng file-editing tools[^\n]*\n> - Tuyệt đối \*\*KHÔNG\*\* tự chạy[^\n]*\n> - Tuyệt đối \*\*KHÔNG\*\* gọi[^\n]*",
        (
            "> 🔴 **LUẬT CẤM VƯỢT RÀO TẠI ROOT WORKSPACE (STRICT LEADER BOUNDARIES — ĐA CLI):**\n"
            "> - Tuyệt đối **KHÔNG** dùng file-editing tools (`write_to_file`, `replace_file_content`, `Write`, `Edit`, `MultiEdit`) sửa code/test tại root.\n"
            "> - Tuyệt đối **KHÔNG** tự chạy build, test, benchmark, dịch ngược hay hạ tầng (`docker`, `kubectl`, `npm/pytest`, `k6`, `rea`...) tại root!\n"
            "> - Tuyệt đối **KHÔNG** gọi subagent/plan nội bộ (`invoke_subagent`, `Agent`, `Task`, `EnterPlanMode`), **KHÔNG** poll (`manage_task`, `schedule`), và **KHÔNG** đọc `task-*.log` / `transcript*.jsonl`."
        ),
        content,
        flags=re.M,
    )
    content = re.sub(
        r"^> - Tại root workspace, Leader \*\*CHỈ ĐƯỢC PHÉP\*\*[^\n]*",
        lambda m: "> - Tại root workspace, Leader **CHỈ ĐƯỢC PHÉP** chạy `orca orchestration ...`, `orca-team ...` và `git merge` (sau Human Gate).",
        content,
        flags=re.M
    )

    # Regex replace the table under ## 👥 Configured Agent (Team)? Topology
    pattern = re.compile(
        r"(## 👥 Configured Agent(?: Team)? Topology\s*\n\s*)(?:\|[^\n]+\|\n)+",
        re.MULTILINE
    )
    if pattern.search(content):
        content = pattern.sub(lambda m: m.group(1) + table_text + "\n", content)

    # Đồng bộ Execution Host và tiêu đề phần 3
    exec_host = str(config.get("executionHost") or "local").strip()
    host_label = "Local Machine" if exec_host == "local" else f"Remote SSH ({exec_host})"
    content = re.sub(
        r"^- \*\*Execution Host:\*\* `[^`]*` \([^\n|]*?\)+(?=\s*\|\s*\*\*Orca CLI:\*\*)",
        f"- **Execution Host:** `{exec_host}` ({host_label})",
        content,
        flags=re.M,
    )
    content = re.sub(
        r"^## ⚡ QUY TRÌNH 4 BƯỚC[^\n]*$",
        "## ⚡ QUY TRÌNH 4 BƯỚC & HIẾN PHÁP KỸ SƯ TRƯỞNG",
        content,
        flags=re.M,
    )

    dev_w_args = _fmt_worker_args_py(d_agent, d_model, dev.get("effort"))
    qa_w_args = _fmt_worker_args_py(q_agent, q_model, qa.get("effort"))

    step1_full = (
        "### BƯỚC 1: PLAN DRAFT, CONSENSUS & PIN (`orca-team card leader --step 1`)\n"
        "- Ghi `plan draft` ➔ `critic-worker` ➔ `plan consensus` ➔ `plan pin` (`contracts.json`), tách Task theo **Disjoint File Ownership**:\n"
        "  ```bash\n"
        "  orca orchestration run-create --objective \"[Mô tả]\"\n"
        "  orca-team plan draft --run <RUN_ID> --content \"## Hợp đồng\\n- POST /api/...\\n## Hạng mục\\n[P1] Module A (files: ...)\"\n"
        "  orca-team plan consensus --run <RUN_ID> && orca-team plan pin --run <RUN_ID>\n"
        "  orca orchestration task-create --spec \"$(orca-team spec dev '[P1] Module A')\"\n"
        "  ```\n\n"
    )
    content = re.sub(
        r"### BƯỚC 1:[^\n]*\n[\s\S]*?(?=### BƯỚC 2:)",
        lambda m: step1_full,
        content,
        flags=re.M
    )

    step2_full = (
        "### BƯỚC 2: WAVE FAN-OUT & WORKTREE SLOTS (`orca-team card leader --step 2`)\n"
        "- Dùng `$(orca-team worktree-arg <role> --task <TASK_ID>)`. Wave 1 (`dev/ui/re`) xong mới chạy Wave 2 (`qa/sec/devops/bench`):\n"
        "  ```bash\n"
        f"  orca orchestration worker-start --task <DEV_TASK_ID> $(orca-team worktree-arg dev --task <DEV_TASK_ID>) {dev_w_args} --json\n"
        f"  orca orchestration worker-start --task <QA_TASK_ID> $(orca-team worktree-arg qa --task <QA_TASK_ID>) {qa_w_args} --json\n"
        "  ```\n\n"
    )
    content = re.sub(
        r"### BƯỚC 2:[^\n]*\n[\s\S]*?(?=### BƯỚC 3:)",
        lambda m: step2_full,
        content,
        flags=re.M
    )

    step3_full = (
        "### BƯỚC 3: WAIT-EVENTS, EVIDENCE LEDGER & STATE ANCHOR (`orca-team card leader --step 3`)\n"
        "- Chờ: `orca-team wait-events [--ack <DELIVERY_ID>] [--run <RUN_ID>]` (batch 2+ bắt buộc `--ack`). State: `orca-team state --run <RUN_ID> [--full|--since <CURSOR>]`.\n"
        "- **Chốt chặn Bằng chứng Máy (`orca-command-guard`):**\n"
        "  1. Worker chạy test/build qua `orca-team verify --run <RUN> --dispatch-id <DID> --task-id <TID> -- <cmd>` (`orca-team gate run`).\n"
        "  2. Guard chặn `QA_FINAL`/`PASS` nếu thiếu Ledger/artifacts, `exit_code != 0`, `head_sha != HEAD`, `dirty == true`, nhánh `dev/ui` chưa merge (`merge-base --is-ancestor`), report Jest/Playwright/JUnit/pytest/Go/TAP lỗi, hoặc ảnh UI chưa `view_file`.\n"
        "  3. `QA_REJECT` kèm JSON (`plan_item`, `file_path`, `error_code`, `repro_cmd`, `expected`, `actual`); ≥3 vòng `[Pn]` ➔ `--type escalation`. Giữ worker bằng `worker-retain`.\n\n"
    )
    content = re.sub(
        r"### BƯỚC 3:[^\n]*\n[\s\S]*?(?=### BƯỚC 4:)",
        lambda m: step3_full,
        content,
        flags=re.M
    )

    merge_slot_list = ["`dev-worker*`"] + (["`devops-worker*`"] if devops_enabled else []) + (["`ui-worker*`"] if ui_enabled else [])
    merge_branches_hint = ", ".join(merge_slot_list)
    step4_full = (
        "### BƯỚC 4: HUMAN GATE & MERGE (`orca-team card leader --step 4`)\n"
        "- Khi `orca-team state --run \"$RUN_ID\"` báo 100% `[P1..Pn]✓`, `EVID` `exit=0`, Security & QA `PASS` và không còn `BLOCK`/`GATE pending`, mở Gate:\n"
        "  ```bash\n"
        "  orca orchestration gate-create --task <FINAL_TASK_ID> --question \"QA & Security PASS 100% [P1..Pn] (Ledger exit=0). Merge?\" --options '[\"yes\",\"wait\"]' --json\n"
        "  ```\n"
        f"- Khi sếp chọn `\"yes\"`: `gate-resolve`, `task-update --status completed`, `orca-team merge-upstream --to-main --run \"$RUN_ID\"` ({merge_branches_hint}), `orca-team release-workers --run \"$RUN_ID\"`.\n"
    )
    content = re.sub(
        r"### BƯỚC 4:[^\n]*\n[\s\S]*$",
        lambda m: step4_full,
        content,
        flags=re.M
    )

    gemini_file.write_text(content, encoding="utf-8")
    _sync_discovery_links(root, config, create_missing=upgraded_from_template)
    _ensure_orca_dir_git_excluded(root)
    try:
        import subprocess
        wt_res = subprocess.run(
            ["git", "-C", str(root), "worktree", "list", "--porcelain"],
            capture_output=True, text=True, timeout=3, check=False,
        )
        if wt_res.returncode == 0 and wt_res.stdout:
            root_real = os.path.realpath(str(root))
            for ln in wt_res.stdout.splitlines():
                if ln.startswith("worktree "):
                    cwt = ln[9:].strip()
                    if cwt and os.path.realpath(cwt) != root_real and os.path.isdir(cwt):
                        _strip_leader_directives_in_child_worktree(Path(cwt), root)
    except Exception:
        pass


def _build_discovery_env():
    env = os.environ.copy()
    env["NO_COLOR"] = "1"
    env["TERM"] = "dumb"
    extra_paths = [
        str(Path.home() / ".local" / "bin"),
        str(Path.home() / ".kimi-code" / "bin"),
        str(Path.home() / ".kimi" / "bin"),
        str(Path.home() / ".antigravity" / "antigravity" / "bin"),
        str(Path.home() / ".opencode" / "bin"),
        str(Path.home() / ".cursor" / "bin"),
        "/usr/local/bin",
        "/opt/homebrew/bin",
    ]
    curr_path = env.get("PATH", "")
    for p in reversed(extra_paths):
        if p not in curr_path:
            curr_path = f"{p}:{curr_path}"
    env["PATH"] = curr_path
    return env

def _find_cli_binary(names, env):
    path_str = env.get("PATH", "")
    for name in names:
        found = shutil.which(name, path=path_str)
        if found:
            return found
    return None

def _strip_ansi_and_spinners(line: str) -> str:
    line = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", line)
    line = re.sub(r"\r", "\n", line)
    line = re.sub(r"^[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏\s]+", "", line)
    return line.strip()

def _extract_baked_effort(model_id: str) -> str:
    m = re.search(r"-(minimal|low|medium|high|xhigh|max|ultra)$", model_id, re.IGNORECASE)
    return m.group(1).lower() if m else ""

def _load_orca_cached_models(agent: str) -> list:
    models = []
    seen = set()
    orca_profiles = Path.home() / "Library" / "Application Support" / "orca" / "profiles"
    if not orca_profiles.exists():
        return models
    agents_to_check = [agent]
    if agent == "gemini":
        agents_to_check.append("antigravity")
    elif agent == "antigravity":
        agents_to_check.append("gemini")

    for p_dir in orca_profiles.iterdir():
        data_file = p_dir / "orca-data.json"
        if not data_file.exists():
            continue
        try:
            data = json.loads(data_file.read_text(encoding="utf-8", errors="ignore"))
            settings = data.get("settings") or {}
            by_host = settings.get("discoveredModelsByAgentByHost") or {}
            by_agent = settings.get("discoveredModelsByAgent") or {}
            raw_list = []
            for ag in agents_to_check:
                for host_map in by_host.values():
                    if isinstance(host_map, dict) and isinstance(host_map.get(ag), list):
                        raw_list.extend(host_map[ag])
                if isinstance(by_agent.get(ag), list):
                    raw_list.extend(by_agent[ag])
            for item in raw_list:
                if not isinstance(item, dict):
                    continue
                mid = str(item.get("id") or "").strip()
                if not mid or mid == "default" or mid in seen:
                    continue
                seen.add(mid)
                lbl = str(item.get("label") or mid).strip()
                baked = _extract_baked_effort(mid)
                t_levels = item.get("thinkingLevels") or []
                effs = [str(x.get("id") if isinstance(x, dict) else x) for x in t_levels if x]
                models.append({
                    "id": mid,
                    "label": lbl,
                    "bakedEffort": baked,
                    "efforts": [] if baked else (effs or ["low", "medium", "high"]),
                    "source": "orca-cache"
                })
        except Exception:
            pass
    return models

def discover_models_for_agent(agent: str, refresh: bool = False) -> tuple:
    """
    Trả về (models_list, source_label) bằng cách truy vấn trực tiếp CLI của provider đã chọn.
    Có cache phiên ngắn hạn (120s) tại /tmp/orca-cli-models-cache.json để tránh gọi lại CLI 8 lần liên tiếp trong cùng 1 phiên khởi tạo.
    Mỗi phần tử trong models_list:
      {"id": str, "label": str, "bakedEffort": str, "efforts": list[str], "source": str}
    """
    import subprocess
    import time
    ag = (agent or "").strip().lower()
    cache_file = Path("/tmp/orca-cli-models-cache.json")
    if not refresh and cache_file.exists():
        try:
            c_data = json.loads(cache_file.read_text(encoding="utf-8", errors="ignore"))
            entry = c_data.get(ag)
            if isinstance(entry, dict) and (time.time() - entry.get("ts", 0) < 120) and entry.get("models"):
                return entry["models"], entry.get("source", "provider-cli")
        except Exception:
            pass

    env = _build_discovery_env()
    models = []
    seen = set()
    source_label = "provider-cli"

    def add_model(mid: str, label: str = "", efforts=None, src="provider-cli"):
        mid = (mid or "").strip()
        if not mid or mid == "default" or mid in seen:
            return
        seen.add(mid)
        baked = _extract_baked_effort(mid)
        if efforts is None:
            if baked:
                eff_list = []
            elif re.search(r"(opus|sonnet|argon|flash|gemini|o1|o3|gpt-5|r1|k1|k3|glm|thinking|reasoning)", mid, re.I):
                eff_list = ["low", "medium", "high"]
            else:
                eff_list = []
        else:
            eff_list = [] if baked else list(efforts)
        models.append({
            "id": mid,
            "label": (label or mid).strip(),
            "bakedEffort": baked,
            "efforts": eff_list,
            "source": src
        })

    # 1. ANTIGRAVITY / GEMINI (`agy models`)
    if ag in ("antigravity", "gemini"):
        bin_path = _find_cli_binary(["agy", "antigravity"] if ag == "antigravity" else ["agy", "gemini", "antigravity"], env)
        if bin_path:
            try:
                res = subprocess.run([bin_path, "models"], capture_output=True, text=True, env=env, timeout=8)
                raw_out = (res.stdout or "") + "\n" + (res.stderr or "")
                raw_out = re.sub(r"\r", "\n", raw_out)
                for raw_line in raw_out.splitlines():
                    clean = _strip_ansi_and_spinners(raw_line)
                    if not clean or clean.lower().startswith(("loading", "available", "fetching", "id ", "model ")):
                        continue
                    # Format: <id>\t<label> or <id>   <label>
                    m = re.match(r"^([a-zA-Z0-9._-]+)\s{2,}(.+)$", clean) or re.match(r"^([a-zA-Z0-9._-]+)\t+(.+)$", clean)
                    if m:
                        mid, lbl = m.group(1).strip(), m.group(2).strip()
                        if mid.lower() not in ("id", "model", "name"):
                            add_model(mid, lbl, src=f"{Path(bin_path).name} models")
                if models:
                    source_label = f"{Path(bin_path).name} models"
            except Exception:
                pass

    # 2. CLAUDE (`claude -p --input-format stream-json --output-format stream-json --verbose`)
    elif ag == "claude":
        bin_path = _find_cli_binary(["claude"], env)
        if bin_path:
            try:
                proc = subprocess.Popen(
                    [bin_path, "-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose"],
                    stdin=subprocess.PIPE,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    env=env
                )
                req = '{"type":"control_request","request_id":"orca-model-discovery","request":{"subtype":"list_models"}}\n'
                try:
                    out, _ = proc.communicate(input=req, timeout=5)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    out, _ = proc.communicate()
                for line in (out or "").splitlines():
                    line = line.strip()
                    if not line.startswith("{"):
                        continue
                    try:
                        obj = json.loads(line)
                        if obj.get("type") == "control_response":
                            resp = (obj.get("response") or {}).get("response") or {}
                            m_list = resp.get("models") or []
                            for m_obj in m_list:
                                mid = m_obj.get("value") or m_obj.get("id")
                                lbl = m_obj.get("displayName") or m_obj.get("label") or mid
                                desc = m_obj.get("description") or ""
                                full_lbl = f"{lbl} ({desc.splitlines()[0]})" if desc else lbl
                                effs = m_obj.get("supportedEffortLevels") or ["low", "medium", "high"]
                                add_model(mid, full_lbl, efforts=effs, src="claude stream-json list_models")
                    except Exception:
                        pass
                if models:
                    source_label = "claude CLI (list_models)"
            except Exception:
                pass
        # Check ~/.claude/settings.json cho custom/router models
        claude_settings = Path.home() / ".claude" / "settings.json"
        if claude_settings.exists():
            try:
                c_cfg = json.loads(claude_settings.read_text(encoding="utf-8", errors="ignore"))
                c_env = c_cfg.get("env") or {}
                for k in ("ANTHROPIC_MODEL", "ANTHROPIC_DEFAULT_OPUS_MODEL", "ANTHROPIC_DEFAULT_SONNET_MODEL", "ANTHROPIC_DEFAULT_HAIKU_MODEL"):
                    val = c_env.get(k)
                    if val and isinstance(val, str):
                        add_model(val, f"{val} (từ ~/.claude/settings.json {k})", src="~/.claude/settings.json")
                if models and source_label == "provider-cli":
                    source_label = "~/.claude/settings.json"
            except Exception:
                pass

    # 3. KIMI (`~/.kimi-code/config.toml` & `~/.kimi/config.toml`)
    elif ag == "kimi":
        cfg_paths = [
            Path.home() / ".kimi-code" / "config.toml",
            Path.home() / ".kimi" / "config.toml"
        ]
        for cfg_p in cfg_paths:
            if not cfg_p.exists():
                continue
            try:
                raw_toml = cfg_p.read_text(encoding="utf-8", errors="ignore")
                def_m = re.search(r'^\s*default_model\s*=\s*"([^"]+)"', raw_toml, re.M)
                default_id = def_m.group(1).strip() if def_m else ""
                sec_pattern = re.compile(r'^\[models\.(?:"([^"]+)"|([A-Za-z0-9_.-]+))\]\s*$([\s\S]*?)(?=^\[|\Z)', re.M)
                parsed_entries = []
                for sm in sec_pattern.finditer(raw_toml):
                    m_key = (sm.group(1) or sm.group(2) or "").strip()
                    body = sm.group(3) or ""
                    disp_m = re.search(r'^\s*model\s*=\s*"([^"]+)"', body, re.M)
                    disp = disp_m.group(1).strip() if disp_m else m_key
                    has_think = "thinking" in body.lower() or "k3" in m_key.lower() or "k1" in m_key.lower()
                    effs = ["low", "medium", "high"] if has_think else []
                    lbl = f"{disp}{' [default]' if m_key == default_id else ''}"
                    parsed_entries.append((0 if m_key == default_id else 1, m_key, lbl, effs))
                parsed_entries.sort(key=lambda x: x[0])
                for _, m_key, lbl, effs in parsed_entries:
                    add_model(m_key, lbl, efforts=effs, src=f"kimi ({cfg_p.parent.name}/config.toml)")
                if default_id and default_id not in seen:
                    add_model(default_id, f"{default_id} [default]", efforts=["low", "medium", "high"], src=f"kimi ({cfg_p.parent.name}/config.toml)")
                if models:
                    source_label = f"kimi CLI ({cfg_p.parent.name}/config.toml)"
            except Exception:
                pass

    # 4. CODEX (`codex debug models`)
    elif ag == "codex":
        bin_path = _find_cli_binary(["codex"], env)
        if bin_path:
            try:
                res = subprocess.run([bin_path, "debug", "models"], capture_output=True, text=True, env=env, timeout=6)
                obj = json.loads(res.stdout or "{}")
                for item in (obj.get("models") or []):
                    slug = item.get("slug")
                    disp = item.get("display_name") or slug
                    r_levels = item.get("supported_reasoning_levels") or []
                    effs = [x.get("effort") for x in r_levels if isinstance(x, dict) and x.get("effort")]
                    add_model(slug, disp, efforts=effs or ["low", "medium", "high"], src="codex debug models")
                if models:
                    source_label = "codex debug models"
            except Exception:
                pass

    # 5. CURSOR (`cursor-agent --list-models`)
    elif ag == "cursor":
        bin_path = _find_cli_binary(["cursor-agent"], env)
        if bin_path:
            try:
                res = subprocess.run([bin_path, "--list-models"], capture_output=True, text=True, env=env, timeout=6)
                for line in (res.stdout or "").splitlines():
                    m = re.match(r"^([^\s]+)\s+-\s+(.+)$", line.strip())
                    if m:
                        add_model(m.group(1), m.group(2), src="cursor-agent --list-models")
                if models:
                    source_label = "cursor-agent --list-models"
            except Exception:
                pass

    # 6. OPENCODE / OPENCODE2 (`opencode models`)
    elif ag in ("opencode", "opencode2"):
        bin_path = _find_cli_binary([ag, "opencode"], env)
        if bin_path:
            try:
                res = subprocess.run([bin_path, "models"], capture_output=True, text=True, env=env, timeout=6)
                for line in (res.stdout or "").splitlines():
                    clean = _strip_ansi_and_spinners(line)
                    if clean and " " not in clean and not clean.lower().startswith("available"):
                        add_model(clean, clean, src=f"{Path(bin_path).name} models")
                if models:
                    source_label = f"{Path(bin_path).name} models"
            except Exception:
                pass

    # 7. OTHER DYNAMIC PROVIDERS (pi, omp, jcode, grok, copilot, aider, goose)
    else:
        cmd_map = {
            "pi": (["pi"], ["--list-models"]),
            "omp": (["omp"], ["models"]),
            "jcode": (["jcode"], ["--no-update", "--quiet", "model", "list"]),
            "grok": (["grok"], ["models"]),
            "aider": (["aider"], ["--list-models", ""]),
        }
        if ag in cmd_map:
            bins, args_list = cmd_map[ag]
            bin_path = _find_cli_binary(bins, env)
            if bin_path:
                try:
                    res = subprocess.run([bin_path] + args_list, capture_output=True, text=True, env=env, timeout=6)
                    for line in (res.stdout or "").splitlines():
                        clean = _strip_ansi_and_spinners(line)
                        if clean and not clean.endswith(":"):
                            parts = clean.split()
                            if parts and ("/" in parts[0] or "-" in parts[0]):
                                add_model(parts[0].lstrip("*- "), clean, src=f"{ag} CLI")
                    if models:
                        source_label = f"{ag} CLI"
                except Exception:
                    pass

    # 8. Merge thêm từ Orca Local Cache (nếu có)
    for cached in _load_orca_cached_models(ag):
        if cached["id"] not in seen:
            seen.add(cached["id"])
            models.append(cached)
            if source_label == "provider-cli":
                source_label = "Orca ADE Cache"

    # Lưu cache phiên 120s
    if models:
        try:
            c_data = {}
            if cache_file.exists():
                c_data = json.loads(cache_file.read_text(encoding="utf-8", errors="ignore"))
            c_data[ag] = {"ts": time.time(), "source": source_label, "models": models}
            cache_file.write_text(json.dumps(c_data, ensure_ascii=False), encoding="utf-8")
        except Exception:
            pass

    return models, source_label


ROLE_TIER_MAP = {
    "coordinator": ("tier1", "high"),
    "developer": ("tier3", "high"),
    "qa": ("tier2", "high"),
    "security": ("tier2", "high"),
    "prReviewer": ("tier2", "high"),
    "issueResolver": ("tier2", "high"),
    "uiSpecialist": ("tier3", "high"),
    "devopsSpecialist": ("tier3", "high"),
    "benchSpecialist": ("tier3", "high"),
    "reSpecialist": ("tier2", "high"),
    "criticSpecialist": ("tier2", "high"),
}


def _model_rank_score(model_id: str | None, effort: str | None = "") -> int:
    """FIX-06: Điểm xếp hạng cấp độ suy luận của model + effort để đảm bảo QA >= Developer và QA thuộc Tier 2+ (effort >= high)."""
    mid = str(model_id or "").strip().lower()
    eff = (str(effort or "").strip().lower() or _extract_baked_effort(mid) or "medium")
    if any(k in mid for k in ("opus", "o1", "gpt-5.3", "gpt-5")):
        base = 300
    elif any(k in mid for k in ("argon", "sonnet", "fable", "o3", "k3", "r1", "glm")):
        base = 200
    elif "3.8-flash" in mid or "2.5-flash" in mid:
        base = 120
    elif any(k in mid for k in ("flash", "haiku", "mini")):
        base = 100
    else:
        base = 200
    eff_bonus = {"ultra": 35, "max": 35, "xhigh": 35, "high": 30, "medium": 15, "low": 5, "minimal": 0}.get(eff, 15)
    return base + eff_bonus

def recommend_model_index(models: list, role_tier: str = "tier2", target_effort: str = "high") -> int:
    """
    Chọn vị trí model (1-based) tối ưu nhất trong danh sách động theo kiến trúc Kim Tự Tháp (5% / 15% / 80%):
      - tier1 (Lead Coordinator): ưu tiên Opus + High (hoặc model suy luận kiến trúc đỉnh nhất)
      - tier2 (Security, Research & Critic, Reverse Eng, PR Reviewer, Issue Resolver): ưu tiên Gemini 4 Argon High / Sonnet High / O3
      - tier3 (Full-Stack Dev, QA, UI, DevOps, Bench): ưu tiên Gemini 3.8 Flash (High cho Dev/DevOps, Medium cho QA/UI) / Kimi K3
    """
    if not models:
        return 1
    eff = (target_effort or "high").lower()

    def score_model(m: dict) -> int:
        mid = m["id"].lower()
        lbl = m["label"].lower()
        baked = (m.get("bakedEffort") or "").lower()
        effs = [e.lower() for e in (m.get("efforts") or [])]
        s = 0
        if role_tier == "tier1":
            if "opus" in mid or "opus" in lbl:
                s += 100
            elif "argon" in mid or "o1" in mid or "gpt-5" in mid or "k3" in mid or "r1" in mid:
                s += 70
            elif "sonnet" in mid or "fable" in mid:
                s += 50
        elif role_tier == "tier2":
            if "argon" in mid or "argon" in lbl:
                s += 100
            elif "sonnet" in mid or "fable" in mid or "o3" in mid or "k3" in mid:
                s += 85
            elif "opus" in mid:
                s += 60
            elif "flash" in mid:
                s += 40
        else:  # tier3 (80% workload: Dev, QA, UI, DevOps - tối ưu tốc độ & quota)
            if "flash" in mid or "flash" in lbl:
                s += 100
            elif "k3" in mid or "kimi" in mid or "haiku" in mid or "mini" in mid or "sonnet" in mid:
                s += 85
            elif "argon" in mid:
                s += 50
            elif "opus" in mid:
                s += 10

        if baked == eff:
            s += 30
        elif not baked and eff in effs:
            s += 28
        elif baked == "high":
            s += 15
        elif baked == "medium":
            s += 10

        if "settings.json" not in m.get("source", ""):
            s += 5
        return s

    best_idx = 1
    best_score = -1
    for i, m in enumerate(models, 1):
        sc = score_model(m)
        if sc > best_score:
            best_score = sc
            best_idx = i
    return best_idx


def cmd_models(args: list):
    """
    Liệt kê danh sách model động từ Provider CLI của agent.
    Dùng: orca-team models <agent> [--json|--tsv] [--role <role>] [--tier tier1|tier2|tier3] [--effort low|medium|high] [--refresh]
    """
    agent = "antigravity"
    as_json = False
    as_tsv = False
    refresh = False
    role_tier = "tier2"
    target_effort = "high"
    explicit_tier = False
    explicit_effort = False

    idx = 0
    while idx < len(args):
        a = args[idx]
        if a in ("-h", "--help"):
            print("Usage: orca-team models [agent] [--agent <agent>] [--json|--tsv] [--refresh] [--role <role>] [--tier <tier1|tier2|tier3>] [--effort <low|medium|high>]")
            return
        elif a in ("--agent", "-a"):
            if idx + 1 >= len(args) or args[idx + 1].startswith("-"):
                print(f"❌ Thiếu giá trị cho '{a}'.", file=sys.stderr)
                sys.exit(1)
            agent = args[idx + 1].strip().lower()
            idx += 2
        elif a.startswith("--agent="):
            v = a.split("=", 1)[1].strip().lower()
            if not v or v.startswith("-"):
                print("❌ Thiếu giá trị cho '--agent='.", file=sys.stderr)
                sys.exit(1)
            agent = v
            idx += 1
        elif a == "--json":
            as_json = True
            idx += 1
        elif a == "--tsv":
            as_tsv = True
            idx += 1
        elif a == "--refresh":
            refresh = True
            idx += 1
        elif a == "--tier":
            if idx + 1 >= len(args) or args[idx + 1].startswith("-"):
                print("❌ Thiếu giá trị cho '--tier'.", file=sys.stderr)
                sys.exit(1)
            role_tier = args[idx + 1].strip()
            explicit_tier = True
            idx += 2
        elif a.startswith("--tier="):
            v = a.split("=", 1)[1].strip()
            if not v or v.startswith("-"):
                print("❌ Thiếu giá trị cho '--tier='.", file=sys.stderr)
                sys.exit(1)
            role_tier = v
            explicit_tier = True
            idx += 1
        elif a == "--effort":
            if idx + 1 >= len(args) or args[idx + 1].startswith("-"):
                print("❌ Thiếu giá trị cho '--effort'.", file=sys.stderr)
                sys.exit(1)
            target_effort = args[idx + 1].strip()
            explicit_effort = True
            idx += 2
        elif a.startswith("--effort="):
            v = a.split("=", 1)[1].strip()
            if not v or v.startswith("-"):
                print("❌ Thiếu giá trị cho '--effort='.", file=sys.stderr)
                sys.exit(1)
            target_effort = v
            explicit_effort = True
            idx += 1
        elif a == "--role":
            if idx + 1 >= len(args) or args[idx + 1].startswith("-"):
                print("❌ Thiếu giá trị cho '--role'.", file=sys.stderr)
                sys.exit(1)
            r_key = ROLE_ALIASES.get(args[idx + 1].strip().lower(), args[idx + 1].strip())
            def_t, def_e = ROLE_TIER_MAP.get(r_key, ("tier2", "high"))
            if not explicit_tier:
                role_tier = def_t
            if not explicit_effort:
                target_effort = def_e
            idx += 2
        elif a.startswith("--role="):
            v = a.split("=", 1)[1].strip()
            if not v or v.startswith("-"):
                print("❌ Thiếu giá trị cho '--role='.", file=sys.stderr)
                sys.exit(1)
            r_key = ROLE_ALIASES.get(v.lower(), v)
            def_t, def_e = ROLE_TIER_MAP.get(r_key, ("tier2", "high"))
            if not explicit_tier:
                role_tier = def_t
            if not explicit_effort:
                target_effort = def_e
            idx += 1
        elif not a.startswith("-"):
            agent = a.lower()
            idx += 1
        else:
            print(f"❌ Tùy chọn không hợp lệ: '{a}'.", file=sys.stderr)
            sys.exit(1)

    models, source_label = discover_models_for_agent(agent, refresh=refresh)
    rec_idx = recommend_model_index(models, role_tier, target_effort)

    if as_json:
        print(json.dumps({
            "agent": agent,
            "source": source_label,
            "recommendedIndex": rec_idx,
            "models": models
        }, ensure_ascii=False, indent=2))
        return

    if as_tsv:
        # Dạng TSV gọn nhẹ cho shell script (orca-project-init):
        # Dòng 1: META\t<source_label>\t<rec_idx>
        # Các dòng sau: MODEL\t<id>\t<label>\t<bakedEffort>\t<efforts_csv>
        clean_src = str(source_label or "provider-cli").replace("\t", " ").replace("\n", " ")
        print(f"META\t{clean_src}\t{rec_idx if models else 0}")
        for m in models:
            mid_val = str(m.get("id") or "").replace("\t", " ").replace("\n", " ").strip()
            lbl_val = str(m.get("label") or mid_val).replace("\t", " ").replace("\n", " ").strip()
            baked_val = str(m.get("bakedEffort") or "-").replace("\t", " ").replace("\n", " ").strip()
            eff_csv = ",".join(str(x).strip() for x in (m.get("efforts") or []) if str(x).strip()) or "-"
            print(f"MODEL\t{mid_val}\t{lbl_val}\t{baked_val}\t{eff_csv}")
        return

    print(f"\n🔍 Danh sách Model truy vấn động cho agent '{agent}' (Nguồn: {source_label}):")
    if not models:
        print(f"   ⚠️ Không tìm thấy CLI hoặc danh sách model động cho '{agent}'.")
        return
    for i, m in enumerate(models, 1):
        rec_tag = " ⭐ (khuyến nghị)" if i == rec_idx else ""
        eff_info = f" [effort tích hợp: {m['bakedEffort']}]" if m.get("bakedEffort") else (
            f" [efforts: {', '.join(m['efforts'])}]" if m.get("efforts") else ""
        )
        lbl_str = f" — {m['label']}" if m["label"] != m["id"] else ""
        print(f"  {i:>2}) {m['id']:<28}{lbl_str}{eff_info}{rec_tag}")
    print("")

def read_terminal_key(fd: int) -> str:
    """Đọc 1 phím hoặc escape sequence từ terminal raw mode (unbuffered os.read trên fd).

    LƯU Ý QUAN TRỌNG: Tuyệt đối KHÔNG dùng `sys.stdin.read(1)` kết hợp `select.select`,
    vì `sys.stdin` (BufferedReader) sẽ hút toàn bộ 3 byte `\\x1b[A` từ kernel buffer vào
    user-space buffer trong lần đọc đầu tiên, khiến `select.select` báo rỗng và trả về
    nhầm phím `\\x1b` (ESC -> hủy cài đặt) khi người dùng bấm mũi tên Lên/Xuống!
    """
    b1 = os.read(fd, 1)
    if not b1:
        return '\x04'
    if b1 == b'\x1b':
        r, _, _ = select.select([fd], [], [], 0.10)
        if not r:
            return '\x1b'
        b2 = os.read(fd, 1)
        if not b2:
            return '\x1b'
        if b2 == b'\x1b':
            # Một số terminal gửi Alt+Arrow dưới dạng ESC ESC [ A hoặc ESC ESC O A
            r_alt, _, _ = select.select([fd], [], [], 0.05)
            if not r_alt:
                return '\x1b'
            b2 = os.read(fd, 1)
            if not b2:
                return '\x1b'
        if b2 == b'[':
            # Chuỗi CSI: ESC [ <params> <final byte trong khoảng 0x40..0x7E (@..~)>
            seq = bytearray()
            for _ in range(16):
                r2, _, _ = select.select([fd], [], [], 0.05)
                if not r2:
                    break
                b_next = os.read(fd, 1)
                if not b_next:
                    break
                seq.extend(b_next)
                if 0x40 <= b_next[0] <= 0x7E:
                    break
            if not seq:
                return '\x1b['
            if seq == bytearray(b'M'):
                # Chuỗi X10 mouse (\x1b[M + 3 byte tọa độ): hút bỏ 3 byte tọa độ để không rò rỉ vào phím kế tiếp
                for _ in range(3):
                    rm, _, _ = select.select([fd], [], [], 0.02)
                    if not rm or not os.read(fd, 1):
                        break
                return '\x1b[M'
            csi_body = seq.decode('latin1', errors='ignore')
            final_ch = csi_body[-1]
            # Chuẩn hóa các phím điều hướng (kể cả khi kèm modifier như \x1b[1;2A)
            if final_ch in ('A', 'B', 'C', 'D', 'H', 'F'):
                return f'\x1b[{final_ch}'
            return f'\x1b[{csi_body}'
        elif b2 == b'O':
            # Chuỗi SS3 (Application Cursor Mode): ESC O A/B/C/D/H/F
            r2, _, _ = select.select([fd], [], [], 0.05)
            if r2:
                b3 = os.read(fd, 1)
                if b3:
                    return '\x1bO' + b3.decode('latin1', errors='ignore')
            return '\x1bO'
        return '\x1b' + b2.decode('latin1', errors='ignore')

    # Nếu là byte đầu của ký tự UTF-8 đa byte (ví dụ bộ gõ tiếng Việt đang bật), đọc nốt các byte tiếp theo
    if b1[0] >= 0x80:
        buf = bytearray(b1)
        for _ in range(3):
            r_utf, _, _ = select.select([fd], [], [], 0.01)
            if not r_utf:
                break
            b_more = os.read(fd, 1)
            if not b_more:
                break
            buf.extend(b_more)
        return buf.decode('utf-8', errors='replace')

    return b1.decode('latin1', errors='ignore')

def interactive_select(
    title: str,
    items: list,
    default_idx: int = 0,
    hint: str = "Dùng phím ↑/↓ hoặc j/k để di chuyển con trỏ, Enter để chọn",
    max_visible: int = 14
) -> tuple:
    """
    Menu điều hướng bằng con trỏ / phím mũi tên (Arrow Keys Interactive TUI).
    Trả về (selected_index, selected_item_str).
    Nếu không phải môi trường TTY tương tác, trả về giá trị mặc định.
    """
    if not items:
        return -1, ""

    current_idx = max(0, min(default_idx, len(items) - 1))

    # Kiểm tra stderr tương tác & lấy fd đọc bàn phím (hỗ trợ cả khi stdin là pipe bằng cách mở /dev/tty)
    if not sys.stderr.isatty():
        return current_idx, items[current_idx]

    import signal
    opened_tty_fd = None
    if sys.stdin.isatty():
        fd = sys.stdin.fileno()
    else:
        try:
            opened_tty_fd = os.open("/dev/tty", os.O_RDONLY)
            fd = opened_tty_fd
        except OSError:
            return current_idx, items[current_idx]

    try:
        old_settings = termios.tcgetattr(fd)
    except Exception:
        if opened_tty_fd is not None:
            os.close(opened_tty_fd)
        return current_idx, items[current_idx]

    try:
        t_rows = shutil.get_terminal_size().lines
        eff_max = max(5, min(max_visible, t_rows - 6))
    except Exception:
        eff_max = max_visible

    def render_menu(start_i: int, cur_i: int) -> int:
        lines_count = 0
        end_i = min(start_i + eff_max, len(items))
        if start_i > 0:
            sys.stderr.write("     \033[90m▲  (...còn phía trên)\033[0m\r\n")
            lines_count += 1
        for i in range(start_i, end_i):
            it = items[i]
            prefix = f"{i+1:>2})"
            if i == cur_i:
                sys.stderr.write(f"\033[1;36m  ❯ {prefix} {it}\033[0m\r\n")
            else:
                sys.stderr.write(f"    {prefix} {it}\r\n")
            lines_count += 1
        if end_i < len(items):
            sys.stderr.write("     \033[90m▼  (...còn phía dưới)\033[0m\r\n")
            lines_count += 1
        sys.stderr.flush()
        return lines_count

    start_idx = 0
    if current_idx >= eff_max:
        start_idx = current_idx - eff_max + 1

    last_rendered_lines = 0
    prev_sigterm = None
    prev_sighup = None

    def _sig_restore(signum, frame):
        raise KeyboardInterrupt

    try:
        prev_sigterm = signal.signal(signal.SIGTERM, _sig_restore)
        prev_sighup = signal.signal(signal.SIGHUP, _sig_restore)
        tty.setraw(fd, when=termios.TCSANOW)
        # Ẩn con trỏ terminal trong lúc tương tác
        sys.stderr.write("\033[?25l")
        sys.stderr.write(f"\r\n\033[1m{title}\033[0m\r\n")
        sys.stderr.write(f"\033[90m({hint})\033[0m\r\n")
        sys.stderr.flush()
        last_rendered_lines = render_menu(start_idx, current_idx)

        while True:
            k = read_terminal_key(fd)
            if k in ('\x1b[A', '\x1bOA', 'k', 'K'):  # Mũi tên Lên / k
                current_idx = (current_idx - 1) % len(items)
            elif k in ('\x1b[B', '\x1bOB', 'j', 'J'):  # Mũi tên Xuống / j
                current_idx = (current_idx + 1) % len(items)
            elif k in ('\x1b[H', '\x1b[1~', '\x1b[7~', '\x1bOH', 'g'):  # Home
                current_idx = 0
            elif k in ('\x1b[F', '\x1b[4~', '\x1b[8~', '\x1bOF', 'G'):  # End
                current_idx = len(items) - 1
            elif k == '\x1b[5~':  # PageUp
                current_idx = max(0, current_idx - eff_max)
            elif k == '\x1b[6~':  # PageDown
                current_idx = min(len(items) - 1, current_idx + eff_max)
            elif k in ('\r', '\n', ' '):  # Enter hoặc Space để xác nhận
                break
            elif k in ('\x03', '\x04', 'q', 'Q', '\x1b'):  # Ctrl+C / Ctrl+D / Esc / q -> Hủy thao tác
                raise KeyboardInterrupt
            elif k.isascii() and k.isdigit() and 1 <= int(k) <= len(items):  # Phím tắt số nhanh
                current_idx = int(k) - 1
                break

            # Điều chỉnh cửa sổ cuộn
            if current_idx < start_idx:
                start_idx = current_idx
            elif current_idx >= start_idx + eff_max:
                start_idx = current_idx - eff_max + 1

            # Xóa các dòng menu cũ và vẽ lại vị trí con trỏ mới
            sys.stderr.write(f"\033[{last_rendered_lines}A\r\033[0J")
            last_rendered_lines = render_menu(start_idx, current_idx)

    finally:
        # Xóa khối menu vừa hiển thị để giữ màn hình gọn đẹp
        if last_rendered_lines > 0:
            sys.stderr.write(f"\033[{last_rendered_lines}A\033[0J")
        # Hiện lại con trỏ terminal
        sys.stderr.write("\033[?25h")
        sys.stderr.flush()
        try:
            termios.tcsetattr(fd, termios.TCSANOW, old_settings)
        except Exception:
            pass
        if opened_tty_fd is not None:
            try:
                os.close(opened_tty_fd)
            except Exception:
                pass
        if prev_sigterm is not None:
            try:
                signal.signal(signal.SIGTERM, prev_sigterm)
            except Exception:
                pass
        if prev_sighup is not None:
            try:
                signal.signal(signal.SIGHUP, prev_sighup)
            except Exception:
                pass

    selected_val = items[current_idx]
    clean_val = re.sub(r"\s*⭐.*$", "", selected_val).strip()
    sys.stderr.write(f"   ➔ Đã chọn: \033[1;32m{clean_val}\033[0m\r\n")
    sys.stderr.flush()
    return current_idx, selected_val

def cmd_select(args: list):
    """
    Menu con trỏ chọn tương tác cho shell script và CLI.
    Dùng: orca-team select --title "..." [--options item1 item2 ...] [--default-idx 0] [--return-idx]
    """
    title = "Chọn một mục:"
    items = []
    default_idx = 0
    return_idx = False

    idx = 0
    while idx < len(args):
        a = args[idx]
        if a == "--title" and idx + 1 < len(args):
            title = args[idx + 1]
            idx += 2
        elif a in ("--default-idx", "--default") and idx + 1 < len(args):
            try:
                default_idx = int(args[idx + 1])
            except ValueError:
                pass
            idx += 2
        elif a in ("--return-idx", "--index"):
            return_idx = True
            idx += 1
        elif a == "--options-json" and idx + 1 < len(args):
            try:
                parsed = json.loads(args[idx + 1])
                if isinstance(parsed, list):
                    items = [str(x) for x in parsed]
            except Exception:
                pass
            idx += 2
        elif a in ("--options", "--items"):
            idx += 1
            while idx < len(args) and not args[idx].startswith("--"):
                items.append(args[idx])
                idx += 1
        elif a in ("--option", "--item") and idx + 1 < len(args):
            items.append(args[idx + 1])
            idx += 2
        else:
            idx += 1

    if not items and not sys.stdin.isatty():
        lines = [l.strip() for l in sys.stdin.readlines() if l.strip()]
        if lines:
            items = lines

    if not items:
        return

    try:
        chosen_i, chosen_val = interactive_select(title, items, default_idx=default_idx)
        if return_idx:
            # 1-based index cho zsh/bash
            print(chosen_i + 1)
        else:
            print(chosen_val)
    except KeyboardInterrupt:
        sys.stderr.write("\r\nĐã hủy.\r\n")
        sys.exit(130)


def cmd_status(root: Path, config: dict):
    if not config:
        print(f"⚠️ Không tìm thấy cấu hình orca-team.json trong '{root}'.")
        print("👉 Hãy khởi tạo trước bằng: orca-project-init")
        sys.exit(1)

    print("\n╔════════════════════════════════════════════════════════════════════════════════════════════════════╗")
    print("║                     🐋  ORCA MULTI-AGENT TEAM TOPOLOGY & MODEL CONFIGURATION                       ║")
    print("╚════════════════════════════════════════════════════════════════════════════════════════════════════╝")
    print(f"📍 Dự án: {root}")
    print(f"🌐 Host thực thi: {config.get('executionHost', 'local')}\n")

    print(f"{'VAI TRÒ (ROLE)':<24} | {'AGENT':<12} | {'MODEL':<26} | {'EFFORT':<8} | {'SONG SONG':<10} | {'GOAL MODE'}")
    print("-" * 100)

    _ensure_critic_defaults(config)
    coord = config.get("coordinator") or {}
    c_agent = coord.get("agent") or "claude"
    c_model = coord.get("model") or "(default)"
    c_effort = coord.get("effort") or "-"
    c_goal = "🎯 /goal" if _is_goal_mode_enabled(coord, config) else "OFF"
    print(f"{'1. Lead Coordinator':<24} | {c_agent:<12} | {c_model:<26} | {c_effort:<8} | {'1':<10} | {c_goal}")

    roles = config.get("roles", {})
    role_order = [
        ("developer", "2. Full-Stack Devs"),
        ("qa", "3. QA & Testers"),
        ("security", "4. Security & Bug"),
        ("prReviewer", "5. PR Reviewer"),
        ("issueResolver", "6. Issue Resolver"),
        ("uiSpecialist", "7. UI/UX Specialist"),
        ("devopsSpecialist", "8. DevOps Infra"),
        ("benchSpecialist", "9. Bench & Perf"),
        ("reSpecialist", "10. Reverse Eng (REA)"),
        ("criticSpecialist", "11. Research & Critic"),
    ]

    for key, label in role_order:
        data = roles.get(key, {})
        is_opt = key in ("uiSpecialist", "devopsSpecialist", "benchSpecialist", "reSpecialist", "criticSpecialist")
        enabled = _is_role_enabled(data, is_optional=is_opt)
        if not enabled:
            print(f"{label:<24} | {'[ĐÃ TẮT]':<12} | {'-':<26} | {'-':<8} | {'-':<10} | -")
            continue
        agent = data.get("agent") or "kimi"
        model = data.get("model") or "(default)"
        effort = data.get("effort") or "-"
        conc = "On-demand" if key in ("prReviewer", "issueResolver") else "Auto-scale"
        r_goal = "🎯 /goal" if _is_goal_mode_enabled(data, config) else "OFF"
        print(f"{label:<24} | {agent:<12} | {model:<26} | {effort:<8} | {conc:<10} | {r_goal}")

    print("-" * 100)
    qa_cfg = roles.get("qa") or {}
    dev_cfg = roles.get("developer") or {}
    if _is_role_enabled(qa_cfg, is_optional=False) and _is_role_enabled(dev_cfg, is_optional=False):
        qa_sc = _model_rank_score(qa_cfg.get("model"), qa_cfg.get("effort"))
        dev_sc = _model_rank_score(dev_cfg.get("model"), dev_cfg.get("effort"))
        if qa_sc < dev_sc:
            print(
                f"\033[1;31m⚠️ CẢNH BÁO [FIX-06]: Model của QA ({qa_cfg.get('model')} / {qa_cfg.get('effort')}) "
                f"có cấp độ suy luận thấp hơn Developer ({dev_cfg.get('model')} / {dev_cfg.get('effort')})!\n"
                f"   👉 Khuyến nghị nâng cấp ngay: orca-team set qa --model gemini-4-argon-high --effort high\033[0m\n"
            )
    print("💡 Xem model từ CLI của provider: orca-team models <agent>")
    print("💡 Thay đổi cấu hình role:        orca-team set <role> [--agent <id>] [--model <model_id>] [--effort <low|med|high>] [--goal|--no-goal]")
    print("💡 Cấp phát worktree tự động:     orca-team worktree-arg <role>\n")

def cmd_set(root: Path, config: dict, args: list):
    if args and any(a in ("-h", "--help", "help") for a in args):
        print("Sử dụng: orca-team set <role|all> [--agent <id>] [--model <model_id>] [--effort <low|medium|high>] [--goal|--no-goal] [--enable|--disable]")
        print("👉 Các role hợp lệ: coord, dev, qa, sec, pr, issue, ui, devops, bench, re, critic, all")
        return

    if not config:
        print(f"❌ Không tìm thấy orca-team.json trong '{root}'.", file=sys.stderr)
        sys.exit(1)

    _ensure_critic_defaults(config)

    if not args:
        print("❌ Thiếu vai trò cần cấu hình. Dùng: orca-team set <role> [options]", file=sys.stderr)
        print("👉 Các role hợp lệ: coord, dev, qa, sec, pr, issue, ui, devops, bench, re, critic, all", file=sys.stderr)
        sys.exit(1)

    role_raw = args[0].lower()
    is_all_roles = role_raw in ("all", "*", "team")
    if is_all_roles:
        role_key = "all"
    elif role_raw in ROLE_ALIASES:
        role_key = ROLE_ALIASES.get(role_raw)
    elif _is_role_or_slot_token(role_raw):
        role_key = _resolve_role_and_slot(role_raw)[0]
    else:
        role_key = None
    if not role_key:
        print(f"❌ Vai trò không hợp lệ: '{role_raw}'.", file=sys.stderr)
        print(f"👉 Hợp lệ: all, {', '.join(sorted(set(ROLE_ALIASES.keys())))}", file=sys.stderr)
        sys.exit(1)

    # Parse options
    new_agent = None
    new_model = None
    new_effort = None
    new_concurrency = None
    new_goal_mode = None
    toggle_enable = None
    sync_only = False
    force_flag = False

    idx = 1
    while idx < len(args):
        opt = args[idx]
        if opt == "--agent":
            if idx + 1 >= len(args) or args[idx + 1].startswith("-"):
                print("❌ Thiếu giá trị cho '--agent'. Dùng: orca-team set <role> --agent <agent_id>", file=sys.stderr)
                sys.exit(1)
            new_agent = args[idx + 1].strip().lower()
            idx += 2
        elif opt.startswith("--agent="):
            v = opt.split("=", 1)[1].strip().lower()
            if not v or v.startswith("-"):
                print("❌ Thiếu giá trị cho '--agent='.", file=sys.stderr)
                sys.exit(1)
            new_agent = v
            idx += 1
        elif opt == "--model":
            if idx + 1 >= len(args) or (args[idx + 1].startswith("-") and args[idx + 1] != "-"):
                print("❌ Thiếu giá trị cho '--model'. Dùng: orca-team set <role> --model <model_id>", file=sys.stderr)
                sys.exit(1)
            m_val = args[idx + 1].strip()
            new_model = "" if m_val.lower() in ("none", "null", "default", "(default)", "-") else m_val
            idx += 2
        elif opt.startswith("--model="):
            m_val = opt.split("=", 1)[1].strip()
            if not m_val or (m_val.startswith("-") and m_val != "-"):
                print("❌ Thiếu giá trị cho '--model='.", file=sys.stderr)
                sys.exit(1)
            new_model = "" if m_val.lower() in ("none", "null", "default", "(default)", "-") else m_val
            idx += 1
        elif opt == "--effort":
            if idx + 1 >= len(args) or (args[idx + 1].startswith("-") and args[idx + 1] != "-"):
                print("❌ Thiếu giá trị cho '--effort'. Dùng: orca-team set <role> --effort <low|medium|high>", file=sys.stderr)
                sys.exit(1)
            e_val = args[idx + 1].strip().lower()
            new_effort = "" if e_val in ("none", "null", "off", "-") else e_val
            idx += 2
        elif opt.startswith("--effort="):
            e_val = opt.split("=", 1)[1].strip().lower()
            if not e_val or (e_val.startswith("-") and e_val != "-"):
                print("❌ Thiếu giá trị cho '--effort='.", file=sys.stderr)
                sys.exit(1)
            new_effort = "" if e_val in ("none", "null", "off", "-") else e_val
            idx += 1
        elif opt == "--concurrency" or opt.startswith("--concurrency="):
            if opt == "--concurrency":
                if idx + 1 >= len(args) or args[idx + 1].startswith("-"):
                    print("❌ Thiếu giá trị cho '--concurrency'.", file=sys.stderr)
                    sys.exit(1)
                idx += 2
            else:
                idx += 1
            new_concurrency = "auto"
        elif opt == "--goal":
            new_goal_mode = True
            idx += 1
        elif opt == "--no-goal":
            new_goal_mode = False
            idx += 1
        elif opt.startswith("--goal="):
            gv = opt.split("=", 1)[1].strip().lower()
            if gv in ("1", "true", "on", "yes"):
                new_goal_mode = True
            elif gv in ("0", "false", "off", "no"):
                new_goal_mode = False
            else:
                print(f"❌ Giá trị không hợp lệ cho '--goal=': '{gv}' (hợp lệ: true/false, on/off).", file=sys.stderr)
                sys.exit(1)
            idx += 1
        elif opt == "--enable":
            toggle_enable = True
            idx += 1
        elif opt == "--disable":
            toggle_enable = False
            idx += 1
        elif opt == "--reset-model":
            new_model = ""
            idx += 1
        elif opt == "--reset-effort":
            new_effort = ""
            idx += 1
        elif opt in ("--sync", "-y", "--yes"):
            # Không return sớm: áp dụng các cờ đã parse rồi mới đồng bộ (trước đây cờ đứng trước --sync bị bỏ qua)
            sync_only = True
            idx += 1
        elif opt in ("--force", "-f"):
            force_flag = True
            idx += 1
        elif not opt.startswith("-") and new_model is None:
            new_model = opt.strip()
            idx += 1
        else:
            print(f"❌ Tùy chọn không hợp lệ: '{opt}'. Dùng 'orca-team --help' để xem danh sách cờ hỗ trợ.", file=sys.stderr)
            sys.exit(1)

    if new_agent is not None and new_agent not in KNOWN_AGENTS and not force_flag:
        print(f"❌ Agent không hợp lệ: '{new_agent}'. Hợp lệ: {', '.join(KNOWN_AGENTS)} (dùng --force để bỏ qua kiểm tra).", file=sys.stderr)
        sys.exit(1)
    if new_effort and new_effort.lower() not in VALID_EFFORTS and not force_flag:
        print(f"❌ Effort không hợp lệ: '{new_effort}'. Hợp lệ: {', '.join(sorted(VALID_EFFORTS))}.", file=sys.stderr)
        sys.exit(1)
    if new_effort:
        new_effort = new_effort.lower()

    if is_all_roles:
        if new_goal_mode is None and not sync_only:
            print("❌ Với vai trò 'all', hãy truyền '--goal' hoặc '--no-goal' (ví dụ: orca-team set all --goal).", file=sys.stderr)
            sys.exit(1)
        if new_goal_mode is not None:
            config["goalMode"] = new_goal_mode
            config.setdefault("coordinator", {})["goalMode"] = new_goal_mode
            for r_obj in config.setdefault("roles", {}).values():
                if isinstance(r_obj, dict):
                    r_obj["goalMode"] = new_goal_mode
                    r_obj.pop("concurrency", None)
            save_config(root, config)
            sync_gemini_directive(root, config)
            state_lbl = "BẬT (🎯 /goal)" if new_goal_mode else "TẮT (OFF)"
            print(f"\n✅ Đã cập nhật Chế độ /goal = {state_lbl} cho TOÀN BỘ 11 vai trò trong 'orca-team.json' và '.agents/GEMINI.md'.\n")
        else:
            sync_gemini_directive(root, config)
            print("📁 Đã đồng bộ lại '.agents/GEMINI.md' từ 'orca-team.json'.")
        return

    if sync_only and new_agent is None and new_model is None and new_effort is None and new_concurrency is None and new_goal_mode is None and toggle_enable is None:
        sync_gemini_directive(root, config)
        print("📁 Đã đồng bộ lại '.agents/GEMINI.md' từ 'orca-team.json'.")
        return

    # Interactive prompt if no flags provided
    if new_agent is None and new_model is None and new_effort is None and new_concurrency is None and new_goal_mode is None and toggle_enable is None:
        if not (sys.stdin.isatty() and sys.stderr.isatty()):
            print(
                "❌ Môi trường không có TTY tương tác. Hãy truyền cờ tường minh: "
                "orca-team set <role> [--agent <id>] [--model <id>] [--effort <low|medium|high>]",
                file=sys.stderr,
            )
            sys.exit(1)
        role_label = ROLE_LABELS.get(role_key, role_key)
        print(f"\n⚙️  Cấu hình tương tác cho vai trò: {role_label}")
        current = (config.get("coordinator") if role_key == "coordinator" else config.get("roles", {}).get(role_key)) or {}
        raw_curr_agent = current.get("agent")
        curr_agent = raw_curr_agent if (raw_curr_agent and raw_curr_agent != "none") else ((config.get("coordinator") or {}).get("agent") or "antigravity")
        curr_model = current.get("model") or "mặc định"
        curr_effort = current.get("effort") or "-"
        if current.get("enabled") is False:
            toggle_enable = True
            print(f"   Hiện tại: [ĐÃ TẮT] ➔ Sẽ tự động kích hoạt sau khi chọn cấu hình")
        else:
            print(f"   Hiện tại: Agent={curr_agent} | Model={curr_model} | Effort={curr_effort}")

        try:
            agent_list = list(KNOWN_AGENTS) if curr_agent in KNOWN_AGENTS else [curr_agent] + list(KNOWN_AGENTS)
            agent_options = [ag + (" (hiện tại)" if ag == curr_agent else "") for ag in agent_list]
            def_agent_idx = agent_list.index(curr_agent)
            ag_i, _ = interactive_select(
                f"👉 Chọn Agent cho vai trò [{role_label}]:",
                agent_options,
                default_idx=def_agent_idx
            )
            target_agent = agent_list[ag_i]
            if target_agent != raw_curr_agent:
                new_agent = target_agent

            # Truy vấn động danh sách model từ CLI của provider target_agent
            role_tier, def_eff = ROLE_TIER_MAP.get(role_key, ("tier2", "high"))
            print(f"   ⏳ Đang truy vấn danh sách model từ CLI của '{target_agent}'...")
            models, src_label = discover_models_for_agent(target_agent)
            if models:
                rec_idx = recommend_model_index(models, role_tier, def_eff)
                model_menu = []
                for i, m in enumerate(models, 1):
                    rec_str = f" ⭐ (khuyến nghị cho {role_label})" if i == rec_idx else ""
                    lbl_str = f" — {m['label']}" if m["label"] != m["id"] else ""
                    eff_str = f" [{m['bakedEffort']}]" if m.get("bakedEffort") else ""
                    model_menu.append(f"{m['id']}{lbl_str}{eff_str}{rec_str}")
                model_menu.append("Nhập model ID tùy chỉnh...")
                model_menu.append(f"Giữ nguyên ({curr_model})")
                model_menu.append("Bỏ chọn model (mặc định Orca ADE)")

                def_m_idx = rec_idx - 1
                for idx_chk, m in enumerate(models):
                    if m["id"] == curr_model:
                        def_m_idx = idx_chk
                        break

                m_i, _ = interactive_select(
                    f"👉 Chọn Model cho agent '{target_agent}' ({role_label}) — Nguồn: {src_label}:",
                    model_menu,
                    default_idx=def_m_idx
                )
                if m_i < len(models):
                    chosen = models[m_i]
                    new_model = chosen["id"]
                    if chosen.get("bakedEffort"):
                        new_effort = chosen["bakedEffort"]
                elif m_i == len(models):  # Nhập tùy chỉnh
                    c_in = input("   Nhập model ID tùy chỉnh: ").strip()
                    if c_in:
                        new_model = c_in
                elif m_i == len(models) + 1:  # Giữ nguyên
                    pass
                else:  # Bỏ chọn model
                    new_model = ""
            else:
                model_input = input(f"   Nhập model ID mới (Enter = giữ nguyên, 'none' = bỏ chọn model): ").strip()
                if model_input.lower() == "none":
                    new_model = ""
                elif model_input:
                    new_model = model_input

            # Nếu model đã chọn chưa tích hợp sẵn effort trong ID và agent/model hỗ trợ --effort thì mới hỏi tiếp effort
            final_model_id = new_model if new_model is not None else (current.get("model") or "")
            baked_eff = _extract_baked_effort(final_model_id) if final_model_id else ""
            if not _supports_effort_py(target_agent, final_model_id):
                new_effort = ""
                print(f"   ➔ Agent '{target_agent}' / model '{final_model_id or 'default'}' không dùng cờ --effort riêng (tự động đặt effort = -)")
            elif baked_eff:
                new_effort = baked_eff
                print(f"   ➔ Reasoning Effort tự động theo model: {new_effort}")
            else:
                effort_choices = ["high (khuyến nghị suy luận cao)", "medium", "low", "none (tắt reasoning)"]
                eff_def_idx = 0 if def_eff == "high" else (1 if def_eff == "medium" else 2)
                eff_i, _ = interactive_select(
                    f"👉 Chọn Reasoning Effort cho model '{final_model_id or 'mặc định'}':",
                    effort_choices,
                    default_idx=eff_def_idx
                )
                if eff_i == 0:
                    new_effort = "high"
                elif eff_i == 1:
                    new_effort = "medium"
                elif eff_i == 2:
                    new_effort = "low"
                else:
                    new_effort = ""

            if role_key != "coordinator":
                print("   ➔ Cơ chế Song song: Auto-scale (tự động tái sử dụng worktree rảnh hoặc đẻ thêm slot mới khi bận)")
        except (EOFError, KeyboardInterrupt):
            sys.stderr.write("\r\n🚫 Đã hủy thao tác cấu hình.\r\n")
            sys.exit(130)


    # Apply changes
    if role_key == "coordinator":
        target = config.setdefault("coordinator", {})
    else:
        target = config.setdefault("roles", {}).setdefault(role_key, {})

    changes = []
    old_agent_val = (target.get("agent") or "").strip().lower()
    if new_agent and new_agent != old_agent_val and new_model is None and target.get("model"):
        # Khi đổi sang provider khác mà không truyền --model, xóa model cũ của provider trước để tránh xung đột
        if not ({old_agent_val, new_agent} <= {"antigravity", "gemini"}):
            new_model = ""
    if new_agent and new_agent == target.get("agent"):
        new_agent = None
    if new_model is not None and (None if new_model == "" else new_model) == target.get("model"):
        new_model = None
    if new_effort is not None and (None if new_effort == "" else new_effort) == target.get("effort"):
        new_effort = None
    if new_agent:
        old_agent = target.get("agent")
        target["agent"] = new_agent
        changes.append(f"Agent: {old_agent} ➔ {new_agent}")

    if new_model is not None:
        old_model = target.get("model") or "(default)"
        val = None if new_model == "" else new_model
        target["model"] = val
        changes.append(f"Model: {old_model} ➔ {val or '(default)'}")

    OPTIONAL_ROLES = ("uiSpecialist", "devopsSpecialist", "benchSpecialist", "reSpecialist", "criticSpecialist")
    if toggle_enable is not None:
        if toggle_enable is False and role_key not in OPTIONAL_ROLES:
            print(
                f"❌ Vai trò cốt lõi '{ROLE_LABELS.get(role_key, role_key)}' là bắt buộc, không thể tắt (--disable). "
                "Chỉ có thể bật/tắt các vai trò chuyên biệt: ui, devops, bench, re, critic.",
                file=sys.stderr,
            )
            sys.exit(1)
        old_en = target.get("enabled", True)
        target["enabled"] = toggle_enable
        changes.append(f"Enabled: {old_en} ➔ {toggle_enable}")
    elif (new_agent or new_model is not None) and target.get("enabled") is False:
        target["enabled"] = True
        changes.append("Enabled: False ➔ True (tự động kích hoạt khi gán Agent/Model)")

    # Tự động kế thừa Agent/Model/Effort khi bật role có agent='none' (cả qua --enable hoặc qua --model)
    if (toggle_enable is True or ((new_agent or new_model is not None) and target.get("enabled") is True)) and not new_agent and target.get("agent") in (None, "", "none"):
        fallback_role = config.get("roles", {}).get("security" if role_key in ("reSpecialist", "criticSpecialist") else "developer", {})
        fb_agent = fallback_role.get("agent") or (config.get("coordinator") or {}).get("agent") or "antigravity"
        if fb_agent == "none":
            fb_agent = "antigravity"
        target["agent"] = fb_agent
        changes.append(f"Agent: none ➔ {fb_agent} (tự động kế thừa khi bật role)")
        if new_model is None and not target.get("model") and fallback_role.get("model"):
            target["model"] = fallback_role.get("model")
            changes.append(f"Model: (default) ➔ {target['model']}")
        if new_effort is None and not target.get("effort"):
            baked_init = _extract_baked_effort(str(target.get("model") or ""))
            if baked_init:
                target["effort"] = baked_init
            elif _supports_effort_py(fb_agent, str(target.get("model") or "")):
                target["effort"] = "medium" if role_key == "uiSpecialist" else "high"
            if target.get("effort"):
                changes.append(f"Effort: - ➔ {target['effort']}")

    if new_effort is None and (new_agent or new_model is not None):
        eff_ag = target.get("agent") or ""
        eff_mod = target.get("model") or ""
        if not _supports_effort_py(eff_ag, eff_mod):
            if target.get("effort"):
                new_effort = ""
        elif new_model:
            baked_from_mod = _extract_baked_effort(new_model)
            if baked_from_mod and baked_from_mod != target.get("effort"):
                new_effort = baked_from_mod

    if new_effort is not None:
        old_eff = target.get("effort") or "-"
        val = None if new_effort == "" else new_effort
        target["effort"] = val
        changes.append(f"Effort: {old_eff} ➔ {val or '-'}")

    if "concurrency" in target:
        target.pop("concurrency", None)
        if new_concurrency is not None:
            changes.append("Concurrency: Auto-scale (tự động tái sử dụng worktree rảnh hoặc đẻ thêm slot mới khi bận)")
    elif new_concurrency is not None:
        changes.append("Concurrency: Auto-scale (tự động tái sử dụng worktree rảnh hoặc đẻ thêm slot mới khi bận)")

    if new_goal_mode is not None:
        old_g = _is_goal_mode_enabled(target, config)
        target["goalMode"] = new_goal_mode
        if old_g != new_goal_mode or "goalMode" not in target:
            changes.append(f"Goal Mode: {'🎯 /goal' if old_g else 'OFF'} ➔ {'🎯 /goal' if new_goal_mode else 'OFF'}")

    if role_key == "criticSpecialist" and target.get("enabled", True) and not target.get("utilities"):
        target["utilities"] = ["git-worktrees", "diff-viewer", "orca-skills-registry"]

    if not changes:
        sync_gemini_directive(root, config)
        print("ℹ️ Không có thay đổi nào được yêu cầu (đã đồng bộ lại '.agents/GEMINI.md').")
        return

    if role_key == "reSpecialist" and target.get("enabled", True):
        if not target.get("utilities"):
            target["utilities"] = [
                "git-worktrees",
                "orca-skills-registry",
                "reverse-engineer-anything",
                "reverse-clone-website",
                "game-reverse-reconstruct",
            ]
        ensure_rea_skill(target.get("agent") or "antigravity")
        changes.append("Skill: Đã đồng bộ 'reverse-engineer-anything', 'reverse-clone-website' & 'game-reverse-reconstruct'")

    if role_key == "coordinator" and new_agent:
        gemini_md = root / ".agents" / "GEMINI.md"
        root_gemini_md = root / "GEMINI.md"
        claude_md = root / "CLAUDE.md"
        agents_md = root / "AGENTS.md"
        c_low = new_agent.lower()
        has_any_orca_link = (
            _is_orca_discovery_link(root_gemini_md)
            or _is_orca_discovery_link(claude_md)
            or _is_orca_discovery_link(agents_md)
        )
        if has_any_orca_link:
            _sync_discovery_links(root, config, create_missing=False)
            if c_low == "claude":
                changes.append("Leader Discovery Link: Kích hoạt CLAUDE.md" if _is_orca_discovery_link(claude_md)
                               else "⚠️ CLAUDE.md là file/symlink riêng của bạn — giữ nguyên, Leader Claude sẽ đọc file đó thay vì .agents/GEMINI.md")
            elif c_low in ["codex", "cursor", "opencode"]:
                changes.append(f"Leader Discovery Link: Kích hoạt AGENTS.md ({new_agent})" if _is_orca_discovery_link(agents_md)
                               else "⚠️ AGENTS.md là file/symlink riêng của bạn — giữ nguyên")
            else:
                if _is_orca_discovery_link(root_gemini_md) and _is_orca_discovery_link(agents_md):
                    changes.append(f"Leader Discovery Link: Kích hoạt GEMINI.md & AGENTS.md ở root ({new_agent})")
                else:
                    changes.append("⚠️ GEMINI.md hoặc AGENTS.md là file/symlink riêng của bạn — giữ nguyên")

    if role_key in ("qa", "developer") and not force_flag:
        roles_chk = config.get("roles") or {}
        qa_chk = roles_chk.get("qa") or {}
        dev_chk = roles_chk.get("developer") or {}
        if _is_role_enabled(qa_chk, is_optional=False) and _is_role_enabled(dev_chk, is_optional=False):
            qa_eff_chk = str(qa_chk.get("effort") or _extract_baked_effort(str(qa_chk.get("model") or "")) or "high").strip().lower()
            qa_sc = _model_rank_score(qa_chk.get("model"), qa_chk.get("effort"))
            dev_sc = _model_rank_score(dev_chk.get("model"), dev_chk.get("effort"))
            if qa_sc < dev_sc or qa_eff_chk not in ("high", "xhigh", "max", "ultra"):
                print(
                    f"❌ [FIX-06] Không được đặt model QA ({qa_chk.get('model')} / {qa_chk.get('effort')}) có cấp độ suy luận "
                    f"thấp hơn Developer ({dev_chk.get('model')} / {dev_chk.get('effort')}) hoặc effort < high! "
                    "Dùng --force nếu bạn thực sự muốn bỏ qua kiểm tra này.",
                    file=sys.stderr,
                )
                sys.exit(1)

    save_config(root, config)
    sync_gemini_directive(root, config)

    print(f"\n✅ Đã cập nhật thành công vai trò [{ROLE_LABELS.get(role_key, role_key)}]:")
    for ch in changes:
        print(f"   • {ch}")
    print("📁 Đã đồng bộ vào 'orca-team.json' và '.agents/GEMINI.md'.\n")

def cmd_link(root: Path, args: list):
    gemini_md = root / ".agents" / "GEMINI.md"
    root_gemini_md = root / "GEMINI.md"
    claude_md = root / "CLAUDE.md"
    agents_md = root / "AGENTS.md"

    mode = args[0] if args else "status"
    if mode in ["all", "--all"]:
        if not gemini_md.exists():
            print("❌ Không có '.agents/GEMINI.md' để liên kết.", file=sys.stderr)
            sys.exit(1)
        problems = []
        for lp in (root_gemini_md, claude_md, agents_md):
            if _is_orca_discovery_link(lp) and lp.exists():
                continue
            if os.path.lexists(lp):
                if lp.is_symlink() and not lp.exists() and _is_orca_discovery_link(lp):
                    lp.unlink(missing_ok=True)
                else:
                    problems.append(f"{lp.name} đã tồn tại (file/symlink riêng của bạn) — giữ nguyên, không ghi đè")
                    continue
            try:
                os.symlink(".agents/GEMINI.md", lp)
            except OSError as e:
                problems.append(f"{lp.name}: {e}")
        print("🔗 Đã kích hoạt các symlink GEMINI.md, CLAUDE.md và AGENTS.md (sẵn sàng mở bất kỳ AI CLI nào).")
        for pr in problems:
            print(f"   ⚠️  {pr}")
        print("")
    elif mode in ["clean", "--clean"]:
        removed = []
        for lp in (root_gemini_md, claude_md, agents_md):
            if _is_orca_discovery_link(lp):
                lp.unlink(missing_ok=True)
                removed.append(lp.name)
        print(f"🧹 Đã dọn dẹp symlink Orca ở root: {', '.join(removed) or '(không có)'} (chỉ giữ .agents/GEMINI.md; symlink riêng của bạn được giữ nguyên).\n")
    else:
        print("\n🔍 Trạng thái Discovery Links:")
        print(f"   • .agents/GEMINI.md: {'✅ Tồn tại' if gemini_md.exists() else '❌ Không có'}")
        print(f"   • GEMINI.md (root):  {'🔗 Symlink active' if root_gemini_md.is_symlink() else ('✅ File riêng' if root_gemini_md.exists() else '⚪ Không có')}")
        print(f"   • CLAUDE.md:         {'🔗 Symlink active' if claude_md.is_symlink() else ('✅ File riêng' if claude_md.exists() else '⚪ Không có')}")
        print(f"   • AGENTS.md:         {'🔗 Symlink active' if agents_md.is_symlink() else ('✅ File riêng' if agents_md.exists() else '⚪ Không có')}")
        print("\n💡 Tùy chọn:")
        print("   • orca-team link all   : Kích hoạt tất cả symlink để mở tự do Antigravity/Claude/Codex")
        print("   • orca-team link clean : Dọn dẹp symlink ở root\n")

def cmd_uninstall_project(root: Path, args: list):
    """Gỡ bỏ toàn bộ cấu hình Orchestrator khỏi project hiện tại hoặc đường dẫn chỉ định."""
    if args and any(a in ("-h", "--help", "help") for a in args):
        print("Sử dụng: orca-team uninstall [<project_dir>] [-y|--yes|--force]")
        return
    for a in (args or []):
        if not a.startswith("-"):
            cand = Path(a).expanduser().resolve()
            if not cand.is_dir():
                print(f"❌ Đường dẫn không tồn tại hoặc không phải thư mục: '{a}'. Hủy (không gỡ project hiện tại).", file=sys.stderr)
                sys.exit(1)
            root = cand
            break

    # Bảo vệ: Không bao giờ tự gỡ bỏ chính kho mã nguồn của framework (kiểm tra TRƯỚC orca-team.json)
    if (root / "templates").is_dir() and (root / "package.json").is_file():
        try:
            pkg = json.loads((root / "package.json").read_text(encoding="utf-8"))
            if pkg.get("name") == "orca-multi-agent-orchestrator":
                print("\n🚫 Đây là thư mục gốc của bộ công cụ 'orca-multi-agent-orchestrator'.", file=sys.stderr)
                print("   Không thể tự gỡ bỏ chính kho mã nguồn framework!", file=sys.stderr)
                print("   Để gỡ bỏ các CLI khỏi máy: hãy chạy './uninstall.sh'.\n", file=sys.stderr)
                sys.exit(1)
        except SystemExit:
            raise
        except Exception:
            pass

    has_any_orca_artifact = (
        (root / "orca-team.json").is_file()
        or (root / ".agents" / "GEMINI.md").is_file()
        or any(_is_orca_discovery_link(root / f) for f in ("GEMINI.md", "CLAUDE.md", "AGENTS.md"))
    )
    if not has_any_orca_artifact:
        print(f"ℹ️  Dự án '{root}' chưa được cấu hình Orca Orchestrator.")
        return

    print(f"\n⚠️  [ORCA UNINSTALL PROJECT] Bạn sắp gỡ bỏ cấu hình Multi-Agent Orchestrator khỏi:")
    print(f"   📁 {root}")
    
    force = any(a in args for a in ["-f", "--force", "-y", "--yes"])
    if not force:
        try:
            ans = input("   ❓ Bạn có chắc chắn muốn xóa cấu hình Orchestrator khỏi project này? [y/N]: ")
            if ans.strip().lower() not in ["y", "yes"]:
                print("   🚫 Đã hủy bỏ thao tác gỡ cài đặt.\n")
                return
        except (KeyboardInterrupt, EOFError):
            print("\n   🚫 Đã hủy thao tác.\n")
            return

    deleted = []
    # 1. Xóa tất cả discovery symlinks ở root
    for f in ["GEMINI.md", "CLAUDE.md", "AGENTS.md"]:
        target = root / f
        if _is_orca_discovery_link(target):
            target.unlink(missing_ok=True)
            deleted.append(f"{f} (symlink)")

    # 2. Xóa orca-team.json
    cfg = root / "orca-team.json"
    if cfg.exists():
        cfg.unlink(missing_ok=True)
        deleted.append("orca-team.json")

    # 3. Xóa .agents/GEMINI.md và chỉ xóa thư mục .agents/ nếu rỗng (bảo vệ .agents/skills hoặc .agents/workflows của user)
    agents_dir = root / ".agents"
    if agents_dir.exists() and agents_dir.is_dir():
        gemini_md = agents_dir / "GEMINI.md"
        if gemini_md.is_file():
            try:
                is_ours = ORCA_DIRECTIVE_MARKER in gemini_md.read_text(encoding="utf-8", errors="ignore")[:2000]
            except Exception:
                is_ours = False
            if is_ours:
                gemini_md.unlink(missing_ok=True)
                deleted.append(".agents/GEMINI.md")
            else:
                print("   ⚠️  Giữ nguyên '.agents/GEMINI.md' (không phải file do Orca Orchestrator sinh ra).")
        try:
            if not any(agents_dir.iterdir()):
                agents_dir.rmdir()
                deleted.append(".agents/ (thư mục rỗng)")
        except Exception:
            pass

    # 4. KHÔNG xóa .orca/ hay .orca-cache/: đây là dữ liệu runtime của Orca ADE app (không do orchestrator tạo ra)
    for r_item in [".orca", ".orca-cache"]:
        if (root / r_item).exists():
            print(f"   ℹ️  Giữ nguyên '{r_item}/' (dữ liệu runtime của Orca ADE). Xóa thủ công nếu chắc chắn không cần.")

    # 5. Dọn dẹp block trong .gitignore nếu có
    gi = root / ".gitignore"
    if gi.exists():
        try:
            lines = gi.read_text(encoding="utf-8").splitlines()
            cleaned_lines = []
            skip = False
            orca_gi_entries = {
                ".agents/", "GEMINI.md", "AGENTS.md", "CLAUDE.md", "orca-team.json",
                ".orca", ".orca/", ".orca-cache", ".orca-cache/", "*.orca.log", ""
            }
            for line in lines:
                if (
                    "# Orca Multi-Agent Orchestrator" in line
                    or "# Orca ADE runtime" in line
                    or "# Orca Orchestrator Runtime Logs" in line
                ):
                    skip = True
                    continue
                if skip and line.strip() in orca_gi_entries:
                    continue
                else:
                    skip = False
                    cleaned_lines.append(line)
            gi.write_text("\n".join(cleaned_lines) + ("\n" if cleaned_lines else ""), encoding="utf-8")
        except Exception:
            pass

    print("\n🎉 Đã gỡ bỏ thành công toàn bộ cấu hình Orchestrator:")
    for d in deleted:
        print(f"   🗑️  Đã xóa: {d}")
    if not deleted:
        print("   ℹ️ Không có file cấu hình nào cần xóa.")
    print("✨ Dự án đã được khôi phục về trạng thái ban đầu sạch sẽ.\n")

def cmd_get(root: Path, config: dict, args: list):
    if args and any(a in ("-h", "--help", "help") for a in args):
        print("Sử dụng: orca-team get <role> [<field>|--field <agent|model|effort|concurrency|goal|enabled|json>]")
        return
    if not config:
        print("❌ Không tìm thấy orca-team.json", file=sys.stderr)
        sys.exit(1)
    if not args:
        print("❌ Thiếu role cần lấy thông tin", file=sys.stderr)
        sys.exit(1)

    role_raw = args[0].lower()
    if role_raw in ROLE_ALIASES:
        role_key = ROLE_ALIASES[role_raw]
    elif _is_role_or_slot_token(role_raw):
        role_key = _resolve_role_and_slot(role_raw)[0]
    else:
        role_key = role_raw
    if role_key not in ROLE_LABELS:
        print(f"❌ Không có cấu hình cho role '{args[0]}'.", file=sys.stderr)
        sys.exit(1)
    _ensure_critic_defaults(config)
    target = (config.get("coordinator") if role_key == "coordinator" else config.get("roles", {}).get(role_key, {})) or {}

    field = "agent"
    idx_g = 1
    while idx_g < len(args):
        ga = args[idx_g]
        if ga == "--field":
            if idx_g + 1 >= len(args) or args[idx_g + 1].startswith("-"):
                print("❌ Thiếu giá trị cho '--field'.", file=sys.stderr)
                sys.exit(1)
            field = args[idx_g + 1].strip()
            idx_g += 2
        elif ga.startswith("--field="):
            fv = ga.split("=", 1)[1].strip()
            if not fv or fv.startswith("-"):
                print("❌ Thiếu giá trị cho '--field='.", file=sys.stderr)
                sys.exit(1)
            field = fv
            idx_g += 1
        elif not ga.startswith("-"):
            field = ga
            idx_g += 1
        else:
            print(f"❌ Tùy chọn không hợp lệ: '{ga}'.", file=sys.stderr)
            sys.exit(1)

    is_opt = role_key in ("uiSpecialist", "devopsSpecialist", "benchSpecialist", "reSpecialist", "criticSpecialist")
    if not target and not is_opt:
        print(f"❌ Không có cấu hình cho role '{args[0]}'.", file=sys.stderr)
        sys.exit(1)
    if field == "json":
        print(json.dumps(target))
    elif field == "agent" and not _is_role_enabled(target, is_optional=is_opt):
        print("none")
    elif field == "enabled":
        print("true" if _is_role_enabled(target, is_optional=is_opt) else "false")
    elif field in ("goal", "goalMode", "goal_mode"):
        print("true" if _is_goal_mode_enabled(target, config) else "false")
    else:
        val = target.get(field)
        if val is None and field == "concurrency":
            val = "auto"
        if val is None:
            sys.exit(1)
        print(json.dumps(val, ensure_ascii=False) if isinstance(val, (list, dict)) else val)

# ---------------------------------------------------------------------------
# Watchdog auto-unblock safety (allowlist + destructive-token denylist, fail-closed)
# ---------------------------------------------------------------------------
# A 'y' is only auto-sent when the LAST non-empty screen line is a plain [y/n] or (y/n) prompt.
# Note: (yes/no) is intentionally excluded because SSH/apt/db prompts require 'yes' and are high-risk.
_WATCHDOG_SAFE_PROMPT_RES = [
    re.compile(r"[\[(]\s*y\s*/\s*n\s*[\])]\s*[:?]?\s*$", re.I),   # ... [y/n]  (y/n)  [Y/n]  [y/N]
]
# Any of these anywhere in the visible tail blocks auto-approval.
_WATCHDOG_DESTRUCTIVE_RES = [
    re.compile(r"(^|[\s;&|(`])(rm|unlink|rmdir)\s", re.I),                          # rm / unlink / rmdir (any flags)
    re.compile(r"\bremove\s+(regular\s+)?(empty\s+)?(file|directory)\b", re.I),     # rm -i interactive prompt text
    re.compile(r"(^|\s)-delete\b", re.I),                                           # find ... -delete
    re.compile(r"(^|[\s;&|(`])dd\s", re.I),
    re.compile(r"\bmkfs(\.\w+)?\b", re.I),
    re.compile(r"\bshred\b", re.I),
    re.compile(r"\btruncate\b", re.I),
    re.compile(r"\bgit\b[^\n]*\bpush\b[^\n]*(\s-[a-z]*f[a-z]*\b|--force|\s\+\S)", re.I),
    re.compile(r"\bgit\b[^\n]*\breset\b[^\n]*--hard", re.I),
    re.compile(r"\bgit\b[^\n]*\bclean\b[^\n]*(\s-[a-z]*f|--force)", re.I),
    re.compile(r"\bgit\b[^\n]*\b(checkout\s+--|restore\b|branch\s+-D|stash\s+(drop|clear))\b", re.I),
    re.compile(r"\b(curl|wget)\b[^\n]*\|\s*(sudo\s+)?(ba|z|da|k|fi)?sh\b", re.I),
    re.compile(r"\bch(mod|own|grp)\b[^\n]*\s(-[a-z]*r[a-z]*|--recursive)\b", re.I),
    re.compile(r">\s*/dev/(sd|hd|nvme|disk|xvd|vd)", re.I),
    re.compile(r"\bdrop\s+(table|database|schema|index|collection)\b", re.I),
    re.compile(r"\bdelete\s+from\b", re.I),
    re.compile(r"\b(flushall|flushdb|migrate\s+reset|flyway\s+clean|db:drop|db:reset)\b", re.I),
    re.compile(r"\bcontinue\s+connecting\b", re.I),
    re.compile(r"\bkubectl\b[^\n]*\bdelete\b", re.I),
    re.compile(r"\bdocker\b[^\n]*\b(rm|rmi|system\s+prune|volume\s+(rm|prune)|image\s+prune|container\s+prune|compose\s+down\s+[^\n]*-v)\b", re.I),
    re.compile(r"\bhelm\b[^\n]*\b(uninstall|delete)\b", re.I),
    re.compile(r"\bterraform\b[^\n]*\bdestroy\b", re.I),
    re.compile(r"\bsudo\b", re.I),
]

def _watchdog_prompt_is_safe(screen_text: str) -> tuple:
    """Fail-closed: (True, '') only if the last line is an allowlisted y/n prompt
    and the visible tail contains no destructive token."""
    cleaned_screen = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", str(screen_text or ""))
    lines = [l.rstrip() for l in cleaned_screen.splitlines() if l.strip()]
    if not lines:
        return False, "empty screen"
    if not any(rx.search(lines[-1]) for rx in _WATCHDOG_SAFE_PROMPT_RES):
        return False, "not a recognised y/n prompt"
    tail = "\n".join(lines[-12:])
    for rx in _WATCHDOG_DESTRUCTIVE_RES:
        m = rx.search(tail)
        if m:
            return False, f"destructive token: {m.group(0).strip()[:40]}"
    return True, ""

def cmd_watchdog(root: Path, args: list = None):
    import subprocess
    args = args or []
    if any(a in ("-h", "--help", "help") for a in args):
        print("Sử dụng: orca-team watchdog [<project_dir>] [--unblock|--fix] [--all|-a]")
        return
    for a in args:
        if not a.startswith("-"):
            cand = Path(a).expanduser()
            if not cand.is_dir():
                print(f"❌ Đường dẫn không tồn tại: '{a}'.", file=sys.stderr)
                sys.exit(1)
            root = cand.resolve()
            break
    auto_unblock = any(a in args for a in ["--unblock", "--fix"])
    scan_all = any(a in args for a in ["--all", "-a"])
    proj_slug = root.name.lower() if root else ""
    root_str = str(root).lower() if root else ""

    def _extract_wt_id_low(w_item: dict) -> str:
        if not isinstance(w_item, dict):
            return ""
        return str(
            (w_item.get("resource") or {}).get("worktreeId")
            or ((w_item.get("projection") or {}).get("resource") or {}).get("worktreeId")
            or w_item.get("worktreeId")
            or ""
        ).lower()

    def _matches_proj(wt_id_low: str) -> bool:
        if not wt_id_low:
            return False
        return (
            (bool(root_str) and root_str in wt_id_low)
            or (bool(proj_slug) and (f"/{proj_slug}/" in wt_id_low or wt_id_low.endswith(f"/{proj_slug}")))
        )

    print(f"\n🩺 [ORCA AGENT WATCHDOG] Đang quét trạng thái worker ({'toàn hệ thống' if scan_all else root.name})...")
    if auto_unblock:
        print("⚡ Chế độ Auto-Unblock: Đang tự động gửi 'y' mở khóa các worker bị kẹt...")

    orca_bin = os.environ.get("ORCA_BIN") or shutil.which("orca") or "/usr/local/bin/orca"
    if not os.path.exists(orca_bin):
        print(f"❌ Không tìm thấy orca CLI tại {orca_bin}", file=sys.stderr)
        return

    try:
        r_res = _safe_orca_run([orca_bin, "orchestration", "run-list", "--json"], timeout=6)
        workers = []
        seen_dispatches = set()
        if r_res.returncode == 0:
            r_data = json.loads(r_res.stdout)
            r_obj = r_data.get("result", r_data) if isinstance(r_data, dict) else {}
            all_runs = [r for r in (r_obj.get("runs", []) if isinstance(r_obj, dict) else []) if not r.get("legacy")]
            for r in all_runs[:8]:
                rid = r.get("id")
                if not rid:
                    continue
                w_res = _safe_orca_run([orca_bin, "orchestration", "worker-list", "--run", rid, "--terminal-state", "active", "--json"], timeout=5)
                if w_res.returncode == 0:
                    w_data = json.loads(w_res.stdout)
                    w_obj = w_data.get("result", w_data) if isinstance(w_data, dict) else {}
                    run_workers = w_obj.get("workers", []) if isinstance(w_obj, dict) else []
                    if not scan_all and proj_slug and run_workers:
                        wt_match = any(_matches_proj(_extract_wt_id_low(w_item)) for w_item in run_workers)
                        if not wt_match:
                            continue
                    for w_item in run_workers:
                        did = w_item.get("dispatchId") or w_item.get("id")
                        if did and did not in seen_dispatches:
                            seen_dispatches.add(did)
                            workers.append(w_item)
        else:
            res = _safe_orca_run([orca_bin, "orchestration", "worker-list", "--terminal-state", "active", "--json"], timeout=10)
            if res.returncode != 0:
                try:
                    err_data = json.loads(res.stdout)
                    msg = err_data.get("error", {}).get("message", "Lỗi kết nối Orca Runtime")
                    print(f"⚠️ {msg}")
                    print("💡 Hãy đảm bảo Orca đang mở hoặc chạy lệnh trực tiếp trên terminal máy host.\n")
                    return
                except Exception:
                    print(f"⚠️ Không thể kết nối Orca Runtime (mã lỗi: {res.returncode}).\n")
                    return
            data = json.loads(res.stdout)
            res_obj = data.get("result", data) if isinstance(data, dict) else {}
            raw_workers = res_obj.get("workers", []) if isinstance(res_obj, dict) else (data if isinstance(data, list) else [])
            for w_item in raw_workers:
                if not scan_all and proj_slug:
                    wt_id_low = _extract_wt_id_low(w_item)
                    if wt_id_low and not _matches_proj(wt_id_low):
                        continue
                workers.append(w_item)

        if not workers:
            print("✨ Hiện không có worker nào đang chạy ngầm cần xử lý.\n")
            return

        print(f"{'DISPATCH ID':<28} | {'TERMINAL':<14} | {'STATE':<14} | {'GHI CHÚ / TRẠNG THÁI'}")
        print("-" * 82)
        
        cli_index = _index_cli_transcripts()
        hung_count = 0
        for w in workers:
            d_id = str(w.get("dispatchId") or w.get("id") or "-")
            t_id = str(w.get("taskId") or "-")
            term = str(w.get("terminalHandle") or w.get("agentTerminalHandle") or "-")
            state = str(w.get("terminalState") or w.get("state") or "-")
            w_state = str(w.get("workerState") or w.get("state") or "-")
            
            note = ""
            if d_id != "-":
                try:
                    show_res = _safe_orca_run([orca_bin, "orchestration", "worker-show", "--dispatch", d_id, "--json"], timeout=10)
                    if show_res.returncode == 0:
                        s_data = json.loads(show_res.stdout)
                        s_res = s_data.get("result", s_data) if isinstance(s_data, dict) else {}
                        w_info = s_res.get("worker") or {}
                        d_info = s_res.get("dispatch") or {}
                        if w_info.get("state"):
                            w_state = str(w_info.get("state"))
                        elif d_info.get("status") in ("succeeded", "failed", "stopped", "timed_out"):
                            w_state = str(d_info.get("status"))
                        obs = s_res.get("observation", {})
                        if obs.get("agentWait"):
                            if auto_unblock and term != "-":
                                # An toàn (Fail-Closed): Phân tích màn hình terminal, chỉ duyệt khi an toàn
                                is_safe = False
                                unsafe_reason = "terminal read failed"
                                try:
                                    t_read = _safe_orca_run([orca_bin, "terminal", "read", "--terminal", term, "--limit", "15", "--screen", "--json"], timeout=5)
                                    if t_read.returncode == 0:
                                        t_data = json.loads(t_read.stdout)
                                        t_res = t_data.get("result", t_data) if isinstance(t_data, dict) else {}
                                        term_obj = t_res.get("terminal", {}) if isinstance(t_res, dict) else {}
                                        if isinstance(term_obj, dict) and term_obj.get("source") == "screen-unavailable":
                                            is_safe, unsafe_reason = False, "screen unavailable"
                                        else:
                                            tail_lines = term_obj.get("tail") if isinstance(term_obj, dict) else None
                                            if isinstance(tail_lines, list):
                                                screen_txt = "\n".join(str(line) for line in tail_lines)
                                            else:
                                                screen_txt = str(t_res.get("content") or t_res.get("screen") or "")
                                            is_safe, unsafe_reason = _watchdog_prompt_is_safe(screen_txt)
                                except Exception:
                                    is_safe = False

                                if is_safe:
                                    send_res = _safe_orca_run([orca_bin, "terminal", "send", "--terminal", term, "--text", "y", "--enter"], timeout=5)
                                    if send_res.returncode == 0:
                                        note = "🔓 ĐÃ TỰ ĐỘNG GỬI [y] MỞ KHÓA"
                                    else:
                                        note = "⚠️ KẸT CÂU HỎI (Mở khóa lỗi)"
                                        hung_count += 1
                                else:
                                    note = f"⚠️ CẦN DUYỆT THỦ CÔNG ({unsafe_reason})"
                                    hung_count += 1
                            else:
                                note = "⚠️ ĐANG KẸT CÂU HỎI XÁC NHẬN [Y/N]"
                                hung_count += 1
                except Exception:
                    pass

            has_valid_term = term not in ("", "-", "None") and w_phase not in ("worktree_create", "terminal_create")
            tf_match = cli_index["by_dispatch"].get(d_id) or (
                (cli_index["by_task"].get(t_id) or cli_index["by_term"].get(term))
                if has_valid_term
                else None
            )
            t_metrics = _analyze_antigravity_transcript(tf_match, scope_id=d_id) if tf_match else {}
            if t_metrics and t_metrics.get("bloated_logs"):
                if auto_unblock:
                    tasks_dir = (tf_match.parent.parent / "tasks") if (tf_match and tf_match.parent.name == "logs") else None
                    guard_bin = os.path.expanduser("~/.local/bin/orca-command-guard")
                    if not os.path.exists(guard_bin):
                        guard_bin = str(Path(__file__).resolve().parent / "orca-command-guard.py")
                    try:
                        if tasks_dir and tasks_dir.is_dir() and os.path.exists(guard_bin):
                            import importlib.util
                            from importlib.machinery import SourceFileLoader
                            guard_spec = importlib.util.spec_from_file_location(
                                "orca_guard", guard_bin, loader=SourceFileLoader("orca_guard", guard_bin)
                            )
                            guard_mod = importlib.util.module_from_spec(guard_spec)
                            guard_spec.loader.exec_module(guard_mod)
                            guard_mod.MAX_TASK_LOG_BYTES = 10 * 1024 * 1024
                            guard_mod._enforce_task_log_cap(tasks_dir)
                        else:
                            for bl_path, bl_sz in t_metrics["bloated_logs"]:
                                bl_p = Path(bl_path)
                                with open(bl_p, "rb") as bf:
                                    head_b = bf.read(256 * 1024)
                                    bf.seek(max(0, bl_sz - 128 * 1024))
                                    tail_b = bf.read()
                                bl_p.write_bytes(head_b + f"\n[... ORCA-WATCHDOG: đã lược bỏ {bl_sz - len(head_b) - len(tail_b):,} bytes giữa log ...]\n".encode() + tail_b)
                        bl_msg = "🛡️ ĐÃ NGẮT LỆNH XẢ LOG >10MB & CẮT GỌN FILE LOG"
                        note = f"{note} | {bl_msg}" if note else bl_msg
                    except Exception:
                        pass
                else:
                    bl_msg = "⚠️ LOG PHÌNH TO >10MB (chạy --unblock để cắt gọn)"
                    note = f"{note} | {bl_msg}" if note else bl_msg
                    hung_count += 1

            if not note:
                idle_s = t_metrics.get("idle_since_last_secs", 0.0) if t_metrics else 0.0
                if w_state not in ("succeeded", "failed", "stopped", "timed_out") and idle_s > 180:
                    unblocked_idle = False
                    if auto_unblock and term != "-":
                        try:
                            cap_fixed = 0
                            if tf_match and tf_match.parent.name == "logs":
                                tasks_dir = tf_match.parent.parent / "tasks"
                                guard_bin = os.path.expanduser("~/.local/bin/orca-command-guard")
                                if not os.path.exists(guard_bin):
                                    guard_bin = str(Path(__file__).resolve().parent / "orca-command-guard.py")
                                if tasks_dir.is_dir() and os.path.exists(guard_bin):
                                    import importlib.util
                                    from importlib.machinery import SourceFileLoader
                                    guard_spec = importlib.util.spec_from_file_location(
                                        "orca_guard", guard_bin, loader=SourceFileLoader("orca_guard", guard_bin)
                                    )
                                    guard_mod = importlib.util.module_from_spec(guard_spec)
                                    guard_spec.loader.exec_module(guard_mod)
                                    cap_fixed = guard_mod._enforce_task_log_cap(tasks_dir) or 0
                            if cap_fixed > 0:
                                note = f"🔓 ĐÃ TỰ ĐỘNG NGẮT TIẾN TRÌNH JEST/LOG TREO ({_fmt_dur(idle_s)})"
                                unblocked_idle = True
                            else:
                                t_read_idle = _safe_orca_run([orca_bin, "terminal", "read", "--terminal", term, "--limit", "15", "--screen", "--json"], timeout=5)
                                if t_read_idle.returncode == 0:
                                    t_data_i = json.loads(t_read_idle.stdout)
                                    t_res_i = t_data_i.get("result", t_data_i) if isinstance(t_data_i, dict) else {}
                                    term_obj_i = t_res_i.get("terminal", {}) if isinstance(t_res_i, dict) else {}
                                    tail_i = term_obj_i.get("tail") if isinstance(term_obj_i, dict) else None
                                    scr_i = "\n".join(str(line) for line in tail_i) if isinstance(tail_i, list) else str(t_res_i.get("content") or t_res_i.get("screen") or "")
                                    clean_i = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", scr_i)
                                    has_destructive = any(rx.search(clean_i) for rx in _WATCHDOG_DESTRUCTIVE_RES)
                                    if not has_destructive and re.search(r"(?m)^\s*[>❯]\s*$", clean_i):
                                        nudge_res = _safe_orca_run(
                                            [
                                                orca_bin, "terminal", "send", "--terminal", term,
                                                "--text", "Tiếp tục hoàn thành nhiệm vụ đang dở (nếu chạy jest phải kèm --forceExit) và gửi báo cáo worker_done về Coordinator ngay khi xong.",
                                                "--enter",
                                            ],
                                            timeout=5,
                                        )
                                        if nudge_res.returncode == 0:
                                            note = f"🔓 ĐÃ GỬI NUDGE ĐÁNH THỨC WORKER TREO ({_fmt_dur(idle_s)})"
                                            unblocked_idle = True
                        except Exception:
                            pass
                    if not unblocked_idle:
                        note = f"⚠️ KHÔNG PHẢN HỒI {_fmt_dur(idle_s)} (last_tool={t_metrics.get('last_tool', '-')})"
                        hung_count += 1
                elif state == "active":
                    note = f"🟢 Đang thực thi ({t_metrics.get('turns', 0)}t, {t_metrics.get('out_tok_s', 0.0):.1f} tok/s)" if t_metrics else "🟢 Đang thực thi"
                elif state == "reclaimable":
                    note = "⚪ Đã xong / Sẵn sàng giải phóng"
                elif state == "retained":
                    note = "🟡 Đang giữ để debug"
                else:
                    note = state

            print(f"{d_id:<28} | {term:<14} | {state:<14} | {note}")

        print("-" * 82)
        if hung_count > 0:
            print(f"⚠️ Phát hiện {hung_count} worker đang bị treo hoặc chờ input!")
            if not auto_unblock:
                print("👉 Tự động mở khóa các worker an toàn: orca-team watchdog --unblock")
            else:
                print("👉 Các worker còn lại đang chờ duyệt lệnh nhạy cảm hoặc bị kẹt tiến trình.")
            print("👉 Để dừng worker bị treo:              orca orchestration worker-stop --dispatch <id>\n")
        else:
            print("✅ Toàn bộ worker đều hoạt động trơn tru.\n")
    except Exception as e:
        print(f"⚠️ Lỗi quét worker: {e}\n")

def estimate_tokens(text: str) -> int:
    if not text:
        return 0
    non_ascii = sum(1 for c in text if ord(c) > 127)
    ascii_chars = len(text) - non_ascii
    return max(1, int(round((ascii_chars / 3.8) + (non_ascii / 2.0))))


def _parse_iso_utc(s):
    if s is None or isinstance(s, bool):
        return None
    from datetime import datetime, timezone
    if isinstance(s, (int, float)):
        v = float(s)
        if v <= 0:
            return None
        return datetime.fromtimestamp(v / 1000.0 if v > 1e11 else v, tz=timezone.utc)
    try:
        clean = str(s).strip()
        if not clean:
            return None
        if re.match(r"^\d+(?:\.\d+)?$", clean):
            v = float(clean)
            if v <= 0:
                return None
            return datetime.fromtimestamp(v / 1000.0 if v > 1e11 else v, tz=timezone.utc)
        if clean.endswith("Z"):
            clean = clean[:-1] + "+00:00"
        elif " " in clean and "+" not in clean and "T" not in clean:
            clean = clean.replace(" ", "T") + "+00:00"
        dt = datetime.fromisoformat(clean)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return dt
    except Exception:
        return None


def _fmt_dur(secs: float) -> str:
    secs_i = max(0, int(round(secs)))
    if secs_i >= 3600:
        return f"{secs_i // 3600}h{(secs_i % 3600) // 60:02d}m"
    if secs_i >= 60:
        return f"{secs_i // 60}m{secs_i % 60:02d}s"
    return f"{secs_i}s"


def _fmt_tok(n: int) -> str:
    if n >= 1_000_000:
        return f"{n / 1_000_000:.2f}M"
    if n >= 10_000:
        return f"{n / 1_000:.1f}k"
    return f"{n:,}"


def _command_from_tool_call(tc: dict) -> str:
    if not isinstance(tc, dict):
        return ""
    if str(tc.get("name") or "") not in ("run_command", "Bash", "bash", "Shell", "shell", "run_shell_command"):
        return ""
    args = tc.get("arguments") or tc.get("args") or tc.get("input") or {}
    if isinstance(args, str):
        try:
            args = json.loads(args)
        except Exception:
            return args
    if isinstance(args, dict):
        return str(args.get("CommandLine") or args.get("command") or args.get("cmd") or "")
    return ""


def _epoch_to_iso_utc(raw_t) -> str:
    try:
        val = float(raw_t)
        if val <= 0:
            return ""
        if val >= 1e11:
            val /= 1000.0
        return datetime.fromtimestamp(val, tz=timezone.utc).isoformat().replace("+00:00", "Z")
    except Exception:
        return ""


def _load_normalized_transcript_steps(tf_path: Path) -> list:
    """Load and normalize steps from Antigravity (`transcript.jsonl`), Claude Code (`~/.claude/projects/*/*.jsonl`), or Kimi Code CLI (`wire.jsonl`)."""
    if not tf_path or not tf_path.exists():
        return []
    tf_str = str(tf_path)
    if tf_path.name == "wire.jsonl" or ".kimi-code" in tf_str:
        try:
            raw_lines = tf_path.read_text(encoding="utf-8", errors="ignore").splitlines()
        except Exception:
            return []
        steps = []
        active_step = None
        last_ts = ""
        for ln in raw_lines:
            if not ln.strip():
                continue
            try:
                obj = json.loads(ln)
            except Exception:
                continue
            if not isinstance(obj, dict):
                continue
            t = obj.get("type")
            ts = _epoch_to_iso_utc(obj.get("time")) or str(obj.get("created_at") or "")
            if ts:
                last_ts = ts
            if t == "turn.prompt":
                inp = obj.get("input") or []
                u_str = (
                    "\n".join(str(x.get("text") or "") for x in inp if isinstance(x, dict))
                    if isinstance(inp, list)
                    else str(inp or "")
                )
                if u_str:
                    if u_str.lstrip().startswith("<task-notification>"):
                        steps.append({"type": "SYSTEM_MESSAGE", "created_at": ts or last_ts, "content": f"[Message from background task]\n{u_str}"})
                    else:
                        steps.append({"type": "USER_INPUT", "created_at": ts or last_ts, "content": u_str})
            elif t == "context.append_loop_event":
                ev = obj.get("event") or {}
                if not isinstance(ev, dict):
                    continue
                et = ev.get("type")
                if et == "step.begin":
                    active_step = {
                        "type": "PLANNER_RESPONSE",
                        "created_at": ts or last_ts,
                        "completed_at": ts or last_ts,
                        "input_tokens": 0,
                        "cache_read_tokens": 0,
                        "output_tokens": 0,
                        "content": "",
                        "tool_calls": [],
                        "_generics": [],
                    }
                elif et == "content.part" and active_step is not None:
                    part = ev.get("part") or {}
                    if isinstance(part, dict) and part.get("text"):
                        active_step["content"] += str(part.get("text"))
                elif et == "tool.call" and active_step is not None:
                    b_name = str(ev.get("name") or "")
                    b_args = ev.get("args") or {}
                    if isinstance(b_args, str):
                        try:
                            b_args = json.loads(b_args)
                        except Exception:
                            b_args = {}
                    active_step["tool_calls"].append({"name": b_name, "args": b_args if isinstance(b_args, dict) else {}})
                elif et == "tool.result":
                    res = ev.get("result") or {}
                    out_s = str(res.get("output") or res.get("error") or "") if isinstance(res, dict) else str(res or "")
                    is_err = bool(isinstance(res, dict) and (res.get("isError") or res.get("error")))
                    g_obj = {
                        "type": "GENERIC",
                        "created_at": ts or last_ts,
                        "status": "ERROR" if is_err else "DONE",
                        "content": f"Completed At: {ts}\n{out_s}" if ts else out_s,
                    }
                    if active_step is not None:
                        active_step["_generics"].append(g_obj)
                    else:
                        steps.append(g_obj)
                elif et == "step.end" and active_step is not None:
                    usage = ev.get("usage") or {}
                    if isinstance(usage, dict):
                        active_step["input_tokens"] = int(usage.get("inputOther") or 0) + int(usage.get("inputCacheCreation") or 0)
                        active_step["cache_read_tokens"] = int(usage.get("inputCacheRead") or 0)
                        active_step["output_tokens"] = int(usage.get("output") or 0)
                    if ts:
                        active_step["completed_at"] = ts
                    gens = active_step.pop("_generics", [])
                    if active_step["input_tokens"] > 0 or active_step["cache_read_tokens"] > 0 or active_step["output_tokens"] > 0 or active_step["tool_calls"]:
                        steps.append(active_step)
                        for g_item in gens:
                            steps.append(g_item)
                    active_step = None
        return steps

    is_claude = ".claude/projects" in tf_str or tf_path.name not in ("transcript.jsonl", "transcript_full.jsonl")
    if not is_claude:
        full_tf = tf_path.parent / "transcript_full.jsonl"
        read_tf = full_tf if full_tf.exists() else tf_path
        try:
            raw_lines = read_tf.read_text(encoding="utf-8", errors="ignore").splitlines()
        except Exception:
            return []
        all_steps = []
        for ln in raw_lines:
            if not ln.strip():
                continue
            try:
                obj = json.loads(ln)
            except ValueError:
                continue
            if isinstance(obj, dict):
                all_steps.append(obj)
        return all_steps

    # Claude Code JSONL format (`type: "user" | "assistant"`, streaming blocks sharing `message.id`)
    try:
        with open(tf_path, "r", encoding="utf-8", errors="ignore") as f:
            raw_objs = []
            for ln in f:
                if '"type":"user"' not in ln and '"type":"assistant"' not in ln and '"type": "user"' not in ln and '"type": "assistant"' not in ln:
                    continue
                try:
                    obj = json.loads(ln)
                    if isinstance(obj, dict) and obj.get("type") in ("user", "assistant"):
                        raw_objs.append(obj)
                except Exception:
                    continue
    except Exception:
        return []

    steps = []
    last_ts = ""
    i = 0
    n = len(raw_objs)
    while i < n:
        obj = raw_objs[i]
        t = obj.get("type")
        ts = str(obj.get("timestamp") or "")
        if t == "user":
            msg = obj.get("message") or {}
            cnt = msg.get("content")
            if isinstance(cnt, list) and any(isinstance(b, dict) and b.get("type") == "tool_result" for b in cnt):
                for b in cnt:
                    if isinstance(b, dict) and b.get("type") == "tool_result":
                        rc = b.get("content")
                        rc_str = (
                            "\n".join(str(x.get("text") or x) if isinstance(x, dict) else str(x) for x in rc)
                            if isinstance(rc, list)
                            else str(rc or "")
                        )
                        steps.append({
                            "type": "GENERIC",
                            "created_at": last_ts or ts or "",
                            "status": "ERROR" if b.get("is_error") else "DONE",
                            "content": f"Completed At: {ts}\n{rc_str}" if ts else rc_str,
                        })
            else:
                u_str = (
                    cnt
                    if isinstance(cnt, str)
                    else ("\n".join(str(x.get("text") or "") for x in cnt if isinstance(x, dict)) if isinstance(cnt, list) else "")
                )
                if u_str:
                    u_l = u_str.lstrip()
                    if u_l.startswith("<task-notification>"):
                        steps.append({"type": "SYSTEM_MESSAGE", "created_at": ts or last_ts or "", "content": f"[Message from background task]\n{u_str}"})
                    elif not u_l.startswith(("<local-command-", "<command-name>")):
                        steps.append({"type": "USER_INPUT", "created_at": ts or last_ts or "", "content": u_str})
            if ts:
                last_ts = ts
            i += 1
        elif t == "assistant":
            msg = obj.get("message") or {}
            mid = msg.get("id")
            usage = msg.get("usage") or {}
            it = int(usage.get("input_tokens") or 0) + int(usage.get("cache_creation_input_tokens") or 0)
            ct = int(usage.get("cache_read_input_tokens") or 0)
            ot = int(usage.get("output_tokens") or 0)
            tcs = []
            pending_generics = []
            t_start = last_ts or ts or ""
            t_end = ts or last_ts or ""
            j = i
            while j < n:
                oj = raw_objs[j]
                tj = oj.get("type")
                tsj = str(oj.get("timestamp") or "")
                if tj == "assistant":
                    mj = oj.get("message") or {}
                    if mid and mj.get("id") == mid:
                        uj = mj.get("usage") or {}
                        if uj:
                            it = max(it, int(uj.get("input_tokens") or 0) + int(uj.get("cache_creation_input_tokens") or 0))
                            ct = max(ct, int(uj.get("cache_read_input_tokens") or 0))
                            ot = max(ot, int(uj.get("output_tokens") or 0))
                        if tsj:
                            t_end = tsj
                        for b in (mj.get("content") or []):
                            if isinstance(b, dict) and b.get("type") == "tool_use":
                                b_name = str(b.get("name") or "")
                                b_inp = b.get("input") or {}
                                tcs.append({
                                    "name": b_name,
                                    "args": b_inp if isinstance(b_inp, dict) else {},
                                })
                        j += 1
                        continue
                    elif not mid and j == i:
                        for b in (mj.get("content") or []):
                            if isinstance(b, dict) and b.get("type") == "tool_use":
                                b_name = str(b.get("name") or "")
                                b_inp = b.get("input") or {}
                                tcs.append({
                                    "name": b_name,
                                    "args": b_inp if isinstance(b_inp, dict) else {},
                                })
                        j += 1
                        break
                    else:
                        break
                elif tj == "user":
                    mj = oj.get("message") or {}
                    cj = mj.get("content")
                    has_more_same_mid = False
                    if mid and isinstance(cj, list) and any(isinstance(b, dict) and b.get("type") == "tool_result" for b in cj):
                        for k_look in range(j + 1, min(n, j + 30)):
                            if raw_objs[k_look].get("type") == "assistant" and (raw_objs[k_look].get("message") or {}).get("id") == mid:
                                has_more_same_mid = True
                                break
                    if has_more_same_mid:
                        for b in cj:
                            if isinstance(b, dict) and b.get("type") == "tool_result":
                                rc = b.get("content")
                                rc_str = (
                                    "\n".join(str(x.get("text") or x) if isinstance(x, dict) else str(x) for x in rc)
                                    if isinstance(rc, list)
                                    else str(rc or "")
                                )
                                pending_generics.append({
                                    "type": "GENERIC",
                                    "created_at": t_end,
                                    "status": "ERROR" if b.get("is_error") else "DONE",
                                    "content": f"Completed At: {tsj}\n{rc_str}" if tsj else rc_str,
                                })
                        j += 1
                        continue
                    break
                else:
                    j += 1
            if it > 0 or ct > 0 or ot > 0 or tcs:
                steps.append({
                    "type": "PLANNER_RESPONSE",
                    "created_at": t_start,
                    "completed_at": t_end,
                    "input_tokens": it,
                    "cache_read_tokens": ct,
                    "output_tokens": ot,
                    "tool_calls": tcs,
                })
                for pg in pending_generics:
                    pg["created_at"] = t_end
                    steps.append(pg)
            if t_end:
                last_ts = t_end
            i = j
        else:
            i += 1
    return steps


def _slice_transcript_steps(steps: list, tf_path: Path, scope_id: str = None) -> list:
    """Slice multi-dispatch worker transcripts or multi-run leader transcripts to the exact `scope_id` window."""
    if not scope_id or not steps:
        return steps
    try:
        if scope_id.startswith("ctx_"):
            # Worker transcript may contain multiple dispatches when 1 Role = 1 Worktree terminal reuse is active
            dispatch_starts = []
            for idx_pos, s in enumerate(steps):
                if s.get("type") == "USER_INPUT":
                    c = str(s.get("content") or "")
                    if "You are a dispatched worker" in c or "--dispatch-id" in c or "ctx_" in c:
                        header_c = c.split("=== TASK ===")[0] if "=== TASK ===" in c else c
                        cids = re.findall(r"--dispatch(?:-id)?\s+(ctx_[a-f0-9]{12})\b", header_c)
                        if not cids and "You are a dispatched worker" in header_c:
                            cids = re.findall(r"\bctx_[a-f0-9]{12}\b", header_c)
                        if not cids:
                            cids = re.findall(r"--dispatch(?:-id)?\s+(ctx_[a-f0-9]{12})\b", c)
                        if cids or "You are a dispatched worker" in c:
                            dispatch_starts.append((idx_pos, set(cids)))
            if dispatch_starts:
                for k, (start_pos, cids_set) in enumerate(dispatch_starts):
                    if scope_id in cids_set:
                        end_pos = len(steps)
                        for m in range(k + 1, len(dispatch_starts)):
                            if scope_id not in dispatch_starts[m][1]:
                                end_pos = dispatch_starts[m][0]
                                break
                        return steps[start_pos:end_pos]
                # Chỉ fallback khi phiên duy nhất đó KHÔNG ghi nhận một ctx_id khác với scope_id (chống đếm trùng khi retry cùng task_id)
                if len(dispatch_starts) == 1 and not dispatch_starts[0][1]:
                    return steps[dispatch_starts[0][0]:]
                return []

        elif scope_id.startswith("run_"):
            # Leader transcript may contain multiple sequential orchestration runs (`run-create`) or resumed `--run <rid>` blocks
            def _is_bg_task_sys_msg(st_obj: dict) -> bool:
                if st_obj.get("type") != "SYSTEM_MESSAGE":
                    return False
                txt = str(st_obj.get("content") or "")
                return (
                    "[Message from background task" in txt
                    or bool(re.search(r'Task id "[^"]+/task-\d+" finished with result:', txt))
                )

            run_creates = []
            step_runs = {}
            orch_steps = set()
            release_steps = set()
            for idx_pos, s in enumerate(steps):
                st_type = s.get("type")
                if st_type in ("SYSTEM_MESSAGE", "USER_INPUT"):
                    sm_str = str(s.get("content") or "")
                    for r_m in re.findall(r"\[ORCA RUNTIME NOTIFICATION\s+—\s+RUN:\s*(run_[a-f0-9]{12})\b", sm_str):
                        step_runs.setdefault(idx_pos, set()).add(r_m)
                        if idx_pos + 1 < len(steps) and steps[idx_pos + 1].get("type") == "PLANNER_RESPONSE":
                            step_runs.setdefault(idx_pos + 1, set()).add(r_m)
                            orch_steps.add(idx_pos + 1)
                    if _is_bg_task_sys_msg(s):
                        for r_m in re.findall(r'(?:Created\s+|RUN=|"run(?:Id|_id)"\s*:\s*"|\brun:|"run"\s*:\s*\{\s*"id"\s*:\s*")(run_[a-f0-9]{12})\b', sm_str):
                            step_runs.setdefault(idx_pos, set()).add(r_m)
                    continue
                if st_type != "PLANNER_RESPONSE":
                    continue
                tcs = s.get("tool_calls") or []
                has_rc = False
                has_orch = False
                for tc in tcs:
                    if not isinstance(tc, dict):
                        continue
                    cmd = _command_from_tool_call(tc)
                    if not cmd or "orca-monitor" in cmd:
                        continue
                    if not re.search(r"\bpython3?\b", cmd) and re.search(r"\borca\s+orchestration\s+run-create\b", cmd):
                        has_rc = True
                        has_orch = True
                        orch_steps.add(idx_pos)
                    if re.search(
                        r"\b(?:orca\s+orchestration\s+(?:task-create|worker-start|check|worker-read|gate-create|gate-resolve|task-update|worker-retain|worker-release|worker-stop|send|reply|run-show|task-list|worker-list)|orca-team\s+(?:plan|pin-plan|master-plan|worktree-arg|wt-arg|slot-arg|merge-upstream|merge-run|run-branches|release-workers|cleanup-tabs|gc-workers))\b",
                        cmd,
                    ):
                        has_orch = True
                        orch_steps.add(idx_pos)
                        for r_m in re.findall(r"--(?:run|run-id|id)(?:=|\s+)[\"']?(run_[a-f0-9]{12})\b", cmd):
                            step_runs.setdefault(idx_pos, set()).add(r_m)
                    if re.search(r"\b(?:orca\s+orchestration\s+(?:worker-release|worker-stop)|orca-team\s+(?:release-workers|cleanup-tabs|gc-workers))\b", cmd):
                        release_steps.add(idx_pos)
                if has_rc or has_orch:
                    j = idx_pos + 1
                    created_rids = []
                    fallback_rids = []
                    max_scan = min(len(steps), idx_pos + 12)
                    while j < max_scan:
                        jt = steps[j].get("type")
                        c_str = str(steps[j].get("content") or "")
                        if jt == "USER_INPUT":
                            break
                        if jt == "GENERIC" or _is_bg_task_sys_msg(steps[j]):
                            for r_m in re.findall(r'(?:"run(?:Id|_id)"\s*:\s*"|\brun:|\[Run\s+)(run_[a-f0-9]{12})\b', c_str):
                                step_runs.setdefault(idx_pos, set()).add(r_m)
                            if has_rc:
                                created_rids.extend(
                                    re.findall(r'(?:Created\s+|RUN=|"run"\s*:\s*\{\s*"id"\s*:\s*")(run_[a-f0-9]{12})\b', c_str)
                                )
                                fallback_rids.extend(re.findall(r"\brun_[a-f0-9]{12}\b", c_str))
                        elif jt == "PLANNER_RESPONSE":
                            # Stop scanning GENERIC if we hit another run-create, otherwise allow scanning for async background task completion
                            next_tcs = steps[j].get("tool_calls") or []
                            if any(not re.search(r"\bpython3?\b", _command_from_tool_call(ntc)) and re.search(r"\borca\s+orchestration\s+run-create\b", _command_from_tool_call(ntc)) for ntc in next_tcs if isinstance(ntc, dict)):
                                break
                            if not has_rc or created_rids:
                                break
                        j += 1
                    if has_rc:
                        chosen_rid = created_rids[-1] if created_rids else (fallback_rids[-1] if fallback_rids else None)
                        if chosen_rid:
                            run_creates.append((idx_pos, chosen_rid))
                            step_runs.setdefault(idx_pos, set()).add(chosen_rid)

            def _advance_past_turn(pos: int, limit_pos: int) -> int:
                p = pos
                while p + 1 < limit_pos and steps[p + 1].get("type") == "GENERIC":
                    p += 1
                if p + 1 < limit_pos and steps[p + 1].get("type") == "PLANNER_RESPONSE" and not (steps[p + 1].get("tool_calls") or []):
                    p += 1
                return p

            def _is_short_confirm(content_str: str) -> bool:
                m_req = re.search(r"<USER_REQUEST>(.*?)</USER_REQUEST>", content_str, re.S)
                req = (m_req.group(1) if m_req else content_str).strip()
                return len(req) <= 45

            def _find_run_start(rc_pos: int, prev_rc_pos: int, target_rid: str = None) -> int:
                floor_pos = prev_rc_pos
                for b_pos in range(rc_pos - 1, prev_rc_pos, -1):
                    rset = step_runs.get(b_pos, set())
                    if b_pos in release_steps or (rset and (not target_rid or target_rid not in rset)):
                        floor_pos = _advance_past_turn(b_pos, rc_pos)
                        break
                u_positions = [p for p in range(floor_pos + 1, rc_pos) if steps[p].get("type") == "USER_INPUT"]
                if not u_positions:
                    if floor_pos > prev_rc_pos:
                        return min(rc_pos, floor_pos + 1)
                    for b_pos in range(rc_pos - 1, prev_rc_pos, -1):
                        if steps[b_pos].get("type") == "USER_INPUT":
                            return b_pos
                    return 0 if prev_rc_pos < 0 else rc_pos
                chosen = u_positions[-1]
                idx_u = len(u_positions) - 1
                while idx_u > 0 and _is_short_confirm(str(steps[u_positions[idx_u]].get("content") or "")):
                    idx_u -= 1
                    chosen = u_positions[idx_u]
                return chosen

            for k, (rc_pos, rid) in enumerate(run_creates):
                if rid == scope_id:
                    prev_rc_pos = run_creates[k - 1][0] if k > 0 else -1
                    start_pos = _find_run_start(rc_pos, prev_rc_pos, scope_id)
                    if k + 1 < len(run_creates):
                        next_rc_pos, next_rid = run_creates[k + 1]
                        end_pos = _find_run_start(next_rc_pos, rc_pos, next_rid)
                    else:
                        last_own = rc_pos
                        for p_idx in range(rc_pos, len(steps)):
                            rset = step_runs.get(p_idx, set())
                            if rset and scope_id not in rset:
                                break
                            if p_idx in orch_steps or scope_id in rset:
                                last_own = p_idx
                        last_own_end = _advance_past_turn(last_own, len(steps))
                        end_pos = len(steps)
                        for fwd_pos in range(last_own_end + 1, len(steps)):
                            fwd_type = steps[fwd_pos].get("type")
                            if fwd_type == "USER_INPUT":
                                end_pos = fwd_pos
                                break
                            if fwd_type == "SYSTEM_MESSAGE":
                                sm_txt = str(steps[fwd_pos].get("content") or "")
                                if _is_bg_task_sys_msg(steps[fwd_pos]) or scope_id in sm_txt:
                                    continue
                                end_pos = fwd_pos
                                break
                    return steps[start_pos:end_pos] if end_pos > start_pos else []

            # Fallback for resumed/non-creator sessions that coordinated `scope_id` via `--run <rid>` / `--id <rid>`
            coord_pos = [p for p, rset in sorted(step_runs.items()) if scope_id in rset]
            if coord_pos:
                first_c, last_c = coord_pos[0], coord_pos[-1]
                prev_other = -1
                for p_idx in range(first_c - 1, -1, -1):
                    rset = step_runs.get(p_idx, set())
                    if (rset and scope_id not in rset) or any(rc_p == p_idx for rc_p, _ in run_creates):
                        prev_other = _advance_past_turn(p_idx, first_c)
                        break
                start_pos = _find_run_start(first_c, prev_other, scope_id)
                next_other = len(steps)
                for p_idx in range(last_c + 1, len(steps)):
                    rset = step_runs.get(p_idx, set())
                    if (rset and scope_id not in rset) or any(rc_p == p_idx for rc_p, _ in run_creates):
                        next_other = p_idx
                        break
                last_c_end = _advance_past_turn(last_c, next_other)
                end_pos = next_other
                for fwd_pos in range(last_c_end + 1, next_other):
                    fwd_type = steps[fwd_pos].get("type")
                    if fwd_type == "USER_INPUT":
                        end_pos = fwd_pos
                        break
                    if fwd_type == "SYSTEM_MESSAGE":
                        sm_txt = str(steps[fwd_pos].get("content") or "")
                        if _is_bg_task_sys_msg(steps[fwd_pos]) or scope_id in sm_txt:
                            continue
                        end_pos = fwd_pos
                        break
                return steps[start_pos:end_pos] if end_pos > start_pos else []
            return []
    except Exception:
        pass
    return steps


_GIT_COMMIT_CMD_RE = re.compile(
    r"(?:^|[;&|()\n])\s*(?:env\s+\S+=\S+\s+)*git(?:\s+(?:-C|-c)\s+\S+|\s+--[\w-]+(?:=\S+)?)*\s+commit\b(?!-)"
)
_GIT_COMMIT_AMEND_RE = re.compile(
    r"(?:^|[;&|()\n])\s*(?:env\s+\S+=\S+\s+)*git(?:\s+(?:-C|-c)\s+\S+|\s+--[\w-]+(?:=\S+)?)*\s+commit\b[^\n;&|]*\s--amend\b"
)
_GIT_COMMIT_HEADER_RE = re.compile(
    r"(?m)^\[(?:[a-zA-Z0-9_./-]+|detached HEAD)(?:\s+\(root-commit\))?\s+([0-9a-f]{7,40})\]\s+([^\n\r]+)"
)
_GIT_MERGE_SUBJ_RE = re.compile(r"(?i)^(?:Merge\b|\w+\(merge\):)")
_GIT_REV_INSPECT_CMD_RE = re.compile(
    r"(?:^|[;&|()\n])\s*git(?:\s+(?:-C|-c)\s+\S+)?\s+(?:rev-parse(?:\s+--short)?\s+HEAD\b|log\b[^\n;&|]*-(?:1|n\s*1)\b(?![^\n;&|]*\b[0-9a-f]{7,40}\b)|show\b(?![^\n;&|]*\b[0-9a-f]{7,40}\b))"
)


def _is_feature_git_commit_cmd(cmd_str: str) -> bool:
    """Return True if cmd_str runs a non-merge feature/fix `git commit` (excluding plain `git commit --no-edit` merge continuation)."""
    if not cmd_str or not _GIT_COMMIT_CMD_RE.search(cmd_str):
        return False
    for seg in re.split(r"[;&|\n]+", cmd_str):
        if _GIT_COMMIT_CMD_RE.search(seg):
            if "--no-edit" in seg and not re.search(r"(?:\s-(?:[a-zA-Z]*[amF]|-amend|-message|-all|-file)\b)", seg):
                continue
            return True
    return False


def _step_end_dt(st_obj: dict):
    """Lấy thời điểm kết thúc thực tế của một step (ưu tiên Completed At trong content hoặc completed_at)."""
    if not isinstance(st_obj, dict):
        return None
    c_str = str(st_obj.get("content") or "")
    m_comp = re.search(r"Completed At:\s*([^\n\r]+)", c_str)
    if m_comp:
        dt = _parse_iso_utc(m_comp.group(1).strip())
        if dt:
            return dt
    return _parse_iso_utc(st_obj.get("completed_at")) or _parse_iso_utc(st_obj.get("created_at"))


def _analyze_antigravity_transcript(tf_path: Path, scope_id: str = None) -> dict:
    all_steps = _load_normalized_transcript_steps(tf_path)
    if not all_steps:
        return {}

    steps = _slice_transcript_steps(all_steps, tf_path, scope_id)
    if not steps:
        return {}

    measured_llm_secs = 0.0
    measured_out_tok = 0
    for i, s in enumerate(steps):
        if s.get("type") == "PLANNER_RESPONSE":
            t_s = _parse_iso_utc(s.get("created_at"))
            t_comp = _parse_iso_utc(s.get("completed_at"))
            ot = int(s.get("output_tokens") or 0)
            if t_s and t_comp:
                dt = max(0.5, (t_comp - t_s).total_seconds())
                if dt <= 120.0 and ot >= 20:
                    measured_llm_secs += dt
                    measured_out_tok += ot
            elif i > 0 and t_s:
                prev_end = _step_end_dt(steps[i - 1])
                if prev_end and 0.3 <= (t_s - prev_end).total_seconds() <= 120.0 and ot >= 20:
                    measured_llm_secs += (t_s - prev_end).total_seconds()
                    measured_out_tok += ot
    raw_rate = (measured_out_tok / measured_llm_secs) if measured_llm_secs > 0 else 50.0
    avg_rate = max(30.0, min(120.0, raw_rate))

    llm_secs = 0.0
    tool_secs = 0.0
    idle_wait_secs = 0.0
    in_tok = 0
    cache_tok = 0
    out_tok = 0
    peak_ctx = 0
    last_ctx = 0
    cum_ctx_tok = 0
    tool_output_tok = 0
    max_tool_output_tok = 0
    max_tool_cmd = ""
    replayed_checks = 0
    help_calls = 0
    context_bomb_cmds = []
    referenced_task_logs = set()
    turns = 0
    poll_turns = 0
    view_calls = 0
    tool_calls = 0
    tool_errors = 0
    last_tool_name = "-"
    commit_shas = []
    ran_git_commit = False
    pending_truncated_commit = False

    for i, s in enumerate(steps):
        for m_tl in re.findall(r"\b(task-\d+)\b", str(s.get("content") or "")):
            referenced_task_logs.add(f"{m_tl}.log")
        if s.get("type") == "PLANNER_RESPONSE":
            turns += 1
            it = int(s.get("input_tokens") or 0)
            ct = int(s.get("cache_read_tokens") or 0)
            ot = int(s.get("output_tokens") or 0)
            if ot <= 0:
                # Ước tính output tokens khi Antigravity transcript không ghi trường output_tokens
                est_out_txt = str(s.get("content") or "") + "\n" + str(s.get("thinking") or "")
                for tc_o in (s.get("tool_calls") or []):
                    if isinstance(tc_o, dict):
                        est_out_txt += "\n" + json.dumps(tc_o, ensure_ascii=False)
                ot = estimate_tokens(est_out_txt)
            in_tok += it
            cache_tok += ct
            out_tok += ot
            last_ctx = it + ct
            cum_ctx_tok += last_ctx
            if last_ctx > peak_ctx:
                peak_ctx = last_ctx
            tcs = s.get("tool_calls") or []
            tool_calls += len(tcs)
            tc_names_in_turn = []
            for tc_item in tcs:
                if isinstance(tc_item, dict):
                    nm_item = str(tc_item.get("name") or tc_item.get("tool_name") or "-")
                    tc_names_in_turn.append(nm_item)
                    if nm_item in ("view_file", "Read"):
                        view_calls += 1
            tc_cmds = [_command_from_tool_call(tc) for tc in tcs if isinstance(tc, dict)]
            for cmd_c in tc_cmds:
                if not cmd_c:
                    continue
                if re.search(r"\b(?:orca|orca-team)\b[^\n]*\s(?:-h|--help|help)\b", cmd_c):
                    help_calls += 1
                if re.search(r"\borca\s+orchestration\s+inbox\b", cmd_c):
                    if "orca orchestration inbox" not in context_bomb_cmds:
                        context_bomb_cmds.append("orca orchestration inbox")
                if re.search(r"\borca\s+orchestration\s+task-create\b[^\n]*\s--json\b", cmd_c):
                    if "task-create --json" not in context_bomb_cmds:
                        context_bomb_cmds.append("task-create --json")
            if tc_names_in_turn:
                last_tool_name = tc_names_in_turn[-1]
                is_pure_poll_tools = all(
                    nm_item in ("manage_task", "schedule", "TaskOutput", "BashOutput", "WaitFor", "CronCreate", "Sleep")
                    for nm_item in tc_names_in_turn
                )
                is_pure_sleep_cmd = bool(tc_cmds) and all(
                    bool(cmd_c and re.match(r"^\s*sleep\s+\d+(?:\.\d+)?\s*$", cmd_c))
                    for cmd_c in tc_cmds
                )
                if is_pure_poll_tools or is_pure_sleep_cmd:
                    poll_turns += 1
            turn_has_git_commit = any(_is_feature_git_commit_cmd(cmd_c) for cmd_c in tc_cmds if cmd_c)
            turn_has_git_amend = any(_GIT_COMMIT_AMEND_RE.search(cmd_c) for cmd_c in tc_cmds if cmd_c)
            turn_has_rev_inspect = any(_GIT_REV_INSPECT_CMD_RE.search(cmd_c) for cmd_c in tc_cmds if cmd_c)
            turn_has_orca_check = any(bool(cmd_c and re.search(r"\borca\s+orchestration\s+check\b", cmd_c)) for cmd_c in tc_cmds)

            t_start = _parse_iso_utc(s.get("created_at"))
            t_comp = _parse_iso_utc(s.get("completed_at"))

            # 1) Tính thời gian suy luận LLM (llm_secs) của lượt này
            if t_start and t_comp:
                llm_secs += max(0.5, (t_comp - t_start).total_seconds())
            elif i > 0 and t_start:
                prev_end = _step_end_dt(steps[i - 1])
                if prev_end and 0.2 <= (t_start - prev_end).total_seconds() <= 120.0:
                    llm_secs += (t_start - prev_end).total_seconds()
                else:
                    est_dt = min(90.0, max(0.8, ot / avg_rate))
                    llm_secs += est_dt
                    if prev_end and (t_start - prev_end).total_seconds() > est_dt:
                        idle_wait_secs += (t_start - prev_end).total_seconds() - est_dt
            else:
                llm_secs += min(90.0, max(0.8, ot / avg_rate))

            # 2) Tính thời gian chạy Tool (tool_secs) và đo lường Token Output của các GENERIC steps thuộc lượt này
            if i + 1 < len(steps) and steps[i + 1].get("type") == "GENERIC":
                j = i + 1
                t_tool_start = t_comp or t_start
                t_tool_end = t_tool_start
                matched_commit_in_turn = False
                saw_merge_header_in_turn = False
                amend_popped = False
                generic_idx = 0
                while j < len(steps) and steps[j].get("type") == "GENERIC":
                    c = str(steps[j].get("content") or "")
                    for m_tl in re.findall(r"\b(task-\d+)\b", c):
                        referenced_task_logs.add(f"{m_tl}.log")
                    # Lược bỏ dòng header Created At / Completed At khi tính token của tool output
                    c_body = re.sub(r"^(?:Created|Completed) At:\s*[^\n\r]+\r?\n?", "", c, flags=re.M)
                    g_tok = estimate_tokens(c_body)
                    tool_output_tok += g_tok
                    idx_tc = min(generic_idx, len(tcs) - 1) if tcs else -1
                    raw_shell_cmd = tc_cmds[idx_tc] if (0 <= idx_tc < len(tc_cmds)) else ""
                    is_shell_cmd = bool(raw_shell_cmd)
                    if is_shell_cmd:
                        cmd_label = raw_shell_cmd
                    elif 0 <= idx_tc < len(tc_names_in_turn):
                        tn = tc_names_in_turn[idx_tc]
                        tc_obj = tcs[idx_tc] if (0 <= idx_tc < len(tcs) and isinstance(tcs[idx_tc], dict)) else {}
                        tc_args = tc_obj.get("arguments") or tc_obj.get("input") or tc_obj.get("args") or {}
                        if isinstance(tc_args, str):
                            try:
                                tc_args = json.loads(tc_args)
                            except Exception:
                                tc_args = {}
                        fp_arg = ""
                        if isinstance(tc_args, dict):
                            fp_arg = str(tc_args.get("AbsolutePath") or tc_args.get("file_path") or tc_args.get("path") or tc_args.get("TargetFile") or "")
                        cmd_label = f"{tn}({os.path.basename(fp_arg)})" if fp_arg else tn
                    else:
                        cmd_label = "tool"
                    cmd_label_short = " ".join(str(cmd_label or "").split())[:72]
                    if g_tok > max_tool_output_tok:
                        max_tool_output_tok = g_tok
                        max_tool_cmd = cmd_label_short
                    is_task_log_view = bool(
                        not is_shell_cmd
                        and cmd_label_short.startswith("view_file(")
                        and re.search(r"\btask-\d+\.log\)", cmd_label_short)
                    )
                    is_huge_file_view = bool(
                        not is_shell_cmd and cmd_label_short.startswith("view_file(") and g_tok >= 15000
                    )
                    if (
                        (
                            (
                                is_shell_cmd
                                and g_tok >= 3500
                                and not re.search(r"\borca\s+orchestration\s+ask\b", raw_shell_cmd)
                            )
                            or (is_task_log_view and g_tok >= 3500)
                            or is_huge_file_view
                        )
                        and cmd_label_short
                        and not any(cmd_label_short in cb for cb in context_bomb_cmds)
                    ):
                        context_bomb_cmds.append(f"{cmd_label_short} (~{g_tok:,} tok)")
                    if turn_has_orca_check and re.search(r'"replayed"\s*:\s*true', c):
                        replayed_checks += 1
                    is_benign_merge_guard = "ORCA RUN-SCOPED MERGE GUARD" in c
                    if not is_benign_merge_guard:
                        if "exited with code" in c and "exited with code 0" not in c:
                            tool_errors += 1
                        elif steps[j].get("status") == "ERROR":
                            tool_errors += 1
                    if turn_has_git_commit:
                        for m_c in _GIT_COMMIT_HEADER_RE.finditer(c):
                            c_sha, c_subj = m_c.group(1), m_c.group(2).strip()
                            if _GIT_MERGE_SUBJ_RE.match(c_subj):
                                saw_merge_header_in_turn = True
                            else:
                                if turn_has_git_amend and not amend_popped and commit_shas:
                                    commit_shas.pop()
                                    amend_popped = True
                                if c_sha not in commit_shas:
                                    commit_shas.append(c_sha)
                                matched_commit_in_turn = True
                                pending_truncated_commit = False
                                ran_git_commit = True
                        if (
                            not matched_commit_in_turn
                            and not saw_merge_header_in_turn
                            and ("exited with code 0" in c or steps[j].get("status") != "ERROR")
                            and ("<truncated" in c or "create mode " in c or "files changed" in c or "file changed" in c)
                        ):
                            if turn_has_git_amend and not amend_popped and commit_shas:
                                commit_shas.pop()
                                amend_popped = True
                            pending_truncated_commit = True
                            ran_git_commit = True
                    elif pending_truncated_commit and turn_has_rev_inspect:
                        m_rev = re.search(r"(?m)^(?:commit\s+)?([0-9a-f]{7,40})\b", c)
                        if m_rev:
                            r_sha = m_rev.group(1)
                            if r_sha not in commit_shas:
                                commit_shas.append(r_sha)
                        pending_truncated_commit = False
                    m1 = re.search(r"Created At:\s*([^\n\r]+)", c)
                    if m1:
                        ts1 = _parse_iso_utc(m1.group(1).strip())
                        if ts1 and (not t_tool_start or ts1 < t_tool_start):
                            t_tool_start = ts1
                    m2 = re.search(r"Completed At:\s*([^\n\r]+)", c)
                    ts2 = _parse_iso_utc(m2.group(1).strip()) if m2 else _parse_iso_utc(steps[j].get("created_at"))
                    if ts2 and (not t_tool_end or ts2 > t_tool_end):
                        t_tool_end = ts2
                    generic_idx += 1
                    j += 1
                if not turn_has_git_commit and pending_truncated_commit:
                    pending_truncated_commit = False
                if t_tool_start and t_tool_end and t_tool_end > t_tool_start:
                    tool_secs += (t_tool_end - t_tool_start).total_seconds()
            elif not turn_has_git_commit and pending_truncated_commit:
                pending_truncated_commit = False

    from datetime import datetime, timezone, timedelta
    t0 = _parse_iso_utc(steps[0].get("created_at"))
    t_last_created = _parse_iso_utc(steps[-1].get("created_at"))
    t_last_comp = _parse_iso_utc(steps[-1].get("completed_at"))
    tN_cands = [t_last_comp, t_last_created]
    if steps[-1].get("type") == "PLANNER_RESPONSE" and not t_last_comp and t_last_created:
        last_ot = int(steps[-1].get("output_tokens") or 0)
        last_est_dt = min(90.0, max(0.8, last_ot / avg_rate))
        tN_cands.append(t_last_created + timedelta(seconds=last_est_dt))
    m_last_comp = re.search(r"Completed At:\s*([^\n\r]+)", str(steps[-1].get("content") or ""))
    if m_last_comp:
        tN_cands.append(_parse_iso_utc(m_last_comp.group(1).strip()))
    tN_valid = [tc_dt for tc_dt in tN_cands if tc_dt is not None]
    tN = max(tN_valid) if tN_valid else None
    active_secs = llm_secs + tool_secs
    wall_secs = max(active_secs, (tN - t0).total_seconds()) if (t0 and tN) else active_secs
    idle_wait_secs = max(idle_wait_secs, max(0.0, wall_secs - active_secs))
    now_utc = datetime.now(timezone.utc)
    idle_since_last = max(0.0, (now_utc - tN).total_seconds()) if tN else 0.0

    bloated_logs = []
    tasks_dir = (tf_path.parent.parent / "tasks") if tf_path.parent.name == "logs" else None
    is_sliced_subset = bool(scope_id and len(steps) < len(all_steps))
    if tasks_dir and tasks_dir.is_dir():
        try:
            for tl in tasks_dir.glob("*.log"):
                st_stat = tl.stat()
                sz = st_stat.st_size
                if sz > 16 * 1024 * 1024:
                    if is_sliced_subset and referenced_task_logs and tl.name not in referenced_task_logs:
                        if t0 and tN:
                            mt = datetime.fromtimestamp(st_stat.st_mtime, tz=timezone.utc)
                            if mt < (t0 - timedelta(seconds=60)) or mt > (tN + timedelta(seconds=60)):
                                continue
                    bloated_logs.append((str(tl), sz))
        except Exception:
            pass

    return {
        "transcript_path": str(tf_path),
        "steps": len(steps),
        "turns": turns,
        "poll_turns": poll_turns,
        "effective_turns": max(0, turns - poll_turns),
        "view_calls": view_calls,
        "tool_calls": tool_calls,
        "tool_errors": tool_errors,
        "in_tok": in_tok,
        "cache_tok": cache_tok,
        "out_tok": out_tok,
        "peak_ctx": peak_ctx,
        "last_ctx": last_ctx,
        "cum_ctx_tok": cum_ctx_tok,
        "tool_output_tok": tool_output_tok,
        "max_tool_output_tok": max_tool_output_tok,
        "max_tool_cmd": max_tool_cmd,
        "replayed_checks": replayed_checks,
        "help_calls": help_calls,
        "context_bomb_cmds": context_bomb_cmds[:5],
        "llm_secs": llm_secs,
        "tool_secs": tool_secs,
        "active_secs": active_secs,
        "wall_secs": wall_secs,
        "idle_wait_secs": idle_wait_secs,
        "idle_since_last_secs": idle_since_last,
        "out_tok_s": out_tok / max(1.0, llm_secs),
        "active_tok_s": out_tok / max(1.0, active_secs),
        "prefill_tok_s": (in_tok + cache_tok + out_tok) / max(1.0, llm_secs),
        "cache_hit_pct": (cache_tok / max(1, in_tok + cache_tok)) * 100.0,
        "avg_turn_s": llm_secs / max(1, turns),
        "last_tool": last_tool_name,
        "last_step_at": steps[-1].get("completed_at") or steps[-1].get("created_at") or "",
        "bloated_logs": bloated_logs,
        "commit_shas": commit_shas,
        "ran_git_commit": ran_git_commit,
    }


def _index_cli_transcripts() -> dict:
    """Scan local CLI session directories (Antigravity & Claude Code) and index transcripts by dispatchId, taskId, termHandle, and runId."""
    by_dispatch = {}
    by_task = {}
    by_term = {}
    by_leader_run = {}

    def _index_parsed_steps(tf: Path, parsed_steps: list, is_cli: int):
        if not parsed_steps:
            return
        user_inputs = [
            str(st.get("content") or "")
            for st in parsed_steps
            if st.get("type") == "USER_INPUT" and st.get("content")
        ]
        is_dispatched_worker = any("You are a dispatched worker" in u for u in user_inputs)
        if is_dispatched_worker:
            header_parts = []
            for u in user_inputs:
                if "You are a dispatched worker" in u:
                    header_parts.append(u.split("=== TASK ===")[0])
                elif "--dispatch-id" in u or "--dispatch " in u:
                    header_parts.append(u)
            blob = "\n".join(header_parts) if header_parts else "\n".join(user_inputs[:2])
            cids = re.findall(r"--dispatch(?:-id)?\s+(ctx_[a-f0-9]{12})\b", blob)
            if not cids:
                cids = re.findall(r"\bctx_[a-f0-9]{12}\b", blob)
            for cid_match in cids:
                by_dispatch[cid_match] = tf
            tids = re.findall(r"--task(?:-id)?\s+(task_[a-f0-9]{12})\b", blob)
            if not tids:
                tids = re.findall(r"\btask_[a-f0-9]{12}\b", blob)
            for tid_match in tids:
                by_task[tid_match] = tf
            worker_terms = re.findall(r"--(?:from|terminal)\s+(term_[a-f0-9-]+)", blob)
            if not worker_terms:
                worker_terms = re.findall(r"Worker terminal(?: handle)?:\s*(term_[a-f0-9-]+)", blob, re.I)
            for trm_match in worker_terms:
                by_term[trm_match] = tf
            return

        creator_ts = {}
        coord_ts = {}
        active_coord_rids = set()
        first_ts = ""
        for st in parsed_steps:
            if st.get("created_at"):
                first_ts = str(st.get("created_at"))
                break
        for idx_s, st in enumerate(parsed_steps):
            st_type = st.get("type")
            if st_type in ("SYSTEM_MESSAGE", "USER_INPUT"):
                sm_str = str(st.get("content") or "")
                sm_ts = str(st.get("created_at") or first_ts or "9999")
                for r_m in re.findall(r"\[ORCA RUNTIME NOTIFICATION\s+—\s+RUN:\s*(run_[a-f0-9]{12})\b", sm_str):
                    coord_ts.setdefault(r_m, sm_ts)
                    active_coord_rids.add(r_m)
                continue
            if st_type != "PLANNER_RESPONSE":
                continue
            step_ts = str(st.get("created_at") or first_ts or "9999")
            tcs = st.get("tool_calls") or []
            has_rc = False
            has_active_orch = False
            for tc in tcs:
                cmd_str = _command_from_tool_call(tc)
                if not cmd_str or "orca-monitor" in cmd_str:
                    continue
                if not re.search(r"\bpython3?\b", cmd_str) and re.search(r"\borca\s+orchestration\s+run-create\b", cmd_str):
                    has_rc = True
                    has_active_orch = True
                if re.search(
                    r"\b(?:orca\s+orchestration\s+(?:task-create|worker-start|check|worker-read|gate-create|gate-resolve|task-update|worker-retain|worker-release|worker-stop|send|reply)|orca-team\s+(?:plan|pin-plan|master-plan|worktree-arg|wt-arg|slot-arg|merge-upstream|merge-run|run-branches|release-workers|cleanup-tabs|gc-workers))\b",
                    cmd_str,
                ):
                    has_active_orch = True
                    for r_m in re.findall(r"--(?:run|run-id|id)(?:=|\s+)[\"']?(run_[a-f0-9]{12})\b", cmd_str):
                        coord_ts.setdefault(r_m, step_ts)
                        active_coord_rids.add(r_m)
            if has_rc or has_active_orch:
                j = idx_s + 1
                created_rids = []
                fallback_rids = []
                max_scan = min(len(parsed_steps), idx_s + 12)
                while j < max_scan:
                    jt = parsed_steps[j].get("type")
                    g_content = str(parsed_steps[j].get("content") or "")
                    if jt == "USER_INPUT":
                        break
                    is_bg_sys = jt == "SYSTEM_MESSAGE" and (
                        "[Message from background task" in g_content
                        or bool(re.search(r'Task id "[^"]+/task-\d+" finished with result:', g_content))
                    )
                    if jt == "GENERIC" or is_bg_sys:
                        for r_m in re.findall(r'(?:"run(?:Id|_id)"\s*:\s*"|\brun:|\[Run\s+)(run_[a-f0-9]{12})\b', g_content):
                            coord_ts.setdefault(r_m, step_ts)
                            if has_active_orch:
                                active_coord_rids.add(r_m)
                        if has_rc:
                            created_rids.extend(
                                re.findall(r'(?:Created\s+|RUN=|"run"\s*:\s*\{\s*"id"\s*:\s*")(run_[a-f0-9]{12})\b', g_content)
                            )
                            fallback_rids.extend(re.findall(r"\brun_[a-f0-9]{12}\b", g_content))
                    elif jt == "PLANNER_RESPONSE":
                        next_tcs = parsed_steps[j].get("tool_calls") or []
                        if any(not re.search(r"\bpython3?\b", _command_from_tool_call(ntc)) and re.search(r"\borca\s+orchestration\s+run-create\b", _command_from_tool_call(ntc)) for ntc in next_tcs if isinstance(ntc, dict)):
                            break
                        if not has_rc or created_rids:
                            break
                    j += 1
                if has_rc:
                    chosen_rid = created_rids[-1] if created_rids else (fallback_rids[-1] if fallback_rids else None)
                    if chosen_rid:
                        creator_ts.setdefault(chosen_rid, step_ts)
                        active_coord_rids.add(chosen_rid)
        all_matched_rids = set(creator_ts.keys()) | (set(coord_ts.keys()) & active_coord_rids)
        for rid_match in all_matched_rids:
            score = 2 if rid_match in creator_ts else 1
            ev_ts = creator_ts.get(rid_match) or coord_ts.get(rid_match) or first_ts or "9999"
            cand = (tf, score, is_cli, ev_ts)
            prev = by_leader_run.get(rid_match)
            if not prev or (score, is_cli) > (prev[1], prev[2]) or ((score, is_cli) == (prev[1], prev[2]) and cand[3] < prev[3]):
                by_leader_run[rid_match] = cand

    roots = [
        Path.home() / ".gemini" / "antigravity-cli" / "brain",
        Path.home() / ".gemini" / "antigravity" / "brain",
    ]
    for r_dir in roots:
        if not r_dir.is_dir():
            continue
        for cid_dir in r_dir.iterdir():
            if not cid_dir.is_dir():
                continue
            tf = cid_dir / ".system_generated" / "logs" / "transcript.jsonl"
            full_tf = cid_dir / ".system_generated" / "logs" / "transcript_full.jsonl"
            if not tf.exists():
                continue
            src_tf = full_tf if full_tf.exists() else tf
            try:
                with open(src_tf, "r", encoding="utf-8", errors="ignore") as f:
                    raw_text = f.read()
            except Exception:
                continue
            if "You are a dispatched worker" not in raw_text and "orchestration" not in raw_text:
                continue
            try:
                parsed_steps = [json.loads(sln) for sln in raw_text.splitlines() if sln.strip()]
                parsed_steps = [st for st in parsed_steps if isinstance(st, dict)]
                _index_parsed_steps(tf, parsed_steps, 1 if "antigravity-cli" in str(tf) else 0)
            except Exception:
                continue

    claude_dir = Path.home() / ".claude" / "projects"
    if claude_dir.is_dir():
        for claude_tf in claude_dir.glob("*/*.jsonl"):
            try:
                with open(claude_tf, "r", encoding="utf-8", errors="ignore") as f:
                    raw_text = f.read()
                if "You are a dispatched worker" not in raw_text and "orchestration" not in raw_text:
                    continue
                parsed_steps = _load_normalized_transcript_steps(claude_tf)
                _index_parsed_steps(claude_tf, parsed_steps, 1)
            except Exception:
                continue

    kimi_dir = Path.home() / ".kimi-code" / "sessions"
    if kimi_dir.is_dir():
        for kimi_tf in kimi_dir.glob("wd_*/session_*/agents/main/wire.jsonl"):
            try:
                with open(kimi_tf, "r", encoding="utf-8", errors="ignore") as f:
                    raw_text = f.read()
                if "You are a dispatched worker" not in raw_text and "orchestration" not in raw_text:
                    continue
                parsed_steps = _load_normalized_transcript_steps(kimi_tf)
                _index_parsed_steps(kimi_tf, parsed_steps, 1)
            except Exception:
                continue

    return {
        "by_dispatch": by_dispatch,
        "by_task": by_task,
        "by_term": by_term,
        "by_leader_run": {rid: v[0] for rid, v in by_leader_run.items()},
    }


def _collect_git_diff_stats(
    wt_path: str,
    wt_name: str,
    root: Path = None,
    start_dt=None,
    comp_dt=None,
    is_active: bool = False,
    commit_shas: list = None,
    has_transcript: bool = False,
    ran_git_commit: bool = False,
) -> dict:
    res = {"files": 0, "ins": 0, "del": 0, "commits": 0}
    has_wt_dir = bool(wt_path and os.path.isdir(wt_path))
    git_dir = wt_path if has_wt_dir else (str(root) if root and root.is_dir() else "")
    if not git_dir:
        return res
    import subprocess
    try:
        def _git(*a, t=2, cwd_override=None):
            r = subprocess.run(["git", "-C", cwd_override or git_dir, *a], capture_output=True, text=True, timeout=t)
            return r.stdout.strip() if r.returncode == 0 else ""

        seen_files = set()
        if commit_shas:
            valid_shas = []
            for sha in commit_shas:
                if _git("rev-parse", "--verify", "-q", f"{sha}^2") or (
                    root and root.is_dir() and str(root) != git_dir and _git("rev-parse", "--verify", "-q", f"{sha}^2", cwd_override=str(root))
                ):
                    continue
                ns = _git("show", "--numstat", "--format=", sha, t=3)
                if not ns and root and root.is_dir() and str(root) != git_dir:
                    ns = _git("show", "--numstat", "--format=", sha, t=3, cwd_override=str(root))
                if ns or _git("cat-file", "-t", sha) == "commit" or (
                    root and root.is_dir() and str(root) != git_dir and _git("cat-file", "-t", sha, cwd_override=str(root)) == "commit"
                ):
                    valid_shas.append(sha)
                    for ln in ns.splitlines():
                        parts = ln.strip().split("\t")
                        if len(parts) >= 3:
                            seen_files.add(parts[2])
                            if parts[0].isdigit():
                                res["ins"] += int(parts[0])
                            if parts[1].isdigit():
                                res["del"] += int(parts[1])
            if valid_shas:
                res["commits"] = len(valid_shas)
                if is_active and has_wt_dir:
                    dirty_ns = _git("diff", "--numstat", "HEAD", t=3)
                    for ln in dirty_ns.splitlines():
                        parts = ln.strip().split("\t")
                        if len(parts) >= 3:
                            seen_files.add(parts[2])
                            if parts[0].isdigit():
                                res["ins"] += int(parts[0])
                            if parts[1].isdigit():
                                res["del"] += int(parts[1])
                res["files"] = len(seen_files)
                return res

        if has_transcript and not ran_git_commit:
            # Worker có transcript đã phân tích và không thực hiện git commit nào trong phiên này
            if is_active and has_wt_dir:
                dirty_ns = _git("diff", "--numstat", "HEAD", t=3)
                for ln in dirty_ns.splitlines():
                    parts = ln.strip().split("\t")
                    if len(parts) >= 3:
                        seen_files.add(parts[2])
                        if parts[0].isdigit():
                            res["ins"] += int(parts[0])
                        if parts[1].isdigit():
                            res["del"] += int(parts[1])
                res["files"] = len(seen_files)
            return res

        # Nếu không có transcript (hoặc transcript bị cắt cụt SHA commit) nhưng có cửa sổ thời gian thực thi của dispatch (start_dt .. comp_dt)
        if start_dt and comp_dt:
            since_ts = max(0, int(start_dt.timestamp()))
            until_ts = int(comp_dt.timestamp()) + 15
            target_ref = "HEAD" if has_wt_dir else (wt_name if (wt_name and wt_name != "-" and _git("rev-parse", "--verify", "-q", wt_name)) else "HEAD")
            shas = []
            reflog_checked = False
            if has_wt_dir or (target_ref != "HEAD"):
                rf_chk = subprocess.run(
                    ["git", "-C", git_dir, "reflog", "show", "--format=%H|%gs", f"--since=@{since_ts}", f"--until=@{until_ts}", target_ref],
                    capture_output=True, text=True, timeout=3,
                )
                if rf_chk.returncode == 0:
                    reflog_checked = True
                    for rln in rf_chk.stdout.splitlines():
                        if "|" not in rln:
                            continue
                        r_sha, r_gs = rln.split("|", 1)
                        r_sha_clean = r_sha.strip()
                        if r_gs.startswith(("commit:", "commit (amend):", "commit (initial):")) and r_sha_clean not in shas:
                            anc_chk = subprocess.run(
                                ["git", "-C", git_dir, "merge-base", "--is-ancestor", r_sha_clean, target_ref],
                                capture_output=True, timeout=2,
                            )
                            if anc_chk.returncode == 0:
                                shas.append(r_sha_clean)
            if not shas and not reflog_checked:
                rev_args = ["rev-list", "--no-merges", f"--since=@{since_ts}", f"--until=@{until_ts}", target_ref]
                if wt_name and not wt_name.startswith(("dev-worker", "devops-worker", "ui-worker")):
                    for excl_cand in ("main", "master", "develop", "dev-worker", "devops-worker", "ui-worker"):
                        if _git("rev-parse", "--verify", "-q", excl_cand):
                            rev_args.append(f"^{excl_cand}")
                    for extra_k in range(2, 11):
                        for pfx in ("dev-worker", "devops-worker", "ui-worker"):
                            cand_br = f"{pfx}-{extra_k}"
                            if _git("rev-parse", "--verify", "-q", cand_br):
                                rev_args.append(f"^{cand_br}")
                shas = [s.strip() for s in _git(*rev_args, t=3).splitlines() if s.strip()]
            if shas:
                res["commits"] = len(shas)
                for sha in shas:
                    ns = _git("show", "--numstat", "--format=", sha, t=3)
                    for ln in ns.splitlines():
                        parts = ln.strip().split("\t")
                        if len(parts) >= 3:
                            seen_files.add(parts[2])
                            if parts[0].isdigit():
                                res["ins"] += int(parts[0])
                            if parts[1].isdigit():
                                res["del"] += int(parts[1])
            if is_active and has_wt_dir:
                dirty_ns = _git("diff", "--numstat", "HEAD", t=3)
                for ln in dirty_ns.splitlines():
                    parts = ln.strip().split("\t")
                    if len(parts) >= 3:
                        seen_files.add(parts[2])
                        if parts[0].isdigit():
                            res["ins"] += int(parts[0])
                        if parts[1].isdigit():
                            res["del"] += int(parts[1])
            res["files"] = len(seen_files)
            return res

        if not has_wt_dir:
            return res

        head_sha = _git("rev-parse", "HEAD")
        main_sha = (
            _git("rev-parse", "--verify", "-q", "main")
            or _git("rev-parse", "--verify", "-q", "master")
            or _git("rev-parse", "--verify", "-q", "develop")
        )
        head_p2 = _git("rev-parse", "--verify", "-q", "HEAD^2")
        base_ref = None
        if head_sha and main_sha and head_sha != main_sha:
            base_ref = _git("merge-base", "HEAD", main_sha) or main_sha
            if not wt_name.startswith(("dev-worker", "devops-worker", "ui-worker")):
                upstream_brs = ["dev-worker", "devops-worker", "ui-worker"]
                for extra_k in range(2, 11):
                    for pfx in ("dev-worker", "devops-worker", "ui-worker"):
                        upstream_brs.append(f"{pfx}-{extra_k}")
                for src_br in upstream_brs:
                    cand_sha = _git("rev-parse", "--verify", "-q", src_br)
                    if not cand_sha:
                        continue
                    anc = subprocess.run(["git", "-C", git_dir, "merge-base", "--is-ancestor", cand_sha, "HEAD"], capture_output=True, timeout=2)
                    if anc.returncode == 0:
                        fwd = subprocess.run(["git", "-C", git_dir, "merge-base", "--is-ancestor", base_ref, cand_sha], capture_output=True, timeout=2)
                        if fwd.returncode == 0 or head_p2 == cand_sha:
                            base_ref = cand_sha
        if base_ref:
            c_cnt = subprocess.run(["git", "-C", git_dir, "rev-list", "--no-merges", "--count", f"{base_ref}..HEAD"], capture_output=True, text=True, timeout=2).stdout.strip()
            if c_cnt.isdigit():
                res["commits"] = int(c_cnt)
            numstat = subprocess.run(["git", "-C", git_dir, "diff", "--numstat", f"{base_ref}..HEAD"], capture_output=True, text=True, timeout=3)
        else:
            numstat = subprocess.run(["git", "-C", git_dir, "diff", "--numstat", "HEAD"], capture_output=True, text=True, timeout=3)
        if numstat.returncode == 0:
            for ln in numstat.stdout.splitlines():
                parts = ln.strip().split("\t")
                if len(parts) >= 3:
                    res["files"] += 1
                    if parts[0].isdigit():
                        res["ins"] += int(parts[0])
                    if parts[1].isdigit():
                        res["del"] += int(parts[1])
    except Exception:
        pass
    return res


def _safe_orca_run(cmd, **kw):
    """subprocess.run cho Orca CLI: timeout/lỗi spawn trả về returncode != 0 thay vì làm sập cả phần telemetry."""
    import subprocess
    kw.setdefault("capture_output", True)
    kw.setdefault("text", True)
    try:
        return subprocess.run(cmd, **kw)
    except (subprocess.TimeoutExpired, OSError) as e:
        return subprocess.CompletedProcess(cmd, 124, stdout="", stderr=str(e))


def cmd_monitor(root: Path, config: dict, args: list = None):
    import io
    import subprocess
    args = args or []
    if any(a in args for a in ["-h", "--help", "help"]):
        print("Sử dụng: orca-monitor [path] [--run <run_id>] [--fix] [--verbose] [--json]")
        return
    verbose = any(a in args for a in ["-v", "--verbose", "--full"])
    auto_fix = any(a in args for a in ["--fix", "-f"])
    as_json = "--json" in args
    orig_stdout = sys.stdout
    if as_json:
        sys.stdout = io.StringIO()

    print("\n╔══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════╗")
    print("║                   🔬 ORCA ENGINEERING TELEMETRY, SPEED BENCHMARK & TOKEN MONITOR                                     ║")
    print("╚══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════╝")
    print(f"📍 Workspace: {root}")
    if auto_fix:
        print("⚡ Auto-Fix Mode: Enabled")
    print("")

    critical_issues = []
    warning_issues = []
    passed_items = []
    actions_taken = []

    # ─────────────────────────────────────────────────────────────────────────────
    # PHẦN 1: CHỈ DẪN HỆ THỐNG & CONTEXT TIÊU TỐN MỖI LƯỢT (PER-TURN SYSTEM PROMPT)
    # ─────────────────────────────────────────────────────────────────────────────
    print("📋 1. SYSTEM PROMPT & STATIC DIRECTIVE OVERHEAD (PER-TURN BASELINE)")
    print(f"{'FILE / NGUỒN':<26} | {'LOẠI':<12} | {'KÍCH THƯỚC':<12} | {'ƯỚC TÍNH TOKENS':<16} | {'TRẠNG THÁI'}")
    print("-" * 88)

    # Kiểm tra đồng bộ cơ chế Tự động co giãn Worktree (orca-team worktree-arg), Chế độ /goal và tối ưu dung lượng (<6.4k tok) trong .agents/GEMINI.md
    gemini_path_chk = root / ".agents" / "GEMINI.md"
    if config and gemini_path_chk.is_file():
        try:
            g_txt = gemini_path_chk.read_text(encoding="utf-8", errors="ignore")
            roles_cfg_chk = config.get("roles") or {}
            missing_elastic_wt = "orca-team worktree-arg" not in g_txt
            coord_goal_cfg = _is_goal_mode_enabled(config.get("coordinator") or {}, config)
            any_worker_goal_cfg = any(
                _is_goal_mode_enabled(roles_cfg_chk.get(rk) or {}, config)
                for rk in ("developer", "qa", "security", "devopsSpecialist", "benchSpecialist", "reSpecialist", "uiSpecialist", "criticSpecialist", "prReviewer", "issueResolver")
            )
            if coord_goal_cfg:
                missing_goal_directive = "CHẾ ĐỘ LÀM TRIỆT ĐỂ MẶC ĐỊNH" not in g_txt
            elif any_worker_goal_cfg:
                missing_goal_directive = (
                    "CHẾ ĐỘ LÀM TRIỆT ĐỂ TRÊN WORKER" not in g_txt
                    or "CHẾ ĐỘ LÀM TRIỆT ĐỂ MẶC ĐỊNH" in g_txt
                    or "(`goalMode: true` trên `coordinator`)" in g_txt
                )
            else:
                missing_goal_directive = (
                    "CHẾ ĐỘ LÀM TRIỆT ĐỂ" in g_txt
                    or "(`goalMode: true` trên `coordinator`)" in g_txt
                    or "PHÂN ĐỊNH TRÁCH NHIỆM KIỂM SOÁT CHẤT LƯỢNG & TIẾN ĐỘ PLAN" not in g_txt
                    or "orca-team plan pin" not in g_txt
                )
            bloated_orca_directive = ORCA_DIRECTIVE_MARKER in g_txt and estimate_tokens(g_txt) > 6400
            if missing_elastic_wt or missing_goal_directive or bloated_orca_directive:
                if auto_fix:
                    sync_gemini_directive(root, config)
                    fix_parts = []
                    if missing_elastic_wt:
                        fix_parts.append("Tự động co giãn Worktree Slots (orca-team worktree-arg)")
                    if missing_goal_directive:
                        fix_parts.append("Kiến trúc Quân sư Critic + Pinned Master Plan + QA Kiểm toán 100% Plan & trạng thái goalMode")
                    if bloated_orca_directive:
                        fix_parts.append("Tối ưu nén dung lượng chỉ dẫn (< 6,400 tokens/turn)")
                    actions_taken.append(
                        f"Đồng bộ lại '.agents/GEMINI.md' bổ sung đầy đủ: {' & '.join(fix_parts)}."
                    )
                else:
                    if missing_elastic_wt:
                        warning_issues.append(
                            "File '.agents/GEMINI.md' đang ở bản cũ chưa dùng lệnh tự động cấp phát/tái sử dụng Worktree Slot "
                            "('orca-team worktree-arg <role>') (chạy 'orca-team sync' hoặc 'orca-monitor --fix' để cập nhật)."
                        )
                    if missing_goal_directive:
                        warning_issues.append(
                            "File '.agents/GEMINI.md' chưa đồng bộ kiến trúc Quân sư Critic + Pinned Master Plan ('orca-team plan pin') + QA Kiểm toán 100% Plan / trạng thái goalMode (chạy 'orca-team sync' hoặc 'orca-monitor --fix' để cập nhật)."
                        )
        except Exception:
            pass

    base_tokens = 0
    target_files = [
        (".agents/GEMINI.md", root / ".agents" / "GEMINI.md"),
        ("CLAUDE.md", root / "CLAUDE.md"),
        ("AGENTS.md", root / "AGENTS.md"),
        ("orca-team.json", root / "orca-team.json"),
        ("plan.md", root / "plan.md"),
    ]

    for rel_name, path in target_files:
        if not path.exists() and not path.is_symlink():
            continue

        is_link = path.is_symlink()
        try:
            raw_text = path.read_text(encoding="utf-8", errors="ignore")
            size_b = len(raw_text.encode("utf-8"))
            tokens = estimate_tokens(raw_text)
        except Exception:
            raw_text = ""
            size_b = 0
            tokens = 0

        if is_link:
            status = "Symlink (0 extra)"
            type_str = "Symlink"
            size_str = f"{size_b} B"
            tokens_str = f"~{tokens} (shared)"
        elif rel_name in ("orca-team.json", "plan.md"):
            type_str = "Config/Doc"
            size_str = f"{size_b/1024:.1f} KB" if size_b > 1024 else f"{size_b} B"
            tokens_str = f"~{tokens} (on-demand)"
            status = "On-demand (0 base)"
        elif rel_name in ("CLAUDE.md", "AGENTS.md") and path.exists():
            type_str = "File thật"
            size_str = f"{size_b/1024:.1f} KB" if size_b > 1024 else f"{size_b} B"
            tokens_str = f"~{tokens} tokens"
            gemini_p = root / ".agents" / "GEMINI.md"
            same = False
            if gemini_p.exists():
                try:
                    same = path.read_bytes() == gemini_p.read_bytes()
                except Exception:
                    same = False
            if same:
                if auto_fix:
                    try:
                        path.unlink()
                        os.symlink(".agents/GEMINI.md", path)
                        actions_taken.append(f"Chuyển '{rel_name}' (nội dung trùng 100%) thành symlink trỏ về '.agents/GEMINI.md'.")
                        type_str = "Symlink"
                        tokens_str = f"~{tokens} (shared)"
                        status = "FIXED (Symlink)"
                    except Exception as e:
                        base_tokens += tokens
                        status = "DUPLICATE (x2)"
                        critical_issues.append(
                            f"File '{rel_name}' là bản sao độc lập thay vì symlink tới '.agents/GEMINI.md' (tốn gấp đôi ~{tokens} tokens/turn)."
                        )
                        actions_taken.append(f"Lỗi khi chuyển '{rel_name}' thành symlink: {e}")
                else:
                    base_tokens += tokens
                    status = "DUPLICATE (x2)"
                    critical_issues.append(
                        f"File '{rel_name}' là bản sao độc lập thay vì symlink tới '.agents/GEMINI.md' (tốn gấp đôi ~{tokens} tokens/turn)."
                    )
            else:
                base_tokens += tokens
                status = "CUSTOM FILE"
                warning_issues.append(
                    f"File '{rel_name}' là file riêng của người dùng (~{tokens} tokens/turn, khác '.agents/GEMINI.md')."
                )
        else:
            type_str = "File thật"
            size_str = f"{size_b/1024:.1f} KB" if size_b > 1024 else f"{size_b} B"
            tokens_str = f"~{tokens} tokens"
            base_tokens += tokens
            if tokens > 6400:
                status = "WARN (>6.4k tok)"
                warning_issues.append(f"File '{rel_name}' nặng ~{tokens} tokens (nạp lại vào context trên mỗi turn).")
            else:
                status = "OK"

        print(f"{rel_name:<26} | {type_str:<12} | {size_str:<12} | {tokens_str:<16} | {status}")

    print("-" * 88)
    print(f"👉 Base Directive Overhead: ~{base_tokens:,} tokens/turn")
    if base_tokens < 6400:
        passed_items.append(f"Base Directive Overhead: ~{base_tokens:,} tokens/turn (< 6,400 tokens threshold).")
    elif base_tokens < 7400:
        warning_issues.append(f"Base Directive Overhead ở mức trung bình (~{base_tokens:,} tokens/turn).")
    else:
        critical_issues.append(f"Base Directive Overhead vượt ngưỡng (~{base_tokens:,} tokens/turn).")

    # Kiểm tra rò rỉ file chỉ dẫn Leader (.agents/GEMINI.md, GEMINI.md, AGENTS.md, CLAUDE.md) sang các Child Worktrees của Worker
    try:
        wt_list_res = subprocess.run(
            ["git", "-C", str(root), "worktree", "list", "--porcelain"],
            capture_output=True, text=True, timeout=4, check=False,
        )
        if wt_list_res.returncode == 0:
            root_real = os.path.realpath(str(root))
            child_wt_paths = []
            for ln in wt_list_res.stdout.splitlines():
                if ln.startswith("worktree "):
                    cand_wt = ln[len("worktree "):].strip()
                    if cand_wt and os.path.realpath(cand_wt) != root_real and os.path.isdir(cand_wt):
                        child_wt_paths.append(cand_wt)
            leaked_child_wts = []
            cleaned_child_wts = []
            for cwt in child_wt_paths:
                matched_files = _strip_leader_directives_in_child_worktree(cwt, root, dry_run=not auto_fix)
                if matched_files:
                    if auto_fix:
                        cleaned_child_wts.append(f"{os.path.basename(cwt)} ({', '.join(matched_files)})")
                    else:
                        leaked_child_wts.append(f"{os.path.basename(cwt)} ({', '.join(matched_files)})")
            if cleaned_child_wts:
                actions_taken.append(
                    f"Gỡ bỏ file chỉ dẫn Leader rò rỉ trong {len(cleaned_child_wts)} child worktree(s) (giữ git status sạch bằng --skip-worktree): {', '.join(cleaned_child_wts)}."
                )
                passed_items.append(f"Child worktrees ({len(child_wt_paths)} worktrees) sạch 100% file chỉ dẫn Leader (0 token leak).")
            elif leaked_child_wts:
                print(f"🚨 Phát hiện rò rỉ file chỉ dẫn Leader trong {len(leaked_child_wts)} child worktree(s): {', '.join(leaked_child_wts)}")
                critical_issues.append(
                    f"Rò rỉ file chỉ dẫn Leader (~{base_tokens:,} tok/turn + lệnh CẤM sửa file) sang child worktree của Worker: {', '.join(leaked_child_wts)} (chạy 'orca-monitor --fix' để dọn sạch)."
                )
            elif child_wt_paths:
                print(f"   • Child Worktree Directive Isolation: {len(child_wt_paths)} worktree(s) clean (0 leaked Leader directive tokens)")
                passed_items.append(f"Child worktrees ({len(child_wt_paths)} worktrees) không bị rò rỉ file chỉ dẫn Leader.")
    except Exception:
        pass
    print("")

    # ─────────────────────────────────────────────────────────────────────────────
    # PHẦN 2: QUÉT BẪY VÒNG LẶP & ĐƯỜNG DẪN CHẾT (DEAD REFERENCE TRAPS)
    # ─────────────────────────────────────────────────────────────────────────────
    print("🕵️ 2. KIỂM TRA ĐƯỜNG DẪN CHẾT TRONG FILE CHỈ DẪN (DEAD REFERENCE CHECK)")
    scanned_directives = []
    seen_real_directives = set()
    for rel_name, p in target_files:
        if rel_name in ("orca-team.json", "plan.md") or not p.exists():
            continue
        try:
            rp = p.resolve()
        except Exception:
            rp = p
        if rp not in seen_real_directives:
            seen_real_directives.add(rp)
            scanned_directives.append(p)
    dead_refs_found = []

    for path in scanned_directives:
        try:
            content = path.read_text(encoding="utf-8", errors="ignore")
        except Exception:
            continue

        seen_in_file = set()
        raw_matches = re.findall(r'(?:[\s\(\[\`\"\'\:]|^)([a-zA-Z0-9_\-\./]+\.[a-zA-Z0-9]{1,5})(?:[\s\)\]\`\"\'\:]|$)', content)
        for p_str in raw_matches:
            if p_str in seen_in_file:
                continue
            if p_str.startswith(('http://', 'https://', 'git://', 'ssh://')):
                continue
            if re.match(r'^\d+\.\d+$', p_str) or re.search(r'/\d+(?:\.\d+)+$', p_str):
                continue
            if p_str.lower() in (
                'e.g.', 'i.e.', 'etc.', 'example.com',
                'node.js', 'next.js', 'nuxt.js', 'vue.js', 'react.js',
                'express.js', 'nest.js', 'three.js', 'chart.js',
            ):
                continue
            if '/' in p_str or p_str.endswith(('.md', '.json', '.sh', '.py', '.ts', '.js', '.yml', '.yaml', '.txt')):
                if p_str in ("plan.md", "orca-team.json", "package.json", "pnpm-lock.yaml", "yarn.lock", "setup-runner.sh"):
                    continue
                if f"-f {p_str}" in content or f'-f "{p_str}"' in content:
                    continue
                if "github.com" in content[max(0, content.find(p_str)-30):content.find(p_str)+len(p_str)+30]:
                    continue

                seen_in_file.add(p_str)
                target_p = root / p_str
                if not target_p.exists():
                    dead_refs_found.append((p_str, path.name))

    if dead_refs_found:
        print(f"🚨 Phát hiện {len(dead_refs_found)} đường dẫn không tồn tại:")
        for ref, source in dead_refs_found:
            print(f"   ❌ '{ref}' (trong {source})")
            critical_issues.append(
                f"Đường dẫn '{ref}' trong '{source}' không tồn tại trên đĩa (gây lỗi File Not Found khi AI gọi view_file)."
            )
    else:
        print("   • Dead references: 0 (OK)")
        passed_items.append("Dead references trong file chỉ dẫn: 0.")
    print("")

    # ─────────────────────────────────────────────────────────────────────────────
    # PHẦN 3: VỆ SINH WORKSPACE & BẪY GIT STATUS (WORKSPACE HYGIENE)
    # ─────────────────────────────────────────────────────────────────────────────
    print("🧹 3. WORKSPACE HYGIENE & GIT STATUS FOOTPRINT")
    gitignore_path = root / ".gitignore"
    is_orca_proj = (root / "orca-team.json").is_file() or (root / ".agents" / "GEMINI.md").is_file()
    if not gitignore_path.exists():
        if auto_fix and is_orca_proj:
            gitignore_path.write_text(".orca/\n.orca-cache/\n*.orca.log\nnode_modules/\n.venv/\n", encoding="utf-8")
            actions_taken.append("Tạo mới '.gitignore' với quy tắc chặn log Orca.")
            print("   • .gitignore rules (.orca/, .orca-cache/, *.orca.log): FIXED")
            passed_items.append(".gitignore đã chặn thư mục tạm của Orca.")
        else:
            print("⚠️ Chưa có file '.gitignore'.")
            warning_issues.append("Thiếu file '.gitignore'.")
    else:
        gi_content = gitignore_path.read_text(encoding="utf-8", errors="ignore")
        missing_ignores = [pat for pat in [".orca", ".orca-cache", "*.orca.log"] if pat not in gi_content]
        if missing_ignores:
            if auto_fix and is_orca_proj:
                with open(gitignore_path, "a", encoding="utf-8") as f:
                    f.write("\n# Orca Orchestrator Runtime Logs & Receipts\n")
                    for m in missing_ignores:
                        f.write(f"{m}\n")
                actions_taken.append(f"Bổ sung '{', '.join(missing_ignores)}' vào .gitignore.")
                print("   • .gitignore rules (.orca/, .orca-cache/, *.orca.log): FIXED")
                passed_items.append(".gitignore đã chặn thư mục tạm của Orca.")
            elif is_orca_proj:
                print(f"⚠️ '.gitignore' thiếu: {', '.join(missing_ignores)}")
                critical_issues.append(f"Thiếu '{', '.join(missing_ignores)}' trong .gitignore.")
            else:
                print(f"   • .gitignore rules: Chưa khởi tạo Orca Orchestrator (bỏ qua {', '.join(missing_ignores)})")
        else:
            print("   • .gitignore rules (.orca/, .orca-cache/, *.orca.log): OK")
            passed_items.append(".gitignore đã chặn thư mục tạm của Orca.")

    try:
        git_res = subprocess.run(["git", "status", "--porcelain"], capture_output=True, text=True, cwd=str(root), timeout=5)
        if git_res.returncode == 0:
            lines = [l for l in git_res.stdout.splitlines() if l.strip()]
            untracked = [l for l in lines if l.startswith("??")]
            modified = [l for l in lines if not l.startswith("??")]
            git_tokens = estimate_tokens(git_res.stdout)
            print(f"   • Git status output: {len(modified)} modified, {len(untracked)} untracked (~{git_tokens:,} tokens khi gọi git status)")
            if len(untracked) > 25:
                warning_issues.append(
                    f"Workspace có {len(untracked)} file untracked (~{git_tokens:,} tokens mỗi lần chạy 'git status')."
                )
            else:
                passed_items.append(f"Git status footprint nhỏ ({len(untracked)} untracked files, ~{git_tokens:,} tokens).")
    except Exception:
        pass
    print("")

    # ─────────────────────────────────────────────────────────────────────────────
    # PHẦN 4: RUNTIME TELEMETRY, TỐC ĐỘ MODEL (TOK/S) & PHÂN TÍCH ĐỊNH LƯỢNG
    # ─────────────────────────────────────────────────────────────────────────────
    print("⚡ 4. RUNTIME TELEMETRY, MODEL VELOCITY (TOK/S) & TOKEN BREAKDOWN")
    orca_bin = os.environ.get("ORCA_BIN") or shutil.which("orca") or "/usr/local/bin/orca"

    runtime_ok = False
    active_run_id = None
    active_run_obj = ""
    run_tasks = {}
    workers = []
    hb_count = done_count = esc_count = handoff_count = done_tokens = 0
    p2p_dev_ready_cnt = p2p_reject_cnt = 0
    run_msgs = []
    leader_m = {}
    worker_metrics_list = []
    model_buckets = {}

    explicit_run_id = None
    for idx_a, a in enumerate(args):
        if a == "--run":
            if idx_a + 1 >= len(args) or args[idx_a + 1].startswith("-"):
                if as_json:
                    sys.stdout = orig_stdout
                print("❌ Thiếu giá trị cho cờ --run (ví dụ: --run run_xxxxxxxxxxxx).", file=sys.stderr)
                sys.exit(1)
            explicit_run_id = args[idx_a + 1]
        elif a.startswith("--run="):
            val = a.split("=", 1)[1].strip()
            if not val or val.startswith("-"):
                if as_json:
                    sys.stdout = orig_stdout
                print("❌ Thiếu giá trị cho cờ --run (ví dụ: --run=run_xxxxxxxxxxxx).", file=sys.stderr)
                sys.exit(1)
            explicit_run_id = val
        elif a.startswith("run_"):
            explicit_run_id = a

    try:
        r_res = _safe_orca_run([orca_bin, "orchestration", "run-list", "--json"], capture_output=True, text=True, timeout=5)
        all_runs = []
        if r_res.returncode == 0:
            r_data = json.loads(r_res.stdout)
            r_obj = r_data.get("result", r_data) if isinstance(r_data, dict) else {}
            all_runs = r_obj.get("runs", []) if isinstance(r_obj, dict) else []
            runtime_ok = True

        proj_slug = root.name.lower()
        candidate_runs = [r for r in all_runs if not r.get("legacy")]

        selected_run = None
        if explicit_run_id:
            scan_runs = [r for r in candidate_runs if r.get("id") == explicit_run_id] or [{"id": explicit_run_id, "objective": ""}]
        else:
            scan_runs = candidate_runs

        from concurrent.futures import ThreadPoolExecutor

        db_p_scan = _find_orca_orchestration_db()
        root_real_lower = os.path.realpath(str(root)).lower()
        root_str_lower = str(root).lower()

        def _fetch_run_workers(r_item: dict):
            rid_str = r_item.get("id")
            if not rid_str:
                return (r_item, None, [])
            w_c = _safe_orca_run([orca_bin, "orchestration", "worker-list", "--run", rid_str, "--json"], capture_output=True, text=True, timeout=8)
            if w_c.returncode == 124:
                return (r_item, 124, [])
            w_l = []
            if w_c.returncode == 0:
                try:
                    wo_d = json.loads(w_c.stdout).get("result", {})
                    w_l = wo_d.get("workers", []) if isinstance(wo_d, dict) else []
                except Exception:
                    w_l = []
            if db_p_scan is not None and (not w_l or any(not (wi.get("resource") or {}).get("worktreeId") for wi in w_l if isinstance(wi, dict))):
                try:
                    import sqlite3 as _sq3_w
                    _cw = _sq3_w.connect(f"file:{db_p_scan}?mode=ro", uri=True, timeout=1.5)
                    _cw.row_factory = _sq3_w.Row
                    _wrows = _cw.execute(
                        """
                        SELECT dc.id AS dispatch_id, dc.task_id, dc.status AS dc_status, dc.created_at, dc.completed_at,
                               wd.state AS wd_state, wd.worktree_id, wd.agent_terminal_handle
                        FROM dispatch_contexts dc
                        LEFT JOIN worker_dispatches wd ON wd.dispatch_id = dc.id
                        WHERE dc.run_id = ?
                        ORDER BY dc.created_at DESC
                        """,
                        (rid_str,),
                    ).fetchall()
                    _cw.close()
                    if not w_l and _wrows:
                        for wr in _wrows:
                            w_l.append({
                                "dispatchId": wr["dispatch_id"],
                                "taskId": wr["task_id"],
                                "state": wr["wd_state"] or wr["dc_status"],
                                "workerState": wr["wd_state"] or wr["dc_status"],
                                "createdAt": wr["created_at"],
                                "completedAt": wr["completed_at"],
                                "agentTerminalHandle": wr["agent_terminal_handle"],
                                "resource": {"worktreeId": wr["worktree_id"], "state": "released"},
                            })
                    elif _wrows:
                        wt_by_did = {str(wr["dispatch_id"] or ""): str(wr["worktree_id"] or "") for wr in _wrows if wr["worktree_id"]}
                        for wi in w_l:
                            if isinstance(wi, dict):
                                did_k = str(wi.get("dispatchId") or wi.get("id") or "")
                                if did_k in wt_by_did:
                                    if not isinstance(wi.get("resource"), dict):
                                        wi["resource"] = {}
                                    if not wi["resource"].get("worktreeId"):
                                        wi["resource"]["worktreeId"] = wt_by_did[did_k]
                except Exception:
                    pass
            return (r_item, w_c.returncode, w_l)

        # Kiểm tra theo đúng thứ tự thời gian (mới nhất trước): kiểm tra run đầu tiên ngay lập tức, sau đó quét song song theo lô 6 run
        batch_idx = 0
        while batch_idx < len(scan_runs) and not selected_run:
            batch_size = 1 if batch_idx == 0 else 6
            batch = scan_runs[batch_idx : batch_idx + batch_size]
            batch_idx += batch_size
            if len(batch) == 1:
                batch_results = [_fetch_run_workers(batch[0])]
            else:
                with ThreadPoolExecutor(max_workers=min(6, len(batch))) as pool:
                    batch_results = list(pool.map(_fetch_run_workers, batch))

            for r, w_rc, w_list_tmp in batch_results:
                rid = r.get("id")
                if not rid:
                    continue
                if w_rc == 124:
                    print(f"⚠️  Orca CLI phản hồi chậm (>8s) khi đọc run {rid} — bỏ qua run này.")
                    continue
                wt_paths = [
                    str((w_item.get("resource") or {}).get("worktreeId") or w_item.get("worktreeId") or "").lower()
                    for w_item in w_list_tmp
                    if isinstance(w_item, dict) and ((w_item.get("resource") or {}).get("worktreeId") or w_item.get("worktreeId"))
                ]
                has_local_run_dir = (root / ".orca" / "runs" / rid).is_dir()
                if explicit_run_id or has_local_run_dir:
                    belongs_to_proj = True
                elif wt_paths:
                    belongs_to_proj = any(
                        root_str_lower in ws_str
                        or root_real_lower in ws_str
                        or f"/{proj_slug}/" in ws_str
                        or f"/{proj_slug}-worktrees/" in ws_str
                        or f"/{proj_slug}." in ws_str
                        or ws_str.endswith(f"/{proj_slug}")
                        for ws_str in wt_paths
                    )
                else:
                    belongs_to_proj = bool(
                        re.search(rf"(?<![\w-]){re.escape(proj_slug)}(?![\w-])", str(r.get("objective", "")).lower())
                    )

                if not explicit_run_id and not belongs_to_proj:
                    continue

                t_chk = _safe_orca_run([orca_bin, "orchestration", "task-list", "--run", rid, "--json"], capture_output=True, text=True, timeout=8)
                if t_chk.returncode == 124:
                    print(f"⚠️  Orca CLI phản hồi chậm (>8s) khi đọc task-list của run {rid} — bỏ qua run này.")
                    continue
                t_list_tmp = []
                if t_chk.returncode == 0:
                    to = json.loads(t_chk.stdout).get("result", {})
                    t_list_tmp = to.get("tasks", []) if isinstance(to, dict) else []

                in_cand = any(cr.get("id") == rid for cr in candidate_runs)
                if (explicit_run_id and (in_cand or w_list_tmp or t_list_tmp)) or (belongs_to_proj and (w_list_tmp or t_list_tmp or has_local_run_dir)):
                    selected_run = r
                    workers = w_list_tmp
                    for t in t_list_tmp:
                        if t.get("id"):
                            run_tasks[t.get("id")] = t
                    break

        if not selected_run and candidate_runs:
            if explicit_run_id:
                print(f"ℹ️  Không tìm thấy Run '{explicit_run_id}' trong Orca Runtime.")
            else:
                # Không lấy run mới nhất của project KHÁC (trước đây gây hiển thị sai số liệu và --fix đụng vào run của project khác)
                print(f"ℹ️  Không tìm thấy Run nào thuộc project '{root.name}' trong {len(scan_runs)} run gần nhất (truyền --run <run_id> để chỉ định).")

        if selected_run:
            active_run_id = selected_run.get("id")
            active_run_obj = selected_run.get("objective", "")

        if runtime_ok:
            cli_index = _index_cli_transcripts()
            if active_run_id:
                obj_short = (active_run_obj[:78] + "...") if len(active_run_obj) > 81 else active_run_obj
                print(f"🎯 Run ID: {active_run_id} — \"{obj_short}\"")
                pinned_plan_p = root / ".orca" / "runs" / active_run_id / "master-plan.md"
                if pinned_plan_p.is_file():
                    try:
                        p_txt = pinned_plan_p.read_text(encoding="utf-8", errors="ignore")
                        p_items = list(dict.fromkeys(re.findall(r"\[P\d+\]", p_txt)))
                        p_items_str = f"{len(p_items)} items ({', '.join(p_items[:8])})" if p_items else "active"
                        print(f"📌 Pinned Master Plan: .orca/runs/{active_run_id}/master-plan.md ({p_items_str}, ~{estimate_tokens(p_txt):,} tok)")
                    except Exception:
                        pass
            print(f"👥 Dispatched Workers: {len(workers)} | Tasks in DAG: {len(run_tasks)}")

            # Tải trước messages của Run để vừa thống kê P2P/Mailbox vừa bù report_tok khi task.result trống
            worker_done_body_by_dispatch = {}
            worker_done_body_by_task = {}
            if active_run_id:
                handle_to_disp_mon: dict[str, str] = {}
                handle_to_task_mon: dict[str, str] = {}
                for w_it in workers:
                    if not isinstance(w_it, dict):
                        continue
                    w_did = str(w_it.get("dispatchId") or w_it.get("id") or "").strip()
                    w_tid = str(w_it.get("taskId") or "").strip()
                    w_th = str(w_it.get("agentTerminalHandle") or "").strip()
                    if w_th:
                        norm_th = w_th[len("terminal:"):] if w_th.startswith("terminal:") else w_th
                        for ch in (w_th, norm_th, f"terminal:{norm_th}"):
                            if w_did:
                                handle_to_disp_mon[ch] = w_did
                            if w_tid:
                                handle_to_task_mon[ch] = w_tid

                loaded_msgs_sqlite = False
                db_p_mon = _find_orca_orchestration_db()
                if db_p_mon is not None:
                    try:
                        import sqlite3 as _sq3
                        _c_mon = _sq3.connect(f"file:{db_p_mon}?mode=ro", uri=True, timeout=1.5)
                        _c_mon.row_factory = _sq3.Row
                        _m_rows = _c_mon.execute(
                            """
                            SELECT id, run_id, from_handle, to_handle, subject, body, type, payload, created_at
                            FROM messages
                            WHERE run_id = ?
                            ORDER BY created_at ASC, rowid ASC
                            """,
                            (active_run_id,),
                        ).fetchall()
                        run_msgs = [dict(r) for r in _m_rows]
                        _c_mon.close()
                        loaded_msgs_sqlite = True
                    except Exception:
                        loaded_msgs_sqlite = False

                if not loaded_msgs_sqlite:
                    msg_res = _safe_orca_run(
                        [orca_bin, "orchestration", "inbox", "--limit", "500", "--json"],
                        capture_output=True, text=True, timeout=5,
                    )
                    if msg_res.returncode == 0:
                        try:
                            msg_data = json.loads(msg_res.stdout)
                            msg_obj = msg_data.get("result", msg_data) if isinstance(msg_data, dict) else {}
                            all_msgs = msg_obj.get("messages", []) if isinstance(msg_obj, dict) else []
                            run_msgs = [
                                m for m in all_msgs
                                if isinstance(m, dict) and (m.get("run_id") == active_run_id or m.get("runId") == active_run_id)
                            ]
                        except Exception:
                            run_msgs = []

                try:
                    # Khử trùng lặp các bản ghi fan-out của `--to '@all'` (cùng người gửi, type, subject, body, payload, created_at)
                    dedup_msgs = []
                    seen_msg_keys = set()
                    for m in run_msgs:
                        if not isinstance(m, dict):
                            continue
                        m_type_k = str(m.get("type") or "")
                        if m_type_k == "heartbeat":
                            dedup_msgs.append(m)
                            continue
                        m_key = (
                            str(m.get("from_handle") or m.get("fromHandle") or ""),
                            m_type_k,
                            str(m.get("subject") or ""),
                            str(m.get("body") or ""),
                            str(m.get("payload") or ""),
                        )
                        if m_key in seen_msg_keys:
                            continue
                        seen_msg_keys.add(m_key)
                        dedup_msgs.append(m)
                    run_msgs = dedup_msgs

                    hb_count = sum(1 for m in run_msgs if m.get("type") == "heartbeat")
                    done_count = sum(1 for m in run_msgs if m.get("type") == "worker_done")
                    esc_count = sum(1 for m in run_msgs if m.get("type") in ["escalation", "question"])
                    handoff_count = sum(1 for m in run_msgs if m.get("type") == "handoff")
                    for m in run_msgs:
                        m_type = str(m.get("type") or "")
                        subj_s = str(m.get("subject") or "")
                        body_s = str(m.get("body") or "")
                        if m_type in ("handoff", "escalation"):
                            m_cls = _classify_p2p_message(m_type, subj_s, body_s)
                            if m_cls == "reject":
                                p2p_reject_cnt += 1
                            elif m_cls == "ready" and m_type == "handoff":
                                p2p_dev_ready_cnt += 1
                        if m_type in ("worker_done", "handoff") and body_s:
                            s_did, s_tid = _extract_msg_dispatch_and_task(
                                m,
                                handle_to_disp=handle_to_disp_mon,
                                handle_to_task=handle_to_task_mon,
                            )
                            if s_did and len(body_s) >= len(worker_done_body_by_dispatch.get(s_did, "")):
                                worker_done_body_by_dispatch[s_did] = body_s
                            if s_tid and len(body_s) >= len(worker_done_body_by_task.get(s_tid, "")):
                                worker_done_body_by_task[s_tid] = body_s
                    done_tokens = sum(
                        estimate_tokens(str(m.get("body") or "") + str(m.get("subject") or ""))
                        for m in run_msgs if m.get("type") in ["worker_done", "handoff", "escalation", "question"]
                    )
                except Exception:
                    pass

            if workers:
                print("\n📊 4.1 BẢNG ĐO LƯỜNG TỐC ĐỘ AGENT CLI & TIÊU THỤ TOKEN TRÊN TỪNG WORKER:")
                hdr = (
                    f"   {'DISPATCH / ROLE':<27} | {'MODEL THỰC TẾ':<26} | {'WALL / IDLE':<13} | "
                    f"{'TURNS / TOOLS':<16} | {'LLM / TOOL TIME':<15} | {'OUT e2e | CTX tok/s':<23} | "
                    f"{'TOKENS (OUT / PEAK / CACHE)':<27} | {'STATE'}"
                )
                print(hdr)
                print("   " + "-" * (len(hdr) - 3))

            reclaimable_dispatches = []
            total_spec_tokens = 0
            total_report_tokens = 0
            counted_task_ids = set()
            known_worker_wt_paths = set()

            def _fetch_ws(did_str: str):
                if not did_str or did_str == "-":
                    return None
                try:
                    r = _safe_orca_run([orca_bin, "orchestration", "worker-show", "--dispatch", did_str, "--json"], capture_output=True, text=True, timeout=4)
                    if r.returncode == 0:
                        return json.loads(r.stdout).get("result", {})
                except Exception:
                    pass
                return None

            ws_map = {}
            if workers:
                d_ids = [str(w.get("dispatchId") or w.get("id") or "-") for w in workers]
                with ThreadPoolExecutor(max_workers=min(8, max(1, len(d_ids)))) as pool:
                    for did_k, ws_val in zip(d_ids, pool.map(_fetch_ws, d_ids)):
                        if ws_val:
                            ws_map[did_k] = ws_val

            task_dispatch_counts = {}
            for _w in workers:
                _tid = str(_w.get("taskId") or "-")
                if _tid and _tid != "-":
                    task_dispatch_counts[_tid] = task_dispatch_counts.get(_tid, 0) + 1

            for w in workers:
                d_id = str(w.get("dispatchId") or w.get("id") or "-")
                t_id = str(w.get("taskId") or "-")
                term = str(w.get("terminalHandle") or w.get("agentTerminalHandle") or "-")
                term_state = str(w.get("terminalState") or "-")
                w_state = str(w.get("workerState") or w.get("state") or "-")
                w_phase = "-"

                wt_name = "-"
                wt_path = ""
                ag_name = "-"
                md_name = "-"
                duration_secs = 0.0
                last_out_idle_secs = None
                start_dt = None
                comp_dt = None

                ws_id = str((w.get("resource") or {}).get("worktreeId") or "")
                if "::" in ws_id:
                    wt_path = ws_id.split("::", 1)[1]
                if "/" in ws_id:
                    wt_name = ws_id.rsplit("/", 1)[-1]

                try:
                    ws_json = ws_map.get(d_id)
                    if ws_json:
                        w_info = ws_json.get("worker", {})
                        d_info = ws_json.get("dispatch", {})
                        t_info = ws_json.get("terminal") or {}
                        p_info = ws_json.get("projection") or {}
                        if w_info.get("state"):
                            w_state = str(w_info.get("state"))
                        elif d_info.get("status") in ("succeeded", "failed", "stopped", "timed_out"):
                            w_state = str(d_info.get("status"))
                        w_phase = str(w_info.get("phase") or w_info.get("stage") or (p_info.get("stage") or {}).get("detail") or "-")
                        res_info = p_info.get("resource") or {}
                        if res_info.get("terminalState"):
                            term_state = str(res_info.get("terminalState"))
                        if t_info.get("worktreePath"):
                            wt_path = str(t_info.get("worktreePath"))
                        start_opts = w_info.get("startOptions", {})
                        if start_opts.get("name"):
                            wt_name = start_opts.get("name")
                        elif start_opts.get("worktree") and wt_name == "-":
                            wt_opt = str(start_opts.get("worktree"))
                            wt_name = wt_opt.rsplit("/", 1)[-1] if "/" in wt_opt else wt_opt.split(":", 1)[-1]
                        eff_launch = (start_opts.get("launch") or {}).get("effective") or {}
                        ag_name = str(eff_launch.get("agent") or start_opts.get("agent") or "-")
                        md_name = str(eff_launch.get("model") or ag_name)

                        c_at = str(d_info.get("dispatchedAt") or w_info.get("createdAt") or "")
                        raw_comp_at = d_info.get("completedAt")
                        from datetime import datetime, timezone
                        now_utc = datetime.now(timezone.utc)
                        if raw_comp_at:
                            comp_dt = _parse_iso_utc(str(raw_comp_at))
                        elif term_state == "active" and w_state not in ("succeeded", "failed", "stopped", "timed_out"):
                            comp_dt = now_utc
                        else:
                            comp_dt = _parse_iso_utc(str(w_info.get("updatedAt") or ""))
                        start_dt = _parse_iso_utc(c_at)
                        if start_dt and comp_dt:
                            duration_secs = max(0.0, (comp_dt - start_dt).total_seconds())

                        last_out_raw = t_info.get("lastOutputAt") or w_info.get("lastHeartbeatAt")
                        if last_out_raw:
                            lo_dt = _parse_iso_utc(str(last_out_raw))
                            if lo_dt:
                                last_out_idle_secs = max(0.0, (now_utc - lo_dt).total_seconds())
                except Exception:
                    pass

                if wt_path:
                    known_worker_wt_paths.add(wt_path)
                    try:
                        known_worker_wt_paths.add(os.path.realpath(wt_path))
                    except Exception:
                        pass

                # Khớp transcript thực tế của Worker CLI (chống nhân đôi khi 1 task có nhiều dispatch retry hoặc lỗi worktree_create)
                never_launched_term = (
                    w_phase in ("worktree_create", "terminal_create")
                    or term in ("", "-", "None")
                )
                tf_match = cli_index["by_dispatch"].get(d_id)
                if not tf_match and not never_launched_term:
                    if task_dispatch_counts.get(t_id, 0) <= 1:
                        tf_match = cli_index["by_task"].get(t_id)
                    if not tf_match:
                        tf_match = cli_index["by_term"].get(term)
                t_metrics = _analyze_antigravity_transcript(tf_match, scope_id=d_id) if tf_match else {}

                t_obj_info = run_tasks.get(t_id, {})
                spec_txt = str(t_obj_info.get("spec") or "")
                res_raw = str(t_obj_info.get("result") or "")
                spec_tok = estimate_tokens(spec_txt)

                rep_body = ""
                reported_files_count = 0
                if res_raw and not never_launched_term and (
                    task_dispatch_counts.get(t_id, 0) <= 1 or d_id in worker_done_body_by_dispatch
                ):
                    try:
                        res_parsed = json.loads(res_raw)
                        rep_body = str(res_parsed.get("body") or "")
                        f_mod = res_parsed.get("filesModified") or []
                        reported_files_count = len(f_mod)
                    except Exception:
                        rep_body = res_raw
                if not rep_body and not never_launched_term:
                    rep_body = worker_done_body_by_dispatch.get(d_id) or (
                        worker_done_body_by_task.get(t_id) if task_dispatch_counts.get(t_id, 0) <= 1 else ""
                    ) or ""
                rep_tok = estimate_tokens(rep_body)
                if t_id and t_id != "-" and t_id not in counted_task_ids:
                    counted_task_ids.add(t_id)
                    total_spec_tokens += spec_tok
                    total_report_tokens += rep_tok
                elif not t_id or t_id == "-":
                    total_spec_tokens += spec_tok
                    total_report_tokens += rep_tok

                is_w_active = w_state not in ("succeeded", "failed", "stopped", "timed_out")
                git_stats = _collect_git_diff_stats(
                    wt_path,
                    wt_name,
                    root=root,
                    start_dt=start_dt,
                    comp_dt=comp_dt,
                    is_active=is_w_active,
                    commit_shas=t_metrics.get("commit_shas") if t_metrics else None,
                    has_transcript=bool(t_metrics),
                    ran_git_commit=bool(t_metrics.get("ran_git_commit")) if t_metrics else False,
                )
                files_mod_count = git_stats["files"] if (git_stats["files"] > 0 or t_metrics) else reported_files_count

                # Chuẩn bị các cột hiển thị
                raw_role_col = f"{d_id[:10]}.. ({wt_name})"
                if len(raw_role_col) > 27:
                    prefix_len = max(4, 27 - len(wt_name) - 5)
                    role_col = f"{d_id[:prefix_len]}.. ({wt_name})"[:27]
                else:
                    role_col = raw_role_col
                model_col = md_name[:26]
                wall_s = duration_secs if duration_secs > 0 else t_metrics.get("wall_secs", 0.0)
                idle_s = t_metrics.get("idle_since_last_secs") if t_metrics else last_out_idle_secs
                if w_state in ("succeeded", "failed", "stopped", "timed_out"):
                    wall_idle_col = f"{_fmt_dur(wall_s)} / done"
                elif idle_s is not None:
                    wall_idle_col = f"{_fmt_dur(wall_s)} / {_fmt_dur(idle_s)}"
                else:
                    wall_idle_col = f"{_fmt_dur(wall_s)} / -"

                if t_metrics:
                    turns_tools_col = f"{t_metrics['turns']}t / {t_metrics['tool_calls']}c({t_metrics['tool_errors']}e)"
                    llm_tool_col = f"{_fmt_dur(t_metrics['llm_secs'])} / {_fmt_dur(t_metrics['tool_secs'])}"
                    speed_col = f"{t_metrics['out_tok_s']:>5.1f} | {_fmt_tok(int(t_metrics['prefill_tok_s'])):>6}/s"
                    tok_col = f"{_fmt_tok(t_metrics['out_tok']):>5} / {_fmt_tok(t_metrics['peak_ctx']):>6} / {t_metrics['cache_hit_pct']:>4.1f}%"
                else:
                    turns_tools_col = "N/A (no log)"
                    llm_tool_col = "- / -"
                    speed_col = "N/A"
                    tok_col = "N/A"

                if term_state in ["reclaimable", "retained"]:
                    reclaimable_dispatches.append(d_id)

                state_col = f"{w_state}/{w_phase} ({term_state})"
                print(
                    f"   {role_col:<27} | {model_col:<26} | {wall_idle_col:<13} | "
                    f"{turns_tools_col:<16} | {llm_tool_col:<15} | {speed_col:<23} | "
                    f"{tok_col:<27} | {state_col}"
                )

                # Dòng phụ hiển thị chi tiết công việc kỹ thuật: Git diff, latency trung bình/turn, tool cuối, spec vs report
                t_title = str(t_obj_info.get("title") or t_obj_info.get("taskTitle") or t_obj_info.get("task_title") or t_obj_info.get("display_name") or "")[:54]
                git_str = f"git: {files_mod_count} files (+{git_stats['ins']}/-{git_stats['del']}, {git_stats['commits']} commits)"
                if t_metrics:
                    poll_t = int(t_metrics.get("poll_turns") or 0)
                    eff_t = int(t_metrics["effective_turns"]) if "effective_turns" in t_metrics else max(0, int(t_metrics["turns"]) - poll_t)
                    poll_info = f" | eff_turns: {eff_t}t (poll={poll_t}t)" if poll_t > 0 else ""
                    wait_s = max(float(t_metrics.get("idle_wait_secs") or 0.0), max(0.0, wall_s - float(t_metrics.get("active_secs") or 0.0)))
                    wait_info = f" | wait/retry: {_fmt_dur(wait_s)}" if wait_s >= 30.0 else ""
                    tool_out_tok = int(t_metrics.get("tool_output_tok") or 0)
                    max_tool_tok = int(t_metrics.get("max_tool_output_tok") or 0)
                    replayed_c = int(t_metrics.get("replayed_checks") or 0)
                    help_c = int(t_metrics.get("help_calls") or 0)
                    bomb_c = len(t_metrics.get("context_bomb_cmds") or [])
                    tool_tok_info = f" | tool_out: {_fmt_tok(tool_out_tok)} (max:{_fmt_tok(max_tool_tok)})" if tool_out_tok > 0 else ""
                    leak_info = f" | ⚠️leak(replay={replayed_c},help={help_c},bomb={bomb_c})" if (replayed_c > 0 or help_c > 0 or bomb_c > 0) else ""
                    lat_str = (
                        f"avg_turn: {t_metrics['avg_turn_s']:.1f}s/turn{poll_info} | active_vel: {t_metrics['active_tok_s']:.1f} tok/s{wait_info} | "
                        f"in_fresh: {_fmt_tok(t_metrics['in_tok'])} | cache_read: {_fmt_tok(t_metrics['cache_tok'])}{tool_tok_info}{leak_info} | last_tool: {t_metrics['last_tool']}"
                    )
                else:
                    lat_str = "transcript telemetry unavailable"
                print(f"      ↳ Task: \"{t_title}\" | spec={spec_tok} tok -> report={rep_tok} tok | {git_str}")
                print(f"      ↳ Perf: {lat_str}")

                if t_metrics:
                    replayed_c = int(t_metrics.get("replayed_checks") or 0)
                    help_c = int(t_metrics.get("help_calls") or 0)
                    bomb_cmds = t_metrics.get("context_bomb_cmds") or []
                    max_tool_tok = int(t_metrics.get("max_tool_output_tok") or 0)
                    if replayed_c >= 2:
                        warning_issues.append(
                            f"Worker {wt_name} ({d_id}) gọi 'orca orchestration check' bị lặp lại tin nhắn cũ ({replayed_c} lần replayed=true do thiếu '--ack <DELIVERY_ID>') gây rò rỉ token."
                        )
                    if help_c >= 2:
                        warning_issues.append(
                            f"Worker {wt_name} ({d_id}) chạy lệnh dò '--help' {help_c} lần thay vì dùng thẳng cú pháp đã cung cấp trong Role Spec."
                        )
                    if bomb_cmds:
                        warning_issues.append(
                            f"Worker {wt_name} ({d_id}) chạy {len(bomb_cmds)} lệnh trả về JSON/spec nguyên khối gây phình Context ({', '.join(bomb_cmds[:2])})."
                        )
                    max_cmd_lbl = str(t_metrics.get("max_tool_cmd") or "large stdout")
                    is_normal_file_read = (
                        max_cmd_lbl.startswith(("view_file(", "Read("))
                        and not any(ext in max_cmd_lbl.lower() for ext in (".log)", "transcript", ".jsonl)"))
                    )
                    max_tok_thresh = 15000 if is_normal_file_read else 8000
                    if max_tool_tok >= max_tok_thresh:
                        warning_issues.append(
                            f"Worker {wt_name} ({d_id}) có 1 lệnh tool bơm tới ~{max_tool_tok:,} tokens vào Context ({max_cmd_lbl})."
                        )

                if t_metrics and w_state not in ("succeeded", "failed", "stopped", "timed_out") and (idle_s or 0) > 180:
                    warning_issues.append(
                        f"Worker {wt_name} ({d_id}) đang active nhưng không có bước thực thi mới trong {_fmt_dur(idle_s)} (last_tool={t_metrics['last_tool']})."
                    )
                if w_state in ("stopped", "failed", "timed_out") and rep_tok == 0:
                    warning_issues.append(
                        f"Worker {wt_name} ({d_id}) đã dừng ({w_state}/{w_phase}) sau {t_metrics.get('turns', 0)} turns nhưng chưa gửi báo cáo hoàn tất (report=0 tok)."
                    )
                if t_metrics and t_metrics["turns"] > 120:
                    raw_t = int(t_metrics["turns"])
                    poll_t = int(t_metrics.get("poll_turns") or 0)
                    eff_t = int(t_metrics["effective_turns"]) if "effective_turns" in t_metrics else max(0, raw_t - poll_t)
                    view_c = int(t_metrics.get("view_calls") or 0)
                    t_errs = int(t_metrics["tool_errors"])
                    t_calls = int(t_metrics["tool_calls"])
                    if t_errs >= 10 or w_state in ("failed", "stopped", "timed_out"):
                        warning_issues.append(
                            f"Worker {wt_name} ({d_id}) đã chạy {raw_t} turns (thực thi: {eff_t}t, poll: {poll_t}t) kèm {t_errs}/{t_calls} lỗi tool — dấu hiệu sa đà đào bới lỗi hoặc vòng lặp retry."
                        )
                    elif eff_t <= 120:
                        warning_issues.append(
                            f"Worker {wt_name} ({d_id}) có tổng {raw_t} turns ({w_state}, chỉ {t_errs}/{t_calls} lỗi), nhưng thực thi chính chỉ {eff_t} turns (còn {poll_t} turns là poll manage_task/schedule chờ lệnh background)."
                        )
                    else:
                        warning_issues.append(
                            f"Worker {wt_name} ({d_id}) chạy {raw_t} turns trên tác vụ lớn ({w_state}, {files_mod_count} files, chỉ {t_errs}/{t_calls} lỗi; thực thi chính: {eff_t}t, poll background: {poll_t}t, đọc file: {view_c} lần)."
                        )
                elif t_metrics and t_metrics["tool_errors"] >= 10:
                    warning_issues.append(
                        f"Worker {wt_name} ({d_id}) có {t_metrics['tool_errors']}/{t_metrics['tool_calls']} lệnh tool trả về mã lỗi (command retry overhead)."
                    )
                if t_metrics and t_metrics.get("bloated_logs"):
                    for bl_path, bl_sz in t_metrics["bloated_logs"]:
                        bl_p = Path(bl_path)
                        mb_sz = bl_sz / (1024 * 1024)
                        if auto_fix:
                            try:
                                guard_bin_fix = os.path.expanduser("~/.local/bin/orca-command-guard")
                                if not os.path.exists(guard_bin_fix):
                                    guard_bin_fix = str(Path(__file__).resolve().parent / "orca-command-guard.py")
                                if os.path.exists(guard_bin_fix):
                                    import importlib.util
                                    from importlib.machinery import SourceFileLoader
                                    guard_spec = importlib.util.spec_from_file_location(
                                        "orca_guard", guard_bin_fix, loader=SourceFileLoader("orca_guard", guard_bin_fix)
                                    )
                                    guard_mod = importlib.util.module_from_spec(guard_spec)
                                    guard_spec.loader.exec_module(guard_mod)
                                    guard_mod.MAX_TASK_LOG_BYTES = 10 * 1024 * 1024
                                    guard_mod._enforce_task_log_cap(bl_p.parent)
                                else:
                                    with open(bl_p, "rb") as bf:
                                        head_b = bf.read(256 * 1024)
                                        bf.seek(max(0, bl_sz - 128 * 1024))
                                        tail_b = bf.read()
                                    bl_p.write_bytes(head_b + f"\n[... ORCA-MONITOR: đã lược bỏ {bl_sz - len(head_b) - len(tail_b):,} bytes giữa log ...]\n".encode() + tail_b)
                                actions_taken.append(f"Đã cắt gọn file log phình to bất thường {bl_p.name} ({mb_sz:.1f} MB) của {wt_name} (giữ lại 256KB đầu + 128KB cuối).")
                            except Exception:
                                pass
                        else:
                            critical_issues.append(
                                f"Worker {wt_name} ({d_id}) sinh ra file log phình to bất thường {bl_p.name} ({mb_sz:.1f} MB — runaway stdout flood). Chạy 'orca-monitor --fix' để cắt gọn."
                            )

                worker_metrics_list.append({
                    "dispatch_id": d_id,
                    "role": wt_name,
                    "model": md_name,
                    "state": w_state,
                    "term_state": term_state,
                    "wall_secs": wall_s,
                    "spec_tok": spec_tok,
                    "rep_tok": rep_tok,
                    "files": files_mod_count,
                    "ins": git_stats["ins"],
                    "del": git_stats["del"],
                    "commits": git_stats["commits"],
                    "telemetry": t_metrics,
                })

            # Hiển thị các Task đang chờ tới lượt trong Task DAG (chưa dispatch)
            dispatched_task_ids = {str(w.get("taskId") or "") for w in workers}
            pending_dag_tasks = [
                t for tid, t in run_tasks.items()
                if tid not in dispatched_task_ids and isinstance(t, dict) and t.get("status") in ("ready", "pending", "blocked")
            ]
            if pending_dag_tasks:
                for pt in pending_dag_tasks:
                    pt_title = str(pt.get("title") or pt.get("taskTitle") or pt.get("task_title") or pt.get("display_name") or "")[:68]
                    pt_status = str(pt.get("status") or "ready")
                    print(f"   ⏳ Queued in DAG ({pt.get('id')} - {pt_status}): \"{pt_title}\"")

            # Kiểm tra các Gate treo (pending) bất kể worker đang retained hay đã released,
            # và chỉ tự chữa các Task bị kẹt 'blocked'/'ready' khi toàn bộ worker đã released (và ít nhất 1 succeeded) và không còn pending gate.
            all_workers_settled_released = (
                bool(worker_metrics_list)
                and all(wm.get("term_state") == "released" for wm in worker_metrics_list)
                and any(wm.get("state") == "succeeded" for wm in worker_metrics_list)
            )
            if active_run_id:
                try:
                    g_res = _safe_orca_run([orca_bin, "orchestration", "gate-list", "--run", active_run_id, "--json"], capture_output=True, text=True, timeout=4)
                    pending_gates = []
                    if g_res.returncode == 0:
                        g_obj = json.loads(g_res.stdout).get("result", {})
                        pending_gates = [g for g in (g_obj.get("gates") or []) if isinstance(g, dict) and g.get("status") == "pending"]
                    if pending_gates:
                        # Gate là quyết định của con người (Human Gate) — monitor KHÔNG BAO GIỜ tự trả lời "yes"
                        warning_issues.append(
                            f"Run {active_run_id} còn {len(pending_gates)} Decision Gate 'pending' chờ bạn quyết định: "
                            + ", ".join(str(g.get("id")) for g in pending_gates[:5])
                            + " (trả lời bằng 'orca orchestration gate-resolve --id <GATE_ID> --resolution <...>')."
                        )
                    all_workers_settled = (
                        bool(worker_metrics_list)
                        and all(wm.get("state") in ("succeeded", "failed", "stopped", "abandoned", "circuit_broken") for wm in worker_metrics_list)
                    )
                    any_worker_released = any(wm.get("term_state") == "released" for wm in worker_metrics_list)
                    unreleased_settled = [wm for wm in worker_metrics_list if wm.get("term_state") != "released"]
                    if all_workers_settled and not pending_gates and unreleased_settled and any_worker_released and not auto_fix:
                        warning_issues.append(
                            f"Run {active_run_id} đã kết thúc nhưng còn {len(unreleased_settled)} tab worker ở các đợt trước chưa đóng "
                            f"(chạy 'orca-team release-workers --run {active_run_id}' hoặc 'orca-monitor --fix')."
                        )
                    if auto_fix and not pending_gates:
                        try:
                            rel_info = release_settled_worker_terminals(
                                root,
                                run_id=active_run_id if all_workers_settled else "",
                                sweep_idle_worktrees=True,
                            )
                            rel_d = len(rel_info.get("releasedDispatches") or [])
                            cls_t = len(rel_info.get("closedTerminals") or [])
                            if rel_d or cls_t:
                                actions_taken.append(
                                    f"Giải phóng {rel_d} worker dispatch(es) và đóng dứt điểm {cls_t} tab terminal worker cũ."
                                )
                                if all_workers_settled:
                                    all_workers_settled_released = True
                        except Exception:
                            pass
                    if all_workers_settled_released and not pending_gates:
                        stuck_tasks = [
                            t for t in run_tasks.values()
                            if isinstance(t, dict) and t.get("status") in ("blocked", "ready") and t.get("result")
                        ]
                        if auto_fix and stuck_tasks:
                            fixed_t = 0
                            for t in stuck_tasks:
                                tid = t.get("id")
                                if tid:
                                    tr = _safe_orca_run([orca_bin, "orchestration", "task-update", "--id", tid, "--status", "completed", "--json"], capture_output=True, text=True, timeout=4)
                                    if tr.returncode == 0:
                                        fixed_t += 1
                            actions_taken.append(
                                f"Cập nhật {fixed_t}/{len(stuck_tasks)} Task (đã có result, worker đã thu hồi) về 'completed' cho Run {active_run_id}."
                            )
                        elif stuck_tasks:
                            warning_issues.append(
                                f"Run {active_run_id} đã thu hồi hết worker nhưng còn {len(stuck_tasks)} Task '{stuck_tasks[0].get('status')}' đã có result (chạy 'orca-monitor --fix' để đánh dấu completed)."
                            )
                except Exception:
                    pass

            # Kiểm tra xung đột đa-Leader trên cùng 1 worker worktree (live working agents >= 2)
            try:
                ps_chk = _safe_orca_run([orca_bin, "worktree", "ps", "--json"], capture_output=True, text=True, timeout=4)
                if ps_chk.returncode == 0 and ps_chk.stdout.strip():
                    ps_w_list = (json.loads(ps_chk.stdout).get("result") or {}).get("worktrees") or []
                    root_resolved_str = str(root.resolve())
                    colliding_wts = []
                    for wt_item in ps_w_list:
                        if not isinstance(wt_item, dict) or wt_item.get("isMainWorktree"):
                            continue
                        p_raw = str(wt_item.get("path") or "").strip()
                        parent_raw = str(wt_item.get("parentWorktreeId") or "").strip()
                        parent_path = parent_raw.split("::", 1)[1] if "::" in parent_raw else parent_raw
                        if parent_path != root_resolved_str and p_raw not in known_worker_wt_paths and os.path.realpath(p_raw) not in known_worker_wt_paths:
                            continue
                        ag_items = wt_item.get("agents") if isinstance(wt_item.get("agents"), list) else []
                        working_cnt = sum(
                            1 for a in ag_items
                            if isinstance(a, dict) and str(a.get("state") or "").strip().lower() in ("working", "running", "busy", "starting")
                        )
                        if working_cnt >= 2:
                            wt_disp = str(wt_item.get("displayName") or Path(p_raw).name)
                            colliding_wts.append(f"{wt_disp} ({working_cnt} working agents)")
                    if colliding_wts:
                        critical_issues.append(
                            f"Phát hiện xung đột đa-Leader trên cùng worktree: {', '.join(colliding_wts)}! "
                            f"Bắt buộc dùng $(orca-team worktree-arg <role>) để tách sang <role>-worker-2."
                        )
            except Exception:
                pass

            # 4.1b Kiểm tra Orca Agent Status Hooks
            hooks_res = _safe_orca_run([orca_bin, "agent", "hooks", "status", "--json"], capture_output=True, text=True, timeout=5)
            if hooks_res.returncode == 0:
                hooks_data = json.loads(hooks_res.stdout).get("result", {})
                hook_statuses = {s.get("agent"): s for s in (hooks_data.get("statuses") or []) if isinstance(s, dict)}
                configured_agents = set()
                if config:
                    c_ag = (config.get("coordinator") or {}).get("agent")
                    if c_ag:
                        configured_agents.add(c_ag)
                    for r_cfg in (config.get("roles") or {}).values():
                        if isinstance(r_cfg, dict) and r_cfg.get("enabled", True) and r_cfg.get("agent") and r_cfg.get("agent") != "none":
                            configured_agents.add(r_cfg.get("agent"))
                if not configured_agents:
                    configured_agents = {"antigravity", "claude", "kimi", "gemini"}

                missing_hooks = [
                    ag for ag in sorted(configured_agents)
                    if ag in hook_statuses and not hook_statuses[ag].get("managedHooksPresent")
                ]
                if missing_hooks and not auto_fix:
                    warning_issues.append(f"Agent {', '.join(missing_hooks)} thiếu Orca Status Hooks (chạy 'orca-monitor --fix' để cài).")
                elif missing_hooks:
                    orca_electron = "/Applications/Orca.app/Contents/MacOS/Orca"
                    hook_ctrl = "/Applications/Orca.app/Contents/Resources/app.asar.unpacked/out/main/agent-hooks/managed-agent-hook-controls.js"
                    if os.path.exists(orca_electron) and os.path.exists(hook_ctrl):
                        env_hydrate = os.environ.copy()
                        env_hydrate["ELECTRON_RUN_AS_NODE"] = "1"
                        h_fix = _safe_orca_run(
                            [
                                orca_electron,
                                "-e",
                                f'require("{hook_ctrl}").installManagedAgentHooks(null, {{agents: {json.dumps(missing_hooks)}, shouldHydrateShellPath: true}}).then(() => process.exit(0)).catch(() => process.exit(1))',
                            ],
                            env=env_hydrate, timeout=8
                        )
                        if h_fix.returncode == 0:
                            actions_taken.append(f"Cài đặt Orca Status Hooks cho: {', '.join(missing_hooks)}")
                            passed_items.append(f"Orca Status Hooks active cho: {', '.join(sorted(configured_agents))}.")
                        else:
                            warning_issues.append(f"Không thể tự cài Orca Status Hooks cho: {', '.join(missing_hooks)}.")
                    else:
                        warning_issues.append(f"Agent {', '.join(missing_hooks)} thiếu Orca Status Hooks.")
                else:
                    passed_items.append(f"Orca Status Hooks active cho: {', '.join(sorted(configured_agents))}.")

        # 4.1c Kiểm tra Orca Command & Stdout Flood Guard Hook (16MB Circuit-Breaker) đa Agent CLI — chạy cả khi Orca runtime đóng
        guard_bin = os.path.expanduser("~/.local/bin/orca-command-guard")
        if os.path.exists(guard_bin):
            try:
                chk_flag = "--install-hooks" if auto_fix else "--check-hooks"
                proc_g = subprocess.run(
                    ["python3", guard_bin, chk_flag, guard_bin],
                    capture_output=True,
                    text=True,
                    timeout=5.0,
                )
                g_info = json.loads((proc_g.stdout or "").strip() or "{}")
                conf_clis = g_info.get("configured") or []
                miss_clis = g_info.get("updatedOrMissing") or []
                if miss_clis and not auto_fix:
                    warning_issues.append(
                        f"Orca Command Guard hook chưa được đăng ký/đã cũ cho Agent CLI: {', '.join(miss_clis)} (chạy 'orca-monitor --fix')."
                    )
                elif miss_clis and auto_fix:
                    actions_taken.append(
                        f"Kích hoạt Orca Command & Token-Leak Guard (PreToolUse/BeforeTool + 16MB Circuit-Breaker) cho: {', '.join(miss_clis)}"
                    )
                if conf_clis and (not miss_clis or auto_fix):
                    passed_items.append(
                        f"Orca Command & Token-Leak Guard active trên đa Agent CLI ({', '.join(conf_clis)})."
                    )
            except Exception as e:
                warning_issues.append(f"Không thể kiểm tra Orca Command Guard hook: {e}")

        if auto_fix:
            synced_acc = _sync_orca_antigravity_account_if_changed()
            if synced_acc:
                actions_taken.append(f"Tự động đồng bộ tài khoản Antigravity mới ({synced_acc}) vào kho Orca Accounts")

        # 4.1d Kiểm tra Orca Worktree Setup Hook (setup-runner.sh / ERR_PNPM_NO_PKG_MANIFEST Trap)
        try:
            has_pkg = (root / "package.json").is_file()
            has_pnpm = (root / "pnpm-lock.yaml").is_file() or (root / "pnpm-workspace.yaml").is_file()
            has_yarn = (root / "yarn.lock").is_file()

            def _is_broken_setup_cmd(cmd_txt: str) -> bool:
                if not cmd_txt:
                    return False
                return bool(
                    (re.search(r"\b(?:pnpm|npm|yarn|bun)\s+(?:install|i)\b", cmd_txt) and not has_pkg)
                    or (re.search(r"\bpnpm\s+(?:install|i)\b", cmd_txt) and not has_pnpm)
                    or (re.search(r"\byarn\s+(?:install|i)\b", cmd_txt) and not has_yarn)
                )

            broken_setup_script = ""
            repo_obj = {}
            if runtime_ok:
                repo_res = _safe_orca_run([orca_bin, "repo", "show", "--repo", f"path:{root}", "--json"], capture_output=True, text=True, timeout=5)
                if repo_res.returncode == 0:
                    repo_obj = json.loads(repo_res.stdout).get("result", {}).get("repo", {}) or {}
                    setup_cmd = str((repo_obj.get("hookSettings") or {}).get("scripts", {}).get("setup") or "").strip()
                    if _is_broken_setup_cmd(setup_cmd):
                        broken_setup_script = setup_cmd

            stale_runners = []
            dot_git = root / ".git"
            wt_git_dirs = []
            if dot_git.is_dir():
                if (dot_git / "worktrees").is_dir():
                    wt_git_dirs.append(dot_git / "worktrees")
            elif dot_git.is_file():
                try:
                    gd_line = dot_git.read_text(encoding="utf-8", errors="ignore").strip()
                    if gd_line.startswith("gitdir:"):
                        gd_path = (root / gd_line.split(":", 1)[1].strip()).resolve()
                        if gd_path.parent.name == "worktrees":
                            wt_git_dirs.append(gd_path.parent)
                except Exception:
                    pass
            for wt_git_dir in wt_git_dirs:
                for sr in wt_git_dir.glob("*/orca/setup-runner.sh"):
                    try:
                        sr_txt = sr.read_text(encoding="utf-8", errors="ignore")
                        if _is_broken_setup_cmd(sr_txt):
                            stale_runners.append(sr)
                    except Exception:
                        pass

            if broken_setup_script or stale_runners:
                if not auto_fix:
                    warning_issues.append(
                        f"Orca Worktree Setup Hook ('{broken_setup_script or 'setup-runner.sh'}') bị lỗi do thiếu package.json/lockfile ở root "
                        f"(gây lỗi ERR_PNPM_NO_PKG_MANIFEST khi mở worker worktree — chạy 'orca-monitor --fix' để gỡ)."
                    )
                else:
                    repo_fix_ok = True
                    orca_electron = "/Applications/Orca.app/Contents/MacOS/Orca"
                    rt_client_js = "/Applications/Orca.app/Contents/Resources/app.asar.unpacked/out/cli/runtime-client.js"
                    if broken_setup_script:
                        if os.path.exists(orca_electron) and os.path.exists(rt_client_js):
                            env_node = os.environ.copy()
                            env_node["ELECTRON_RUN_AS_NODE"] = "1"
                            existing_hooks = repo_obj.get("hookSettings") if isinstance(repo_obj.get("hookSettings"), dict) else {}
                            existing_scripts = existing_hooks.get("scripts") if isinstance(existing_hooks.get("scripts"), dict) else {}
                            merged_hooks = {
                                **existing_hooks,
                                "mode": existing_hooks.get("mode") or "auto",
                                "setupRunPolicy": existing_hooks.get("setupRunPolicy") or "run-by-default",
                                "setupAgentStartupPolicy": existing_hooks.get("setupAgentStartupPolicy") or "start-immediately",
                                "scripts": {**existing_scripts, "setup": ""},
                                "commandSourcePolicy": existing_hooks.get("commandSourcePolicy") or "local-only",
                            }
                            js_code = (
                                f'const {{ RuntimeClient }} = require({json.dumps(rt_client_js)});'
                                f'(async () => {{'
                                f'  const c = new RuntimeClient();'
                                f'  await c.call("repo.update", {{'
                                f'    repo: {json.dumps(f"path:{root}")},'
                                f'    updates: {{ hookSettings: {json.dumps(merged_hooks)} }}'
                                f'  }});'
                                f'}})().then(() => process.exit(0)).catch(() => process.exit(1));'
                            )
                            fix_res = _safe_orca_run([orca_electron, "-e", js_code], env=env_node, timeout=8)
                            if fix_res.returncode == 0:
                                actions_taken.append(f"Xóa Orca Setup Hook lỗi ('{broken_setup_script}') trong cấu hình repo '{root.name}'.")
                            else:
                                repo_fix_ok = False
                                warning_issues.append(f"Không thể xóa Orca Setup Hook lỗi ('{broken_setup_script}') qua RuntimeClient.")
                        else:
                            repo_fix_ok = False
                            warning_issues.append(f"Orca Setup Hook ('{broken_setup_script}') bị lỗi nhưng thiếu Orca RuntimeClient để tự gỡ.")
                    removed_sr = 0
                    for sr in stale_runners:
                        try:
                            sr.unlink(missing_ok=True)
                            removed_sr += 1
                        except Exception:
                            repo_fix_ok = False
                    if removed_sr:
                        actions_taken.append(f"Xóa {removed_sr} file 'orca/setup-runner.sh' lỗi trong .git/worktrees/*.")
                    if repo_fix_ok:
                        passed_items.append("Orca Worktree Setup Hook (setup-runner.sh): Clean (không bị lỗi thiếu package.json).")
            else:
                passed_items.append("Orca Worktree Setup Hook (setup-runner.sh): Clean (không bị lỗi thiếu package.json).")
        except Exception:
            pass

        if runtime_ok:
            # 4.2 Phân tích Mailbox & Giao tiếp P2P
            if active_run_id:
                print(f"\n📬 4.2 MAILBOX & P2P IPC TELEMETRY:")
                print(
                    f"   • Messages in Run: {len(run_msgs)} total | heartbeat={hb_count} (SQLite-handled, 0 LLM tokens) | "
                    f"worker_done={done_count} | handoff={handoff_count} (P2P ready={p2p_dev_ready_cnt}, reject={p2p_reject_cnt}) | escalation/question={esc_count}"
                )
                print(
                    f"   • Coordinator/Peer Wake Payload: {done_count + handoff_count + esc_count} event(s), "
                    f"payload={done_tokens:,} tokens (avg {done_tokens // max(1, done_count + handoff_count + esc_count)} tok/msg)"
                )

            # 4.3 BẢNG TỔNG HỢP SỐ LIỆU ĐO ĐẠC THỰC TẾ (LEADER VS WORKERS TELEMETRY)
            if workers:
                leader_tf = cli_index["by_leader_run"].get(active_run_id) if active_run_id else None
                leader_m = _analyze_antigravity_transcript(leader_tf, scope_id=active_run_id) if leader_tf else {}
                if leader_m:
                    l_replayed = int(leader_m.get("replayed_checks") or 0)
                    l_help = int(leader_m.get("help_calls") or 0)
                    l_bombs = leader_m.get("context_bomb_cmds") or []
                    if l_replayed >= 2:
                        warning_issues.append(
                            f"Leader Coordinator gọi 'orca orchestration check' bị lặp lại tin nhắn cũ ({l_replayed} lần replayed=true do thiếu '--ack <DELIVERY_ID>') gây rò rỉ token."
                        )
                    if l_help >= 2:
                        warning_issues.append(
                            f"Leader Coordinator chạy lệnh dò '--help' {l_help} lần."
                        )
                    if l_bombs:
                        warning_issues.append(
                            f"Leader Coordinator chạy {len(l_bombs)} lệnh trả về JSON/spec nguyên khối gây phình Context ({', '.join(l_bombs[:2])})."
                        )

                w_with_m = [wm["telemetry"] for wm in worker_metrics_list if wm.get("telemetry")]
                w_turns = sum(m["turns"] for m in w_with_m)
                w_poll_turns = sum(int(m.get("poll_turns") or 0) for m in w_with_m)
                w_eff_turns = sum(int(m["effective_turns"]) if "effective_turns" in m else max(0, int(m["turns"]) - int(m.get("poll_turns") or 0)) for m in w_with_m)
                w_tools = sum(m["tool_calls"] for m in w_with_m)
                w_errs = sum(m["tool_errors"] for m in w_with_m)
                w_in_tok = sum(m["in_tok"] for m in w_with_m)
                w_cache_tok = sum(m["cache_tok"] for m in w_with_m)
                w_out_tok = sum(m["out_tok"] for m in w_with_m)
                w_peak_max = max((m["peak_ctx"] for m in w_with_m), default=0)
                w_cum_ctx = sum(int(m.get("cum_ctx_tok") or 0) for m in w_with_m)
                w_tool_out_tok = sum(int(m.get("tool_output_tok") or 0) for m in w_with_m)
                w_max_tool_out = max((int(m.get("max_tool_output_tok") or 0) for m in w_with_m), default=0)
                w_replayed = sum(int(m.get("replayed_checks") or 0) for m in w_with_m)
                w_help = sum(int(m.get("help_calls") or 0) for m in w_with_m)
                w_bombs = sum(len(m.get("context_bomb_cmds") or []) for m in w_with_m)
                w_llm_s = sum(m["llm_secs"] for m in w_with_m)
                w_tool_s = sum(m["tool_secs"] for m in w_with_m)
                w_out_speed = w_out_tok / max(1.0, w_llm_s)
                w_prefill_speed = (w_in_tok + w_cache_tok + w_out_tok) / max(1.0, w_llm_s)
                w_cache_pct = (w_cache_tok / max(1, w_in_tok + w_cache_tok)) * 100.0

                released_cnt = sum(1 for wm in worker_metrics_list if wm.get("term_state") == "released")
                retained_cnt = sum(1 for wm in worker_metrics_list if wm.get("term_state") in ["retained", "reclaimable"])
                active_cnt = sum(1 for wm in worker_metrics_list if wm.get("term_state") == "active")

                print(f"\n📈 4.3 BẢNG ĐỐI CHIẾU SỐ LIỆU ĐO ĐẠC THỰC TẾ (MEASURED TRANSCRIPT METRICS):")
                print("   ┌──────────────────────────────────────────────┬─────────────────────────────────┬─────────────────────────────────┐")
                print("   │ Chỉ số kỹ thuật (Đo trực tiếp từ Transcript) │ LEADER (Coordinator)            │ WORKERS (Tổng hợp các nhánh)    │")
                print("   ├──────────────────────────────────────────────┼─────────────────────────────────┼─────────────────────────────────┤")
                if leader_m:
                    l_poll_t = int(leader_m.get("poll_turns") or 0)
                    l_eff_t = int(leader_m["effective_turns"]) if "effective_turns" in leader_m else max(0, int(leader_m["turns"]) - l_poll_t)
                    if l_poll_t > 0:
                        l_turns_str = f"{leader_m['turns']}t (eff:{l_eff_t}) / {leader_m['tool_calls']}c ({leader_m['tool_errors']}e)"
                    else:
                        l_turns_str = f"{leader_m['turns']} turns / {leader_m['tool_calls']} tools ({leader_m['tool_errors']} err)"
                    l_time_str = f"LLM {_fmt_dur(leader_m['llm_secs'])} | Tool {_fmt_dur(leader_m['tool_secs'])}"
                    l_spd_str = f"{leader_m['out_tok_s']:.1f} out/s | {_fmt_tok(int(leader_m['prefill_tok_s']))} tot/s"
                    l_in_str = f"{leader_m['in_tok']:,} tok"
                    l_cache_str = f"{leader_m['cache_tok']:,} tok ({leader_m['cache_hit_pct']:.1f}%)"
                    l_out_str = f"{leader_m['out_tok']:,} tok"
                    l_peak_str = f"{leader_m['peak_ctx']:,} tok (last: {leader_m['last_ctx']:,})"
                    l_cum_str = f"{int(leader_m.get('cum_ctx_tok') or 0):,} tok"
                    l_tool_out_str = f"{int(leader_m.get('tool_output_tok') or 0):,} tok (max:{_fmt_tok(int(leader_m.get('max_tool_output_tok') or 0))})"
                    l_leak_str = f"replay={int(leader_m.get('replayed_checks') or 0)}, help={int(leader_m.get('help_calls') or 0)}, bomb={len(leader_m.get('context_bomb_cmds') or [])}"
                else:
                    l_turns_str = "N/A (IDE/External Session)"
                    l_time_str = "N/A"
                    l_spd_str = "N/A"
                    l_in_str = f"~{base_tokens + total_spec_tokens + total_report_tokens:,} tok (est)"
                    l_cache_str = "N/A"
                    l_out_str = f"~{total_spec_tokens:,} tok (spec)"
                    l_peak_str = f"~{base_tokens + total_report_tokens:,} tok"
                    l_cum_str = "N/A"
                    l_tool_out_str = "N/A"
                    l_leak_str = "N/A"

                if w_with_m:
                    if w_poll_turns > 0:
                        w_turns_str = f"{w_turns}t (eff:{w_eff_turns}) / {w_tools}c ({w_errs}e)"
                    else:
                        w_turns_str = f"{w_turns} turns / {w_tools} tools ({w_errs} err)"
                else:
                    w_turns_str = "N/A"
                w_time_str = f"LLM {_fmt_dur(w_llm_s)} | Tool {_fmt_dur(w_tool_s)}" if w_with_m else "N/A"
                w_spd_str = f"{w_out_speed:.1f} out/s | {_fmt_tok(int(w_prefill_speed))} tot/s" if w_with_m else "N/A"
                w_in_str = f"{w_in_tok:,} tok" if w_with_m else "N/A"
                w_cache_str = f"{w_cache_tok:,} tok ({w_cache_pct:.1f}%)" if w_with_m else "N/A"
                w_out_str = f"{w_out_tok:,} tok" if w_with_m else "N/A"
                w_peak_str = f"max {w_peak_max:,} tok" if w_with_m else "N/A"
                w_cum_str = f"{w_cum_ctx:,} tok" if w_with_m else "N/A"
                w_tool_out_str = f"{w_tool_out_tok:,} tok (max:{_fmt_tok(w_max_tool_out)})" if w_with_m else "N/A"
                w_leak_str = f"replay={w_replayed}, help={w_help}, bomb={w_bombs}" if w_with_m else "N/A"
                l_term_str = f"active={active_cnt}, retain={retained_cnt}"
                w_term_str = f"released={released_cnt}/{len(workers)}"

                print(f"   │ 1. Số lượt suy luận & gọi Tool (Turns/Tools) │ {l_turns_str:<31} │ {w_turns_str:<31} │")
                print(f"   │ 2. Thời gian thực thi (LLM Inference / Tool) │ {l_time_str:<31} │ {w_time_str:<31} │")
                print(f"   │ 3. Tốc độ (OUT e2e tok/s | CTX tok/s)      │ {l_spd_str:<31} │ {w_spd_str:<31} │")
                print(f"   │ 4. Fresh Input Tokens (Nạp mới lũy kế)       │ {l_in_str:<31} │ {w_in_str:<31} │")
                print(f"   │ 5. Cache Read Tokens (Tái sử dụng Cache %)   │ {l_cache_str:<31} │ {w_cache_str:<31} │")
                print(f"   │ 6. Output Tokens (Reasoning + Code sinh ra)  │ {l_out_str:<31} │ {w_out_str:<31} │")
                print(f"   │ 7. Đỉnh Context Window (Peak Context / Turn) │ {l_peak_str:<31} │ {w_peak_str:<31} │")
                print(f"   │ 8. Tổng Context Lũy Kế (Cumul. Billed Input) │ {l_cum_str:<31} │ {w_cum_str:<31} │")
                print(f"   │ 9. Tool Output Footprint (Stdout -> Context) │ {l_tool_out_str:<31} │ {w_tool_out_str:<31} │")
                print(f"   │ 10. Chỉ số Rò rỉ Token (Replay/Help/Bomb)    │ {l_leak_str:<31} │ {w_leak_str:<31} │")
                print(f"   │ 11. Trạng thái Worker Terminals              │ {l_term_str:<31} │ {w_term_str:<31} │")
                print("   └──────────────────────────────────────────────┴─────────────────────────────────┴─────────────────────────────────┘")

                # Phân tích tốc độ theo từng dòng Model thực tế trong Run
                for wm in worker_metrics_list:
                    tm = wm.get("telemetry")
                    if not tm:
                        continue
                    m_key = wm["model"]
                    b = model_buckets.setdefault(m_key, {"runs": 0, "turns": 0, "out_tok": 0, "in_tok": 0, "cache_tok": 0, "llm_s": 0.0, "tool_s": 0.0})
                    b["runs"] += 1
                    b["turns"] += tm["turns"]
                    b["out_tok"] += tm["out_tok"]
                    b["in_tok"] += tm["in_tok"]
                    b["cache_tok"] += tm["cache_tok"]
                    b["llm_s"] += tm["llm_secs"]
                    b["tool_s"] += tm["tool_secs"]
                if leader_m and config:
                    l_mod = str((config.get("coordinator") or {}).get("model") or "coordinator-model")
                    b = model_buckets.setdefault(f"{l_mod} (leader)", {"runs": 0, "turns": 0, "out_tok": 0, "in_tok": 0, "cache_tok": 0, "llm_s": 0.0, "tool_s": 0.0})
                    b["runs"] += 1
                    b["turns"] += leader_m["turns"]
                    b["out_tok"] += leader_m["out_tok"]
                    b["in_tok"] += leader_m["in_tok"]
                    b["cache_tok"] += leader_m["cache_tok"]
                    b["llm_s"] += leader_m["llm_secs"]
                    b["tool_s"] += leader_m["tool_secs"]

                if model_buckets:
                    print("\n⏱️ 4.4 BENCHMARK TỐC ĐỘ THỰC TẾ THEO MODEL (MODEL SPEED & LATENCY PROFILE):")
                    for m_key, b in model_buckets.items():
                        out_s = b["out_tok"] / max(1.0, b["llm_s"])
                        tot_s = (b["in_tok"] + b["cache_tok"] + b["out_tok"]) / max(1.0, b["llm_s"])
                        avg_t = b["llm_s"] / max(1, b["turns"])
                        c_pct = (b["cache_tok"] / max(1, b["in_tok"] + b["cache_tok"])) * 100.0
                        llm_share = (b["llm_s"] / max(1.0, b["llm_s"] + b["tool_s"])) * 100.0
                        print(
                            f"   • {m_key:<32}: out_e2e={out_s:>5.1f} tok/s | ctx={_fmt_tok(int(tot_s)):>6} tok/s | "
                            f"latency={avg_t:>4.1f}s/turn | cache={c_pct:>4.1f}% | time_split: LLM {llm_share:.0f}% / Tool {100-llm_share:.0f}%"
                        )

        else:
            print("ℹ️ Không thể kết nối Orca Runtime qua CLI (EPERM hoặc Orca đang đóng).")
            print("  (Chạy 'orca-monitor' trực tiếp trên Terminal để truy xuất runtime telemetry).")
    except Exception as e:
        print(f"ℹ️ Bỏ qua kiểm tra runtime chi tiết do: {e}")
    print("")

    # ─────────────────────────────────────────────────────────────────────────────
    # PHẦN 5: TỔNG KẾT PHÁT HIỆN KỸ THUẬT & LỆNH XỬ LÝ (DIAGNOSTIC SUMMARY)
    # ─────────────────────────────────────────────────────────────────────────────
    print("🎯 5. CHẨN ĐOÁN KỸ THUẬT & KHUYẾN NGHỊ HÀNH ĐỘNG (DIAGNOSTIC AUDIT)")
    print("═" * 105)

    if actions_taken:
        print("🛠️ AUTO-FIX ĐÃ THỰC THI:")
        for act in actions_taken:
            print(f"   • {act}")
        print("")

    if critical_issues:
        print("🔴 CRITICAL ISSUES (CẦN XỬ LÝ NGAY):")
        for idx, iss in enumerate(critical_issues, 1):
            print(f"   {idx}. {iss}")
        print("")

    if warning_issues:
        print("🟡 WARNINGS / BOTTLENECKS (ĐIỂM NGHẼN HOẶC RÒ RỈ CONTEXT):")
        for idx, iss in enumerate(warning_issues, 1):
            print(f"   {idx}. {iss}")
        print("")

    if passed_items:
        print("🟢 PASSED CHECKS:")
        for idx, item in enumerate(passed_items, 1):
            print(f"   {idx}. {item}")
        print("")

    print("⌨️ LỆNH ĐIỀU KHIỂN NHANH:")
    print("   • Tự động sửa lỗi cấu hình / đóng Gate treo:  orca-monitor --fix")
    print("   • Kiểm tra & gỡ kẹt worker chờ prompt:        orca-team watchdog --unblock\n")

    if as_json:
        sys.stdout = orig_stdout
        out_payload = {
            "workspace": str(root),
            "baseDirectiveTokens": base_tokens,
            "runId": active_run_id,
            "objective": active_run_obj,
            "workersCount": len(workers),
            "tasksCount": len(run_tasks),
            "mailbox": {
                "total": len(run_msgs),
                "heartbeat": hb_count,
                "workerDone": done_count,
                "handoff": handoff_count,
                "escalation": esc_count,
                "wakePayloadTokens": done_tokens,
            },
            "leaderTelemetry": leader_m,
            "workerMetrics": worker_metrics_list,
            "modelBenchmarks": model_buckets,
            "summary": {
                "criticalIssues": len(critical_issues),
                "warnings": len(warning_issues),
                "passedChecks": len(passed_items),
                "actionsTaken": len(actions_taken),
            },
            "issues": {
                "critical": critical_issues,
                "warnings": warning_issues,
                "passed": passed_items,
                "actions": actions_taken,
            },
        }
        print(json.dumps(out_payload, ensure_ascii=False, indent=2))


def _resolve_monitor_root(default_root: Path, default_config: dict, sub_args: list):
    if any(a in ("-h", "--help", "help") for a in sub_args):
        return default_root, default_config
    skip_next = False
    for a in sub_args:
        if skip_next:
            skip_next = False
            continue
        if a == "--run":
            skip_next = True
            continue
        if a.startswith("-") or a.startswith("run_"):
            continue
        cand = Path(a).expanduser()
        if cand.is_dir():
            r = cand.resolve()
            return r, load_config(r)
        print(f"❌ Đường dẫn không tồn tại hoặc không phải thư mục: '{a}'.", file=sys.stderr)
        sys.exit(1)
    return default_root, default_config


KNOWN_SUBCOMMANDS = {
    "status", "list", "show",
    "set", "get",
    "watchdog", "workers", "health",
    "monitor", "debug", "tokens", "token", "audit-tokens",
    "link", "discovery",
    "sync",
    "uninstall", "remove", "clean-all", "purge",
    "models", "list-models", "discover-models",
    "select", "menu", "choose",
    "agents", "list-agents",
    "spec", "role-spec", "prompt",
    "plan", "pin-plan", "master-plan",
    "kb", "knowledge", "system-engineer",
    "worktree-arg", "wt-arg", "slot-arg",
    "release-workers", "cleanup-tabs", "gc-workers",
    "merge-upstream", "merge-run", "run-branches",
    "wait-events", "wait", "check-wait",
    "verify", "gate", "state", "card", "brief",
    "version", "--version", "-V",
    "-h", "--help", "help",
}


def _check_self_repo_version_and_drift(enforce_check: bool = False) -> dict[str, Any]:
    """C-FIX-32: Inspect git commit SHA and working-tree cleanliness of the orca-team installation."""
    repo_dir = Path(__file__).resolve().parent.parent
    sha = "unknown"
    dirty_files: list[str] = []
    try:
        p_sha = subprocess.run(["git", "-C", str(repo_dir), "rev-parse", "HEAD"], capture_output=True, text=True, timeout=2)
        if p_sha.returncode == 0 and (p_sha.stdout or "").strip():
            sha = (p_sha.stdout or "").strip()
        p_st = subprocess.run(["git", "-C", str(repo_dir), "status", "--porcelain"], capture_output=True, text=True, timeout=2)
        if p_st.returncode == 0 and (p_st.stdout or "").strip():
            dirty_files = [ln.strip() for ln in (p_st.stdout or "").splitlines() if ln.strip()]
    except Exception:
        pass
    info = {
        "repoPath": str(repo_dir),
        "commitSha": sha,
        "shortSha": sha[:7] if sha != "unknown" else "unknown",
        "dirty": bool(dirty_files),
        "dirtyFiles": dirty_files,
        "status": "uncommitted" if dirty_files else "clean",
    }
    if enforce_check and dirty_files:
        if os.environ.get("ORCA_REJECT_DIRTY_INSTALL", "0").strip() == "1":
            print(
                f"❌ [ORCA INSTALL-DRIFT GUARD] Bản cài đặt orca-team tại '{repo_dir}' (commit {info['shortSha']}) đang có file chưa commit (uncommitted): {dirty_files}!",
                file=sys.stderr,
            )
            sys.exit(2)
    return info


def main():
    raw_args = sys.argv[1:]

    explicit_root = None
    args = []
    i = 0
    after_dd = False
    seen_spec_token = False
    while i < len(raw_args):
        if raw_args[i] == "--":
            after_dd = True
            args.append(raw_args[i])
            i += 1
            continue
        if not after_dd and not args and raw_args[i] in ("spec", "role-spec", "prompt", "verify", "gate", "state", "card", "brief"):
            seen_spec_token = True
            args.append(raw_args[i])
            i += 1
            continue
        if not after_dd and raw_args[i] in ("--task", "-t", "--title", "--content", "-c", "--body", "--file", "-f") and i + 1 < len(raw_args):
            args.append(raw_args[i])
            args.append(raw_args[i + 1])
            i += 2
            continue
        if not after_dd and not seen_spec_token and raw_args[i] in ("--path", "-C"):
            if i + 1 >= len(raw_args) or raw_args[i + 1].startswith("-"):
                print(f"❌ Thiếu giá trị đường dẫn cho cờ '{raw_args[i]}'.", file=sys.stderr)
                sys.exit(1)
            cand = Path(raw_args[i + 1]).expanduser()
            if not cand.is_dir():
                print(f"❌ Đường dẫn không tồn tại: '{raw_args[i + 1]}'.", file=sys.stderr)
                sys.exit(1)
            explicit_root = cand.resolve()
            i += 2
        elif not after_dd and not seen_spec_token and raw_args[i].startswith("--path="):
            p_val = raw_args[i].split("=", 1)[1].strip()
            if not p_val or p_val.startswith("-"):
                print("❌ Thiếu giá trị đường dẫn cho cờ '--path='.", file=sys.stderr)
                sys.exit(1)
            cand = Path(p_val).expanduser()
            if not cand.is_dir():
                print(f"❌ Đường dẫn không tồn tại: '{p_val}'.", file=sys.stderr)
                sys.exit(1)
            explicit_root = cand.resolve()
            i += 1
        else:
            args.append(raw_args[i])
            i += 1

    prog_name = Path(sys.argv[0]).name
    if prog_name != "orca-monitor" and args:
        cmd0 = args[0].lower()
        if cmd0 == "critic" and len(args) > 1 and args[1].lower() in ("brief", "blind-pack", "pack"):
            caller_dir = explicit_root if explicit_root is not None else Path.cwd().resolve()
            cmd_critic_brief(args[2:], caller_dir=caller_dir)
            return
        if cmd0 == "critic" and len(args) > 1 and args[1].lower() == "write":
            caller_dir = explicit_root if explicit_root is not None else Path.cwd().resolve()
            cmd_critic_write(args[2:], caller_dir=caller_dir)
            return
        if cmd0 in ("critic-brief", "blind-pack"):
            caller_dir = explicit_root if explicit_root is not None else Path.cwd().resolve()
            cmd_critic_brief(args[1:], caller_dir=caller_dir)
            return
        if cmd0 in ("spec", "role-spec", "prompt"):
            cmd_spec(args[1:], explicit_root=explicit_root)
            return
        if cmd0 in ("plan", "pin-plan", "master-plan"):
            caller_dir = explicit_root if explicit_root is not None else Path.cwd().resolve()
            sub_args = (["pin"] + args[1:]) if cmd0 == "pin-plan" else args[1:]
            cmd_plan(sub_args, caller_dir=caller_dir)
            return
        if cmd0 in ("kb", "knowledge", "system-engineer"):
            caller_dir = explicit_root if explicit_root is not None else Path.cwd().resolve()
            cmd_kb(args[1:], caller_dir=caller_dir)
            return
        if cmd0 in ("worktree-arg", "wt-arg", "slot-arg"):
            root = explicit_root if explicit_root is not None else find_project_root()
            cmd_worktree_arg(root, args[1:])
            return
        if cmd0 in ("release-workers", "cleanup-tabs", "gc-workers"):
            root = explicit_root if explicit_root is not None else find_project_root()
            cmd_release_workers(root, args[1:])
            return
        if cmd0 in ("merge-upstream", "merge-run", "run-branches"):
            caller_dir = explicit_root if explicit_root is not None else Path.cwd().resolve()
            sub_args = (["--list-only"] + args[1:]) if cmd0 == "run-branches" else args[1:]
            cmd_merge_upstream(sub_args, caller_dir=caller_dir)
            return
        if cmd0 in ("wait-events", "wait", "check-wait"):
            caller_dir = explicit_root if explicit_root is not None else Path.cwd().resolve()
            cmd_wait_events(args[1:], caller_dir=caller_dir)
            return
        if cmd0 == "state":
            caller_dir = explicit_root if explicit_root is not None else Path.cwd().resolve()
            cmd_state(args[1:], caller_dir=caller_dir)
            return
        if cmd0 == "card":
            cmd_card(args[1:])
            return
        if cmd0 == "verify":
            caller_dir = explicit_root if explicit_root is not None else Path.cwd().resolve()
            cmd_verify(args[1:], caller_dir=caller_dir)
            return
        if cmd0 == "gate":
            caller_dir = explicit_root if explicit_root is not None else Path.cwd().resolve()
            cmd_gate(args[1:], caller_dir=caller_dir)
            return
        if cmd0 == "brief":
            caller_dir = explicit_root if explicit_root is not None else Path.cwd().resolve()
            cmd_brief(args[1:], caller_dir=caller_dir)
            return
        if cmd0 in ("models", "list-models", "discover-models"):
            cmd_models(args[1:])
            return
        if cmd0 in ("select", "menu", "choose"):
            cmd_select(args[1:])
            return
        if cmd0 in ("agents", "list-agents"):
            print("🐋 Các Agent chính thức được Orca ADE hỗ trợ:")
            for ag in KNOWN_AGENTS:
                print(f"  • {ag}")
            return
        if cmd0 in ("version", "--version", "-v"):
            v_info = _check_self_repo_version_and_drift(enforce_check=("--enforce" in args))
            if "--json" in args:
                print(json.dumps(v_info, ensure_ascii=False, indent=2))
            else:
                st_lbl = f"UNCOMMITTED ({len(v_info['dirtyFiles'])} files)" if v_info["dirty"] else "CLEAN"
                print(f"orca-team commit={v_info['commitSha']} status={st_lbl} path={v_info['repoPath']}")
            return
        if cmd0 in ("-h", "--help", "help"):
            print(__doc__)
            return

    root = explicit_root if explicit_root is not None else find_project_root()
    config = load_config(root)

    # Nếu được gọi trực tiếp qua alias 'orca-monitor'
    if prog_name == "orca-monitor":
        root, config = _resolve_monitor_root(root, config, args)
        cmd_monitor(root, config, args)
        return

    if not args or args[0] in ["status", "list", "show"] or (
        args[0].lower() not in ROLE_ALIASES
        and args[0].lower() not in KNOWN_SUBCOMMANDS
        and Path(args[0]).expanduser().is_dir()
    ):
        scan_args = args[1:] if (args and args[0] in ("status", "list", "show")) else args
        if any(a in ("-h", "--help", "help") for a in scan_args):
            print("Sử dụng: orca-team [status] [path]")
            return
        for a in scan_args:
            if not a.startswith("-"):
                cand = Path(a).expanduser()
                if not cand.is_dir():
                    print(f"❌ Đường dẫn không tồn tại: '{a}'.", file=sys.stderr)
                    sys.exit(1)
                root = cand.resolve()
                config = load_config(root)
                break
        cmd_status(root, config)
    elif args[0] == "set":
        cmd_set(root, config, args[1:])
    elif args[0] == "get":
        cmd_get(root, config, args[1:])
    elif args[0] in ["watchdog", "workers", "health"]:
        cmd_watchdog(root, args[1:])
    elif args[0] in ["monitor", "debug", "tokens", "token", "audit-tokens"]:
        root, config = _resolve_monitor_root(root, config, args[1:])
        cmd_monitor(root, config, args[1:])
    elif args[0] in ["link", "discovery"]:
        cmd_link(root, args[1:])
    elif args[0] == "sync":
        if any(a in ("-h", "--help", "help") for a in args[1:]):
            print("Sử dụng: orca-team sync [path]")
            return
        for a in args[1:]:
            if not a.startswith("-"):
                if not Path(a).expanduser().is_dir():
                    print(f"❌ Đường dẫn không tồn tại: '{a}'.", file=sys.stderr)
                    sys.exit(1)
                root = Path(a).expanduser().resolve()
                config = load_config(root)
                break
        if not config:
            print(f"❌ Không tìm thấy orca-team.json trong '{root}'.", file=sys.stderr)
            sys.exit(1)
        sync_gemini_directive(root, config)
        print(f"✅ Đã đồng bộ '{root / '.agents' / 'GEMINI.md'}' từ '{root / 'orca-team.json'}'.")
    elif args[0] in ["uninstall", "remove", "clean-all", "purge"]:
        cmd_uninstall_project(root, args[1:])
    else:
        # Default fallback: check if first arg is a role name directly, e.g. "orca-team dev"
        if args[0].lower() in ROLE_ALIASES:
            cmd_set(root, config, args)
        else:
            print(f"❌ Lệnh không hợp lệ: '{args[0]}'. Dùng 'orca-team --help' để xem hướng dẫn.", file=sys.stderr)
            sys.exit(1)

if __name__ == "__main__":
    main()
