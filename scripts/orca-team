REA_REPO_URL = "https://github.com/morluto/rea.git"
REA_CLIENT_MAP = {
    "antigravity": "antigravity",
    "gemini": "gemini_cli",
    "claude": "claude_code",
    "codex": "codex",
    "cursor": "cursor",
