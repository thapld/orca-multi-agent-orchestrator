def ensure_rea_skill(agent: str = "antigravity"):
    """
    Đảm bảo skill 'reverse-engineer-anything' (từ https://github.com/morluto/rea.git)
    và công cụ 'rea' được cài đặt/đồng bộ cho các agent CLI (Antigravity, Claude, Codex, Kimi...).
    """
    import subprocess
    import tempfile

    skill_targets = [
        Path.home() / ".gemini" / "config" / "skills" / "reverse-engineer-anything",
        Path.home() / ".agents" / "skills" / "reverse-engineer-anything",
        Path.home() / ".claude" / "skills" / "reverse-engineer-anything",
    ]

    # 1. Kiểm tra xem đã có bản cài đặt chuẩn ở một trong các thư mục chưa
    existing_src = None
    for st in skill_targets:
        if (st / "SKILL.md").exists():
            existing_src = st
            break

    # 2. Nếu chưa có ở bất kỳ đâu, thử chạy rea setup, npx rea-agents, hoặc git clone từ https://github.com/morluto/rea.git
    env = _build_discovery_env()
    rea_bin = _find_cli_binary(["rea"], env)
    npx_bin = _find_cli_binary(["npx"], env)
    rea_client = REA_CLIENT_MAP.get((agent or "antigravity").lower(), "antigravity")

    if not existing_src:
        print(f"   🔧 [REA] Đang cài đặt skill 'reverse-engineer-anything' từ {REA_REPO_URL}...")
        if rea_bin:
            try:
                subprocess.run([rea_bin, "setup", "--client", rea_client, "--yes"], capture_output=True, text=True, env=env, timeout=30)
            except Exception:
                pass
        elif npx_bin:
            try:
                subprocess.run([npx_bin, "-y", "rea-agents@latest", "setup", "--client", rea_client, "--yes"], capture_output=True, text=True, env=env, timeout=45)
            except Exception:
                pass
        for st in skill_targets:
            if (st / "SKILL.md").exists():
                existing_src = st
                break

    if not existing_src:
        tmp_dir = Path(tempfile.mkdtemp(prefix="orca-rea-"))
        try:
            res = subprocess.run(
                ["git", "clone", "--depth", "1", REA_REPO_URL, str(tmp_dir)],
                capture_output=True, text=True, timeout=45
            )
            if res.returncode == 0:
                candidates = [
                    tmp_dir / "skills" / "reverse-engineer-anything",
                    tmp_dir / "skill" / "reverse-engineer-anything",
                    tmp_dir / "reverse-engineer-anything",
                    tmp_dir,
                ]
                for cand in candidates:
                    if (cand / "SKILL.md").exists():
                        target_primary = skill_targets[0]
                        target_primary.parent.mkdir(parents=True, exist_ok=True)
                        if target_primary.exists():
                            shutil.rmtree(target_primary, ignore_errors=True)
                        shutil.copytree(cand, target_primary, dirs_exist_ok=True)
                        existing_src = target_primary
                        print(f"   ✅ [REA] Đã tải và cài đặt skill 'reverse-engineer-anything' vào {target_primary}")
                        break
        except Exception as e:
            print(f"   ⚠️  [REA] Không thể clone tự động từ {REA_REPO_URL}: {e}", file=sys.stderr)
        finally:
            shutil.rmtree(tmp_dir, ignore_errors=True)

    # 3. Đồng bộ sang các thư mục skill chung (~/.agents/skills và ~/.claude/skills) để mọi worker đều đọc được
    if existing_src and (existing_src / "SKILL.md").exists():
        for st in skill_targets:
            if st == existing_src or (st / "SKILL.md").exists():
                continue
            try:
                st.parent.mkdir(parents=True, exist_ok=True)
                shutil.copytree(existing_src, st, dirs_exist_ok=True)
            except Exception:
                pass

    # 4. Nếu có binary 'rea', đảm bảo đăng ký MCP/client cho agent được chọn
    if rea_bin:
        try:
            subprocess.run([rea_bin, "setup", "--client", rea_client, "--yes"], capture_output=True, text=True, env=env, timeout=20)
        except Exception:
            pass


def find_project_root():
    curr = Path.cwd().resolve()
    # 1. Tra cứu Git common-dir nếu đang nằm trong child worktree
    try:
        import subprocess
        res = subprocess.run(["git", "rev-parse", "--git-common-dir"], capture_output=True, text=True, cwd=str(curr))
        if res.returncode == 0 and res.stdout.strip():
            raw_git = Path(res.stdout.strip())
            common_git = raw_git if raw_git.is_absolute() else (curr / raw_git).resolve()
            main_root = common_git.parent
            if (main_root / "orca-team.json").exists() or (main_root / ".agents" / "GEMINI.md").exists():
                return main_root
    except Exception:
        pass

    # 2. Quét ngược lên các thư mục cha thông thường
    for parent in [curr] + list(curr.parents):
        if (parent / "orca-team.json").exists() or (parent / ".agents" / "GEMINI.md").exists():
            return parent
    return curr

def load_config(root: Path):
    cfg_file = root / "orca-team.json"
    if not cfg_file.exists():
        return None
    try:
        with open(cfg_file, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception as e:
        print(f"❌ Lỗi đọc orca-team.json: {e}", file=sys.stderr)
        return None

def save_config(root: Path, config: dict):
    cfg_file = root / "orca-team.json"
    with open(cfg_file, "w", encoding="utf-8") as f:
        json.dump(config, f, indent=2, ensure_ascii=False)
        f.write("\n")

def _supports_effort_py(agent: str, model: str) -> bool:
    ag = (agent or "").strip().lower()
    mod = str(model or "").strip()
    if not mod or mod in ("None", "null", "(default)"):
        return False
    if ag in ("antigravity", "codebuddy", "codex", "muse"):
        return True
    if ag == "claude":
        return "haiku" not in mod.lower()
    if ag == "cursor":
        return mod in ("gpt-5.3-codex", "claude-opus-4-8")
    return False

def _fmt_worker_args_py(agent: str, model, effort: str) -> str:
    ag = (agent or "").strip().lower()
    args = f"--agent {agent}"
    mod = str(model).strip() if (model and str(model).strip() not in ("None", "null", "(default)")) else ""
    eff = str(effort).strip().lower() if (effort and str(effort).strip() not in ("None", "null", "-")) else ""

    # Orca worker-start chỉ hỗ trợ --model trên: antigravity, claude, codex, cursor, muse, codebuddy, omp
    # (kimi, gemini, opencode khi tạo new-child, aider, goose, copilot tự lấy model từ config riêng)
    model_supported_agents = {"antigravity", "claude", "codex", "cursor", "muse", "codebuddy", "omp"}
    if not mod or ag not in model_supported_agents:
        return args

    args += f' --model "{mod}"'

    # --effort bắt buộc phải đi kèm --model và chỉ hỗ trợ trên một số agent/model nhất định trong Orca
    if not eff or ag == "omp":
        return args
    if ag == "antigravity" or ag == "codebuddy":
        if eff in ("xhigh", "max", "ultra"):
            eff = "high"
        elif eff == "minimal":
            eff = "low"
        if eff not in ("low", "medium", "high"):
            return args
    elif ag == "claude":
        if "haiku" in mod.lower():
            return args
        if eff not in ("low", "medium", "high", "xhigh", "max"):
            return args
    elif ag == "cursor":
        if mod not in ("gpt-5.3-codex", "claude-opus-4-8") or eff not in ("low", "medium", "high"):
            return args
    elif ag in ("codex", "muse"):
        if eff not in ("minimal", "low", "medium", "high", "xhigh", "max", "ultra"):
            return args
    else:
        return args

    args += f" --effort {eff}"
    return args

def _is_role_enabled(data: dict, is_optional: bool = True) -> bool:
    if not isinstance(data, dict):
        return False
    ag = data.get("agent")
    has_valid_agent = bool(ag and ag != "none")
    if "enabled" in data:
        return bool(data["enabled"]) and has_valid_agent
    return has_valid_agent if is_optional else True

def sync_gemini_directive(root: Path, config: dict):
    gemini_file = root / ".agents" / "GEMINI.md"
    if not gemini_file.exists():
        return

    content = gemini_file.read_text(encoding="utf-8")
    
    # Build updated table rows
    rows = []
    rows.append("| Role | Agent & Model | Concurrency | Capabilities & Orca Utilities |")
    rows.append("| :--- | :--- | :--- | :--- |")
    
    # Coordinator
    coord = config.get("coordinator", {})
    c_agent = coord.get("agent", "claude")
    c_model = coord.get("model")
    c_display = f"`{c_agent}`" + (f" ({c_model})" if c_model else "")
    rows.append(f"| **Lead Coordinator** | {c_display} | 1 | Task DAG, Zero-Trust Audit, Decision Gates, Release |")

    # Developer
    roles = config.get("roles", {})
    dev = roles.get("developer", {})
    d_agent = dev.get("agent", "kimi")
    d_model = dev.get("model")
    d_display = f"`{d_agent}`" + (f" ({d_model})" if d_model else "")
    d_count = dev.get("concurrency", 2)
    rows.append(f"| **Full-Stack Devs** | {d_display} | {d_count} parallel | Child worktrees, clean architecture, unit tests |")

    # QA
    qa = roles.get("qa", {})
    q_agent = qa.get("agent", "kimi")
    q_model = qa.get("model")
    q_display = f"`{q_agent}`" + (f" ({q_model})" if q_model else "")
    q_count = qa.get("concurrency", 1)
    rows.append(f"| **QA & Testers** | {q_display} | {q_count} parallel | Integration/E2E suites, adversarial edge-case testing |")

    # Security
    sec = roles.get("security", {})
    s_agent = sec.get("agent", "codex")
    s_model = sec.get("model")
    s_display = f"`{s_agent}`" + (f" ({s_model})" if s_model else "")
    s_count = sec.get("concurrency", 1)
    rows.append(f"| **Security & Bug Hunter** | {s_display} | {s_count} parallel | OWASP Top 10, concurrency/race conditions, leak audit |")

    # PR Reviewer
    pr = roles.get("prReviewer", {})
    p_agent = pr.get("agent", "claude")
    p_model = pr.get("model")
    p_display = f"`{p_agent}`" + (f" ({p_model})" if p_model else "")
    rows.append(f"| **PR Reviewer** | {p_display} | On-demand | PR checkout (`--pr`), line-by-line diff audit |")

    # Issue Resolver
    issue = roles.get("issueResolver", {})
    i_agent = issue.get("agent", "kimi")
    i_model = issue.get("model")
    i_display = f"`{i_agent}`" + (f" ({i_model})" if i_model else "")
    rows.append(f"| **Issue Resolver** | {i_display} | On-demand | Issue checkout (`--issue`), reproduction test & fix |")

    # DevOps Specialist
    devops = roles.get("devopsSpecialist", {})
    devops_enabled = _is_role_enabled(devops, is_optional=True)
    if devops_enabled:
        do_agent = devops.get("agent", "codex")
        do_model = devops.get("model")
        do_display = f"`{do_agent}`" + (f" ({do_model})" if do_model else "")
        rows.append(f"| **DevOps Specialist** | {do_display} | On-demand | Docker/K8s rollout, DB migrations, SSH worktrees |")

    # UI Specialist
    ui = roles.get("uiSpecialist", {})
    ui_enabled = _is_role_enabled(ui, is_optional=True)
    if ui_enabled:
        u_agent = ui.get("agent", "claude")
        u_model = ui.get("model")
        u_display = f"`{u_agent}`" + (f" ({u_model})" if u_model else "")
        rows.append(f"| **UI/UX Specialist** | {u_display} | On-demand | Design Mode (Click-to-code), responsive & a11y |")

    # Bench & Perf Specialist
    bench = roles.get("benchSpecialist", {})
    bench_enabled = _is_role_enabled(bench, is_optional=True)
    if bench_enabled:
        b_agent = bench.get("agent", "antigravity")
        b_model = bench.get("model")
        b_display = f"`{b_agent}`" + (f" ({b_model})" if b_model else "")
        rows.append(f"| **Bench & Perf Specialist** | {b_display} | On-demand | Stress/Load test (RPS/EPS), p95/p99 latency, profiling |")

    # Reverse Engineering Specialist (REA)
    re_spec = roles.get("reSpecialist", {})
    re_enabled = _is_role_enabled(re_spec, is_optional=True)
    if re_enabled:
        r_agent = re_spec.get("agent", "antigravity")
        r_model = re_spec.get("model")
        r_display = f"`{r_agent}`" + (f" ({r_model})" if r_model else "")
        rows.append(f"| **Reverse Eng (REA)** | {r_display} | On-demand | Binary/Package/ASAR/Protocol decompile (`rea` skill) |")

    table_text = "\n".join(rows)

    # Đồng bộ dòng BẮT BUỘC PHÂN VAI ĐÚNG CHUYÊN MÔN ở đầu file theo đúng các role đang bật
    routing_parts = ["Code ứng dụng ➔ **`dev-worker`**"]
    if devops_enabled:
        routing_parts.append("Docker, K8s, Helm, DB migration, `.env`, infra ➔ **`devops-worker`**")
    routing_parts.append("Kiểm toán bảo mật & rò rỉ ➔ **`sec-worker`**")
    routing_parts.append("Kiểm thử nghiệm thu ➔ **`qa-worker`**")
    if bench_enabled:
        routing_parts.append("Đo tải RPS/EPS & tối ưu hiệu năng ➔ **`bench-worker`**")
    if re_enabled:
        routing_parts.append("Dịch ngược Binary/ASAR/Protocol (`rea`) ➔ **`re-worker`**")
    if ui_enabled:
        routing_parts.append("Giao diện CSS/DOM ➔ **`ui-worker`**")
    routing_line = "> - **BẮT BUỘC PHÂN VAI ĐÚNG CHUYÊN MÔN:** " + " | ".join(routing_parts) + "."
    content = re.sub(r"^> - \*\*BẮT BUỘC PHÂN VAI ĐÚNG CHUYÊN MÔN:\*\*.*$", routing_line, content, flags=re.M)

    # Regex replace the table under ## 👥 Configured Agent (Team)? Topology
    pattern = re.compile(
        r"(## 👥 Configured Agent(?: Team)? Topology\s*\n\s*)(?:\|[^\n]+\|\n)+",
        re.MULTILINE
    )
    if pattern.search(content):
        content = pattern.sub(lambda m: m.group(1) + table_text + "\n", content)

    dev_spec_line = (
        '  orca orchestration task-create --spec "[ROLE: PRINCIPAL DEV] Nhiệm vụ: [Chi tiết code & file paths]. '
        'Chuẩn: Clean Architecture, type-safe 100%, xử lý edge cases (null, timeout, concurrency), không TODO/mock giả/hardcode secret. '
        'CẤM VƯỢT RÀO: Chỉ sửa code app & unit test; CẤM sửa K8s/Docker của DevOps; CẤM xóa/skip (@Ignore, .skip) test cũ đang fail. '
        'GIAO TIẾP & THẨM QUYỀN QUYẾT ĐỊNH (BẮT BUỘC giữ nguyên --from/--task-id/--dispatch-id/--terminal từ Preamble): '
        '(1) Đồng bộ nhánh mới nhất (git merge --no-edit main) và kiểm tra hộp thư (orca orchestration check --terminal <worker_handle> --json) nhận chỉ đạo/spec từ Coordinator; '
        'nếu cần quyết định kiến trúc/cấu hình, BẮT BUỘC hỏi Coordinator qua orca orchestration ask --from <worker_handle> --question \'...\' --json '
        '(worker KHÔNG tự ý đổi thiết kế liên role), (2) Build & Unit Test EXIT_CODE=0 và git commit sạch vào nhánh dev-worker, '
        '(3) Trước khi gửi worker_done, BẮT BUỘC gửi bàn giao về Coordinator duyệt: '
        'orca orchestration send --from <worker_handle> --type handoff --subject \'Dev Handoff: dev-worker (<commit_hash>)\' '
        '--body \'Tóm tắt file sửa, API/schema/env thay đổi để Coordinator điều phối cho DevOps/QA/Sec/Bench\' '
        '--task-id <task_id> --dispatch-id <dispatch_id> --json '
        '(KHÔNG dùng --to \'@all\' vì \'@all\' loại trừ Coordinator!)." --json'
    )
    devops_spec_line = (
        '  orca orchestration task-create --spec "[ROLE: PRINCIPAL DEVOPS/SRE] Nhiệm vụ: [Docker/K8s/DB/Infra]. '
        'Chuẩn: Dockerfile multi-stage/non-root, K8s probes/limits, DB migration idempotent có rollback. '
        'CẤM VƯỢT RÀO: Chỉ sửa Infra/Docker/K8s/DB/CI; CẤM sửa business logic của Dev. '
        'RÀ SOÁT RUNTIME LOGS & BÁO CÁO COORDINATOR (BẮT BUỘC giữ nguyên --from/--task-id/--dispatch-id/--terminal từ Preamble): '
        '(1) Chạy orca orchestration check --terminal <worker_handle> --json nhận nhánh/commit đã được Coordinator duyệt và '
        'chạy git merge --no-edit main && git merge --no-edit dev-worker trước khi build, (2) CẤM chỉ nhìn Pod Running (1/1 Ready) hay /health 200 lúc mới bật rồi báo xong! '
        'Bắt buộc chờ qua chu kỳ chạy thật của background worker/@Scheduled/consumer và quét TOÀN BỘ Runtime Logs từ lúc container start '
        '(kubectl logs/docker logs KHÔNG dùng --since ngắn cắt lỗi) trên TẤT CẢ các pod/container (App + DB + Kafka/Broker + Sidecar) '
        'cùng trạng thái DB, (3) Nếu phát hiện BẤT KỲ dòng ERROR, FATAL, PANIC, Exception, Stacktrace, lỗi SQL, '
        'SSLHandshakeException, Auth 401/403 hay health=ERROR nào lúc runtime ➔ BẮT BUỘC trình báo ngay lên Coordinator: '
        'orca orchestration send --from <worker_handle> --type escalation --subject \'Runtime Log Error\' '
        '--body \'<Chi tiết pod & log lỗi trình Coordinator phán quyết>\' --task-id <task_id> --dispatch-id <dispatch_id> --json '
        '(KHÔNG dùng --to \'@all\'!) rồi chờ chỉ đạo hoặc báo worker_done --outcome failed '
        '(CẤM báo succeeded khi runtime log còn lỗi!); khi sạch lỗi 100%, gửi '
        'orca orchestration send --from <worker_handle> --type handoff --subject \'Infra Ready\' --body \'<Pod/Port/Log sạch 100%>\' '
        '--task-id <task_id> --dispatch-id <dispatch_id> --json về Coordinator." --json'
    )
    sec_spec_line = (
        '  orca orchestration task-create --spec "[ROLE: PRINCIPAL SECURITY AUDITOR] Nhiệm vụ: Kiểm toán Red-Team cho [module]. '
        'Chuẩn: Soi git diff theo OWASP Top 10 (SQLi, Injection, Auth/JWT, IDOR, SSRF, XSS), Race Conditions/Deadlock, Resource/Memory Leaks '
        'và Secret Leaks. CẤM VƯỢT RÀO: Read-Only Audit & PoC; CẤM tự sửa code tính năng của Dev. GIAO TIẾP & BẰNG CHỨNG BẮT BUỘC: '
        'Chạy git merge --no-edit main && git merge --no-edit dev-worker để diff đúng commit mới của Dev; nếu phát hiện lỗ hổng phải trình ngay lên Coordinator bằng '
        'orca orchestration send --from <worker_handle> --type escalation --subject \'Security Vulnerability Found\' '
        '--body \'<file:line & PoC trình Coordinator ra quyết định>\' --task-id <task_id> --dispatch-id <dispatch_id> --json; '
        'liệt kê rõ file:line theo 4 mục [OWASP, Concurrency, Leaks, Secrets] và chốt SECURITY_VERDICT: PASS hoặc BLOCK." --json'
    )
    qa_spec_line = (
        '  orca orchestration task-create --spec "[ROLE: PRINCIPAL QA/SDET] Nhiệm vụ: Kiểm thử nghiệm thu, bẻ gãy hệ thống '
        '(Adversarial Testing) & Kiểm toán Runtime Logs cho [chi tiết]. Chuẩn: Phủ kín Happy Path, Edge Cases (null, rỗng, số âm, '
        'payload lớn, race condition, lỗi mạng/DB) và 100% Acceptance Criteria. CẤM VƯỢT RÀO & CẤM CHE GIẤU LỖI: Chỉ viết/chạy test; '
        'CẤM TUYỆT ĐỐI sửa business logic của Dev; CẤM xóa/nới lỏng assert (vd: chỉ check HTTP 200 hay attempts>=1 mà lờ đi '
        'status=FAILED/health=ERROR/last_error/SSLHandshakeException); CẤM dùng --since ngắn để cắt bỏ log lỗi cũ hoặc bỏ sót '
        'không quét pod DB/Kafka! GIAO TIẾP & BÁO CÁO COORDINATOR (BẮT BUỘC): (1) Kiểm tra hộp thư (orca orchestration check --terminal <worker_handle> --json) '
        'nhận nhánh/môi trường từ Coordinator và chạy git merge --no-edit main && git merge --no-edit dev-worker trước khi test, (2) Chạy lệnh test thật VÀ kiểm toán trực tiếp '
        'TOÀN BỘ Runtime Logs (kubectl logs/docker logs từ lúc start trên MỌI container App + DB + Broker) trong & sau khi chạy E2E/scheduled jobs, '
        '(3) Nếu vướng môi trường phải hỏi Coordinator qua orca orchestration ask --from <worker_handle> --question \'...\' --json; '
        'nếu phát hiện BẤT KỲ lỗi ERROR/Exception/FATAL/SQL/SSL/health=ERROR nào trong Runtime Logs hay DB ➔ BẮT BUỘC trình ngay lên Coordinator bằng '
        'orca orchestration send --from <worker_handle> --type escalation --subject \'QA Runtime/Test Failure\' '
        '--body \'<Trích xuất log lỗi trình Coordinator phán quyết>\' --task-id <task_id> --dispatch-id <dispatch_id> --json và chốt QA_VERDICT: FAIL!" --json'
    )
    bench_spec_line = (
        '  orca orchestration task-create --spec "[ROLE: PRINCIPAL BENCHMARK & PERF] Nhiệm vụ: [Đo tải, benchmark & profiling]. '
        'Chuẩn: Có bước warm-up, dùng công cụ chuẩn (k6/wrk/JMH/pytest-benchmark/go test -bench/EXPLAIN ANALYZE), đo Before vs After. '
        'CẤM VƯỢT RÀO: Chỉ viết/chạy benchmark & phân tích bottleneck; CẤM tự sửa business logic hoặc drop dữ liệu/bỏ validate để ăn gian điểm số! '
        'GIAO TIẾP & BẰNG CHỨNG BẮT BUỘC: (1) Nhận chỉ đạo nhánh/môi trường từ Coordinator và chạy git merge --no-edit main && git merge --no-edit dev-worker để đo trên code mới nhất, '
        '(2) Xuất bảng số liệu thật: Concurrency, Throughput (req/s hoặc EPS), Latency (p50/p95/p99), Error Rate (0%), CPU/RAM; '
        'nếu phát hiện nghẽn cổ chai, gửi ngay orca orchestration send --from <worker_handle> --type escalation --subject \'Perf Bottleneck Found\' '
        '--body \'<file:line/query gây nghẽn trình Coordinator phán quyết>\' --task-id <task_id> --dispatch-id <dispatch_id> --json '
        'và chốt PERF_VERDICT: PASS hoặc BOTTLENECK_FOUND." --json'
    )
    re_spec_line = (
        '  orca orchestration task-create --spec "[ROLE: PRINCIPAL REVERSE ENGINEER (REA)] Nhiệm vụ: [Giải phẫu artifact/binary/protocol]. '
        'Chuẩn: Bắt buộc kích hoạt skill reverse-engineer-anything (morluto/rea) & công cụ rea/rea-agents (open_binary, inspect_artifact, '
        'analyze_javascript_application, inspect_web_network_capture...). CẤM VƯỢT RÀO: (1) Read-Only đối với source code dự án '
        '(chỉ xuất Đặc tả Kỹ thuật Clean-Room, CẤM copy code decompile rối rắm vào repo), '
        '(2) CẤM dùng REA cho source code repo thông thường, (3) CẤM đoán mò hành vi hộp đen khi không có Evidence từ REA! '
        'GIAO TIẾP & BẰNG CHỨNG BẮT BUỘC: Xuất Hồ sơ Evidence thực tế (Target SHA-256/Path, REA tool đã chạy, Symbol/Offset/Decompiled Function/'
        'Struct/Protocol contract, Unknowns/Limitations), gửi bản tin orca orchestration send --from <worker_handle> --type handoff '
        '--subject \'REA Clean-Room Spec\' --body \'<Tóm tắt Spec trình Coordinator duyệt và giao Dev>\' --task-id <task_id> --dispatch-id <dispatch_id> --json '
        'và chốt RE_VERDICT: EVIDENCE_COMPLETE hoặc BLOCKED_BY_UNKNOWN." --json'
    )
    ui_spec_line = (
        '  orca orchestration task-create --spec "[ROLE: PRINCIPAL UI/UX] Nhiệm vụ: [Giao diện, CSS/DOM, Responsive & a11y]. '
        'CẤM VƯỢT RÀO: Chỉ sửa UI/Frontend; CẤM sửa backend/DB. BẰNG CHỨNG BẮT BUỘC: Build/typecheck EXIT_CODE=0, không lỗi Console, '
        'kiểm tra snapshot/screenshot Mobile/Desktop, gửi orca orchestration send --from <worker_handle> --type handoff --subject \'UI Ready\' '
        '--body \'<Branch/Commit/Routes>\' --task-id <task_id> --dispatch-id <dispatch_id> --json về Coordinator và git commit." --json'
    )

    def _wt_expr(w_name):
        return f"$(git worktree list | sed -n 's/^\\([^ ]*\\).*\\[{w_name}\\].*/--worktree path:\\1/p' | head -n 1 | grep . || echo \"--worktree new-child --name {w_name}\")"

    # Tự động thêm/gỡ các dòng Step 1 (task-create) và Step 2 (worker-start) nếu role được bật/tắt động
    optional_directives = [
        (
            devops_enabled,
            "ROLE: PRINCIPAL DEVOPS/SRE",
            f'  # Principal DevOps/SRE (BẮT BUỘC khi có Docker, K8s, pod, Helm, CI/CD, DB migration, .env, infra):\n{devops_spec_line}\n',
            "devops-worker",
            f'  # DevOps Worker (khi có Task DevOps - Docker/K8s/DB/Infra):\n  orca orchestration worker-start --task <DEVOPS_TASK_ID> {_wt_expr("devops-worker")} {_fmt_worker_args_py(devops.get("agent", "antigravity"), devops.get("model"), devops.get("effort"))} --json\n'
        ),
        (
            ui_enabled,
            "ROLE: PRINCIPAL UI/UX",
            f'  # Principal UI/UX (Khi có Frontend, CSS/DOM, Design Mode):\n{ui_spec_line}\n',
            "ui-worker",
            f'  # UI Worker (khi có Task Frontend/UI):\n  orca orchestration worker-start --task <UI_TASK_ID> {_wt_expr("ui-worker")} {_fmt_worker_args_py(ui.get("agent", "antigravity"), ui.get("model"), ui.get("effort"))} --json\n'
        ),
        (
            bench_enabled,
            "ROLE: PRINCIPAL BENCHMARK & PERF",
            f'  # Principal Benchmark & Perf (BẮT BUỘC khi đo tải RPS/EPS, tối ưu hiệu năng, latency p95/p99, batch/queue/DB tuning):\n{bench_spec_line}\n',
            "bench-worker",
            f'  # Benchmark Worker (khi có Task Benchmark / Stress Test / Tối ưu hiệu năng):\n  orca orchestration worker-start --task <BENCH_TASK_ID> {_wt_expr("bench-worker")} {_fmt_worker_args_py(bench.get("agent", "antigravity"), bench.get("model"), bench.get("effort"))} --json\n'
        ),
        (
            re_enabled,
            "ROLE: PRINCIPAL REVERSE ENGINEER (REA)",
            f'  # Principal Reverse Engineer - REA (BẮT BUỘC khi dịch ngược binary/JAR/ASAR/APK/firmware/network capture hoặc tái tạo giao thức đóng):\n{re_spec_line}\n',
            "re-worker",
            f'  # Reverse Engineering Worker (khi có Task Dịch ngược Binary/Package/ASAR/Protocol với REA):\n  orca orchestration worker-start --task <RE_TASK_ID> {_wt_expr("re-worker")} {_fmt_worker_args_py(re_spec.get("agent", "antigravity"), re_spec.get("model"), re_spec.get("effort"))} --json\n'
        ),
    ]

    for is_en, step1_marker, step1_block, w_name, step2_block in optional_directives:
        has_w_cmd = bool(re.search(rf"^[ \t]*orca orchestration worker-start[^\n]*--name\s+{re.escape(w_name)}\b", content, re.M))
        if is_en:
            if step1_marker not in content:
                # Chèn vào trước # Principal AppSec Auditor hoặc cuối khối bash của Bước 1
                anchor_s1 = re.search(r"^[ \t]*#[ \t]*(?:\d+\.\s*)?Principal AppSec Auditor.*$", content, re.M)
                if anchor_s1:
                    content = content[:anchor_s1.start()] + step1_block + content[anchor_s1.start():]
            if not has_w_cmd:
                # Chèn vào trước # Security Worker hoặc sau dev-worker trong Bước 2
                anchor_s2 = re.search(r"^[ \t]*#[ \t]*Security Worker.*$", content, re.M)
                if anchor_s2:
                    content = content[:anchor_s2.start()] + step2_block + content[anchor_s2.start():]
                else:
                    dev_w = re.search(r"^.*--name\s+dev-worker.*\n", content, re.M)
                    if dev_w:
                        content = content[:dev_w.end()] + step2_block + content[dev_w.end():]
        else:
            if step1_marker in content:
                s1_pat = re.compile(
                    rf"\n?(?:^[ \t]*#[^\n]*\n)?^[ \t]*orca orchestration task-create --spec \"\[{re.escape(step1_marker)}\][^\n]*\n",
                    re.M
                )
                content = s1_pat.sub("\n", content)
            if has_w_cmd:
                s2_pat = re.compile(
                    rf"(?:^[ \t]*#[^\n]*\n)?^[ \t]*orca orchestration worker-start[^\n]*--name\s+{re.escape(w_name)}\b[^\n]*\n",
                    re.M
                )
                content = s2_pat.sub("", content)

    # Nâng cấp tự động chuẩn mực Giao tiếp Liên Vai trò & Runtime Log Audit cho mọi vai trò và Bước 2, 3 trên các file GEMINI.md hiện hữu
    for marker_str, replacement_line in [
        ("ROLE: PRINCIPAL DEV", dev_spec_line),
        ("ROLE: PRINCIPAL DEVOPS/SRE", devops_spec_line),
        ("ROLE: PRINCIPAL SECURITY AUDITOR", sec_spec_line),
        ("ROLE: PRINCIPAL BENCHMARK & PERF", bench_spec_line),
        ("ROLE: PRINCIPAL REVERSE ENGINEER (REA)", re_spec_line),
        ("ROLE: PRINCIPAL UI/UX", ui_spec_line),
    ]:
        content = re.sub(
            rf'^[ \t]*orca orchestration task-create --spec "\[{re.escape(marker_str)}\][^\n]*$',
            lambda m, r=replacement_line: r,
            content,
            flags=re.M
        )
    content = re.sub(
        r'^[ \t]*#[ \t]*(?:\d+\.\s*)?Principal SDET / QA[^\n]*\n[ \t]*orca orchestration task-create --spec "\[ROLE: PRINCIPAL QA/SDET\][^\n]*$',
        lambda m: f'  # 4. Principal SDET / QA (Kiểm thử độc lập, Nghiệm thu & Kiểm toán Runtime Logs):\n{qa_spec_line}',
        content,
        flags=re.M
    )
    step2_header = (
        '### BƯỚC 2: FAN-OUT (1 ROLE = 1 WORKTREE ĐỊNH DANH DUY NHẤT & GOM NHÓM TERMINAL TABS)\n'
        '- 🔴 **QUY TẮC GOM NHÓM TERMINAL TABS (CẤM ĐẺ THÊM WORKTREE TRÙNG LẶP `-2`, `-3` & TRÁNH XUNG ĐỘT ĐA REPO `selector_ambiguous`):** Mỗi vai trò (`dev-worker`, `devops-worker`, `qa-worker`, `sec-worker`, `bench-worker`, `re-worker`, `ui-worker`) chỉ dùng **1 Worktree định danh duy nhất**. Nếu worktree của role đó đã tồn tại trong repo (`git worktree list`), **BẮT BUỘC truyền `--worktree path:<abs_path>` (không truyền `--name`)** để Orca định vị chính xác tuyệt đối worktree của repo hiện tại và **mở + gom nhóm các Terminal Tab mới ngay bên trong worktree đó** (giống hệt cách `main` worktree gom nhóm các tab của Leader); chỉ tạo `--worktree new-child --name <role>-worker` ở lần chạy đầu tiên khi worktree chưa tồn tại:\n'
    )
    content = re.sub(
        r"### BƯỚC 2:[^\n]*\n- [^\n]*\n",
        lambda m: step2_header,
        content,
        flags=re.M
    )
    step3_full = (
        '### BƯỚC 3: REACTIVE WAIT, THẨM QUYỀN PHÁN QUYẾT CỦA COORDINATOR & KIỂM CHỨNG ZERO-TRUST\n'
        '- 🔴 **BẮT BUỘC lắng nghe đủ 4 tín hiệu (`worker_done,escalation,question,handoff`) và DỪNG GỌI TOOL sau khi chạy (các lần wait kế tiếp BẮT BUỘC thêm `--ack <DELIVERY_ID>` của batch trước để không bị lặp lại batch cũ):**\n'
        '  ```bash\n'
        '  orca orchestration check [--ack <DELIVERY_ID>] --wait --types "worker_done,escalation,question,handoff" --timeout-ms 900000 --json\n'
        '  ```\n'
        '- **Thẩm quyền Ra Quyết định Trung tâm (Lead Coordinator = Sole Technical & Orchestration Decision-Maker):**\n'
        '  - **Worker KHÔNG có quyền tự ra lệnh đổi thiết kế hay sửa Task Spec của nhau!** Worker chỉ có **Quyền Phủ quyết Chuyên môn (Domain Veto)** tại cổng của mình (`escalation`/`BLOCK`/`FAIL`) và trình bằng chứng lên **Lead Coordinator** (bỏ trống `--to` để gửi thẳng vào Run mailbox của Coordinator).\n'
        '  - **Nhận `question` (từ `ask`):** Coordinator ra quyết định và phản hồi qua `orca orchestration reply --id <MSG_ID> --body "[Quyết định của Chief Architect]" --json`.\n'
        '  - **Nhận `handoff` (từ RE/Dev/DevOps/UI):** Coordinator kiểm duyệt bằng chứng (Commit Hash, Clean-Room Spec, Pod/Port/Log sạch) rồi quyết định bàn giao cho role kế tiếp.\n'
        '  - **Nhận `escalation` (từ DevOps/QA/Sec/Bench):** Coordinator phân tích root cause, phân xử xung đột và quyết định điều phối bản vá: nếu worker cần sửa **đang chạy (`live`)** thì gửi `orca orchestration send --to dispatch:<LIVE_DISPATCH_ID> --type dispatch --subject "Coordinator Directive" --body "..." --json`; nếu worker **đã kết thúc (`settled` / đã `worker_done`)** thì tạo Task fix mới (`task-create`) + `worker-start` vào đúng worktree định danh của role đó (`--worktree path:<abs_path>`), rồi điều phối `devops-worker` & `qa-worker` kiểm toán lại.\n'
        '- **Nghiệm thu Zero-Trust:** Đọc `orca orchestration worker-read --dispatch <DISPATCH_ID> --json` và `orca orchestration inbox --json`. '
        '**BÁC BỎ NGAY** nếu vi phạm 1 trong 4 điều:\n'
        '  1. **Báo sạch giả (Fake Clean):** Báo `succeeded` nhưng thiếu `EXIT_CODE=0`, thiếu `git commit` (Commit Hash), '
        '`Tests Run = 0`, thiếu bảng số liệu Benchmark (RPS/EPS, p95/p99), thiếu Evidence từ `rea` (`re-worker`), '
        'hoặc QA/DevOps/Sec/Bench chạy trên nhánh cũ chưa merge commit mới của Dev.\n'
        '  2. **Bỏ sót/Che giấu Lỗi Runtime (Log Blindness/Masking):** DevOps/QA báo `PASS` nhưng thiếu bằng chứng quét '
        '**Full Container/Pod Logs** (từ lúc start trên toàn bộ App + DB + Kafka/Broker sau chu kỳ background job), dùng `--since` ngắn '
        'cắt lỗi, bỏ sót pod phụ trợ (`postgres`, `kafka`), hoặc QA sửa test script nới lỏng assert / '
        'phớt lờ trạng thái lỗi (`ERROR`, `FATAL`, `Exception`, `SQL error`, `SSLHandshakeException`, `health: ERROR`, `close_status: FAILED`) '
        'thay vì gửi `escalation`.\n'
        '  3. **Còn lỗi tồn đọng:** Lỗi compile, test fail, lỗi runtime logs, `SECURITY_VERDICT: BLOCK`, `QA_VERDICT: FAIL`, '
        '`PERF_VERDICT: BOTTLENECK_FOUND`, `RE_VERDICT: BLOCKED_BY_UNKNOWN`, hoặc pod `CrashLoopBackOff`/`ErrImagePull`.\n'
        '  4. **Vượt rào (Boundary Crossing):** QA/Bench/RE tự sửa code app, Dev xóa/skip test cũ, DevOps sửa business logic, hoặc Worker tự ý đổi kiến trúc không qua Coordinator.\n'
        '- **Tự chữa lỗi:** Nếu bị bác bỏ hoặc fail, **cấm tự sửa ở root!** Tạo Task fix mới kèm log lỗi/bottleneck, giao `dev-worker`/`devops-worker` sửa (mở tab mới ngay trong worktree định danh hiện hữu) và bắt buộc chạy lại `qa-worker`/`sec-worker`/`bench-worker` xác nhận đến khi PASS 100%.\n'
        '- ⚠️ **GIỮ TERMINAL WORKER SỐNG Ở BƯỚC 3 BẰNG `worker-retain` (KHÔNG GỌI `worker-release` Ở BƯỚC 3):** Khi một worker đã hoàn tất (`worker_done`), gọi `orca orchestration worker-retain --dispatch <DISPATCH_ID> --json` để thỏa mãn Completion Accounting của Orca đồng thời giữ nguyên terminal worker trên Orca Sidebar (hiển thị **chấm xanh `🟢`**, **icon Agent `✓`** và **chuông thông báo `🔔`** cho tới Bước 4)!\n\n'
    )
    content = re.sub(
        r"### BƯỚC 3:[^\n]*\n[\s\S]*?(?=### BƯỚC 4:)",
        lambda m: step3_full,
        content,
        flags=re.M
    )
    step4_full = (
        '### BƯỚC 4: HUMAN GATE & DỌN DẸP SAU MERGE (CHỐT CHẶN CUỐI)\n'
        '- Chỉ khi đủ bằng chứng thép của Dev (`Commit Hash` + `Build OK`), DevOps (`Pod/Infra Ready`), Security (`PASS`), QA (`PASS 100%`), Benchmark (`PERF_VERDICT: PASS`) và Reverse Eng (`RE_VERDICT: EVIDENCE_COMPLETE` nếu có), mới tạo Gate báo chuông xin phép người dùng (cấm tự ý merge):\n'
        '  ```bash\n'
        '  orca orchestration gate-create --task <FINAL_TASK_ID> --question "Đã kiểm chứng đủ bằng chứng Build, DevOps, Security (PASS), QA (PASS 100%) và Benchmark/RE. Merge code vào nhánh chính chứ sếp?" --options \'["yes","wait"]\' --json\n'
        '  ```\n'
        '- Chỉ khi người dùng phản hồi `"yes"`:\n'
        '  1. Đóng Gate và khôi phục trạng thái `completed` cho `<FINAL_TASK_ID>` (vì `gate-create` chuyển task sang `blocked` và `gate-resolve` trong Orca đưa task về `ready`):\n'
        '     ```bash\n'
        '     orca orchestration gate-resolve --id <GATE_ID> --resolution "yes" --json\n'
        '     orca orchestration task-update --id <FINAL_TASK_ID> --status completed --json\n'
        '     ```\n'
        '  2. Thực hiện `git merge` vào nhánh chính, sau đó chạy `orca orchestration worker-release --dispatch <DISPATCH_ID> --json` để giải phóng retention và đóng các terminal worker.\n'
    )
    content = re.sub(
        r"### BƯỚC 4:[^\n]*\n[\s\S]*$",
        lambda m: step4_full,
        content,
        flags=re.M
    )

    # Đồng bộ luôn các dòng lệnh worker-start trong BƯỚC 2 của .agents/GEMINI.md
    worker_map = {
        "dev-worker": (d_agent, d_model, dev.get("effort")),
        "qa-worker": (q_agent, q_model, qa.get("effort")),
        "sec-worker": (s_agent, s_model, sec.get("effort")),
        "devops-worker": (devops.get("agent", "antigravity"), devops.get("model"), devops.get("effort")),
        "ui-worker": (ui.get("agent", "antigravity"), ui.get("model"), ui.get("effort")),
        "bench-worker": (bench.get("agent", "antigravity"), bench.get("model"), bench.get("effort")),
        "re-worker": (re_spec.get("agent", "antigravity"), re_spec.get("model"), re_spec.get("effort")),
    }
    for w_name, (w_ag, w_mod, w_eff) in worker_map.items():
        if not w_ag or w_ag == "none":
            continue
        # Nâng cấp dòng worker-start cũ sang biểu thức tái sử dụng worktree path:<abs_path>
        old_wt_pat = re.compile(
            rf"(orca orchestration worker-start\s+--task\s+<[^>]+>\s+)(?:--worktree\s+new-child\s+--name\s+{re.escape(w_name)}|\$\(git worktree list[^\n]*--name\s+{re.escape(w_name)}\"\))(?=\s+--agent)",
            re.MULTILINE
        )
        content = old_wt_pat.sub(lambda m, wn=w_name: m.group(1) + _wt_expr(wn), content)
        w_pat = re.compile(
            rf"(--name\s+{re.escape(w_name)}\"?\)?\s+)--agent\s+\S+(?:\s+--model\s+\"[^\"]*\")?(?:\s+--effort\s+\S+)?",
            re.MULTILINE
        )
        formatted_args = _fmt_worker_args_py(w_ag, w_mod, w_eff)
        content = w_pat.sub(lambda m, fa=formatted_args: m.group(1) + fa, content)

    gemini_file.write_text(content, encoding="utf-8")


def _build_discovery_env():
    env = os.environ.copy()
    env["NO_COLOR"] = "1"
    env["TERM"] = "dumb"
    extra_paths = [
        str(Path.home() / ".local" / "bin"),
        str(Path.home() / ".kimi-code" / "bin"),
        str(Path.home() / ".kimi" / "bin"),
        str(Path.home() / ".antigravity" / "antigravity" / "bin"),
        str(Path.home() / ".opencode" / "bin"),
        str(Path.home() / ".cursor" / "bin"),
        "/usr/local/bin",
        "/opt/homebrew/bin",
    ]
    curr_path = env.get("PATH", "")
    for p in reversed(extra_paths):
        if p not in curr_path:
            curr_path = f"{p}:{curr_path}"
    env["PATH"] = curr_path
    return env

def _find_cli_binary(names, env):
    path_str = env.get("PATH", "")
    for name in names:
        found = shutil.which(name, path=path_str)
        if found:
            return found
    return None

def _strip_ansi_and_spinners(line: str) -> str:
    line = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", line)
    line = re.sub(r"\r", "\n", line)
    line = re.sub(r"^[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏\s]+", "", line)
    return line.strip()

def _extract_baked_effort(model_id: str) -> str:
    m = re.search(r"-(low|medium|high|xhigh|max)$", model_id, re.IGNORECASE)
    return m.group(1).lower() if m else ""

def _load_orca_cached_models(agent: str) -> list:
    models = []
    seen = set()
    orca_profiles = Path.home() / "Library" / "Application Support" / "orca" / "profiles"
    if not orca_profiles.exists():
        return models
    agents_to_check = [agent]
    if agent == "gemini":
        agents_to_check.append("antigravity")
    elif agent == "antigravity":
        agents_to_check.append("gemini")

    for p_dir in orca_profiles.iterdir():
        data_file = p_dir / "orca-data.json"
        if not data_file.exists():
            continue
        try:
            data = json.loads(data_file.read_text(encoding="utf-8", errors="ignore"))
            settings = data.get("settings") or {}
            by_host = settings.get("discoveredModelsByAgentByHost") or {}
            by_agent = settings.get("discoveredModelsByAgent") or {}
            raw_list = []
            for ag in agents_to_check:
                for host_map in by_host.values():
                    if isinstance(host_map, dict) and isinstance(host_map.get(ag), list):
                        raw_list.extend(host_map[ag])
                if isinstance(by_agent.get(ag), list):
                    raw_list.extend(by_agent[ag])
            for item in raw_list:
                if not isinstance(item, dict):
                    continue
                mid = str(item.get("id") or "").strip()
                if not mid or mid == "default" or mid in seen:
                    continue
                seen.add(mid)
                lbl = str(item.get("label") or mid).strip()
                baked = _extract_baked_effort(mid)
                t_levels = item.get("thinkingLevels") or []
                effs = [str(x.get("id") if isinstance(x, dict) else x) for x in t_levels if x]
                models.append({
                    "id": mid,
                    "label": lbl,
                    "bakedEffort": baked,
                    "efforts": [] if baked else (effs or ["low", "medium", "high"]),
                    "source": "orca-cache"
                })
        except Exception:
            pass
    return models

def discover_models_for_agent(agent: str, refresh: bool = False) -> tuple:
    """
    Trả về (models_list, source_label) bằng cách truy vấn trực tiếp CLI của provider đã chọn.
    Có cache phiên ngắn hạn (120s) tại /tmp/orca-cli-models-cache.json để tránh gọi lại CLI 8 lần liên tiếp trong cùng 1 phiên khởi tạo.
    Mỗi phần tử trong models_list:
      {"id": str, "label": str, "bakedEffort": str, "efforts": list[str], "source": str}
    """
    import subprocess
    import time
    ag = (agent or "").strip().lower()
    cache_file = Path("/tmp/orca-cli-models-cache.json")
    if not refresh and cache_file.exists():
        try:
            c_data = json.loads(cache_file.read_text(encoding="utf-8", errors="ignore"))
            entry = c_data.get(ag)
            if isinstance(entry, dict) and (time.time() - entry.get("ts", 0) < 120) and entry.get("models"):
                return entry["models"], entry.get("source", "provider-cli")
        except Exception:
            pass

    env = _build_discovery_env()
    models = []
    seen = set()
    source_label = "provider-cli"

    def add_model(mid: str, label: str = "", efforts=None, src="provider-cli"):
        mid = (mid or "").strip()
        if not mid or mid == "default" or mid in seen:
            return
        seen.add(mid)
        baked = _extract_baked_effort(mid)
        if efforts is None:
            if baked:
                eff_list = []
            elif re.search(r"(opus|sonnet|argon|flash|gemini|o1|o3|gpt-5|r1|k1|k3|glm|thinking|reasoning)", mid, re.I):
                eff_list = ["low", "medium", "high"]
            else:
                eff_list = []
        else:
            eff_list = [] if baked else list(efforts)
        models.append({
            "id": mid,
            "label": (label or mid).strip(),
            "bakedEffort": baked,
            "efforts": eff_list,
            "source": src
        })

    # 1. ANTIGRAVITY / GEMINI (`agy models`)
    if ag in ("antigravity", "gemini"):
        bin_path = _find_cli_binary(["agy", "antigravity"] if ag == "antigravity" else ["agy", "gemini", "antigravity"], env)
        if bin_path:
            try:
                res = subprocess.run([bin_path, "models"], capture_output=True, text=True, env=env, timeout=8)
                raw_out = (res.stdout or "") + "\n" + (res.stderr or "")
                raw_out = re.sub(r"\r", "\n", raw_out)
                for raw_line in raw_out.splitlines():
                    clean = _strip_ansi_and_spinners(raw_line)
                    if not clean or clean.lower().startswith(("loading", "available", "fetching", "id ", "model ")):
                        continue
                    # Format: <id>\t<label> or <id>   <label>
                    m = re.match(r"^([a-zA-Z0-9._-]+)\s{2,}(.+)$", clean) or re.match(r"^([a-zA-Z0-9._-]+)\t+(.+)$", clean)
                    if m:
                        mid, lbl = m.group(1).strip(), m.group(2).strip()
                        if mid.lower() not in ("id", "model", "name"):
                            add_model(mid, lbl, src=f"{Path(bin_path).name} models")
                if models:
                    source_label = f"{Path(bin_path).name} models"
            except Exception:
                pass

    # 2. CLAUDE (`claude -p --input-format stream-json --output-format stream-json --verbose`)
    elif ag == "claude":
        bin_path = _find_cli_binary(["claude"], env)
        if bin_path:
            try:
                proc = subprocess.Popen(
                    [bin_path, "-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose"],
                    stdin=subprocess.PIPE,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    env=env
                )
                req = '{"type":"control_request","request_id":"orca-model-discovery","request":{"subtype":"list_models"}}\n'
                try:
                    out, _ = proc.communicate(input=req, timeout=5)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    out, _ = proc.communicate()
                for line in (out or "").splitlines():
                    line = line.strip()
                    if not line.startswith("{"):
                        continue
                    try:
                        obj = json.loads(line)
                        if obj.get("type") == "control_response":
                            resp = (obj.get("response") or {}).get("response") or {}
                            m_list = resp.get("models") or []
                            for m_obj in m_list:
                                mid = m_obj.get("value") or m_obj.get("id")
                                lbl = m_obj.get("displayName") or m_obj.get("label") or mid
                                desc = m_obj.get("description") or ""
                                full_lbl = f"{lbl} ({desc.splitlines()[0]})" if desc else lbl
                                effs = m_obj.get("supportedEffortLevels") or ["low", "medium", "high"]
                                add_model(mid, full_lbl, efforts=effs, src="claude stream-json list_models")
                    except Exception:
                        pass
                if models:
                    source_label = "claude CLI (list_models)"
            except Exception:
                pass
        # Check ~/.claude/settings.json cho custom/router models
        claude_settings = Path.home() / ".claude" / "settings.json"
        if claude_settings.exists():
            try:
                c_cfg = json.loads(claude_settings.read_text(encoding="utf-8", errors="ignore"))
                c_env = c_cfg.get("env") or {}
                for k in ("ANTHROPIC_MODEL", "ANTHROPIC_DEFAULT_OPUS_MODEL", "ANTHROPIC_DEFAULT_SONNET_MODEL", "ANTHROPIC_DEFAULT_HAIKU_MODEL"):
                    val = c_env.get(k)
                    if val and isinstance(val, str):
                        add_model(val, f"{val} (từ ~/.claude/settings.json {k})", src="~/.claude/settings.json")
            except Exception:
                pass

    # 3. KIMI (`~/.kimi-code/config.toml` & `~/.kimi/config.toml`)
    elif ag == "kimi":
        cfg_paths = [
            Path.home() / ".kimi-code" / "config.toml",
            Path.home() / ".kimi" / "config.toml"
        ]
        for cfg_p in cfg_paths:
            if not cfg_p.exists():
                continue
            try:
                raw_toml = cfg_p.read_text(encoding="utf-8", errors="ignore")
                def_m = re.search(r'^\s*default_model\s*=\s*"([^"]+)"', raw_toml, re.M)
                default_id = def_m.group(1).strip() if def_m else ""
                sec_pattern = re.compile(r'^\[models\.(?:"([^"]+)"|([A-Za-z0-9_.-]+))\]\s*$([\s\S]*?)(?=^\[|\Z)', re.M)
                parsed_entries = []
                for sm in sec_pattern.finditer(raw_toml):
                    m_key = (sm.group(1) or sm.group(2) or "").strip()
                    body = sm.group(3) or ""
                    disp_m = re.search(r'^\s*model\s*=\s*"([^"]+)"', body, re.M)
                    disp = disp_m.group(1).strip() if disp_m else m_key
                    has_think = "thinking" in body.lower() or "k3" in m_key.lower() or "k1" in m_key.lower()
                    effs = ["low", "medium", "high"] if has_think else []
                    lbl = f"{disp}{' [default]' if m_key == default_id else ''}"
                    parsed_entries.append((0 if m_key == default_id else 1, m_key, lbl, effs))
                parsed_entries.sort(key=lambda x: x[0])
                for _, m_key, lbl, effs in parsed_entries:
                    add_model(m_key, lbl, efforts=effs, src=f"kimi ({cfg_p.parent.name}/config.toml)")
                if default_id and default_id not in seen:
                    add_model(default_id, f"{default_id} [default]", efforts=["low", "medium", "high"], src=f"kimi ({cfg_p.parent.name}/config.toml)")
                if models:
                    source_label = f"kimi CLI ({cfg_p.parent.name}/config.toml)"
            except Exception:
                pass

    # 4. CODEX (`codex debug models`)
    elif ag == "codex":
        bin_path = _find_cli_binary(["codex"], env)
        if bin_path:
            try:
                res = subprocess.run([bin_path, "debug", "models"], capture_output=True, text=True, env=env, timeout=6)
                obj = json.loads(res.stdout or "{}")
                for item in (obj.get("models") or []):
                    slug = item.get("slug")
                    disp = item.get("display_name") or slug
                    r_levels = item.get("supported_reasoning_levels") or []
                    effs = [x.get("effort") for x in r_levels if isinstance(x, dict) and x.get("effort")]
                    add_model(slug, disp, efforts=effs or ["low", "medium", "high"], src="codex debug models")
                if models:
                    source_label = "codex debug models"
            except Exception:
                pass

    # 5. CURSOR (`cursor-agent --list-models`)
    elif ag == "cursor":
        bin_path = _find_cli_binary(["cursor-agent"], env)
        if bin_path:
            try:
                res = subprocess.run([bin_path, "--list-models"], capture_output=True, text=True, env=env, timeout=6)
                for line in (res.stdout or "").splitlines():
                    m = re.match(r"^([^\s]+)\s+-\s+(.+)$", line.strip())
                    if m:
                        add_model(m.group(1), m.group(2), src="cursor-agent --list-models")
                if models:
                    source_label = "cursor-agent --list-models"
            except Exception:
                pass

    # 6. OPENCODE / OPENCODE2 (`opencode models`)
    elif ag in ("opencode", "opencode2"):
        bin_path = _find_cli_binary([ag, "opencode"], env)
        if bin_path:
            try:
                res = subprocess.run([bin_path, "models"], capture_output=True, text=True, env=env, timeout=6)
                for line in (res.stdout or "").splitlines():
                    clean = _strip_ansi_and_spinners(line)
                    if clean and " " not in clean and not clean.lower().startswith("available"):
                        add_model(clean, clean, src=f"{Path(bin_path).name} models")
                if models:
                    source_label = f"{Path(bin_path).name} models"
            except Exception:
                pass

    # 7. OTHER DYNAMIC PROVIDERS (pi, omp, jcode, grok, copilot, aider, goose)
    else:
        cmd_map = {
            "pi": (["pi"], ["--list-models"]),
            "omp": (["omp"], ["models"]),
            "jcode": (["jcode"], ["--no-update", "--quiet", "model", "list"]),
            "grok": (["grok"], ["models"]),
            "aider": (["aider"], ["--list-models", ""]),
        }
        if ag in cmd_map:
            bins, args_list = cmd_map[ag]
            bin_path = _find_cli_binary(bins, env)
            if bin_path:
                try:
                    res = subprocess.run([bin_path] + args_list, capture_output=True, text=True, env=env, timeout=6)
                    for line in (res.stdout or "").splitlines():
                        clean = _strip_ansi_and_spinners(line)
                        if clean and not clean.endswith(":"):
                            parts = clean.split()
                            if parts and ("/" in parts[0] or "-" in parts[0]):
                                add_model(parts[0].lstrip("*- "), clean, src=f"{ag} CLI")
                    if models:
                        source_label = f"{ag} CLI"
                except Exception:
                    pass

    # 8. Merge thêm từ Orca Local Cache (nếu có)
    for cached in _load_orca_cached_models(ag):
        if cached["id"] not in seen:
            seen.add(cached["id"])
            models.append(cached)
            if source_label == "provider-cli":
                source_label = "Orca ADE Cache"

    # Lưu cache phiên 120s
    if models:
        try:
            c_data = {}
            if cache_file.exists():
                c_data = json.loads(cache_file.read_text(encoding="utf-8", errors="ignore"))
            c_data[ag] = {"ts": time.time(), "source": source_label, "models": models}
            cache_file.write_text(json.dumps(c_data, ensure_ascii=False), encoding="utf-8")
        except Exception:
            pass

    return models, source_label


ROLE_TIER_MAP = {
    "coordinator": ("tier1", "high"),
    "developer": ("tier3", "high"),
    "qa": ("tier3", "medium"),
    "security": ("tier2", "high"),
    "prReviewer": ("tier2", "high"),
    "issueResolver": ("tier2", "high"),
    "uiSpecialist": ("tier3", "medium"),
    "devopsSpecialist": ("tier3", "high"),
    "benchSpecialist": ("tier3", "high"),
    "reSpecialist": ("tier2", "high"),
}

def recommend_model_index(models: list, role_tier: str = "tier2", target_effort: str = "high") -> int:
    """
    Chọn vị trí model (1-based) tối ưu nhất trong danh sách động theo kiến trúc Kim Tự Tháp (5% / 15% / 80%):
      - tier1 (Lead Coordinator): ưu tiên Opus + High (hoặc model suy luận kiến trúc đỉnh nhất)
      - tier2 (Security, PR Reviewer, Issue Resolver): ưu tiên Gemini 4 Argon High / Sonnet High / O3
      - tier3 (Full-Stack Dev, QA, UI, DevOps): ưu tiên Gemini 3.8 Flash (High cho Dev/DevOps, Medium cho QA/UI) / Kimi K3
    """
    if not models:
        return 1
    eff = (target_effort or "high").lower()

    def score_model(m: dict) -> int:
        mid = m["id"].lower()
        lbl = m["label"].lower()
        baked = (m.get("bakedEffort") or "").lower()
        effs = [e.lower() for e in (m.get("efforts") or [])]
        s = 0
        if role_tier == "tier1":
            if "opus" in mid or "opus" in lbl:
                s += 100
            elif "argon" in mid or "o1" in mid or "gpt-5" in mid or "k3" in mid or "r1" in mid:
                s += 70
            elif "sonnet" in mid or "fable" in mid:
                s += 50
        elif role_tier == "tier2":
            if "argon" in mid or "argon" in lbl:
                s += 100
            elif "sonnet" in mid or "fable" in mid or "o3" in mid or "k3" in mid:
                s += 85
            elif "opus" in mid:
                s += 60
            elif "flash" in mid:
                s += 40
        else:  # tier3 (80% workload: Dev, QA, UI, DevOps - tối ưu tốc độ & quota)
            if "flash" in mid or "flash" in lbl:
                s += 100
            elif "k3" in mid or "kimi" in mid or "haiku" in mid or "mini" in mid or "sonnet" in mid:
                s += 85
            elif "argon" in mid:
                s += 50
            elif "opus" in mid:
                s += 10

        if baked == eff:
            s += 30
        elif not baked and eff in effs:
            s += 28
        elif baked == "high":
            s += 15
        elif baked == "medium":
            s += 10

        if "settings.json" not in m.get("source", ""):
            s += 5
        return s

    best_idx = 1
    best_score = -1
    for i, m in enumerate(models, 1):
        sc = score_model(m)
        if sc > best_score:
            best_score = sc
            best_idx = i
    return best_idx


def cmd_models(args: list):
    """
    Liệt kê danh sách model động từ Provider CLI của agent.
    Dùng: orca-team models <agent> [--json|--tsv] [--role <role>] [--tier tier1|tier2|tier3] [--effort low|medium|high] [--refresh]
    """
    agent = "antigravity"
    as_json = False
    as_tsv = False
    refresh = False
    role_tier = "tier2"
    target_effort = "high"

    idx = 0
    while idx < len(args):
        a = args[idx]
        if a == "--json":
            as_json = True
            idx += 1
        elif a == "--tsv":
            as_tsv = True
            idx += 1
        elif a == "--refresh":
            refresh = True
            idx += 1
        elif a == "--tier" and idx + 1 < len(args):
            role_tier = args[idx + 1]
            idx += 2
        elif a == "--effort" and idx + 1 < len(args):
            target_effort = args[idx + 1]
            idx += 2
        elif a == "--role" and idx + 1 < len(args):
            r_key = ROLE_ALIASES.get(args[idx + 1].lower(), args[idx + 1])
            role_tier, target_effort = ROLE_TIER_MAP.get(r_key, ("tier2", "high"))
            idx += 2
        elif not a.startswith("-"):
            agent = a.lower()
            idx += 1
        else:
            idx += 1

    models, source_label = discover_models_for_agent(agent, refresh=refresh)
    rec_idx = recommend_model_index(models, role_tier, target_effort)

    if as_json:
        print(json.dumps({
            "agent": agent,
            "source": source_label,
            "recommendedIndex": rec_idx,
            "models": models
        }, ensure_ascii=False, indent=2))
        return

    if as_tsv:
        # Dạng TSV gọn nhẹ cho shell script (orca-project-init):
        # Dòng 1: META\t<source_label>\t<rec_idx>
        # Các dòng sau: MODEL\t<id>\t<label>\t<bakedEffort>\t<efforts_csv>
        print(f"META\t{source_label}\t{rec_idx}")
        for m in models:
            eff_csv = ",".join(m.get("efforts") or [])
            print(f"MODEL\t{m['id']}\t{m['label']}\t{m.get('bakedEffort', '')}\t{eff_csv}")
        return

    print(f"\n🔍 Danh sách Model truy vấn động cho agent '{agent}' (Nguồn: {source_label}):")
    if not models:
        print(f"   ⚠️ Không tìm thấy CLI hoặc danh sách model động cho '{agent}'.")
        return
    for i, m in enumerate(models, 1):
        rec_tag = " ⭐ (khuyến nghị)" if i == rec_idx else ""
        eff_info = f" [effort tích hợp: {m['bakedEffort']}]" if m.get("bakedEffort") else (
            f" [efforts: {', '.join(m['efforts'])}]" if m.get("efforts") else ""
        )
        lbl_str = f" — {m['label']}" if m["label"] != m["id"] else ""
        print(f"  {i:>2}) {m['id']:<28}{lbl_str}{eff_info}{rec_tag}")
    print("")

def read_terminal_key(fd: int) -> str:
    """Đọc 1 phím hoặc escape sequence từ terminal raw mode."""
    ch = sys.stdin.read(1)
    if ch == '\x1b':
        r, _, _ = select.select([sys.stdin], [], [], 0.05)
        if r:
            ch2 = sys.stdin.read(1)
            if ch2 == '[':
                r2, _, _ = select.select([sys.stdin], [], [], 0.05)
                if r2:
                    ch3 = sys.stdin.read(1)
                    if ch3 in ('A', 'B', 'C', 'D', 'H', 'F'):
                        return f'\x1b[{ch3}'
                    elif ch3 in ('1', '2', '3', '4', '5', '6', '7', '8'):
                        r3, _, _ = select.select([sys.stdin], [], [], 0.05)
                        if r3:
                            ch4 = sys.stdin.read(1)
                            return f'\x1b[{ch3}{ch4}'
                    return f'\x1b[{ch3}'
                return '\x1b['
            elif ch2 == 'O':
                r2, _, _ = select.select([sys.stdin], [], [], 0.05)
                if r2:
                    ch3 = sys.stdin.read(1)
                    return f'\x1bO{ch3}'
                return '\x1bO'
            return '\x1b' + ch2
        return '\x1b'
    return ch

def interactive_select(
    title: str,
    items: list,
    default_idx: int = 0,
    hint: str = "Dùng phím ↑/↓ hoặc j/k để di chuyển con trỏ, Enter để chọn",
    max_visible: int = 14
) -> tuple:
    """
    Menu điều hướng bằng con trỏ / phím mũi tên (Arrow Keys Interactive TUI).
    Trả về (selected_index, selected_item_str).
    Nếu không phải môi trường TTY tương tác, trả về giá trị mặc định.
    """
    if not items:
        return -1, ""

    current_idx = max(0, min(default_idx, len(items) - 1))

    # Kiểm tra stdin / stderr tương tác
    if not (sys.stdin.isatty() and sys.stderr.isatty()):
        return current_idx, items[current_idx]

    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)

    try:
        t_rows = shutil.get_terminal_size().lines
        eff_max = max(5, min(max_visible, t_rows - 6))
    except Exception:
        eff_max = max_visible

    def render_menu(start_i: int, cur_i: int) -> int:
        lines_count = 0
        end_i = min(start_i + eff_max, len(items))
        if start_i > 0:
            sys.stderr.write("     \033[90m▲  (...còn phía trên)\033[0m\r\n")
            lines_count += 1
        for i in range(start_i, end_i):
            it = items[i]
            prefix = f"{i+1:>2})"
            if i == cur_i:
                sys.stderr.write(f"\033[1;36m  ❯ {prefix} {it}\033[0m\r\n")
            else:
                sys.stderr.write(f"    {prefix} {it}\r\n")
            lines_count += 1
        if end_i < len(items):
            sys.stderr.write("     \033[90m▼  (...còn phía dưới)\033[0m\r\n")
            lines_count += 1
        sys.stderr.flush()
        return lines_count

    # Ẩn con trỏ terminal trong lúc tương tác
    sys.stderr.write("\033[?25l")
    sys.stderr.write(f"\r\n\033[1m{title}\033[0m\r\n")
    sys.stderr.write(f"\033[90m({hint})\033[0m\r\n")
    sys.stderr.flush()

    start_idx = 0
    if current_idx >= eff_max:
        start_idx = current_idx - eff_max + 1

    last_rendered_lines = render_menu(start_idx, current_idx)

    try:
        tty.setraw(fd)
        while True:
            k = read_terminal_key(fd)
            if k in ('\x1b[A', '\x1bOA', 'k', 'K'):  # Mũi tên Lên / k
                current_idx = (current_idx - 1) % len(items)
            elif k in ('\x1b[B', '\x1bOB', 'j', 'J'):  # Mũi tên Xuống / j
                current_idx = (current_idx + 1) % len(items)
            elif k in ('\x1b[H', '\x1b[1~', '\x1bOH', 'g'):  # Home
                current_idx = 0
            elif k in ('\x1b[F', '\x1b[4~', '\x1bOF', 'G'):  # End
                current_idx = len(items) - 1
            elif k == '\x1b[5~':  # PageUp
                current_idx = max(0, current_idx - eff_max)
            elif k == '\x1b[6~':  # PageDown
                current_idx = min(len(items) - 1, current_idx + eff_max)
            elif k in ('\r', '\n', ' '):  # Enter hoặc Space để xác nhận
                break
            elif k == '\x03':  # Ctrl+C
                raise KeyboardInterrupt
            elif k in ('q', 'Q', '\x1b'):  # Esc / q
                break
            elif k.isdigit() and 1 <= int(k) <= len(items):  # Phím tắt số nhanh
                current_idx = int(k) - 1
                break

            # Điều chỉnh cửa sổ cuộn
            if current_idx < start_idx:
                start_idx = current_idx
            elif current_idx >= start_idx + eff_max:
                start_idx = current_idx - eff_max + 1

            # Xóa các dòng menu cũ và vẽ lại vị trí con trỏ mới
            sys.stderr.write(f"\033[{last_rendered_lines}A")
            last_rendered_lines = render_menu(start_idx, current_idx)

    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        # Xóa khối menu vừa hiển thị để giữ màn hình gọn đẹp
        sys.stderr.write(f"\033[{last_rendered_lines}A\033[0J")
        # Hiện lại con trỏ terminal
        sys.stderr.write("\033[?25h")
        sys.stderr.flush()

    selected_val = items[current_idx]
    clean_val = re.sub(r"\s*⭐.*$", "", selected_val).strip()
    sys.stderr.write(f"   ➔ Đã chọn: \033[1;32m{clean_val}\033[0m\r\n")
    sys.stderr.flush()
    return current_idx, selected_val

def cmd_select(args: list):
    """
    Menu con trỏ chọn tương tác cho shell script và CLI.
    Dùng: orca-team select --title "..." [--options item1 item2 ...] [--default-idx 0] [--return-idx]
    """
    title = "Chọn một mục:"
    items = []
    default_idx = 0
    return_idx = False

    idx = 0
    while idx < len(args):
        a = args[idx]
        if a == "--title" and idx + 1 < len(args):
            title = args[idx + 1]
            idx += 2
        elif a in ("--default-idx", "--default") and idx + 1 < len(args):
            try:
                default_idx = int(args[idx + 1])
            except ValueError:
                pass
            idx += 2
        elif a in ("--return-idx", "--index"):
            return_idx = True
            idx += 1
        elif a == "--options-json" and idx + 1 < len(args):
            try:
                items = json.loads(args[idx + 1])
            except Exception:
                pass
            idx += 2
        elif a in ("--options", "--items"):
            idx += 1
            while idx < len(args) and not args[idx].startswith("--"):
                items.append(args[idx])
                idx += 1
        elif a in ("--option", "--item") and idx + 1 < len(args):
            items.append(args[idx + 1])
            idx += 2
        else:
            idx += 1

    if not items and not sys.stdin.isatty():
        lines = [l.strip() for l in sys.stdin.readlines() if l.strip()]
        if lines:
            items = lines

    if not items:
        return

    try:
        chosen_i, chosen_val = interactive_select(title, items, default_idx=default_idx)
        if return_idx:
            # 1-based index cho zsh/bash
            print(chosen_i + 1)
        else:
            print(chosen_val)
    except KeyboardInterrupt:
        sys.stderr.write("\r\nĐã hủy.\r\n")
        sys.exit(130)


def cmd_status(root: Path, config: dict):
    if not config:
        print(f"⚠️ Không tìm thấy cấu hình orca-team.json trong '{root}'.")
        print("👉 Hãy khởi tạo trước bằng: orca-project-init")
        sys.exit(1)

    print("\n╔═════════════════════════════════════════════════════════════════════════════════════════╗")
    print("║                🐋  ORCA MULTI-AGENT TEAM TOPOLOGY & MODEL CONFIGURATION                ║")
    print("╚═════════════════════════════════════════════════════════════════════════════════════════╝")
    print(f"📍 Dự án: {root}")
    print(f"🌐 Host thực thi: {config.get('executionHost', 'local')}\n")

    print(f"{'VAI TRÒ (ROLE)':<24} | {'AGENT':<12} | {'MODEL':<26} | {'EFFORT':<8} | {'SONG SONG'}")
    print("-" * 89)

    coord = config.get("coordinator", {})
    c_agent = coord.get("agent", "claude")
    c_model = coord.get("model") or "(default)"
    c_effort = coord.get("effort") or "-"
    print(f"{'1. Lead Coordinator':<24} | {c_agent:<12} | {c_model:<26} | {c_effort:<8} | 1")

    roles = config.get("roles", {})
    role_order = [
        ("developer", "2. Full-Stack Devs"),
        ("qa", "3. QA & Testers"),
        ("security", "4. Security & Bug"),
        ("prReviewer", "5. PR Reviewer"),
        ("issueResolver", "6. Issue Resolver"),
        ("uiSpecialist", "7. UI/UX Specialist"),
        ("devopsSpecialist", "8. DevOps Infra"),
        ("benchSpecialist", "9. Bench & Perf"),
        ("reSpecialist", "10. Reverse Eng (REA)")
    ]

    for key, label in role_order:
        data = roles.get(key, {})
        is_opt = key in ("uiSpecialist", "devopsSpecialist", "benchSpecialist", "reSpecialist")
        enabled = _is_role_enabled(data, is_optional=is_opt)
        if not enabled:
            print(f"{label:<24} | {'[ĐÃ TẮT]':<12} | {'-':<26} | {'-':<8} | -")
            continue
        agent = data.get("agent", "kimi")
        model = data.get("model") or "(default)"
        effort = data.get("effort") or "-"
        conc = str(data.get("concurrency", "On-demand"))
        print(f"{label:<24} | {agent:<12} | {model:<26} | {effort:<8} | {conc}")

    print("-" * 89)
    print("💡 Xem model từ CLI của provider: orca-team models <agent>")
    print("💡 Thay đổi cấu hình role:        orca-team set <role> [--agent <id>] [--model <model_id>] [--effort <low|med|high>]\n")

def cmd_set(root: Path, config: dict, args: list):
    if not config:
        print(f"❌ Không tìm thấy orca-team.json trong '{root}'.", file=sys.stderr)
        sys.exit(1)

    if not args:
        print("❌ Thiếu vai trò cần cấu hình. Dùng: orca-team set <role> [options]", file=sys.stderr)
        print("👉 Các role hợp lệ: coord, dev, qa, sec, pr, issue, ui, devops, bench, re", file=sys.stderr)
        sys.exit(1)

    role_raw = args[0].lower()
    role_key = ROLE_ALIASES.get(role_raw)
    if not role_key:
        print(f"❌ Vai trò không hợp lệ: '{role_raw}'.", file=sys.stderr)
        print(f"👉 Hợp lệ: {', '.join(sorted(set(ROLE_ALIASES.keys())))}", file=sys.stderr)
        sys.exit(1)

    # Parse options
    new_agent = None
    new_model = None
    new_effort = None
    new_concurrency = None
    toggle_enable = None

    idx = 1
    while idx < len(args):
        opt = args[idx]
        if opt == "--agent" and idx + 1 < len(args):
            new_agent = args[idx + 1]
            idx += 2
        elif opt == "--model" and idx + 1 < len(args):
            new_model = args[idx + 1]
            idx += 2
        elif opt == "--effort" and idx + 1 < len(args):
            new_effort = args[idx + 1]
            idx += 2
        elif opt == "--concurrency" and idx + 1 < len(args):
            new_concurrency = int(args[idx + 1])
            idx += 2
        elif opt == "--enable":
            toggle_enable = True
            idx += 1
        elif opt == "--disable":
            toggle_enable = False
            idx += 1
        elif opt == "--reset-model":
            new_model = ""
            idx += 1
        elif opt == "--reset-effort":
            new_effort = ""
            idx += 1
        elif opt in ("--sync", "-y", "--yes"):
            sync_gemini_directive(root, config)
            print("📁 Đã đồng bộ lại '.agents/GEMINI.md' từ 'orca-team.json'.")
            return
        else:
            print(f"⚠️ Cảnh báo: Tùy chọn không nhận diện: {opt}", file=sys.stderr)
            idx += 1

    # Interactive prompt if no flags provided
    if new_agent is None and new_model is None and new_effort is None and new_concurrency is None and toggle_enable is None:
        role_label = ROLE_LABELS.get(role_key, role_key)
        print(f"\n⚙️  Cấu hình tương tác cho vai trò: {role_label}")
        current = config.get("coordinator") if role_key == "coordinator" else config.get("roles", {}).get(role_key, {})
        raw_curr_agent = current.get("agent")
        curr_agent = raw_curr_agent if (raw_curr_agent and raw_curr_agent != "none") else (config.get("coordinator", {}).get("agent") or "antigravity")
        curr_model = current.get("model") or "mặc định"
        curr_effort = current.get("effort") or "-"
        if current.get("enabled") is False:
            toggle_enable = True
            print(f"   Hiện tại: [ĐÃ TẮT] ➔ Sẽ tự động kích hoạt sau khi chọn cấu hình")
        else:
            print(f"   Hiện tại: Agent={curr_agent} | Model={curr_model} | Effort={curr_effort}")

        agent_options = [ag + (" (hiện tại)" if ag == curr_agent else "") for ag in KNOWN_AGENTS]
        def_agent_idx = KNOWN_AGENTS.index(curr_agent) if curr_agent in KNOWN_AGENTS else 0
        ag_i, _ = interactive_select(
            f"👉 Chọn Agent cho vai trò [{role_label}]:",
            agent_options,
            default_idx=def_agent_idx
        )
        target_agent = KNOWN_AGENTS[ag_i]
        if target_agent != raw_curr_agent:
            new_agent = target_agent

        # Truy vấn động danh sách model từ CLI của provider target_agent
        role_tier, def_eff = ROLE_TIER_MAP.get(role_key, ("tier2", "high"))
        print(f"   ⏳ Đang truy vấn danh sách model từ CLI của '{target_agent}'...")
        models, src_label = discover_models_for_agent(target_agent)
        if models:
            rec_idx = recommend_model_index(models, role_tier, def_eff)
            model_menu = []
            for i, m in enumerate(models, 1):
                rec_str = f" ⭐ (khuyến nghị cho {role_label})" if i == rec_idx else ""
                lbl_str = f" — {m['label']}" if m["label"] != m["id"] else ""
                eff_str = f" [{m['bakedEffort']}]" if m.get("bakedEffort") else ""
                model_menu.append(f"{m['id']}{lbl_str}{eff_str}{rec_str}")
            model_menu.append("Nhập model ID tùy chỉnh...")
            model_menu.append(f"Giữ nguyên ({curr_model})")
            model_menu.append("Bỏ chọn model (mặc định Orca ADE)")

            def_m_idx = rec_idx - 1
            for idx_chk, m in enumerate(models):
                if m["id"] == curr_model:
                    def_m_idx = idx_chk
                    break

            m_i, _ = interactive_select(
                f"👉 Chọn Model cho agent '{target_agent}' ({role_label}) — Nguồn: {src_label}:",
                model_menu,
                default_idx=def_m_idx
            )
            if m_i < len(models):
                chosen = models[m_i]
                new_model = chosen["id"]
                if chosen.get("bakedEffort"):
                    new_effort = chosen["bakedEffort"]
            elif m_i == len(models):  # Nhập tùy chỉnh
                c_in = input("   Nhập model ID tùy chỉnh: ").strip()
                if c_in:
                    new_model = c_in
            elif m_i == len(models) + 1:  # Giữ nguyên
                pass
            else:  # Bỏ chọn model
                new_model = ""
        else:
            model_input = input(f"   Nhập model ID mới (Enter = giữ nguyên, 'none' = bỏ chọn model): ").strip()
            if model_input.lower() == "none":
                new_model = ""
            elif model_input:
                new_model = model_input

        # Nếu model đã chọn chưa tích hợp sẵn effort trong ID và agent/model hỗ trợ --effort thì mới hỏi tiếp effort
        final_model_id = new_model if new_model is not None else (current.get("model") or "")
        baked_eff = _extract_baked_effort(final_model_id) if final_model_id else ""
        if not _supports_effort_py(target_agent, final_model_id):
            new_effort = ""
            print(f"   ➔ Agent '{target_agent}' / model '{final_model_id or 'default'}' không dùng cờ --effort riêng (tự động đặt effort = -)")
        elif baked_eff:
            new_effort = baked_eff
            print(f"   ➔ Reasoning Effort tự động theo model: {new_effort}")
        else:
            effort_choices = ["high (khuyến nghị suy luận cao)", "medium", "low", "none (tắt reasoning)"]
            eff_def_idx = 0 if def_eff == "high" else (1 if def_eff == "medium" else 2)
            eff_i, _ = interactive_select(
                f"👉 Chọn Reasoning Effort cho model '{final_model_id or 'mặc định'}':",
                effort_choices,
                default_idx=eff_def_idx
            )
            if eff_i == 0:
                new_effort = "high"
            elif eff_i == 1:
                new_effort = "medium"
            elif eff_i == 2:
                new_effort = "low"
            else:
                new_effort = ""


    # Apply changes
    if role_key == "coordinator":
        target = config.setdefault("coordinator", {})
    else:
        target = config.setdefault("roles", {}).setdefault(role_key, {})

    changes = []
    if new_agent:
        old_agent = target.get("agent")
        target["agent"] = new_agent
        changes.append(f"Agent: {old_agent} ➔ {new_agent}")

    if new_model is not None:
        old_model = target.get("model") or "(default)"
        val = None if new_model == "" else new_model
        target["model"] = val
        changes.append(f"Model: {old_model} ➔ {val or '(default)'}")

    if new_effort is None and (new_agent or new_model is not None):
        eff_ag = target.get("agent") or ""
        eff_mod = target.get("model") or ""
        if not _supports_effort_py(eff_ag, eff_mod) and target.get("effort"):
            new_effort = ""

    if new_effort is not None:
        old_eff = target.get("effort") or "-"
        val = None if new_effort == "" else new_effort
        target["effort"] = val
        changes.append(f"Effort: {old_eff} ➔ {val or '-'}")

    if new_concurrency:
        old_c = target.get("concurrency")
        target["concurrency"] = new_concurrency
        changes.append(f"Concurrency: {old_c} ➔ {new_concurrency}")

    if toggle_enable is not None:
        old_en = target.get("enabled", True)
        target["enabled"] = toggle_enable
        changes.append(f"Enabled: {old_en} ➔ {toggle_enable}")
        if toggle_enable and not new_agent and target.get("agent") in (None, "", "none"):
            fallback_role = config.get("roles", {}).get("security" if role_key == "reSpecialist" else "developer", {})
            fb_agent = fallback_role.get("agent") or config.get("coordinator", {}).get("agent") or "antigravity"
            if fb_agent == "none":
                fb_agent = "antigravity"
            target["agent"] = fb_agent
            changes.append(f"Agent: none ➔ {fb_agent} (tự động kế thừa khi bật role)")
            if new_model is None and not target.get("model") and fallback_role.get("model"):
                target["model"] = fallback_role.get("model")
                changes.append(f"Model: (default) ➔ {target['model']}")
            if new_effort is None and not target.get("effort"):
                target["effort"] = "medium" if role_key == "uiSpecialist" else "high"
                changes.append(f"Effort: - ➔ {target['effort']}")
    elif role_key in ("uiSpecialist", "devopsSpecialist", "benchSpecialist", "reSpecialist"):
        if (new_agent or new_model is not None) and target.get("enabled") is False:
            target["enabled"] = True
            changes.append("Enabled: False ➔ True (tự động kích hoạt khi gán Agent/Model)")

    if not changes:
        sync_gemini_directive(root, config)
        print("ℹ️ Không có thay đổi nào được yêu cầu (đã đồng bộ lại '.agents/GEMINI.md').")
        return

    if role_key == "reSpecialist" and target.get("enabled", True):
        if not target.get("utilities"):
            target["utilities"] = ["git-worktrees", "orca-skills-registry", "reverse-engineer-anything"]
        ensure_rea_skill(target.get("agent") or "antigravity")
        changes.append("Skill: Đã đồng bộ 'reverse-engineer-anything' (morluto/rea)")

    if role_key == "coordinator" and new_agent:
        gemini_md = root / ".agents" / "GEMINI.md"
        root_gemini_md = root / "GEMINI.md"
        claude_md = root / "CLAUDE.md"
        agents_md = root / "AGENTS.md"
        c_low = new_agent.lower()
        if c_low == "claude":
            if not claude_md.exists() and gemini_md.exists():
                try: os.symlink(".agents/GEMINI.md", claude_md)
                except: pass
            if agents_md.is_symlink(): agents_md.unlink(missing_ok=True)
            changes.append("Leader Discovery Link: Kích hoạt CLAUDE.md")
        elif c_low in ["codex", "cursor", "opencode"]:
            if not agents_md.exists() and gemini_md.exists():
                try: os.symlink(".agents/GEMINI.md", agents_md)
                except: pass
            if claude_md.is_symlink(): claude_md.unlink(missing_ok=True)
            changes.append(f"Leader Discovery Link: Kích hoạt AGENTS.md ({new_agent})")
        elif c_low in ["antigravity", "gemini"]:
            if not root_gemini_md.exists() and gemini_md.exists():
                try: os.symlink(".agents/GEMINI.md", root_gemini_md)
                except: pass
            if not agents_md.exists() and gemini_md.exists():
                try: os.symlink(".agents/GEMINI.md", agents_md)
                except: pass
            changes.append("Leader Discovery Link: Kích hoạt GEMINI.md & AGENTS.md ở root (Antigravity)")

    save_config(root, config)
    sync_gemini_directive(root, config)

    print(f"\n✅ Đã cập nhật thành công vai trò [{ROLE_LABELS.get(role_key, role_key)}]:")
    for ch in changes:
        print(f"   • {ch}")
    print("📁 Đã đồng bộ vào 'orca-team.json' và '.agents/GEMINI.md'.\n")

def cmd_link(root: Path, args: list):
    gemini_md = root / ".agents" / "GEMINI.md"
    root_gemini_md = root / "GEMINI.md"
    claude_md = root / "CLAUDE.md"
    agents_md = root / "AGENTS.md"

    mode = args[0] if args else "status"
    if mode in ["all", "--all"]:
        if not root_gemini_md.exists() and gemini_md.exists():
            try: os.symlink(".agents/GEMINI.md", root_gemini_md)
            except: pass
        if not claude_md.exists() and gemini_md.exists():
            try: os.symlink(".agents/GEMINI.md", claude_md)
            except: pass
        if not agents_md.exists() and gemini_md.exists():
            try: os.symlink(".agents/GEMINI.md", agents_md)
            except: pass
        print("🔗 Đã kích hoạt các symlink GEMINI.md, CLAUDE.md và AGENTS.md (sẵn sàng mở bất kỳ AI CLI nào).\n")
    elif mode in ["clean", "--clean"]:
        if root_gemini_md.is_symlink(): root_gemini_md.unlink(missing_ok=True)
        if claude_md.is_symlink(): claude_md.unlink(missing_ok=True)
        if agents_md.is_symlink(): agents_md.unlink(missing_ok=True)
        print("🧹 Đã dọn dẹp các symlink ở root (chỉ giữ .agents/GEMINI.md).\n")
    else:
        print("\n🔍 Trạng thái Discovery Links:")
        print(f"   • .agents/GEMINI.md: {'✅ Tồn tại' if gemini_md.exists() else '❌ Không có'}")
        print(f"   • GEMINI.md (root):  {'🔗 Symlink active' if root_gemini_md.is_symlink() else ('✅ File riêng' if root_gemini_md.exists() else '⚪ Không có')}")
        print(f"   • CLAUDE.md:         {'🔗 Symlink active' if claude_md.is_symlink() else ('✅ File riêng' if claude_md.exists() else '⚪ Không có')}")
        print(f"   • AGENTS.md:         {'🔗 Symlink active' if agents_md.is_symlink() else ('✅ File riêng' if agents_md.exists() else '⚪ Không có')}")
        print("\n💡 Tùy chọn:")
        print("   • orca-team link all   : Kích hoạt tất cả symlink để mở tự do Antigravity/Claude/Codex")
        print("   • orca-team link clean : Dọn dẹp symlink ở root\n")

def cmd_uninstall_project(root: Path, args: list):
    """Gỡ bỏ toàn bộ cấu hình Orchestrator khỏi project hiện tại hoặc đường dẫn chỉ định."""
    for a in (args or []):
        if not a.startswith("-"):
            cand = Path(a).expanduser().resolve()
            if cand.exists() and cand.is_dir():
                root = cand
                break

    # Bảo vệ: Không bao giờ tự gỡ bỏ chính kho mã nguồn của framework
    if (root / "templates").is_dir() and (root / "package.json").is_file():
        try:
            pkg = json.loads((root / "package.json").read_text(encoding="utf-8"))
            if pkg.get("name") == "orca-multi-agent-orchestrator":
                print("\n🚫 Đây là thư mục gốc của bộ công cụ 'orca-multi-agent-orchestrator'.")
                print("   Không thể tự gỡ bỏ chính kho mã nguồn framework!")
                print("   Để gỡ bỏ các CLI khỏi máy: hãy chạy './uninstall.sh'.\n")
                return
        except Exception:
            pass

    print(f"\n⚠️  [ORCA UNINSTALL PROJECT] Bạn sắp gỡ bỏ cấu hình Multi-Agent Orchestrator khỏi:")
    print(f"   📁 {root}")
    
    force = any(a in args for a in ["-f", "--force", "-y", "--yes"])
    if not force:
        try:
            ans = input("   ❓ Bạn có chắc chắn muốn xóa cấu hình Orchestrator khỏi project này? [y/N]: ")
            if ans.strip().lower() not in ["y", "yes"]:
                print("   🚫 Đã hủy bỏ thao tác gỡ cài đặt.\n")
                return
        except (KeyboardInterrupt, EOFError):
            print("\n   🚫 Đã hủy thao tác.\n")
            return

    deleted = []
    # 1. Xóa tất cả discovery symlinks ở root
    for f in ["GEMINI.md", "CLAUDE.md", "AGENTS.md"]:
        target = root / f
        if target.is_symlink():
            target.unlink(missing_ok=True)
            deleted.append(f"{f} (symlink)")

    # 2. Xóa orca-team.json
    cfg = root / "orca-team.json"
    if cfg.exists():
        cfg.unlink(missing_ok=True)
        deleted.append("orca-team.json")

    # 3. Xóa .agents/GEMINI.md và chỉ xóa thư mục .agents/ nếu rỗng (bảo vệ .agents/skills hoặc .agents/workflows của user)
    agents_dir = root / ".agents"
    if agents_dir.exists() and agents_dir.is_dir():
        gemini_md = agents_dir / "GEMINI.md"
        if gemini_md.exists() or gemini_md.is_symlink():
            gemini_md.unlink(missing_ok=True)
            deleted.append(".agents/GEMINI.md")
        try:
            if not any(agents_dir.iterdir()):
                agents_dir.rmdir()
                deleted.append(".agents/ (thư mục rỗng)")
        except Exception:
            pass

    # 4. Xóa các file/thư mục runtime Orca nếu có
    for r_item in [".orca", ".orca-cache"]:
        rp = root / r_item
        if rp.exists():
            try:
                if rp.is_dir(): shutil.rmtree(rp)
                else: rp.unlink(missing_ok=True)
                deleted.append(f"{r_item}/")
            except Exception:
                pass

    # 5. Dọn dẹp block trong .gitignore nếu có
    gi = root / ".gitignore"
    if gi.exists():
        try:
            lines = gi.read_text(encoding="utf-8").splitlines()
            cleaned_lines = []
            skip = False
            for line in lines:
                if "# Orca Multi-Agent Orchestrator" in line or "# Orca ADE runtime" in line:
                    skip = True
                    continue
                if skip and line.strip() in [".agents/", "GEMINI.md", "AGENTS.md", "CLAUDE.md", "orca-team.json", ".orca/", ".orca-cache/", "*.orca.log", ""]:
                    continue
                else:
                    skip = False
                    cleaned_lines.append(line)
            gi.write_text("\n".join(cleaned_lines) + ("\n" if cleaned_lines else ""), encoding="utf-8")
        except Exception:
            pass

    print("\n🎉 Đã gỡ bỏ thành công toàn bộ cấu hình Orchestrator:")
    for d in deleted:
        print(f"   🗑️  Đã xóa: {d}")
    if not deleted:
        print("   ℹ️ Không có file cấu hình nào cần xóa.")
    print("✨ Dự án đã được khôi phục về trạng thái ban đầu sạch sẽ.\n")

def cmd_get(root: Path, config: dict, args: list):
    if not config:
        print("❌ Không tìm thấy orca-team.json", file=sys.stderr)
        sys.exit(1)
    if not args:
        print("❌ Thiếu role cần lấy thông tin", file=sys.stderr)
        sys.exit(1)

    role_raw = args[0].lower()
    role_key = ROLE_ALIASES.get(role_raw, role_raw)
    target = config.get("coordinator") if role_key == "coordinator" else config.get("roles", {}).get(role_key, {})
    if not target:
        sys.exit(1)

    field = "agent"
    if "--field" in args:
        f_idx = args.index("--field")
        if f_idx + 1 < len(args):
            field = args[f_idx + 1]

    if field == "json":
        print(json.dumps(target))
    elif field == "agent" and target.get("enabled") is False:
        print("none")
    else:
        val = target.get(field)
        if val is not None:
            print(val)
        else:
            sys.exit(1)

def cmd_watchdog(root: Path, args: list = None):
    import subprocess
    args = args or []
    auto_unblock = any(a in args for a in ["--unblock", "--fix", "-y"])

    print("\n🩺 [ORCA AGENT WATCHDOG] Đang quét trạng thái toàn bộ worker...")
    if auto_unblock:
        print("⚡ Chế độ Auto-Unblock: Đang tự động gửi 'y' mở khóa các worker bị kẹt...")

    orca_bin = os.environ.get("ORCA_BIN") or shutil.which("orca") or "/usr/local/bin/orca"
    if not os.path.exists(orca_bin):
        print(f"❌ Không tìm thấy orca CLI tại {orca_bin}", file=sys.stderr)
        return

    try:
        res = subprocess.run([orca_bin, "orchestration", "worker-list", "--terminal-state", "active", "--json"], capture_output=True, text=True, timeout=10)
        if res.returncode != 0:
            try:
                err_data = json.loads(res.stdout)
                msg = err_data.get("error", {}).get("message", "Lỗi kết nối Orca Runtime")
                print(f"⚠️ {msg}")
                print("💡 Hãy đảm bảo Orca đang mở hoặc chạy lệnh trực tiếp trên terminal máy host.\n")
                return
            except Exception:
                print(f"⚠️ Không thể kết nối Orca Runtime (mã lỗi: {res.returncode}).\n")
                return

        data = json.loads(res.stdout)
        res_obj = data.get("result", data) if isinstance(data, dict) else {}
        workers = res_obj.get("workers", []) if isinstance(res_obj, dict) else (data if isinstance(data, list) else [])
        
        if not workers:
            print("✨ Hiện không có worker nào đang chạy ngầm cần xử lý.\n")
            return

        print(f"{'DISPATCH ID':<28} | {'TERMINAL':<14} | {'STATE':<14} | {'GHI CHÚ / TRẠNG THÁI'}")
        print("-" * 82)
        
        hung_count = 0
        for w in workers:
            d_id = str(w.get("dispatchId") or w.get("id") or "-")
            term = str(w.get("terminalHandle") or w.get("agentTerminalHandle") or "-")
            state = str(w.get("terminalState") or w.get("state") or "-")
            
            note = ""
            if d_id != "-":
                try:
                    show_res = subprocess.run([orca_bin, "orchestration", "worker-show", "--dispatch", d_id, "--json"], capture_output=True, text=True, timeout=10)
                    if show_res.returncode == 0:
                        s_data = json.loads(show_res.stdout)
                        s_res = s_data.get("result", s_data) if isinstance(s_data, dict) else {}
                        obs = s_res.get("observation", {})
                        if obs.get("agentWait"):
                            if auto_unblock and term != "-":
                                # An toàn (Fail-Closed): Phân tích màn hình terminal, chỉ duyệt khi an toàn
                                is_safe = False
                                try:
                                    t_read = subprocess.run([orca_bin, "terminal", "read", "--terminal", term, "--limit", "15", "--screen", "--json"], capture_output=True, text=True, timeout=5)
                                    if t_read.returncode == 0:
                                        t_data = json.loads(t_read.stdout)
                                        t_res = t_data.get("result", t_data) if isinstance(t_data, dict) else {}
                                        term_obj = t_res.get("terminal", {}) if isinstance(t_res, dict) else {}
                                        tail_lines = term_obj.get("tail") if isinstance(term_obj, dict) else None
                                        if isinstance(tail_lines, list):
                                            non_empty = [str(line) for line in tail_lines if str(line).strip()]
                                            out_low = "\n".join(non_empty[-12:]).lower()
                                        else:
                                            out_low = str(t_res.get("content") or t_res.get("screen") or t_read.stdout).lower()

                                        deny_list = [
                                            "rm -r", "rm -fr", "rm -rf", "git reset --hard", "git clean", 
                                            "push -f", "push --force", "drop database", "drop table", 
                                            "truncate", "delete from", "kubectl delete", "terraform destroy", 
                                            "chmod -r", "| sh", "| bash", "sudo"
                                        ]
                                        has_danger = any(danger in out_low for danger in deny_list)
                                        has_confirm = any(c in out_low for c in ["[y/n]", "(y/n)", "[y/n", "[y/N]", "[Y/n]", "continue?"])
                                        
                                        if not has_danger and has_confirm:
                                            is_safe = True
                                except Exception:
                                    is_safe = False

                                if is_safe:
                                    send_res = subprocess.run([orca_bin, "terminal", "send", "--terminal", term, "--text", "y", "--enter"], capture_output=True, text=True, timeout=5)
                                    if send_res.returncode == 0:
                                        note = "🔓 ĐÃ TỰ ĐỘNG GỬI [y] MỞ KHÓA"
                                    else:
                                        note = "⚠️ KẸT CÂU HỎI (Mở khóa lỗi)"
                                        hung_count += 1
                                else:
                                    note = "⚠️ CẦN DUYỆT THỦ CÔNG (Lệnh nhạy cảm hoặc không phải [y/n])"
                                    hung_count += 1
                            else:
                                note = "⚠️ ĐANG KẸT CÂU HỎI XÁC NHẬN [Y/N]"
                                hung_count += 1
                except Exception:
                    pass

            if not note:
                if state == "active":
                    note = "🟢 Đang thực thi"
                elif state == "reclaimable":
                    note = "⚪ Đã xong / Sẵn sàng giải phóng"
                elif state == "retained":
                    note = "🟡 Đang giữ để debug"
                else:
                    note = state

            print(f"{d_id:<28} | {term:<14} | {state:<14} | {note}")

        print("-" * 82)
        if hung_count > 0:
            print(f"⚠️ Phát hiện {hung_count} worker đang bị treo chờ input!")
            if not auto_unblock:
                print("👉 Tự động mở khóa các worker an toàn: orca-team watchdog --unblock")
            else:
                print("👉 Các worker còn lại đang chờ duyệt lệnh nhạy cảm. Hãy vào Orca Terminal để duyệt thủ công.")
            print("👉 Để dừng worker cạn token: orca orchestration worker-stop --dispatch <id>\n")
        else:
            print("✅ Toàn bộ worker đều hoạt động trơn tru.\n")
    except Exception as e:
        print(f"⚠️ Lỗi quét worker: {e}\n")

def estimate_tokens(text: str) -> int:
    if not text:
        return 0
    non_ascii = sum(1 for c in text if ord(c) > 127)
    ascii_chars = len(text) - non_ascii
    return max(1, int(round((ascii_chars / 3.8) + (non_ascii / 2.0))))


def _parse_iso_utc(s: str):
    if not s:
        return None
    from datetime import datetime, timezone
    try:
        clean = str(s).strip()
        if clean.endswith("Z"):
            clean = clean[:-1] + "+00:00"
        elif " " in clean and "+" not in clean and "T" not in clean:
            clean = clean.replace(" ", "T") + "+00:00"
        dt = datetime.fromisoformat(clean)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return dt
    except Exception:
        return None


def _fmt_dur(secs: float) -> str:
    secs_i = max(0, int(round(secs)))
    if secs_i >= 3600:
        return f"{secs_i // 3600}h{(secs_i % 3600) // 60:02d}m"
    if secs_i >= 60:
        return f"{secs_i // 60}m{secs_i % 60:02d}s"
    return f"{secs_i}s"


def _fmt_tok(n: int) -> str:
    if n >= 1_000_000:
        return f"{n / 1_000_000:.2f}M"
    if n >= 10_000:
        return f"{n / 1_000:.1f}k"
    return f"{n:,}"


def _analyze_antigravity_transcript(tf_path: Path) -> dict:
    try:
        raw_lines = tf_path.read_text(encoding="utf-8", errors="ignore").splitlines()
        steps = [json.loads(ln) for ln in raw_lines if ln.strip()]
    except Exception:
        return {}
    if not steps:
        return {}

    measured_llm_secs = 0.0
    measured_out_tok = 0
    for i, s in enumerate(steps):
        if s.get("type") == "PLANNER_RESPONSE" and i + 1 < len(steps) and steps[i + 1].get("type") == "GENERIC":
            t_s = _parse_iso_utc(s.get("created_at"))
            t_e = _parse_iso_utc(steps[i + 1].get("created_at"))
            ot = int(s.get("output_tokens") or 0)
            if t_s and t_e:
                dt = max(0.5, (t_e - t_s).total_seconds())
                measured_llm_secs += dt
                measured_out_tok += ot
    avg_rate = (measured_out_tok / measured_llm_secs) if measured_llm_secs > 0 else 50.0

    llm_secs = 0.0
    tool_secs = 0.0
    idle_wait_secs = 0.0
    in_tok = 0
    cache_tok = 0
    out_tok = 0
    peak_ctx = 0
    last_ctx = 0
    turns = 0
    tool_calls = 0
    tool_errors = 0
    last_tool_name = "-"

    for i, s in enumerate(steps):
        if s.get("type") == "PLANNER_RESPONSE":
            turns += 1
            it = int(s.get("input_tokens") or 0)
            ct = int(s.get("cache_read_tokens") or 0)
            ot = int(s.get("output_tokens") or 0)
            in_tok += it
            cache_tok += ct
            out_tok += ot
            last_ctx = it + ct
            if last_ctx > peak_ctx:
                peak_ctx = last_ctx
            tcs = s.get("tool_calls") or []
            tool_calls += len(tcs)
            if tcs and isinstance(tcs[-1], dict):
                last_tool_name = str(tcs[-1].get("name") or "-")

            t_start = _parse_iso_utc(s.get("created_at"))
            if i + 1 < len(steps):
                t_end = _parse_iso_utc(steps[i + 1].get("created_at"))
                if steps[i + 1].get("type") == "GENERIC" and t_start and t_end:
                    dt = max(0.5, (t_end - t_start).total_seconds())
                    llm_secs += dt
                    j = i + 1
                    t_tool_start = t_end
                    t_tool_end = t_end
                    while j < len(steps) and steps[j].get("type") == "GENERIC":
                        c = str(steps[j].get("content") or "")
                        if "exited with code" in c and "exited with code 0" not in c:
                            tool_errors += 1
                        elif steps[j].get("status") == "ERROR":
                            tool_errors += 1
                        m2 = re.search(r"Completed At:\s*([^\n\r]+)", c)
                        if m2:
                            ts2 = _parse_iso_utc(m2.group(1).strip())
                            if ts2 and (not t_tool_end or ts2 > t_tool_end):
                                t_tool_end = ts2
                        j += 1
                    if j < len(steps) and steps[j].get("type") == "PLANNER_RESPONSE":
                        ts_next_p = _parse_iso_utc(steps[j].get("created_at"))
                        if ts_next_p and t_tool_start and ts_next_p > t_tool_start:
                            t_tool_end = ts_next_p
                    if t_tool_start and t_tool_end and t_tool_end > t_tool_start:
                        tool_secs += (t_tool_end - t_tool_start).total_seconds()
                else:
                    est_dt = max(0.8, ot / max(10.0, avg_rate))
                    llm_secs += est_dt
                    if t_start and t_end and (t_end - t_start).total_seconds() > est_dt:
                        idle_wait_secs += (t_end - t_start).total_seconds() - est_dt
            else:
                llm_secs += max(0.8, ot / max(10.0, avg_rate))

    t0 = _parse_iso_utc(steps[0].get("created_at"))
    tN = _parse_iso_utc(steps[-1].get("created_at"))
    wall_secs = max(0.0, (tN - t0).total_seconds()) if (t0 and tN) else 0.0
    active_secs = llm_secs + tool_secs
    from datetime import datetime, timezone
    now_utc = datetime.now(timezone.utc)
    idle_since_last = max(0.0, (now_utc - tN).total_seconds()) if tN else 0.0

    return {
        "transcript_path": str(tf_path),
        "steps": len(steps),
        "turns": turns,
        "tool_calls": tool_calls,
        "tool_errors": tool_errors,
        "in_tok": in_tok,
        "cache_tok": cache_tok,
        "out_tok": out_tok,
        "peak_ctx": peak_ctx,
        "last_ctx": last_ctx,
        "llm_secs": llm_secs,
        "tool_secs": tool_secs,
        "active_secs": active_secs,
        "wall_secs": wall_secs,
        "idle_wait_secs": idle_wait_secs,
        "idle_since_last_secs": idle_since_last,
        "out_tok_s": out_tok / max(1.0, llm_secs),
        "active_tok_s": out_tok / max(1.0, active_secs),
        "prefill_tok_s": (in_tok + cache_tok + out_tok) / max(1.0, llm_secs),
        "cache_hit_pct": (cache_tok / max(1, in_tok + cache_tok)) * 100.0,
        "avg_turn_s": llm_secs / max(1, turns),
        "last_tool": last_tool_name,
        "last_step_at": steps[-1].get("created_at") or "",
    }


def _index_cli_transcripts() -> dict:
    """Scan local CLI session directories and index transcripts by dispatchId, taskId, termHandle, and runId."""
    by_dispatch = {}
    by_task = {}
    by_term = {}
    by_leader_run = {}

    roots = [
        Path.home() / ".gemini" / "antigravity-cli" / "brain",
        Path.home() / ".gemini" / "antigravity" / "brain",
    ]
    for r_dir in roots:
        if not r_dir.is_dir():
            continue
        for cid_dir in r_dir.iterdir():
            if not cid_dir.is_dir():
                continue
            tf = cid_dir / ".system_generated" / "logs" / "transcript.jsonl"
            full_tf = cid_dir / ".system_generated" / "logs" / "transcript_full.jsonl"
            if not tf.exists():
                continue
            src = full_tf if full_tf.exists() else tf
            try:
                with open(src, "r", encoding="utf-8", errors="ignore") as f:
                    first_line = f.readline()
                    is_dispatched_worker = "You are a dispatched worker" in first_line
                    rest_sample = "" if is_dispatched_worker else f.read()
            except Exception:
                continue

            if is_dispatched_worker:
                for cid_match in re.findall(r"ctx_[a-f0-9]+", first_line):
                    by_dispatch[cid_match] = tf
                for tid_match in re.findall(r"task_[a-f0-9]+", first_line):
                    by_task[tid_match] = tf
                for trm_match in re.findall(r"term_[a-f0-9-]+", first_line):
                    by_term[trm_match] = tf
            else:
                combined = first_line + "\n" + rest_sample
                for rid_match in set(re.findall(r"run_[a-f0-9]+", combined)):
                    prev = by_leader_run.get(rid_match)
                    if not prev or ("antigravity-cli" in str(tf) and "antigravity-cli" not in str(prev)):
                        by_leader_run[rid_match] = tf
    return {
        "by_dispatch": by_dispatch,
        "by_task": by_task,
        "by_term": by_term,
        "by_leader_run": by_leader_run,
    }


def _collect_git_diff_stats(wt_path: str, wt_name: str) -> dict:
    res = {"files": 0, "ins": 0, "del": 0, "commits": 0}
    if not wt_path or not os.path.isdir(wt_path):
        return res
    import subprocess
    try:
        head_sha = subprocess.run(["git", "-C", wt_path, "rev-parse", "HEAD"], capture_output=True, text=True, timeout=2).stdout.strip()
        main_sha = subprocess.run(["git", "-C", wt_path, "rev-parse", "main"], capture_output=True, text=True, timeout=2).stdout.strip()
        dev_sha = subprocess.run(["git", "-C", wt_path, "rev-parse", "dev-worker"], capture_output=True, text=True, timeout=2).stdout.strip()
        base_ref = None
        if head_sha and main_sha and head_sha != main_sha:
            if wt_name == "dev-worker" or head_sha != dev_sha:
                base_ref = dev_sha if (wt_name != "dev-worker" and dev_sha and dev_sha != head_sha) else main_sha
        if base_ref:
            c_cnt = subprocess.run(["git", "-C", wt_path, "rev-list", "--count", f"{base_ref}..HEAD"], capture_output=True, text=True, timeout=2).stdout.strip()
            if c_cnt.isdigit():
                res["commits"] = int(c_cnt)
            numstat = subprocess.run(["git", "-C", wt_path, "diff", "--numstat", f"{base_ref}..HEAD"], capture_output=True, text=True, timeout=3)
        else:
            numstat = subprocess.run(["git", "-C", wt_path, "diff", "--numstat", "HEAD"], capture_output=True, text=True, timeout=3)
        if numstat.returncode == 0:
            for ln in numstat.stdout.splitlines():
                parts = ln.strip().split("\t")
                if len(parts) >= 3:
                    res["files"] += 1
                    if parts[0].isdigit():
                        res["ins"] += int(parts[0])
                    if parts[1].isdigit():
                        res["del"] += int(parts[1])
    except Exception:
        pass
    return res


def cmd_monitor(root: Path, config: dict, args: list = None):
    import subprocess
    args = args or []
    verbose = any(a in args for a in ["-v", "--verbose", "--full"])
    auto_fix = any(a in args for a in ["--fix", "-f"])

    print("\n╔══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════╗")
    print("║                   🔬 ORCA ENGINEERING TELEMETRY, SPEED BENCHMARK & TOKEN MONITOR                                     ║")
    print("╚══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════╝")
    print(f"📍 Workspace: {root}")
    if auto_fix:
        print("⚡ Auto-Fix Mode: Enabled")
    print("")

    critical_issues = []
    warning_issues = []
    passed_items = []
    actions_taken = []

    # ─────────────────────────────────────────────────────────────────────────────
    # PHẦN 1: CHỈ DẪN HỆ THỐNG & CONTEXT TIÊU TỐN MỖI LƯỢT (PER-TURN SYSTEM PROMPT)
    # ─────────────────────────────────────────────────────────────────────────────
    print("📋 1. SYSTEM PROMPT & STATIC DIRECTIVE OVERHEAD (PER-TURN BASELINE)")
    print(f"{'FILE / NGUỒN':<26} | {'LOẠI':<12} | {'KÍCH THƯỚC':<12} | {'ƯỚC TÍNH TOKENS':<16} | {'TRẠNG THÁI'}")
    print("-" * 88)

    base_tokens = 0
    target_files = [
        (".agents/GEMINI.md", root / ".agents" / "GEMINI.md"),
        ("CLAUDE.md", root / "CLAUDE.md"),
        ("AGENTS.md", root / "AGENTS.md"),
        ("orca-team.json", root / "orca-team.json"),
        ("plan.md", root / "plan.md"),
    ]

    for rel_name, path in target_files:
        if not path.exists() and not path.is_symlink():
            continue

        is_link = path.is_symlink()
        try:
            raw_text = path.read_text(encoding="utf-8", errors="ignore")
            size_b = len(raw_text.encode("utf-8"))
            tokens = estimate_tokens(raw_text)
        except Exception:
            raw_text = ""
            size_b = 0
            tokens = 0

        if is_link:
            status = "Symlink (0 extra)"
            type_str = "Symlink"
            size_str = f"{size_b} B"
            tokens_str = f"~{tokens} (shared)"
        else:
            type_str = "File thật"
            size_str = f"{size_b/1024:.1f} KB" if size_b > 1024 else f"{size_b} B"
            tokens_str = f"~{tokens} tokens"
            base_tokens += tokens
            if tokens > 5600:
                status = "WARN (>5.6k tok)"
                warning_issues.append(f"File '{rel_name}' nặng ~{tokens} tokens (nạp lại vào context trên mỗi turn).")
            else:
                status = "OK"

        if rel_name in ["CLAUDE.md", "AGENTS.md"] and not is_link and path.exists():
            gemini_p = root / ".agents" / "GEMINI.md"
            if gemini_p.exists():
                status = "DUPLICATE (x2)"
                critical_issues.append(
                    f"File '{rel_name}' là bản sao độc lập thay vì symlink tới '.agents/GEMINI.md' (tốn gấp đôi ~{tokens} tokens/turn)."
                )
                if auto_fix:
                    try:
                        path.unlink()
                        os.symlink(".agents/GEMINI.md", path)
                        actions_taken.append(f"Chuyển '{rel_name}' thành symlink trỏ về '.agents/GEMINI.md'.")
                        status = "FIXED (Symlink)"
                    except Exception as e:
                        actions_taken.append(f"Lỗi khi chuyển '{rel_name}' thành symlink: {e}")

        print(f"{rel_name:<26} | {type_str:<12} | {size_str:<12} | {tokens_str:<16} | {status}")

    print("-" * 88)
    print(f"👉 Base Directive Overhead: ~{base_tokens:,} tokens/turn")
    if base_tokens < 6400:
        passed_items.append(f"Base Directive Overhead: ~{base_tokens:,} tokens/turn (< 6,400 tokens threshold).")
    elif base_tokens < 7400:
        warning_issues.append(f"Base Directive Overhead ở mức trung bình (~{base_tokens:,} tokens/turn).")
    else:
        critical_issues.append(f"Base Directive Overhead vượt ngưỡng (~{base_tokens:,} tokens/turn).")
    print("")

    # ─────────────────────────────────────────────────────────────────────────────
    # PHẦN 2: QUÉT BẪY VÒNG LẶP & ĐƯỜNG DẪN CHẾT (DEAD REFERENCE TRAPS)
    # ─────────────────────────────────────────────────────────────────────────────
    print("🕵️ 2. KIỂM TRA ĐƯỜNG DẪN CHẾT TRONG FILE CHỈ DẪN (DEAD REFERENCE CHECK)")
    scanned_directives = [p for _, p in target_files if p.exists()]
    dead_refs_found = []

    for path in scanned_directives:
        try:
            content = path.read_text(encoding="utf-8", errors="ignore")
        except Exception:
            continue

        raw_matches = re.findall(r'(?:[\s\(\[\`\"\'\:]|^)([a-zA-Z0-9_\-\./]+\.[a-zA-Z0-9]{1,5})(?:[\s\)\]\`\"\'\:]|$)', content)
        for p_str in raw_matches:
            if p_str.startswith(('http://', 'https://', 'git://', 'ssh://')):
                continue
            if re.match(r'^\d+\.\d+$', p_str):
                continue
            if p_str in ['e.g.', 'i.e.', 'etc.', 'example.com']:
                continue
            if '/' in p_str or p_str.endswith(('.md', '.json', '.sh', '.py', '.ts', '.js', '.yml', '.yaml', '.txt')):
                if p_str in ["plan.md", "orca-team.json"]:
                    continue
                if "github.com" in content[max(0, content.find(p_str)-30):content.find(p_str)+len(p_str)+30]:
                    continue

                target_p = root / p_str
                if not target_p.exists():
                    dead_refs_found.append((p_str, path.name))

    if dead_refs_found:
        print(f"🚨 Phát hiện {len(dead_refs_found)} đường dẫn không tồn tại:")
        for ref, source in dead_refs_found:
            print(f"   ❌ '{ref}' (trong {source})")
            critical_issues.append(
                f"Đường dẫn '{ref}' trong '{source}' không tồn tại trên đĩa (gây lỗi File Not Found khi AI gọi view_file)."
            )
    else:
        print("   • Dead references: 0 (OK)")
        passed_items.append("Dead references trong file chỉ dẫn: 0.")
    print("")

    # ─────────────────────────────────────────────────────────────────────────────
    # PHẦN 3: VỆ SINH WORKSPACE & BẪY GIT STATUS (WORKSPACE HYGIENE)
    # ─────────────────────────────────────────────────────────────────────────────
    print("🧹 3. WORKSPACE HYGIENE & GIT STATUS FOOTPRINT")
    gitignore_path = root / ".gitignore"
    if not gitignore_path.exists():
        print("⚠️ Chưa có file '.gitignore'.")
        warning_issues.append("Thiếu file '.gitignore'.")
        if auto_fix:
            gitignore_path.write_text(".orca/\n.orca-cache/\n*.orca.log\nnode_modules/\n.venv/\n", encoding="utf-8")
            actions_taken.append("Tạo mới '.gitignore' với quy tắc chặn log Orca.")
    else:
        gi_content = gitignore_path.read_text(encoding="utf-8", errors="ignore")
        missing_ignores = [pat for pat in [".orca", ".orca-cache", "*.orca.log"] if pat not in gi_content]
        if missing_ignores:
            print(f"⚠️ '.gitignore' thiếu: {', '.join(missing_ignores)}")
            critical_issues.append(f"Thiếu '{', '.join(missing_ignores)}' trong .gitignore.")
            if auto_fix:
                with open(gitignore_path, "a", encoding="utf-8") as f:
                    f.write("\n# Orca Orchestrator Runtime Logs & Receipts\n")
                    for m in missing_ignores:
                        f.write(f"{m}\n")
                actions_taken.append(f"Bổ sung '{', '.join(missing_ignores)}' vào .gitignore.")
        else:
            print("   • .gitignore rules (.orca/, .orca-cache/, *.orca.log): OK")
            passed_items.append(".gitignore đã chặn thư mục tạm của Orca.")

    try:
        git_res = subprocess.run(["git", "status", "--porcelain"], capture_output=True, text=True, cwd=str(root), timeout=5)
        if git_res.returncode == 0:
            lines = [l for l in git_res.stdout.splitlines() if l.strip()]
            untracked = [l for l in lines if l.startswith("??")]
            modified = [l for l in lines if not l.startswith("??")]
            git_tokens = estimate_tokens(git_res.stdout)
            print(f"   • Git status output: {len(modified)} modified, {len(untracked)} untracked (~{git_tokens:,} tokens khi gọi git status)")
            if len(untracked) > 25:
                warning_issues.append(
                    f"Workspace có {len(untracked)} file untracked (~{git_tokens:,} tokens mỗi lần chạy 'git status')."
                )
            else:
                passed_items.append(f"Git status footprint nhỏ ({len(untracked)} untracked files, ~{git_tokens:,} tokens).")
    except Exception:
        pass
    print("")

    # ─────────────────────────────────────────────────────────────────────────────
    # PHẦN 4: RUNTIME TELEMETRY, TỐC ĐỘ MODEL (TOK/S) & PHÂN TÍCH ĐỊNH LƯỢNG
    # ─────────────────────────────────────────────────────────────────────────────
    print("⚡ 4. RUNTIME TELEMETRY, MODEL VELOCITY (TOK/S) & TOKEN BREAKDOWN")
    orca_bin = os.environ.get("ORCA_BIN") or shutil.which("orca") or "/usr/local/bin/orca"

    runtime_ok = False
    active_run_id = None
    active_run_obj = ""
    run_tasks = {}
    workers = []

    try:
        r_res = subprocess.run([orca_bin, "orchestration", "run-list", "--json"], capture_output=True, text=True, timeout=5)
        all_runs = []
        if r_res.returncode == 0:
            r_data = json.loads(r_res.stdout)
            r_obj = r_data.get("result", r_data) if isinstance(r_data, dict) else {}
            all_runs = r_obj.get("runs", []) if isinstance(r_obj, dict) else []
            runtime_ok = True

        proj_slug = root.name.lower()
        candidate_runs = [r for r in all_runs if not r.get("legacy")]

        selected_run = None
        for r in candidate_runs[:6]:
            rid = r.get("id")
            if not rid:
                continue
            w_chk = subprocess.run([orca_bin, "orchestration", "worker-list", "--run", rid, "--json"], capture_output=True, text=True, timeout=4)
            t_chk = subprocess.run([orca_bin, "orchestration", "task-list", "--run", rid, "--json"], capture_output=True, text=True, timeout=4)
            w_list_tmp = []
            t_list_tmp = []
            if w_chk.returncode == 0:
                wo = json.loads(w_chk.stdout).get("result", {})
                w_list_tmp = wo.get("workers", []) if isinstance(wo, dict) else []
            if t_chk.returncode == 0:
                to = json.loads(t_chk.stdout).get("result", {})
                t_list_tmp = to.get("tasks", []) if isinstance(to, dict) else []

            belongs_to_proj = (proj_slug in str(r.get("objective", "")).lower())
            for w_item in w_list_tmp:
                ws_str = str((w_item.get("resource") or {}).get("worktreeId") or "")
                if proj_slug in ws_str.lower() or str(root).lower() in ws_str.lower():
                    belongs_to_proj = True
                    break

            if belongs_to_proj and (w_list_tmp or t_list_tmp):
                selected_run = r
                workers = w_list_tmp
                for t in t_list_tmp:
                    if t.get("id"):
                        run_tasks[t.get("id")] = t
                break

        if not selected_run and candidate_runs:
            selected_run = candidate_runs[0]
            rid = selected_run.get("id")
            w_chk = subprocess.run([orca_bin, "orchestration", "worker-list", "--run", rid, "--json"], capture_output=True, text=True, timeout=4)
            t_chk = subprocess.run([orca_bin, "orchestration", "task-list", "--run", rid, "--json"], capture_output=True, text=True, timeout=4)
            if w_chk.returncode == 0:
                wo = json.loads(w_chk.stdout).get("result", {})
                workers = wo.get("workers", []) if isinstance(wo, dict) else []
            if t_chk.returncode == 0:
                to = json.loads(t_chk.stdout).get("result", {})
                for t in (to.get("tasks", []) if isinstance(to, dict) else []):
                    if t.get("id"):
                        run_tasks[t.get("id")] = t

        if selected_run:
            active_run_id = selected_run.get("id")
            active_run_obj = selected_run.get("objective", "")

        if runtime_ok:
            cli_index = _index_cli_transcripts()
            if active_run_id:
                obj_short = (active_run_obj[:78] + "...") if len(active_run_obj) > 81 else active_run_obj
                print(f"🎯 Run ID: {active_run_id} — \"{obj_short}\"")
            print(f"👥 Dispatched Workers: {len(workers)} | Tasks in DAG: {len(run_tasks)}")

            if workers:
                print("\n📊 4.1 BẢNG ĐO LƯỜNG TỐC ĐỘ AGENT CLI & TIÊU THỤ TOKEN TRÊN TỪNG WORKER:")
                hdr = (
                    f"   {'DISPATCH / ROLE':<27} | {'MODEL THỰC TẾ':<26} | {'WALL / IDLE':<13} | "
                    f"{'TURNS / TOOLS':<16} | {'LLM / TOOL TIME':<15} | {'SPEED (OUT | PREFILL)':<23} | "
                    f"{'TOKENS (OUT / PEAK / CACHE)':<27} | {'STATE'}"
                )
                print(hdr)
                print("   " + "-" * (len(hdr) - 3))

            reclaimable_dispatches = []
            total_spec_tokens = 0
            total_report_tokens = 0
            worker_metrics_list = []

            for w in workers:
                d_id = str(w.get("dispatchId") or w.get("id") or "-")
                t_id = str(w.get("taskId") or "-")
                term = str(w.get("terminalHandle") or w.get("agentTerminalHandle") or "-")
                term_state = str(w.get("terminalState") or "-")
                w_state = str(w.get("workerState") or w.get("state") or "-")
                w_phase = "-"

                wt_name = "-"
                wt_path = ""
                ag_name = "-"
                md_name = "-"
                duration_secs = 0.0
                last_out_idle_secs = None

                ws_id = str((w.get("resource") or {}).get("worktreeId") or "")
                if "::" in ws_id:
                    wt_path = ws_id.split("::", 1)[1]
                if "/" in ws_id:
                    wt_name = ws_id.rsplit("/", 1)[-1]

                try:
                    ws_res = subprocess.run([orca_bin, "orchestration", "worker-show", "--dispatch", d_id, "--json"], capture_output=True, text=True, timeout=4)
                    if ws_res.returncode == 0:
                        ws_json = json.loads(ws_res.stdout).get("result", {})
                        w_info = ws_json.get("worker", {})
                        d_info = ws_json.get("dispatch", {})
                        t_info = ws_json.get("terminal") or {}
                        w_phase = str(w_info.get("phase") or "-")
                        if t_info.get("worktreePath"):
                            wt_path = str(t_info.get("worktreePath"))
                        start_opts = w_info.get("startOptions", {})
                        if start_opts.get("name"):
                            wt_name = start_opts.get("name")
                        elif start_opts.get("worktree") and wt_name == "-":
                            wt_opt = str(start_opts.get("worktree"))
                            wt_name = wt_opt.rsplit("/", 1)[-1] if "/" in wt_opt else wt_opt.split(":", 1)[-1]
                        eff_launch = (start_opts.get("launch") or {}).get("effective") or {}
                        ag_name = str(eff_launch.get("agent") or start_opts.get("agent") or "-")
                        md_name = str(eff_launch.get("model") or ag_name)

                        c_at = str(d_info.get("dispatchedAt") or w_info.get("createdAt") or "")
                        raw_comp_at = d_info.get("completedAt")
                        from datetime import datetime, timezone
                        now_utc = datetime.now(timezone.utc)
                        if raw_comp_at:
                            comp_dt = _parse_iso_utc(str(raw_comp_at))
                        elif term_state == "active" or w_state not in ("succeeded", "failed", "stopped", "timed_out"):
                            comp_dt = now_utc
                        else:
                            comp_dt = _parse_iso_utc(str(w_info.get("updatedAt") or ""))
                        start_dt = _parse_iso_utc(c_at)
                        if start_dt and comp_dt:
                            duration_secs = max(0.0, (comp_dt - start_dt).total_seconds())

                        last_out_raw = t_info.get("lastOutputAt") or w_info.get("lastHeartbeatAt")
                        if last_out_raw:
                            lo_dt = _parse_iso_utc(str(last_out_raw))
                            if lo_dt:
                                last_out_idle_secs = max(0.0, (now_utc - lo_dt).total_seconds())
                except Exception:
                    pass

                # Khớp transcript thực tế của Worker CLI
                tf_match = (
                    cli_index["by_dispatch"].get(d_id)
                    or cli_index["by_task"].get(t_id)
                    or cli_index["by_term"].get(term)
                )
                t_metrics = _analyze_antigravity_transcript(tf_match) if tf_match else {}

                t_obj_info = run_tasks.get(t_id, {})
                spec_txt = str(t_obj_info.get("spec") or "")
                res_raw = str(t_obj_info.get("result") or "")
                spec_tok = estimate_tokens(spec_txt)
                total_spec_tokens += spec_tok

                rep_body = ""
                files_mod_count = 0
                if res_raw:
                    try:
                        res_parsed = json.loads(res_raw)
                        rep_body = str(res_parsed.get("body") or "")
                        f_mod = res_parsed.get("filesModified") or []
                        files_mod_count = len(f_mod)
                    except Exception:
                        rep_body = res_raw
                rep_tok = estimate_tokens(rep_body)
                total_report_tokens += rep_tok

                git_stats = _collect_git_diff_stats(wt_path, wt_name)
                if files_mod_count == 0 and git_stats["files"] > 0:
                    files_mod_count = git_stats["files"]

                # Chuẩn bị các cột hiển thị
                role_col = f"{d_id[:10]}.. ({wt_name})"[:27]
                model_col = md_name[:26]
                wall_s = duration_secs if duration_secs > 0 else t_metrics.get("wall_secs", 0.0)
                idle_s = t_metrics.get("idle_since_last_secs") if t_metrics else last_out_idle_secs
                if w_state in ("succeeded", "failed", "stopped"):
                    wall_idle_col = f"{_fmt_dur(wall_s)} / done"
                elif idle_s is not None:
                    wall_idle_col = f"{_fmt_dur(wall_s)} / {_fmt_dur(idle_s)}"
                else:
                    wall_idle_col = f"{_fmt_dur(wall_s)} / -"

                if t_metrics:
                    turns_tools_col = f"{t_metrics['turns']}t / {t_metrics['tool_calls']}c({t_metrics['tool_errors']}e)"
                    llm_tool_col = f"{_fmt_dur(t_metrics['llm_secs'])} / {_fmt_dur(t_metrics['tool_secs'])}"
                    speed_col = f"{t_metrics['out_tok_s']:>5.1f} | {_fmt_tok(int(t_metrics['prefill_tok_s'])):>6}/s"
                    tok_col = f"{_fmt_tok(t_metrics['out_tok']):>5} / {_fmt_tok(t_metrics['peak_ctx']):>6} / {t_metrics['cache_hit_pct']:>4.1f}%"
                else:
                    turns_tools_col = "N/A (no log)"
                    llm_tool_col = "- / -"
                    speed_col = "N/A"
                    tok_col = "N/A"

                if term_state in ["reclaimable", "retained"]:
                    reclaimable_dispatches.append(d_id)

                state_col = f"{w_state}/{w_phase} ({term_state})"
                print(
                    f"   {role_col:<27} | {model_col:<26} | {wall_idle_col:<13} | "
                    f"{turns_tools_col:<16} | {llm_tool_col:<15} | {speed_col:<23} | "
                    f"{tok_col:<27} | {state_col}"
                )

                # Dòng phụ hiển thị chi tiết công việc kỹ thuật: Git diff, latency trung bình/turn, tool cuối, spec vs report
                t_title = str(t_obj_info.get("task_title") or t_obj_info.get("display_name") or "")[:54]
                git_str = f"git: {files_mod_count} files (+{git_stats['ins']}/-{git_stats['del']}, {git_stats['commits']} commits)"
                if t_metrics:
                    lat_str = f"avg_turn: {t_metrics['avg_turn_s']:.1f}s/turn | active_vel: {t_metrics['active_tok_s']:.1f} tok/s | in_fresh: {_fmt_tok(t_metrics['in_tok'])} | cache_read: {_fmt_tok(t_metrics['cache_tok'])} | last_tool: {t_metrics['last_tool']}"
                else:
                    lat_str = "transcript telemetry unavailable"
                print(f"      ↳ Task: \"{t_title}\" | spec={spec_tok} tok -> report={rep_tok} tok | {git_str}")
                print(f"      ↳ Perf: {lat_str}")

                if t_metrics and w_state not in ("succeeded", "failed", "stopped") and (idle_s or 0) > 180:
                    warning_issues.append(
                        f"Worker {wt_name} ({d_id}) đang active nhưng không có bước thực thi mới trong {_fmt_dur(idle_s)} (last_tool={t_metrics['last_tool']})."
                    )
                if t_metrics and t_metrics["tool_errors"] >= 10:
                    warning_issues.append(
                        f"Worker {wt_name} ({d_id}) có {t_metrics['tool_errors']}/{t_metrics['tool_calls']} lệnh tool trả về mã lỗi (command retry overhead)."
                    )

                worker_metrics_list.append({
                    "dispatch_id": d_id,
                    "role": wt_name,
                    "model": md_name,
                    "state": w_state,
                    "term_state": term_state,
                    "wall_secs": wall_s,
                    "spec_tok": spec_tok,
                    "rep_tok": rep_tok,
                    "files": files_mod_count,
                    "ins": git_stats["ins"],
                    "del": git_stats["del"],
                    "telemetry": t_metrics,
                })

            # Hiển thị các Task đang chờ tới lượt trong Task DAG (chưa dispatch)
            dispatched_task_ids = {str(w.get("taskId") or "") for w in workers}
            pending_dag_tasks = [
                t for tid, t in run_tasks.items()
                if tid not in dispatched_task_ids and isinstance(t, dict) and t.get("status") in ("ready", "pending", "blocked")
            ]
            if pending_dag_tasks:
                for pt in pending_dag_tasks:
                    pt_title = str(pt.get("task_title") or pt.get("display_name") or "")[:68]
                    pt_status = str(pt.get("status") or "ready")
                    print(f"   ⏳ Queued in DAG ({pt.get('id')} - {pt_status}): \"{pt_title}\"")

            # Kiểm tra các Gate treo (pending) hoặc Task bị kẹt 'blocked'/'ready' sau khi toàn bộ worker đã succeeded & released ở Bước 4
            all_workers_settled_released = bool(workers) and all(
                str(w.get("workerState") or w.get("state") or "") == "succeeded" and str(w.get("terminalState") or "") == "released"
                for w in workers
            )
            if active_run_id and all_workers_settled_released:
                try:
                    g_res = subprocess.run([orca_bin, "orchestration", "gate-list", "--run", active_run_id, "--json"], capture_output=True, text=True, timeout=4)
                    pending_gates = []
                    if g_res.returncode == 0:
                        g_obj = json.loads(g_res.stdout).get("result", {})
                        pending_gates = [g for g in (g_obj.get("gates") or []) if isinstance(g, dict) and g.get("status") == "pending"]
                    stuck_tasks = [
                        t for t in run_tasks.values()
                        if isinstance(t, dict) and t.get("status") in ("blocked", "ready") and t.get("result")
                    ]
                    if pending_gates or stuck_tasks:
                        if auto_fix:
                            resolved_g = 0
                            fixed_t = 0
                            for g in pending_gates:
                                gid = g.get("id")
                                if gid:
                                    gr = subprocess.run([orca_bin, "orchestration", "gate-resolve", "--id", gid, "--resolution", "yes", "--json"], capture_output=True, text=True, timeout=4)
                                    if gr.returncode == 0:
                                        resolved_g += 1
                            for t in stuck_tasks:
                                tid = t.get("id")
                                if tid:
                                    tr = subprocess.run([orca_bin, "orchestration", "task-update", "--id", tid, "--status", "completed", "--json"], capture_output=True, text=True, timeout=4)
                                    if tr.returncode == 0:
                                        fixed_t += 1
                            if (len(pending_gates) > resolved_g) or (len(stuck_tasks) > fixed_t):
                                try:
                                    import sqlite3
                                    orca_db = Path.home() / "Library" / "Application Support" / "orca" / "profiles" / "default" / "orchestration.sqlite"
                                    if orca_db.exists():
                                        conn = sqlite3.connect(str(orca_db), timeout=3)
                                        with conn:
                                            for g in pending_gates:
                                                gid = g.get("id")
                                                if gid:
                                                    conn.execute("UPDATE decision_gates SET status = 'resolved', resolution = 'yes', resolved_at = COALESCE(resolved_at, datetime('now')) WHERE id = ? AND status = 'pending'", (gid,))
                                                    resolved_g += 1
                                            for t in stuck_tasks:
                                                tid = t.get("id")
                                                if tid:
                                                    conn.execute("UPDATE tasks SET status = 'completed', completed_at = COALESCE(completed_at, datetime('now')), updated_at = datetime('now') WHERE id = ? AND status IN ('blocked', 'ready')", (tid,))
                                                    fixed_t += 1
                                        conn.close()
                                except Exception:
                                    pass
                            actions_taken.append(f"Đóng {len(pending_gates)} Gate pending & cập nhật {len(stuck_tasks)} Task về 'completed' cho Run {active_run_id}.")
                        else:
                            warning_issues.append(
                                f"Run {active_run_id} đã thu hồi hết worker nhưng còn {len(pending_gates)} Gate 'pending' / {len(stuck_tasks)} Task '{stuck_tasks[0].get('status') if stuck_tasks else 'blocked'}' (chạy 'orca-monitor --fix' để đồng bộ)."
                            )
                except Exception:
                    pass

            # 4.1b Kiểm tra Orca Agent Status Hooks
            hooks_res = subprocess.run([orca_bin, "agent", "hooks", "status", "--json"], capture_output=True, text=True, timeout=5)
            if hooks_res.returncode == 0:
                hooks_data = json.loads(hooks_res.stdout).get("result", {})
                hook_statuses = {s.get("agent"): s for s in (hooks_data.get("statuses") or []) if isinstance(s, dict)}
                configured_agents = set()
                if config:
                    c_ag = (config.get("coordinator") or {}).get("agent")
                    if c_ag:
                        configured_agents.add(c_ag)
                    for r_cfg in (config.get("roles") or {}).values():
                        if isinstance(r_cfg, dict) and r_cfg.get("enabled", True) and r_cfg.get("agent") and r_cfg.get("agent") != "none":
                            configured_agents.add(r_cfg.get("agent"))
                if not configured_agents:
                    configured_agents = {"antigravity", "claude", "kimi", "gemini"}

                missing_hooks = [
                    ag for ag in sorted(configured_agents)
                    if ag in hook_statuses and not hook_statuses[ag].get("managedHooksPresent")
                ]
                if missing_hooks:
                    orca_electron = "/Applications/Orca.app/Contents/MacOS/Orca"
                    hook_ctrl = "/Applications/Orca.app/Contents/Resources/app.asar.unpacked/out/main/agent-hooks/managed-agent-hook-controls.js"
                    if os.path.exists(orca_electron) and os.path.exists(hook_ctrl):
                        env_hydrate = os.environ.copy()
                        env_hydrate["ELECTRON_RUN_AS_NODE"] = "1"
                        subprocess.run(
                            [orca_electron, "-e", f'require("{hook_ctrl}").installManagedAgentHooks(null, {{agents: {json.dumps(missing_hooks)}, shouldHydrateShellPath: true}})'],
                            env=env_hydrate, capture_output=True, text=True, timeout=8
                        )
                        actions_taken.append(f"Cài đặt Orca Status Hooks cho: {', '.join(missing_hooks)}")
                        passed_items.append(f"Orca Status Hooks active cho: {', '.join(sorted(configured_agents))}.")
                    else:
                        warning_issues.append(f"Agent {', '.join(missing_hooks)} thiếu Orca Status Hooks.")
                else:
                    passed_items.append(f"Orca Status Hooks active cho: {', '.join(sorted(configured_agents))}.")

            # 4.2 Phân tích Mailbox
            inbox_res = subprocess.run([orca_bin, "orchestration", "inbox", "--limit", "50", "--json"], capture_output=True, text=True, timeout=5)
            hb_count = done_count = esc_count = handoff_count = done_tokens = 0
            run_msgs = []
            if inbox_res.returncode == 0:
                inbox_data = json.loads(inbox_res.stdout)
                inbox_obj = inbox_data.get("result", inbox_data) if isinstance(inbox_data, dict) else {}
                all_msgs = inbox_obj.get("messages", []) if isinstance(inbox_obj, dict) else []
                run_msgs = [m for m in all_msgs if not active_run_id or m.get("run_id") == active_run_id]
                if not run_msgs:
                    run_msgs = all_msgs[:20]

                hb_count = sum(1 for m in run_msgs if m.get("type") == "heartbeat")
                done_count = sum(1 for m in run_msgs if m.get("type") == "worker_done")
                esc_count = sum(1 for m in run_msgs if m.get("type") in ["escalation", "question"])
                handoff_count = sum(1 for m in run_msgs if m.get("type") in ["handoff", "dispatch", "status"])
                done_tokens = sum(estimate_tokens(str(m.get("body") or "") + str(m.get("subject") or "")) for m in run_msgs if m.get("type") in ["worker_done", "handoff", "escalation", "question"])

                print(f"\n📬 4.2 MAILBOX IPC TELEMETRY:")
                print(f"   • Messages in Run: {len(run_msgs)} total | heartbeat={hb_count} (SQLite-handled, 0 LLM tokens) | worker_done={done_count} | handoff={handoff_count} | escalation/question={esc_count}")
                print(f"   • Coordinator Wake Payload: {done_count + handoff_count + esc_count} event(s), payload={done_tokens:,} tokens (avg {done_tokens // max(1, done_count + handoff_count + esc_count)} tok/msg)")

            # 4.3 BẢNG TỔNG HỢP SỐ LIỆU ĐO ĐẠC THỰC TẾ (LEADER VS WORKERS TELEMETRY)
            if workers:
                leader_tf = cli_index["by_leader_run"].get(active_run_id) if active_run_id else None
                leader_m = _analyze_antigravity_transcript(leader_tf) if leader_tf else {}

                w_with_m = [wm["telemetry"] for wm in worker_metrics_list if wm.get("telemetry")]
                w_turns = sum(m["turns"] for m in w_with_m)
                w_tools = sum(m["tool_calls"] for m in w_with_m)
                w_errs = sum(m["tool_errors"] for m in w_with_m)
                w_in_tok = sum(m["in_tok"] for m in w_with_m)
                w_cache_tok = sum(m["cache_tok"] for m in w_with_m)
                w_out_tok = sum(m["out_tok"] for m in w_with_m)
                w_peak_max = max((m["peak_ctx"] for m in w_with_m), default=0)
                w_llm_s = sum(m["llm_secs"] for m in w_with_m)
                w_tool_s = sum(m["tool_secs"] for m in w_with_m)
                w_out_speed = w_out_tok / max(1.0, w_llm_s)
                w_prefill_speed = (w_in_tok + w_cache_tok + w_out_tok) / max(1.0, w_llm_s)
                w_cache_pct = (w_cache_tok / max(1, w_in_tok + w_cache_tok)) * 100.0

                released_cnt = sum(1 for w in workers if str(w.get("terminalState") or "") == "released")
                retained_cnt = sum(1 for w in workers if str(w.get("terminalState") or "") in ["retained", "reclaimable"])
                active_cnt = sum(1 for w in workers if str(w.get("terminalState") or "") == "active")

                print(f"\n📈 4.3 BẢNG ĐỐI CHIẾU SỐ LIỆU ĐO ĐẠC THỰC TẾ (MEASURED TRANSCRIPT METRICS):")
                print("   ┌──────────────────────────────────────────────┬─────────────────────────────────┬─────────────────────────────────┐")
                print("   │ Chỉ số kỹ thuật (Đo trực tiếp từ Transcript) │ LEADER (Coordinator)            │ WORKERS (Tổng hợp các nhánh)    │")
                print("   ├──────────────────────────────────────────────┼─────────────────────────────────┼─────────────────────────────────┤")
                if leader_m:
                    l_turns_str = f"{leader_m['turns']} turns / {leader_m['tool_calls']} tools ({leader_m['tool_errors']} err)"
                    l_time_str = f"LLM {_fmt_dur(leader_m['llm_secs'])} | Tool {_fmt_dur(leader_m['tool_secs'])}"
                    l_spd_str = f"{leader_m['out_tok_s']:.1f} out/s | {_fmt_tok(int(leader_m['prefill_tok_s']))} tot/s"
                    l_in_str = f"{leader_m['in_tok']:,} tok"
                    l_cache_str = f"{leader_m['cache_tok']:,} tok ({leader_m['cache_hit_pct']:.1f}%)"
                    l_out_str = f"{leader_m['out_tok']:,} tok"
                    l_peak_str = f"{leader_m['peak_ctx']:,} tok (last: {leader_m['last_ctx']:,})"
                else:
                    l_turns_str = "N/A (IDE/External Session)"
                    l_time_str = "N/A"
                    l_spd_str = "N/A"
                    l_in_str = f"~{base_tokens + total_spec_tokens + total_report_tokens:,} tok (est)"
                    l_cache_str = "N/A"
                    l_out_str = f"~{total_spec_tokens:,} tok (spec)"
                    l_peak_str = f"~{base_tokens + total_report_tokens:,} tok"

                w_turns_str = f"{w_turns} turns / {w_tools} tools ({w_errs} err)" if w_with_m else "N/A"
                w_time_str = f"LLM {_fmt_dur(w_llm_s)} | Tool {_fmt_dur(w_tool_s)}" if w_with_m else "N/A"
                w_spd_str = f"{w_out_speed:.1f} out/s | {_fmt_tok(int(w_prefill_speed))} tot/s" if w_with_m else "N/A"
                w_in_str = f"{w_in_tok:,} tok" if w_with_m else "N/A"
                w_cache_str = f"{w_cache_tok:,} tok ({w_cache_pct:.1f}%)" if w_with_m else "N/A"
                w_out_str = f"{w_out_tok:,} tok" if w_with_m else "N/A"
                w_peak_str = f"max {w_peak_max:,} tok" if w_with_m else "N/A"
                l_term_str = f"active={active_cnt}, retain={retained_cnt}"
                w_term_str = f"released={released_cnt}/{len(workers)}"

                print(f"   │ 1. Số lượt suy luận & gọi Tool (Turns/Tools) │ {l_turns_str:<31} │ {w_turns_str:<31} │")
                print(f"   │ 2. Thời gian thực thi (LLM Inference / Tool) │ {l_time_str:<31} │ {w_time_str:<31} │")
                print(f"   │ 3. Tốc độ xử lý (Out tok/s | Total tok/s)    │ {l_spd_str:<31} │ {w_spd_str:<31} │")
                print(f"   │ 4. Fresh Input Tokens (Nạp mới lũy kế)       │ {l_in_str:<31} │ {w_in_str:<31} │")
                print(f"   │ 5. Cache Read Tokens (Tái sử dụng Cache %)   │ {l_cache_str:<31} │ {w_cache_str:<31} │")
                print(f"   │ 6. Output Tokens (Reasoning + Code sinh ra)  │ {l_out_str:<31} │ {w_out_str:<31} │")
                print(f"   │ 7. Đỉnh Context Window (Peak Context / Turn) │ {l_peak_str:<31} │ {w_peak_str:<31} │")
                print(f"   │ 8. Trạng thái Worker Terminals               │ {l_term_str:<31} │ {w_term_str:<31} │")
                print("   └──────────────────────────────────────────────┴─────────────────────────────────┴─────────────────────────────────┘")

                # Phân tích tốc độ theo từng dòng Model thực tế trong Run
                model_buckets = {}
                for wm in worker_metrics_list:
                    tm = wm.get("telemetry")
                    if not tm:
                        continue
                    m_key = wm["model"]
                    b = model_buckets.setdefault(m_key, {"runs": 0, "turns": 0, "out_tok": 0, "in_tok": 0, "cache_tok": 0, "llm_s": 0.0, "tool_s": 0.0})
                    b["runs"] += 1
                    b["turns"] += tm["turns"]
                    b["out_tok"] += tm["out_tok"]
                    b["in_tok"] += tm["in_tok"]
                    b["cache_tok"] += tm["cache_tok"]
                    b["llm_s"] += tm["llm_secs"]
                    b["tool_s"] += tm["tool_secs"]
                if leader_m and config:
                    l_mod = str((config.get("coordinator") or {}).get("model") or "coordinator-model")
                    b = model_buckets.setdefault(f"{l_mod} (leader)", {"runs": 0, "turns": 0, "out_tok": 0, "in_tok": 0, "cache_tok": 0, "llm_s": 0.0, "tool_s": 0.0})
                    b["runs"] += 1
                    b["turns"] += leader_m["turns"]
                    b["out_tok"] += leader_m["out_tok"]
                    b["in_tok"] += leader_m["in_tok"]
                    b["cache_tok"] += leader_m["cache_tok"]
                    b["llm_s"] += leader_m["llm_secs"]
                    b["tool_s"] += leader_m["tool_secs"]

                if model_buckets:
                    print("\n⏱️ 4.4 BENCHMARK TỐC ĐỘ THỰC TẾ THEO MODEL (MODEL SPEED & LATENCY PROFILE):")
                    for m_key, b in model_buckets.items():
                        out_s = b["out_tok"] / max(1.0, b["llm_s"])
                        tot_s = (b["in_tok"] + b["cache_tok"] + b["out_tok"]) / max(1.0, b["llm_s"])
                        avg_t = b["llm_s"] / max(1, b["turns"])
                        c_pct = (b["cache_tok"] / max(1, b["in_tok"] + b["cache_tok"])) * 100.0
                        llm_share = (b["llm_s"] / max(1.0, b["llm_s"] + b["tool_s"])) * 100.0
                        print(
                            f"   • {m_key:<32}: gen={out_s:>5.1f} out_tok/s | throughput={_fmt_tok(int(tot_s)):>6} tok/s | "
                            f"latency={avg_t:>4.1f}s/turn | cache={c_pct:>4.1f}% | time_split: LLM {llm_share:.0f}% / Tool {100-llm_share:.0f}%"
                        )

        else:
            print("ℹ️ Không thể kết nối Orca Runtime qua CLI (EPERM hoặc Orca đang đóng).")
            print("  (Chạy 'orca-monitor' trực tiếp trên Terminal để truy xuất runtime telemetry).")
    except Exception as e:
        print(f"ℹ️ Bỏ qua kiểm tra runtime chi tiết do: {e}")
    print("")

    # ─────────────────────────────────────────────────────────────────────────────
    # PHẦN 5: TỔNG KẾT PHÁT HIỆN KỸ THUẬT & LỆNH XỬ LÝ (DIAGNOSTIC SUMMARY)
    # ─────────────────────────────────────────────────────────────────────────────
    print("🎯 5. CHẨN ĐOÁN KỸ THUẬT & KHUYẾN NGHỊ HÀNH ĐỘNG (DIAGNOSTIC AUDIT)")
    print("═" * 105)

    if actions_taken:
        print("🛠️ AUTO-FIX ĐÃ THỰC THI:")
        for act in actions_taken:
            print(f"   • {act}")
        print("")

    if critical_issues:
        print("🔴 CRITICAL ISSUES (CẦN XỬ LÝ NGAY):")
        for idx, iss in enumerate(critical_issues, 1):
            print(f"   {idx}. {iss}")
        print("")

    if warning_issues:
        print("🟡 WARNINGS / BOTTLENECKS (ĐIỂM NGHẼN HOẶC RÒ RỈ CONTEXT):")
        for idx, iss in enumerate(warning_issues, 1):
            print(f"   {idx}. {iss}")
        print("")

    if passed_items:
        print("🟢 PASSED CHECKS:")
        for idx, item in enumerate(passed_items, 1):
            print(f"   {idx}. {item}")
        print("")

    print("⌨️ LỆNH ĐIỀU KHIỂN NHANH:")
    print("   • Tự động sửa lỗi cấu hình / đóng Gate treo:  orca-monitor --fix")
    print("   • Kiểm tra & gỡ kẹt worker chờ prompt:        orca-team watchdog --unblock\n")

def main():
    raw_args = sys.argv[1:]
    explicit_root = None
    args = []
    i = 0
    while i < len(raw_args):
        if raw_args[i] in ("--path", "-C") and i + 1 < len(raw_args):
            explicit_root = Path(raw_args[i + 1]).expanduser().resolve()
            i += 2
        elif raw_args[i].startswith("--path="):
            explicit_root = Path(raw_args[i].split("=", 1)[1]).expanduser().resolve()
            i += 1
        else:
            args.append(raw_args[i])
            i += 1

    root = explicit_root if explicit_root is not None else find_project_root()
    config = load_config(root)

    # Nếu được gọi trực tiếp qua alias 'orca-monitor'
    prog_name = Path(sys.argv[0]).name
    if prog_name == "orca-monitor":
        for a in args:
            if not a.startswith("-") and Path(a).expanduser().is_dir():
                root = Path(a).expanduser().resolve()
                config = load_config(root)
                break
        cmd_monitor(root, config, args)
        return

    if not args or args[0] in ["status", "list", "show"] or Path(args[0]).expanduser().is_dir():
        for a in args:
            if not a.startswith("-") and Path(a).expanduser().is_dir():
                root = Path(a).expanduser().resolve()
                config = load_config(root)
                break
        cmd_status(root, config)
    elif args[0] == "set":
        cmd_set(root, config, args[1:])
    elif args[0] == "get":
        cmd_get(root, config, args[1:])
    elif args[0] in ["watchdog", "workers", "health"]:
        cmd_watchdog(root, args[1:])
    elif args[0] in ["monitor", "debug", "tokens", "token", "audit-tokens"]:
        for a in args[1:]:
            if not a.startswith("-") and Path(a).expanduser().is_dir():
                root = Path(a).expanduser().resolve()
                config = load_config(root)
                break
        cmd_monitor(root, config, args[1:])
    elif args[0] in ["link", "discovery"]:
        cmd_link(root, args[1:])
    elif args[0] == "sync":
        for a in args[1:]:
            if not a.startswith("-") and Path(a).expanduser().is_dir():
                root = Path(a).expanduser().resolve()
                config = load_config(root)
                break
        if not config:
            print(f"❌ Không tìm thấy orca-team.json trong '{root}'.", file=sys.stderr)
            sys.exit(1)
        sync_gemini_directive(root, config)
        print(f"✅ Đã đồng bộ '{root / '.agents' / 'GEMINI.md'}' từ '{root / 'orca-team.json'}'.")
    elif args[0] in ["uninstall", "remove", "clean-all", "purge"]:
        cmd_uninstall_project(root, args[1:])
    elif args[0] in ["models", "list-models", "discover-models"]:
        cmd_models(args[1:])
    elif args[0] in ["select", "menu", "choose"]:
        cmd_select(args[1:])
    elif args[0] in ["agents", "list-agents"]:
        print("🐋 Các Agent chính thức được Orca ADE hỗ trợ:")
        for ag in KNOWN_AGENTS:
            print(f"  • {ag}")
    elif args[0] in ["-h", "--help", "help"]:
        print(__doc__)
    else:
        # Default fallback: check if first arg is a role name directly, e.g. "orca-team dev"
        if args[0].lower() in ROLE_ALIASES:
            cmd_set(root, config, args)
        else:
            print(f"❌ Lệnh không hợp lệ: '{args[0]}'. Dùng 'orca-team --help' để xem hướng dẫn.", file=sys.stderr)
            sys.exit(1)

if __name__ == "__main__":
    main()
