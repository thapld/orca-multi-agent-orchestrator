{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrcaTeamConfig",
  "description": "Configuration schema for Orca Multi-Agent Orchestration Team",
  "projectPath": "/path/to/project",
  "executionHost": "local",
  "coordinator": {
    "agent": "claude",
    "description": "Lead Architect & DAG Coordinator"
  },
  "roles": {
    "developer": {
      "agent": "kimi",
      "concurrency": 2,
      "utilities": ["git-worktrees", "browser-design-mode", "orca-skills-registry"]
    },
    "qa": {
      "agent": "kimi",
      "concurrency": 1,
      "utilities": ["git-worktrees", "browser-design-mode", "orca-skills-registry"]
    },
    "security": {
      "agent": "codex",
      "concurrency": 1,
      "utilities": ["git-worktrees", "orca-skills-registry"]
    },
    "prReviewer": {
      "agent": "claude",
      "utilities": ["git-worktrees", "diff-viewer", "annotate-ai-diff"]
    },
    "issueResolver": {
      "agent": "kimi",
      "utilities": ["git-worktrees", "issue-metadata", "commit-push"]
    },
    "uiSpecialist": {
      "enabled": true,
      "agent": "claude",
      "utilities": ["browser-design-mode", "per-worktree-browser"]
    },
    "devopsSpecialist": {
      "enabled": true,
      "agent": "codex",
      "utilities": ["ssh-remote-execution", "orca-per-workspace-env"]
    }
  }
}
